# Rocket Routers Firmware E — Mycelium v3.4.0 — VERSION METADATA
# Append to .config in ~/src/openwrt then run: make defconfig
#
# Changes from v3.3.0:
#   - 98-rocket-wifi: REMOVED set -e (was killing WiFi configuration silently)
#       Any UCI failure now logged and skipped — uci commit wireless always runs
#       Creates default_radioX iface sections if missing
#   - 92-rocket-pin-modem: FIXED infinite respawn loop
#       Replaced procd_set_param respawn with plain start() — oneshot, no restart
#   - rocket-vE.config: ADDED sms-tool package
#       sms_tool is called by 97-rocket-modem for all AT commands; was missing,
#       causing error 127 on every AT command (APN never set, NCM mode not set)
#   - Hotplug scripts now baked directly into squashfs (belt AND suspenders):
#       /etc/hotplug.d/usb/20-quectel-smarty-apn (APN re-apply on USB connect)
#       /etc/hotplug.d/net/30-wwan-up (ifup wwan when usb0 appears)
#   - Build script stages hotplug scripts directly into files/ — not just
#     deployed at runtime by uci-defaults

CONFIG_VERSION_DIST="Rocket Routers"
CONFIG_VERSION_NUMBER="3.4.0"
CONFIG_VERSION_CODE="rocket-E-mycelium"
CONFIG_VERSION_REPO="https://rocketrouters.co.uk"
CONFIG_VERSION_MANUFACTURER="Rocket Routers"
CONFIG_VERSION_MANUFACTURER_URL="https://rocketrouters.co.uk"
CONFIG_VERSION_BUG_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_SUPPORT_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_PRODUCT="Rocket Plus E"
CONFIG_VERSION_HWREV="E"
CONFIG_VERSION_FILENAMES=y
