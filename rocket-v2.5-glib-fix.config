# Rocket Routers Firmware A v2.5 - GLib subpackage fix
#
# In current OpenWrt SNAPSHOT, glib2 is split into 5 subpackages.
# Selecting only CONFIG_PACKAGE_glib2=y doesn't pull them in - the
# subpackages have to be explicitly enabled so the build system
# registers them as providers of libglib/libgio/libgobject.

CONFIG_PACKAGE_glib2-core=y
CONFIG_PACKAGE_glib2-gmodule=y
CONFIG_PACKAGE_glib2-gobject=y
CONFIG_PACKAGE_glib2-gio=y
CONFIG_PACKAGE_glib2-gthread=y
