#!/bin/sh
# /etc/uci-defaults/93-rocket-iperf3
# Mycelium Mesh RocketRouters - iperf3 server (LAN-side throughput testing)
#
# Drops a procd init script that runs `iperf3 -s` on TCP/UDP port 5201, bound
# to the LAN bridge only (so it's not exposed to WAN/cell). Lets customers
# benchmark wifi/lan from any laptop with `iperf3 -c 192.168.1.1`.
#
# Why daemon-only on LAN: iperf3 -s with no firewall rule would be reachable
# from cell/fibre WAN if we bound it to all interfaces. We bind to br-lan IP
# so it's automatically firewalled by the WAN zone.

set -e
LOGTAG="rocket-iperf3"
logger -t "$LOGTAG" "v2.5.5 installing iperf3 server"

cat > /etc/init.d/rocket-iperf3 <<'EOF'
#!/bin/sh /etc/rc.common
# Rocket Routers iperf3 server
# Listens on br-lan IP only (LAN-side benchmarking)

START=95
STOP=15
USE_PROCD=1

PROG=/usr/bin/iperf3

start_service() {
    # Bind to br-lan IP if available, fall back to 0.0.0.0 (firewall blocks WAN)
    local LAN_IP
    LAN_IP=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
    [ -z "$LAN_IP" ] && LAN_IP="0.0.0.0"

    procd_open_instance
    procd_set_param command "$PROG" -s -p 5201 --bind "$LAN_IP"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
EOF

chmod +x /etc/init.d/rocket-iperf3
/etc/init.d/rocket-iperf3 enable
/etc/init.d/rocket-iperf3 start >/dev/null 2>&1 || true

logger -t "$LOGTAG" "iperf3 server enabled on port 5201 (LAN only)"
exit 0
