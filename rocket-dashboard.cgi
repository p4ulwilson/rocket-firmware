function applyLang(code){
  var L = LANGS[code] || LANGS['en'];
  var en = LANGS['en'];
  document.body.classList.toggle('rtl', code === 'ar');
  document.querySelectorAll('[data-i18n]').forEach(function(el){
    var k = el.getAttribute('data-i18n');
    el.innerHTML = (L[k] !== undefined) ? L[k] : (en[k] || '');
  });
  document.getElementById('tab-earn').innerHTML    = L.tab_earn    || en.tab_earn;
  document.getElementById('tab-claude').innerHTML  = L.tab_claude  || en.tab_claude;
  document.getElementById('tab-nov').innerHTML     = L.tab_nov     || en.tab_nov;
  document.getElementById('tab-exp').innerHTML     = L.tab_exp     || en.tab_exp;
  document.getElementById('tab-protect').innerHTML = L.tab_protect || en.tab_protect;
  var foot = document.getElementById('foot-refresh');
  if(foot) foot.innerHTML = (L.foot || en.foot) + ' · Last updated: ${NOW}';
  var h1 = document.getElementById('hdr-title');
  var sub = document.getElementById('hdr-sub');
  if(code === 'eg'){
    if(h1) h1.innerHTML = '𓂀 𓆣𓋴𓂋𓁨𓄿𓅱𓈖𓌀 𓃭𓅱𓈖𓆑𓂀𓅱';
    if(sub) sub.innerHTML = '𓁨𓈖𓌀 𓁨𓂋𓈖𓌀𓅱 𓆑𓋴𓂋𓁨𓄿𓅱𓈖𓌀 — ${HOSTNAME}';
  } else {
    if(h1) h1.innerHTML = 'Rocket Routers';
    if(sub) sub.innerHTML = 'Mycelium Firmware — Freedom Layer · ${HOSTNAME}';
  }
  try{ localStorage.setItem('rr_lang', code); }catch(e){}
}
function setLang(code){ applyLang(code); }

// ── Init ──────────────────────────────────────────────────────────────────────
(function(){
  // Restore language
  var lang = 'en';
  try{ lang = localStorage.getItem('rr_lang') || 'en'; }catch(e){}
  var sel = document.getElementById('lang-sel');
  if(sel && LANGS[lang]) sel.value = lang;
  if(lang !== 'en') applyLang(lang);

  // Restore wallet
  try{
    var pp = localStorage.getItem('rr_paypal');
    var cr = localStorage.getItem('rr_crypto');
    if(pp) document.getElementById('w-paypal').value = pp;
    if(cr) document.getElementById('w-crypto').value = cr;
  }catch(e){}

  // Restore memory option
  try{
    var mem = localStorage.getItem('rr_mem');
    if(mem){
      var opts = document.querySelectorAll('.mem-opt');
      var idx = {none:0,'128':1,'256':2,dynamic:3};
      if(idx[mem] !== undefined && opts[idx[mem]]){
        selectMem(mem, opts[idx[mem]]);
      }
    }
  }catch(e){}

  // Subnet auto-grant: anyone on the same LAN (family, friends, guests) gets full access
  // They're physically in the same location as the router owner — that's good enough
  try{
    var _h = location.hostname;
    var _isLAN = _h === 'localhost'
      || /^192\.168\./.test(_h)
      || /^10\./.test(_h)
      || /^172\.(1[6-9]|2[0-9]|3[01])\./.test(_h);
    if(_isLAN){
      if(!localStorage.getItem('rr_mesh'))   localStorage.setItem('rr_mesh',   '1');
      if(!localStorage.getItem('rr_donate')) localStorage.setItem('rr_donate', '1');
    }
  }catch(e){}

  // Init user account bar
  try{ userInit(); }catch(e){}

  // Restore mesh join state
  try{
    if(localStorage.getItem('rr_mesh') === '1') joinMesh(true);
  }catch(e){}

  // Restore donate state
  try{
    if(localStorage.getItem('rr_donate') === '1') donateMesh(true);
  applyDonationState();
  }catch(e){}

  // If we arrived via _liveSecureRedirect()'s ?tab= query string and the hash
  // got dropped along the way (e.g. by the cert-warning interstitial), recover
  // the intended tab from the query string before doing the hash-based restore.
  try{
    if(!window.location.hash){
      var _m = /(?:^\?|&)tab=([a-z]+)/.exec(window.location.search);
      if(_m) window.location.hash = '#' + _m[1];
    }
  }catch(e){}

  // Restore tab from URL hash
  var h = window.location.hash.replace('#','');
  var valid = {earn:1, claude:1, nov:1, exp:1, protect:1, video:1, chat:1, live:1, account:1, intel:1, map:1, search:1, app:1, explorer:1, netsetup:1};
  if(!h) h = 'nov'; // default landing tab when there's no URL hash at all
  if(h && valid[h]){
    document.querySelectorAll('.tc').forEach(function(t){t.classList.remove('on')});
    document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('on')});
    document.getElementById('t-'+h).classList.add('on');
    document.getElementById('tab-'+h).classList.add('on');
    if(h === 'claude'){ startMatrix(); initClaude(); setTimeout(mmLoad,600); setTimeout(mmSync,3000); }
    if(h === 'earn') startEarnMatrix();
    if(h === 'nov' || h === 'exp') startRefresh();
    // NOTE: show('nov') always forces a full page reload (see show() above), so this
    // hash-restore path is the ONLY place that actually initialises the Overview tab's
    // live widgets on a real navigation. Must mirror everything show('nov') would do.
    if(h === 'nov'){ setTimeout(drawSparkline, 100); setTimeout(loadBwHogs, 300); setTimeout(updateHageziStatus,500); setTimeout(smStart,300); setTimeout(loadWifiDevices,300); setTimeout(loadMonthlyReport,400); }
    if(h === 'chat'){ initChatGate(); if(localStorage.getItem('rr_donate')==='1'){ initGov(); initChat(); initRooms(); initPeers(); } }
    if(h === 'exp'){ initLocalMesh(); vnstatLoad(); setTimeout(initWanIfaceDefaults,150); setTimeout(dnsLoad,200); setTimeout(topoInit,300); setTimeout(loadHoneypot,400); setTimeout(updateExpMeshStatus,200); setTimeout(cakeLoad,400); setTimeout(bwGraphInit,700); }
    if(h === 'protect'){ initDnsBlock(); }
    if(h === 'video'){ initVideo(); }
    if(h === 'live'){ initLive(); }
    if(h === 'account'){ initAccount(); }
    if(h === 'intel'){ initIntel(); }
    if(h === 'netsetup'){ loadNetSetup(); }
  }
})();

// ── Mycelium Video ────────────────────────────────────────────────────────────
var _videoFile = null;

function initVideo(){
  var donated = false;
  try{ donated = localStorage.getItem('rr_donate') === '1'; }catch(e){}
  var gate    = document.getElementById('video-gate');
  var upload  = document.getElementById('video-upload-section');
  var prog    = document.getElementById('video-progress-wrap');
  var vlist   = document.getElementById('video-list');
  var pvlist  = document.getElementById('peer-video-list');
  if(!donated){
    if(gate)   gate.style.display   = 'block';
    if(upload) upload.style.display = 'none';
    if(prog)   prog.style.display   = 'none';
    if(vlist)  vlist.innerHTML = '';
    if(pvlist) pvlist.innerHTML = '';
    return;
  }
  if(gate)   gate.style.display   = 'none';
  if(upload) upload.style.display = 'block';
  var myBtn = document.getElementById('my-channel-btn');
  if(myBtn) myBtn.style.display = localStorage.getItem('rr_user_name') ? 'inline-block' : 'none';
  loadNodeOwner(); setupVideoRooms(); loadVideoList(); loadPeerVideos();
  rrInitAppTab();
}

function initClaude(){
  var donated = false;
  try{ donated = localStorage.getItem('rr_donate') === '1'; }catch(e){}
  var gate  = document.getElementById('claude-gate');
  var inner = document.getElementById('claude-inner');
  if(!donated){
    if(gate)  gate.style.display  = 'block';
    if(inner) inner.style.display = 'none';
    return;
  }
  if(gate)  gate.style.display  = 'none';
  if(inner) inner.style.display = 'block';
}

function initChatGate(){
  var donated = false;
  try{ donated = localStorage.getItem('rr_donate') === '1'; }catch(e){}
  var gate = document.getElementById('chat-gate');
  var wrap = document.getElementById('chat-content-wrap');
  if(!donated){
    if(gate) gate.style.display = 'block';
    if(wrap) wrap.style.display = 'none';
    return;
  }
  if(gate) gate.style.display = 'none';
  if(wrap) wrap.style.display = 'block';
}

function videoDrop(e){
  e.preventDefault();
  document.getElementById('video-upload-section').style.borderColor='rgba(63,185,80,.3)';
  var f = e.dataTransfer.files[0];
  if(!f || !f.type.startsWith('video/')) return;
  _videoFile = f; showVideoFile(f);
}
function videoFileSelected(inp){
  var f = inp.files[0]; if(!f) return;
  _videoFile = f; showVideoFile(f);
}
function showVideoFile(f){
  document.getElementById('video-drop-label').style.display='none';
  document.getElementById('video-file-ready').style.display='block';
  document.getElementById('video-selected-name').textContent = f.name;
  document.getElementById('video-selected-size').textContent = (f.size/1048576).toFixed(1)+' MB · '+(f.type||'video');
  var t = document.getElementById('video-title-input');
  if(t && !t.value) t.value = f.name.replace(/\.[^.]+$/,'');
}

var _videoChannelFilter = null; // null = all, string = filter by uploader
var _nodeOwner = ""; // router owner — only they can delete anon videos

function loadNodeOwner(){
  fetch("/cgi-bin/rocket?get_node_owner")
    .then(function(r){ return r.json(); })
    .then(function(d){ if(d.ok) _nodeOwner = d.owner || ""; })
    .catch(function(){});
}

function toggleMyChannel(){
  var me = localStorage.getItem('rr_user_name')||'';
  if(!me) return;
  if(_videoChannelFilter === me){ clearChannelFilter(); return; }
  _videoChannelFilter = me;
  var hdr = document.getElementById('video-channel-header');
  var clr = document.getElementById('channel-clear-btn');
  var btn = document.getElementById('my-channel-btn');
  if(hdr){ hdr.textContent = '📺 @'+me+"'s channel"; hdr.style.display='block'; }
  if(clr) clr.style.display='inline-block';
  if(btn){ btn.style.background='rgba(63,185,80,.2)'; btn.textContent='📺 My Channel ✓'; }
  loadVideoList();
}

function viewChannel(uploader){
  if(!uploader || uploader==='anon') return;
  _videoChannelFilter = uploader;
  var hdr = document.getElementById('video-channel-header');
  var clr = document.getElementById('channel-clear-btn');
  if(hdr){ hdr.textContent = '📺 @'+uploader+"'s channel"; hdr.style.display='block'; }
  if(clr) clr.style.display='inline-block';
  var el = document.getElementById('video-list');
  if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
  loadVideoList();
}

function clearChannelFilter(){
  _videoChannelFilter = null;
  var hdr = document.getElementById('video-channel-header');
  var clr = document.getElementById('channel-clear-btn');
  var btn = document.getElementById('my-channel-btn');
  if(hdr) hdr.style.display='none';
  if(clr) clr.style.display='none';
  if(btn){ btn.style.background='none'; btn.textContent='📺 My Channel'; }
  loadVideoList();
}

function videoUpload(){
  if(!_videoFile) return;
  var title = (document.getElementById('video-title-input').value.trim() || _videoFile.name).slice(0,200);
  var mime  = _videoFile.type || 'video/mp4';
  var cat   = (document.getElementById('video-cat-select')||{}).value || 'general';
  var anon  = (document.getElementById('video-anon-check')||{}).checked;
  var uploader = anon ? 'anon' : (localStorage.getItem('rr_user_name')||'anon');
  document.getElementById('video-upload-section').style.display='none';
  document.getElementById('video-progress-wrap').style.display='block';
  document.getElementById('video-progress-label').textContent = 'Uploading "'+_esc(title)+'"…';
  document.getElementById('video-progress-pct').textContent = '0%';
  document.getElementById('video-progress-bar').style.width = '0';
  document.getElementById('video-progress-sub').textContent = 'Sending to router…';
  var url = '/cgi-bin/rocket?video_upload&title='+encodeURIComponent(title)+'&mime='+encodeURIComponent(mime)+'&cat='+encodeURIComponent(cat)+'&user='+encodeURIComponent(uploader)+(anon?'&anon=1':'');
  var xhr = new XMLHttpRequest();
  xhr.upload.onprogress = function(e){
    if(!e.lengthComputable) return;
    var pct = Math.round(e.loaded/e.total*100);
    document.getElementById('video-progress-pct').textContent = pct+'%';
    document.getElementById('video-progress-bar').style.width = pct+'%';
    if(pct===100){ document.getElementById('video-progress-label').textContent='Processing chunks…';
                   document.getElementById('video-progress-sub').textContent='Hashing & storing on SSD…'; }
  };
  xhr.onload = function(){
    document.getElementById('video-progress-wrap').style.display='none';
    document.getElementById('video-upload-section').style.display='block';
    try {
      var d = JSON.parse(xhr.responseText);
      if(d.ok){
        videoAnnounce(d.id, cat);
        captureAndUploadThumb(d.id, _videoFile);
        generateAndUploadSprite(d.id, _videoFile);
        _videoFile=null;
        document.getElementById('video-drop-label').style.display='block';
        document.getElementById('video-file-ready').style.display='none';
        document.getElementById('video-file-input').value='';
        document.getElementById('video-title-input').value='';
        var cs=document.getElementById('video-cat-select'); if(cs) cs.value='general';
        var ac=document.getElementById('video-anon-check'); if(ac) ac.checked=false;
        document.getElementById('video-upload-section').style.borderColor='rgba(63,185,80,.3)';
        loadVideoList();
      } else { alert('Upload failed: '+(d.error||'unknown')); }
    } catch(e){ alert('Upload failed — server error'); }
  };
  xhr.onerror = function(){
    document.getElementById('video-progress-wrap').style.display='none';
    document.getElementById('video-upload-section').style.display='block';
    alert('Upload failed — network error');
  };
  xhr.open('POST', url);
  xhr.setRequestHeader('Content-Type', mime);
  xhr.send(_videoFile);
}

function captureAndUploadThumb(id, file){
  if(!file) return;
  var url = URL.createObjectURL(file);
  var vid = document.createElement('video');
  vid.muted = true;
  vid.preload = 'metadata';
  vid.onloadedmetadata = function(){
    var seekTo = Math.min(5, vid.duration > 0 ? vid.duration * 0.1 : 0);
    if(seekTo < 0.1) seekTo = 0.1;
    vid.currentTime = seekTo;
  };
  vid.onseeked = function(){
    var MAX = 400;
    var w = vid.videoWidth || 400, h = vid.videoHeight || 225;
    if(w > MAX){ h = Math.round(h * MAX / w); w = MAX; }
    var c = document.createElement('canvas');
    c.width = w; c.height = h;
    c.getContext('2d').drawImage(vid, 0, 0, w, h);
    c.toBlob(function(blob){
      if(!blob) return;
      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/cgi-bin/rocket?video_thumb_upload&id=' + encodeURIComponent(id));
      xhr.setRequestHeader('Content-Type', 'image/jpeg');
      xhr.send(blob);
    }, 'image/jpeg', 0.82);
    URL.revokeObjectURL(url);
  };
  vid.onerror = function(){ URL.revokeObjectURL(url); };
  vid.src = url;
}

function loadVideoList(){
  fetch('/cgi-bin/rocket?video_list')
    .then(function(r){ return r.json(); })
    .then(function(d){
      var vids = d.videos||[];
      if(_videoChannelFilter) vids = vids.filter(function(v){ return (v.uploader||'anon') === _videoChannelFilter; });
      renderVideoList(vids);
    })
    .catch(function(){ var el=document.getElementById('video-list'); if(el) el.innerHTML='<div style="color:#f0a500;font-size:.82em;text-align:center;padding:24px">⚠ Could not load videos</div>'; });
}

function renderVideoList(videos){
  var el = document.getElementById('video-list'); if(!el) return;
  if(!videos.length){
    el.innerHTML='<div style="color:#3a3f44;font-size:.82em;text-align:center;padding:24px">No videos yet — upload one above 🍄</div>';
    return;
  }
  var cats = {'general':'🌍','news':'📰','gaming':'🎮','creative':'🎵','truth':'🔍'};
  var h = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">';
  videos.sort(function(a,b){ return (b.uploaded||0)-(a.uploaded||0); });
  videos.forEach(function(v){
    var vdown = typeof v.votes_down !== 'undefined' ? v.votes_down : 0;
    var vrep  = typeof v.reports   !== 'undefined' ? v.reports   : 0;
    if(vdown >= 3 || vrep >= 3) return; // kill switch
    var vup  = typeof v.votes_up !== 'undefined' ? v.votes_up : 0;
    var ago  = _vAgo(v.uploaded);
    var size = v.size ? (v.size/1048576).toFixed(1)+' MB' : '';
    var views= v.views ? '👁 '+v.views : '';
    var catEmoji = cats[v.cat||'general']||'🌍';
    var uploader = v.uploader || 'anon';
    var me = localStorage.getItem('rr_user_name')||'';
    var isOwner = me && me === uploader;
    var voted='';    try{ voted=localStorage.getItem('rr_voted_'+v.id)||''; }catch(e){}
    var reported=false; try{ reported=localStorage.getItem('rr_reported_'+v.id)==='1'; }catch(e){}
    var upSt  = voted==='up'   ? 'background:rgba(63,185,80,.3);border:1px solid #3fb950;'  : 'background:none;border:1px solid rgba(63,185,80,.22);';
    var downSt= voted==='down' ? 'background:rgba(248,81,73,.2);border:1px solid #f85149;'  : 'background:none;border:1px solid rgba(248,81,73,.18);';
    var repSt = reported        ? 'background:rgba(240,165,0,.2);border:1px solid #f0a500;'  : 'background:none;border:1px solid rgba(240,165,0,.18);';
    var vDis  = voted    ? ' disabled' : '';
    var repDis= reported ? ' disabled' : '';
    var thumbUrl = '/cgi-bin/rocket?video_thumb&id='+encodeURIComponent(v.id);
    var eid = _esc(v.id), etitle = _esc(v.title||'Untitled'), emime = _esc(v.mime||'video/mp4');
    var euploader = _esc(uploader);
    h += '<div style="background:#161b22;border:1px solid #30363d;border-radius:12px;overflow:hidden;display:flex;flex-direction:column">';
    // Thumbnail
    h += '<div style="position:relative;padding-bottom:56.25%;background:#0d1117;cursor:pointer" onclick="videoPlay(\''+eid+'\',\''+emime+'\',\''+etitle+'\')">';
    h += '<img src="'+thumbUrl+'" alt="" style="position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;object-fit:cover" onerror="this.style.display=\'none\'">';
    h += '<div style="position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center"><div style="background:rgba(0,0,0,.55);border:2px solid rgba(63,185,80,.7);border-radius:50%;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:#3fb950;font-size:1em">▶</div></div>';
    h += '<div style="position:absolute;top:7px;left:7px;background:rgba(0,0,0,.65);border-radius:5px;padding:2px 7px;font-size:.7em;color:#c9d1d9">'+catEmoji+'</div>';
    if(views) h += '<div style="position:absolute;bottom:7px;right:7px;background:rgba(0,0,0,.65);border-radius:5px;padding:2px 7px;font-size:.68em;color:#8b949e">'+views+'</div>';
    h += '</div>';
    // Info
    h += '<div style="padding:10px 12px;flex:1;display:flex;flex-direction:column;gap:6px">';
    h += '<div style="color:#c9d1d9;font-size:.84em;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+etitle+'">'+etitle+'</div>';
    // Uploader + timestamp row
    var uploaderHtml = uploader === 'anon'
      ? '<span style="color:#484f58">anon</span>'
      : '<a href="#" onclick="viewChannel(\''+euploader+'\');return false" style="color:#58a6ff;text-decoration:none;font-weight:600" title="View @'+euploader+'\'s channel">@'+euploader+'</a>';
    h += '<div style="display:flex;justify-content:space-between;align-items:center;font-size:.71em">';
    h += '<span>'+uploaderHtml+'</span>';
    h += '<span style="color:#484f58">'+ago+(size?' · '+size:'')+'</span>';
    h += '</div>';
    // Action buttons
    h += '<div style="display:flex;gap:4px;margin-top:2px">';
    h += '<button onclick="videoVote(\''+eid+'\',\'up\',this)"'+vDis+' style="flex:1;'+upSt+'border-radius:6px;padding:4px 0;color:#3fb950;font-size:.75em;cursor:pointer">👍 '+vup+'</button>';
    h += '<button onclick="videoVote(\''+eid+'\',\'down\',this)"'+vDis+' style="flex:1;'+downSt+'border-radius:6px;padding:4px 0;color:#f85149;font-size:.75em;cursor:pointer">👎 '+vdown+'</button>';
    h += '<button onclick="videoReport(\''+eid+'\',this)"'+repDis+' style="'+repSt+'border-radius:6px;padding:4px 8px;color:#f0a500;font-size:.75em;cursor:pointer" title="Report harmful video">🚩</button>';
    if(isOwner || (uploader === 'anon' && me && me === _nodeOwner)) h += '<button onclick="videoDelete(\''+eid+'\',this)" style="background:none;border:1px solid rgba(248,81,73,.25);border-radius:6px;padding:4px 8px;color:#f85149;font-size:.75em;cursor:pointer" title="Delete video">🗑</button>';
    h += '</div></div></div>';
  });
  h += '</div>';
  el.innerHTML = h;
}

function _vAgo(ts){
  if(!ts) return '';
  var d=Math.floor(Date.now()/1000)-ts;
  if(d<60) return 'just now';
  if(d<3600) return Math.floor(d/60)+'m ago';
  if(d<86400) return Math.floor(d/3600)+'h ago';
  return Math.floor(d/86400)+'d ago';
}

function videoPlay(id, mime, title){
  _playingId = id;
  var player=document.getElementById('rr-video-player');
  var wrap=document.getElementById('video-player-wrap');
  var tEl=document.getElementById('video-player-title');
  if(!player||!wrap) return;
  player.pause(); player.src='';
  player.src='/cgi-bin/rocket?video_stream&id='+encodeURIComponent(id);
  if(tEl) tEl.textContent=title;
  wrap.style.display='block';
  wrap.scrollIntoView({behavior:'smooth',block:'nearest'});
  player.load(); player.play().catch(function(){});
  rrPlayerInit(id);
  _updatePlayerVoteButtons(id);
  // Show vote/report buttons for local videos
  var pa=document.getElementById('video-player-actions');
  if(pa) pa.style.display='flex';
  videoLoadComments(id);
}

function videoClose(){
  var player=document.getElementById('rr-video-player');
  var wrap=document.getElementById('video-player-wrap');
  var cw=document.getElementById('video-comments-wrap');
  if(player){ player.pause(); player.src=''; }
  if(wrap) wrap.style.display='none';
  if(cw) cw.style.display='none';
}

var _vidCommentSort='new';

function rrSetCommentSort(s){
  _vidCommentSort=s;
  var bn=document.getElementById('csort-new'), bt=document.getElementById('csort-top');
  if(bn){ bn.style.background=s==='new'?'rgba(63,185,80,.15)':'none'; bn.style.borderColor=s==='new'?'rgba(63,185,80,.4)':'#30363d'; bn.style.color=s==='new'?'#3fb950':'#484f58'; }
  if(bt){ bt.style.background=s==='top'?'rgba(63,185,80,.15)':'none'; bt.style.borderColor=s==='top'?'rgba(63,185,80,.4)':'#30363d'; bt.style.color=s==='top'?'#3fb950':'#484f58'; }
  if(_playingId) videoLoadComments(_playingId);
}

function videoLoadComments(id){
  var cw=document.getElementById('video-comments-wrap');
  var cl=document.getElementById('video-comments-list');
  var cf=document.getElementById('video-comment-form');
  var cm=document.getElementById('video-comment-login-msg');
  if(!cw||!cl) return;
  cw.style.display='block';
  cl.innerHTML='<div style="color:#484f58;font-size:.8em;padding:6px 0">Loading…</div>';
  var me=localStorage.getItem('rr_user_name')||'';
  var tok=localStorage.getItem('rr_user_token')||'';
  if(cf) cf.style.display=(me&&tok)?'block':'none';
  if(cm) cm.style.display=(me&&tok)?'none':'block';
  fetch('/cgi-bin/rocket?video_comment_list&id='+encodeURIComponent(id))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok||!d.comments||!d.comments.length){
        cl.innerHTML='<div style="color:#484f58;font-size:.8em;padding:6px 0;font-style:italic">No comments yet — be the first!</div>';
        return;
      }
      var owner=_nodeOwner||'';
      var votes=d.votes||{};
      var comments=d.comments.slice();
      if(_vidCommentSort==='top'){
        comments.sort(function(a,b){ return (votes[b.id]||0)-(votes[a.id]||0); });
      } else {
        comments.sort(function(a,b){ return b.ts-a.ts; });
      }
      // Build tree
      var topLevel=[], replies={};
      comments.forEach(function(c){
        if(c.parent&&c.parent!==''){
          if(!replies[c.parent]) replies[c.parent]=[];
          replies[c.parent].push(c);
        } else { topLevel.push(c); }
      });
      function renderC(c, isReply){
        var v=votes[c.id]||0;
        var vStr=v>0?'+'+v:(v<0?''+v:'0');
        var vCol=v>0?'#3fb950':(v<0?'#f85149':'#484f58');
        var canDel=!!(me&&(me===c.user||me===owner));
        var ind=isReply?'margin-left:24px;border-left:2px solid #21262d;padding-left:10px;':'';
        var delB=canDel?'<button onclick="videoCommentDelete(\''+id+'\',\''+c.id+'\',this)" style="background:none;border:none;color:#484f58;cursor:pointer;font-size:.72em;padding:1px 4px" title="Delete">✕</button>':'';
        var repB=(me&&tok)?'<button onclick="rrShowReply(\''+c.id+'\')" style="background:none;border:none;color:#484f58;cursor:pointer;font-size:.74em;padding:1px 6px;text-decoration:underline">↩ Reply</button>':'';
        var repCnt=replies[c.id]?'<span style="color:#484f58;font-size:.72em">'+replies[c.id].length+' repl'+(replies[c.id].length===1?'y':'ies')+'</span>':'';
        return '<div style="border-bottom:1px solid #21262d;padding:8px 0;'+ind+'" id="vc-'+c.id+'">'
          +'<div style="display:flex;align-items:center;gap:5px;margin-bottom:3px;flex-wrap:wrap">'
          +'<span style="color:#3fb950;font-size:.8em;font-weight:600">@'+_esc(c.user)+'</span>'
          +'<span style="color:#484f58;font-size:.73em">'+_vAgo(c.ts)+'</span>'
          +delB+repB+repCnt
          +'<span style="margin-left:auto;display:flex;align-items:center;gap:3px">'
          +'<button onclick="videoCommentVote(\''+id+'\',\''+c.id+'\',\'up\')" style="background:none;border:1px solid rgba(63,185,80,.2);border-radius:4px;padding:1px 6px;color:#3fb950;font-size:.72em;cursor:pointer">▲</button>'
          +'<span id="vcv-'+c.id+'" style="font-size:.74em;color:'+vCol+';min-width:18px;text-align:center">'+vStr+'</span>'
          +'<button onclick="videoCommentVote(\''+id+'\',\''+c.id+'\',\'down\')" style="background:none;border:1px solid rgba(248,81,73,.15);border-radius:4px;padding:1px 6px;color:#f85149;font-size:.72em;cursor:pointer">▼</button>'
          +'</span></div>'
          +'<div style="color:#c9d1d9;font-size:.84em;line-height:1.5">'+_esc(c.text).replace(/\n/g,'<br>')+'</div>'
          +'<div id="reply-form-'+c.id+'" style="display:none;margin-top:8px">'
          +'<div style="display:flex;gap:6px;align-items:flex-start">'
          +'<textarea id="reply-inp-'+c.id+'" rows="2" placeholder="Reply to @'+_esc(c.user)+'…" style="flex:1;background:#161b22;border:1px solid #30363d;border-radius:6px;color:#c9d1d9;font-size:.82em;padding:6px 8px;resize:none;font-family:inherit"></textarea>'
          +'<div style="display:flex;flex-direction:column;gap:4px">'
          +'<button onclick="videoReplyPost(\''+id+'\',\''+c.id+'\')" style="background:#238636;border:none;border-radius:6px;color:#fff;font-size:.78em;padding:5px 10px;cursor:pointer">Post</button>'
          +'<button onclick="rrShowReply(\''+c.id+'\')" style="background:none;border:1px solid #30363d;border-radius:6px;color:#484f58;font-size:.78em;padding:4px 10px;cursor:pointer">✕</button>'
          +'</div></div>'
          +'<label style="display:flex;align-items:center;gap:6px;margin-top:5px;cursor:pointer;font-size:.76em;color:#8b949e;user-select:none">'
          +'<input type="checkbox" id="reply-anon-'+c.id+'" style="accent-color:#3fb950;width:12px;height:12px"> Post anonymously</label>'
          +'</div>'
          +'</div>';
      }
      var html='';
      topLevel.forEach(function(c){
        html+=renderC(c,false);
        if(replies[c.id]) replies[c.id].forEach(function(r){ html+=renderC(r,true); });
      });
      cl.innerHTML=html;
    })
    .catch(function(){ cl.innerHTML='<div style="color:#484f58;font-size:.8em">Could not load comments</div>'; });
}

function rrShowReply(cid){
  var f=document.getElementById('reply-form-'+cid);
  if(!f) return;
  f.style.display=f.style.display==='none'?'block':'none';
  if(f.style.display==='block'){
    var inp=document.getElementById('reply-inp-'+cid);
    if(inp) inp.focus();
  }
}

function videoCommentVote(vid,cid,dir){
  fetch('/cgi-bin/rocket?video_comment_vote&id='+encodeURIComponent(vid)+'&cid='+encodeURIComponent(cid)+'&dir='+dir,{method:'POST'})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.ok){
        var el=document.getElementById('vcv-'+cid);
        if(el){
          var v=d.votes||0;
          el.textContent=v>0?'+'+v:(v<0?''+v:'0');
          el.style.color=v>0?'#3fb950':(v<0?'#f85149':'#484f58');
        }
      }
    }).catch(function(){});
}

function videoCommentPost(){
  var id=_playingId;
  var inp=document.getElementById('video-comment-inp');
  if(!id||!inp) return;
  var text=inp.value.trim();
  if(!text) return;
  var tok=localStorage.getItem('rr_user_token')||'';
  if(!tok){ alert('Please sign in to comment'); return; }
  var anon=!!(document.getElementById('video-comment-anon')||{}).checked;
  inp.disabled=true;
  fetch('/cgi-bin/rocket?video_comment_add&id='+encodeURIComponent(id),{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({text:text,parent:'',anon:anon,token:tok})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    inp.disabled=false;
    if(d.ok){inp.value='';videoLoadComments(id);}
    else alert(d.error||'Failed to post comment');
  })
  .catch(function(){inp.disabled=false;alert('Network error');});
}

function videoReplyPost(vid,parentId){
  var inp=document.getElementById('reply-inp-'+parentId);
  if(!inp) return;
  var text=inp.value.trim();
  if(!text) return;
  var tok=localStorage.getItem('rr_user_token')||'';
  if(!tok){alert('Please sign in to comment');return;}
  var anonEl=document.getElementById('reply-anon-'+parentId);
  var anon=!!(anonEl&&anonEl.checked);
  inp.disabled=true;
  fetch('/cgi-bin/rocket?video_comment_add&id='+encodeURIComponent(vid),{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({text:text,parent:parentId,anon:anon,token:tok})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    inp.disabled=false;
    if(d.ok){inp.value='';videoLoadComments(vid);}
    else alert(d.error||'Failed');
  })
  .catch(function(){inp.disabled=false;alert('Network error');});
}

function videoCommentDelete(vid, cid, btn){
  if(!confirm('Delete this comment?')) return;
  var tok=localStorage.getItem('rr_user_token')||'';
  if(!tok) return;
  if(btn) btn.disabled=true;
  fetch('/cgi-bin/rocket?video_comment_delete&id='+encodeURIComponent(vid)+'&cid='+encodeURIComponent(cid), {
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+tok},
    body:JSON.stringify({token:tok})
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(d.ok){
      var el=document.getElementById('vc-'+cid);
      if(el) el.remove();
    } else { if(btn) btn.disabled=false; alert(d.error||'Failed'); }
  })
  .catch(function(){ if(btn) btn.disabled=false; });
}

// ── Custom player ────────────────────────────────────────────────
var _rrSprite=null, _rrSeeking=false, _rrKbBound=false;

function rrPlayerInit(id){
  var v=document.getElementById('rr-video-player');
  if(!v) return;
  // Remove old listeners by cloning
  var v2=v.cloneNode(false); v.parentNode.replaceChild(v2,v); v=v2;
  v.id='rr-video-player';
  // Re-wire src (videoPlay already set it, set again after clone)
  v.src='/cgi-bin/rocket?video_stream&id='+encodeURIComponent(id);
  v.preload='metadata'; v.load(); v.play().catch(function(){});
  v.addEventListener('timeupdate',_rrTick);
  v.addEventListener('loadedmetadata',function(){
    var dot=document.getElementById('rr-seek-dot');
    if(dot) dot.style.display='block';
    _rrUpdateTime(0,v.duration);
  });
  v.addEventListener('play',function(){ var b=document.getElementById('rr-play-btn'); if(b) b.textContent='⏸'; });
  v.addEventListener('pause',function(){ var b=document.getElementById('rr-play-btn'); if(b) b.textContent='▶'; });
  v.addEventListener('ended',function(){ var b=document.getElementById('rr-play-btn'); if(b) b.textContent='↺'; });
  // Keyboard
  if(!_rrKbBound){ document.addEventListener('keydown',_rrKey); _rrKbBound=true; }
  // Load sprite meta
  _rrSprite=null;
  fetch('/cgi-bin/rocket?video_sprite&id='+encodeURIComponent(id)+'&type=meta')
    .then(function(r){return r.json();}).then(function(d){
      if(d.cols){
        _rrSprite=d;
        _rrSprite.img=new Image();
        _rrSprite.img.src='/cgi-bin/rocket?video_sprite&id='+encodeURIComponent(id);
      }
    }).catch(function(){});
}

function _rrTick(){
  var v=document.getElementById('rr-video-player');
  if(!v||_rrSeeking) return;
  var pct=v.duration?(v.currentTime/v.duration*100):0;
  var sb=document.getElementById('rr-seek-bar');
  var dot=document.getElementById('rr-seek-dot');
  if(sb) sb.style.width=pct+'%';
  if(dot) dot.style.left=pct+'%';
  _rrUpdateTime(v.currentTime,v.duration);
}

function _rrFmt(s){ s=Math.floor(s||0); var m=Math.floor(s/60); s=s%60; return m+':'+(s<10?'0':'')+s; }

function _rrUpdateTime(c,d){
  var el=document.getElementById('rr-time-disp');
  if(el) el.textContent=_rrFmt(c)+' / '+_rrFmt(d);
}

function _rrPct(e){
  var area=document.getElementById('rr-seek-area');
  if(!area) return 0;
  var r=area.getBoundingClientRect();
  return Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));
}

function rrPlayPause(){
  var v=document.getElementById('rr-video-player');
  if(!v) return;
  if(v.paused||v.ended) v.play(); else v.pause();
}

function rrMute(){
  var v=document.getElementById('rr-video-player');
  var btn=document.getElementById('rr-mute-btn');
  var sl=document.getElementById('rr-vol-slider');
  if(!v) return;
  v.muted=!v.muted;
  if(btn) btn.textContent=v.muted?'🔇':'🔊';
  if(sl) sl.value=v.muted?0:v.volume;
}

function rrSetVolume(val){
  var v=document.getElementById('rr-video-player');
  var btn=document.getElementById('rr-mute-btn');
  if(!v) return;
  v.volume=parseFloat(val);
  v.muted=(parseFloat(val)===0);
  if(btn) btn.textContent=(v.muted||parseFloat(val)===0)?'🔇':(parseFloat(val)<0.5?'🔉':'🔊');
}

function rrSeekStart(e){
  var v=document.getElementById('rr-video-player');
  if(!v||!v.duration) return;
  _rrSeeking=true;
  var pct=_rrPct(e);
  v.currentTime=pct*v.duration;
  var sb=document.getElementById('rr-seek-bar'), dot=document.getElementById('rr-seek-dot');
  if(sb) sb.style.width=(pct*100)+'%';
  if(dot) dot.style.left=(pct*100)+'%';
  function onMove(e2){ var p=_rrPct(e2); v.currentTime=p*v.duration; if(sb) sb.style.width=(p*100)+'%'; if(dot) dot.style.left=(p*100)+'%'; _rrUpdateTime(v.currentTime,v.duration); }
  function onUp(){ _rrSeeking=false; document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onUp); }
  document.addEventListener('mousemove',onMove);
  document.addEventListener('mouseup',onUp);
}

function rrSeekHover(e){
  var v=document.getElementById('rr-video-player');
  if(!v||!v.duration||!_rrSprite||!_rrSprite.img||!_rrSprite.img.complete||!_rrSprite.img.naturalWidth) return;
  var pct=_rrPct(e);
  var t=pct*v.duration;
  var fi=Math.min(Math.floor(t/(_rrSprite.interval||10)), (_rrSprite.cols*_rrSprite.rows)-1);
  var col=fi%_rrSprite.cols, row=Math.floor(fi/_rrSprite.cols);
  var tip=document.getElementById('rr-sprite-tip');
  var canvas=document.getElementById('rr-sprite-canvas');
  if(!tip||!canvas) return;
  var ctx=canvas.getContext('2d');
  ctx.drawImage(_rrSprite.img, col*_rrSprite.fw, row*_rrSprite.fh, _rrSprite.fw, _rrSprite.fh, 0, 0, canvas.width, canvas.height);
  var tEl=document.getElementById('rr-sprite-time');
  if(tEl) tEl.textContent=_rrFmt(t);
  var area=document.getElementById('rr-seek-area');
  var r=area.getBoundingClientRect();
  var left=Math.max(80,Math.min(r.width-80,e.clientX-r.left));
  tip.style.left=left+'px';
  tip.style.display='block';
}

function rrSeekLeave(){
  var tip=document.getElementById('rr-sprite-tip');
  if(tip) tip.style.display='none';
}

function rrDownload(){
  if(!_playingId) return;
  var a=document.createElement('a');
  a.href='/cgi-bin/rocket?video_stream&id='+encodeURIComponent(_playingId);
  var t=document.getElementById('video-player-title');
  a.download=(t?t.textContent:'video')||'video';
  a.click();
}

function rrShareTimestamp(){
  var v=document.getElementById('rr-video-player');
  if(!v||!_playingId) return;
  var t=Math.floor(v.currentTime);
  var url=location.href.replace(/#.*/,'')+' — video:'+_playingId+(t?'  t='+t+'s':'');
  if(navigator.clipboard){ navigator.clipboard.writeText(url).then(function(){ rrToast('Link copied — starts at '+_rrFmt(t)); }); }
  else prompt('Copy link:',url);
}

function rrPiP(){
  var v=document.getElementById('rr-video-player');
  if(!v) return;
  if(document.pictureInPictureElement) document.exitPictureInPicture();
  else if(v.requestPictureInPicture) v.requestPictureInPicture();
}

function rrFullscreen(){
  var w=document.getElementById('video-player-wrap');
  var v=document.getElementById('rr-video-player');
  if(!w||!v) return;
  if(document.fullscreenElement||document.webkitFullscreenElement){
    (document.exitFullscreen||document.webkitExitFullscreen).call(document);
  } else {
    v.style.maxHeight='none';
    v.style.height='100%';
    w.style.display='flex';
    w.style.flexDirection='column';
    var req=w.requestFullscreen||w.webkitRequestFullscreen||w.mozRequestFullScreen;
    if(req) req.call(w);
  }
}
function _rrFsChange(){
  if(!document.fullscreenElement&&!document.webkitFullscreenElement){
    var v=document.getElementById('rr-video-player');
    var w=document.getElementById('video-player-wrap');
    if(v){v.style.maxHeight='400px';v.style.height='';}
    if(w){w.style.display='';w.style.flexDirection='';}
  }
}
document.addEventListener('fullscreenchange',_rrFsChange);
document.addEventListener('webkitfullscreenchange',_rrFsChange);

function rrToast(msg){
  var t=document.createElement('div');
  t.textContent=msg;
  t.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#21262d;border:1px solid #30363d;color:#e6edf3;padding:8px 18px;border-radius:8px;font-size:.82em;z-index:9999;pointer-events:none;transition:opacity .4s';
  document.body.appendChild(t);
  setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); },400); },2200);
}

function _rrKey(e){
  var w=document.getElementById('video-player-wrap');
  if(!w||w.style.display==='none') return;
  var v=document.getElementById('rr-video-player');
  if(!v) return;
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  switch(e.code){
    case 'Space':      e.preventDefault(); rrPlayPause(); break;
    case 'ArrowLeft':  e.preventDefault(); v.currentTime=Math.max(0,v.currentTime-10); break;
    case 'ArrowRight': e.preventDefault(); v.currentTime=Math.min(v.duration||0,v.currentTime+10); break;
    case 'ArrowUp':    e.preventDefault(); rrSetVolume(Math.min(1,(v.volume+0.1)).toFixed(2)); var sl=document.getElementById('rr-vol-slider'); if(sl) sl.value=v.volume; break;
    case 'ArrowDown':  e.preventDefault(); rrSetVolume(Math.max(0,(v.volume-0.1)).toFixed(2)); var sl=document.getElementById('rr-vol-slider'); if(sl) sl.value=v.volume; break;
    case 'KeyM': rrMute(); break;
    case 'KeyF': rrFullscreen(); break;
    case 'KeyP': rrPiP(); break;
  }
}

// ── Sprite sheet generation (runs in browser after upload) ─────────
function generateAndUploadSprite(id, file){
  if(!file) return;
  var url=URL.createObjectURL(file);
  var vid=document.createElement('video');
  vid.muted=true; vid.preload='metadata';
  var FW=160, FH=90, COLS=10;
  var frames=0, interval=10, duration=0, canvas=null, ctx=null, frameIdx=0;
  vid.onloadedmetadata=function(){
    duration=vid.duration;
    if(!duration||duration<=0){ URL.revokeObjectURL(url); return; }
    interval=Math.max(5,Math.floor(duration/100));
    var numFrames=Math.ceil(duration/interval);
    COLS=Math.min(10,numFrames);
    var rows=Math.ceil(numFrames/COLS);
    canvas=document.createElement('canvas');
    canvas.width=COLS*FW; canvas.height=rows*FH;
    ctx=canvas.getContext('2d');
    frames=numFrames;
    vid.currentTime=0;
  };
  vid.onseeked=function(){
    if(frameIdx>=frames){
      canvas.toBlob(function(blob){
        if(!blob) return;
        var numFrames=frames, interval2=interval, rows=Math.ceil(numFrames/COLS);
        var xhr=new XMLHttpRequest();
        xhr.open('POST','/cgi-bin/rocket?video_sprite_upload&id='+encodeURIComponent(id)+'&cols='+COLS+'&rows='+rows+'&fw='+FW+'&fh='+FH+'&interval='+interval2+'&dur='+Math.round(duration));
        xhr.setRequestHeader('Content-Type','image/jpeg');
        xhr.send(blob);
      },'image/jpeg',0.72);
      URL.revokeObjectURL(url);
      return;
    }
    var col=frameIdx%COLS, row=Math.floor(frameIdx/COLS);
    ctx.drawImage(vid, col*FW, row*FH, FW, FH);
    frameIdx++;
    vid.currentTime=Math.min(frameIdx*interval, duration-0.1);
  };
  vid.onerror=function(){ URL.revokeObjectURL(url); };
  vid.src=url;
}
// ─────────────────────────────────────────────────────────────────

function videoDelete(id, btn){
  if(!confirm('Delete this video and all its chunks? This cannot be undone.')) return;
  if(btn) btn.disabled=true;
  fetch('/cgi-bin/rocket?video_delete&id='+encodeURIComponent(id))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){ loadVideoList(); }
      else { if(btn) btn.disabled=false; alert('Delete failed: '+(d.error||'unknown')); }
    })
    .catch(function(){ if(btn) btn.disabled=false; });
}

function setupVideoRooms(){
  fetch('/cgi-bin/rocket?video_rooms_setup')
    .then(function(r){ return r.json(); })
    .catch(function(){}); // fire and forget — runs in background
}

function videoAnnounce(id, cat){
  fetch('/cgi-bin/rocket?video_announce&id='+encodeURIComponent(id)+'&cat='+encodeURIComponent(cat||'general'))
    .then(function(r){ return r.json(); })
    .catch(function(){}); // fire and forget
}

function reAnnounceAll(btn){
  var status = document.getElementById('reannounce-status');
  if(btn){ btn.disabled=true; btn.textContent='Scanning…'; }
  if(status) status.textContent='';
  fetch('/cgi-bin/rocket?video_list')
    .then(function(r){ return r.json(); })
    .then(function(d){
      var videos = d.videos||[];
      if(!videos.length){
        if(btn){ btn.disabled=false; btn.textContent='📡 Re-Announce All Videos'; }
        if(status) status.textContent='No videos found on this node.';
        return;
      }
      if(status) status.textContent='Announcing '+videos.length+' video'+(videos.length===1?'':'s')+'…';
      var done=0; var ok=0;
      videos.forEach(function(v){
        fetch('/cgi-bin/rocket?video_announce&id='+encodeURIComponent(v.id)+'&cat='+encodeURIComponent(v.cat||'general'))
          .then(function(r){ return r.json(); })
          .then(function(res){ if(res.ok) ok++; })
          .catch(function(){})
          .finally(function(){
            done++;
            if(done===videos.length){
              if(btn){ btn.disabled=false; btn.textContent='📡 Re-Announce All Videos'; }
              if(status){ status.style.color='#3fb950'; status.textContent='✓ '+ok+'/'+videos.length+' announced to the mesh'; }
              setTimeout(function(){ if(status) status.textContent=''; }, 5000);
            }
          });
      });
    })
    .catch(function(){
      if(btn){ btn.disabled=false; btn.textContent='📡 Re-Announce All Videos'; }
      if(status){ status.style.color='#f85149'; status.textContent='Could not read video list'; }
    });
}

function videoVote(id, dir, btn){
  if(btn) btn.disabled=true;
  fetch('/cgi-bin/rocket?video_vote&id='+encodeURIComponent(id)+'&dir='+dir)
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){
        try{ localStorage.setItem('rr_voted_'+id, dir); }catch(e){}
        loadVideoList();
      } else if(d.error === 'already_voted'){
        // Sync localStorage with what the server knows
        try{ localStorage.setItem('rr_voted_'+id, d.prev||dir); }catch(e){}
        loadVideoList();
      } else { if(btn) btn.disabled=false; }
    })
    .catch(function(){ if(btn) btn.disabled=false; });
}

function videoReport(id, btn){
  if(!confirm('Report this video as harmful or inappropriate?\n\nThree reports from different nodes removes it from the mesh.')) return;
  if(btn) btn.disabled=true;
  fetch('/cgi-bin/rocket?video_report&id='+encodeURIComponent(id))
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){
        try{ localStorage.setItem('rr_reported_'+id,'1'); }catch(e){}
        if(d.killed){ loadVideoList(); }
      } else if(d.error==='already_reported'){
        try{ localStorage.setItem('rr_reported_'+id,'1'); }catch(e){}
      } else { if(btn) btn.disabled=false; }
    })
    .catch(function(){ if(btn) btn.disabled=false; });
}

function videoVoteFromPlayer(dir, btn){
  if(!_playingId) return;
  videoVote(_playingId, dir, btn);
  setTimeout(function(){ _updatePlayerVoteButtons(_playingId); }, 400);
}

function videoReportFromPlayer(btn){
  if(!_playingId) return;
  videoReport(_playingId, btn);
}

function _updatePlayerVoteButtons(id){
  var voted=''; try{ voted=localStorage.getItem('rr_voted_'+id)||''; }catch(e){}
  var reported=false; try{ reported=localStorage.getItem('rr_reported_'+id)==='1'; }catch(e){}
  var upBtn=document.getElementById('vp-up');
  var dnBtn=document.getElementById('vp-down');
  var repBtn=document.getElementById('vp-rep');
  if(upBtn){
    upBtn.disabled=!!voted;
    upBtn.style.background=voted==='up'?'rgba(63,185,80,.3)':'none';
    upBtn.style.borderColor=voted==='up'?'#3fb950':'rgba(63,185,80,.25)';
  }
  if(dnBtn){
    dnBtn.disabled=!!voted;
    dnBtn.style.background=voted==='down'?'rgba(248,81,73,.2)':'none';
    dnBtn.style.borderColor=voted==='down'?'#f85149':'rgba(248,81,73,.2)';
  }
  if(repBtn){
    repBtn.disabled=reported;
    repBtn.style.background=reported?'rgba(240,165,0,.2)':'none';
    repBtn.style.borderColor=reported?'#f0a500':'rgba(240,165,0,.2)';
  }
}

function loadPeerVideos(){
  var el=document.getElementById('peer-video-list');
  if(el) el.innerHTML='<div style="color:#3a3f44;font-size:.82em;text-align:center;padding:24px">Scanning mesh…</div>';
  fetch('/cgi-bin/rocket?video_peers')
    .then(function(r){ return r.json(); })
    .then(function(d){ renderPeerVideos(d.videos||[]); })
    .catch(function(){ var el=document.getElementById('peer-video-list'); if(el) el.innerHTML='<div style="color:#f0a500;font-size:.82em;text-align:center;padding:24px">⚠ Could not reach mesh</div>'; });
}

function renderPeerVideos(videos){
  var el=document.getElementById('peer-video-list'); if(!el) return;
  if(!videos.length){
    el.innerHTML='<div style="color:#3a3f44;font-size:.82em;text-align:center;padding:24px">No mesh videos yet — invite a friend to add a node 🍄</div>';
    return;
  }
  var cats={'general':'🌍','news':'📰','gaming':'🎮','creative':'🎵','truth':'🔍'};
  var h='<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">';
  videos.sort(function(a,b){ return (b.uploaded||0)-(a.uploaded||0); });
  videos.forEach(function(v){
    var ago  = _vAgo(v.uploaded);
    var size = v.size ? (v.size/1048576).toFixed(1)+' MB' : '';
    var catEmoji = cats[v.cat||'general']||'🌍';
    var eip    = _esc(v.ip||'');
    var eid    = _esc(v.id);
    var emime  = _esc(v.mime||'video/mp4');
    var etitle = _esc(v.title||'Untitled');
    var enode  = _esc(v.node||v.ip||'?');
    // Prefer Yggdrasil (global) over LAN IP — ygg needs IPv6 bracket notation
    var eygg = _esc(v.ygg||'');
    var peerHost = eygg ? '['+eygg+']' : (v.ip||'0.0.0.0');
    var peerLabel = eygg ? '🌍 global mesh' : '🏠 local mesh';
    // Peer thumbnail: fetched from the peer's router
    var thumbUrl = 'http://'+peerHost+'/cgi-bin/rocket?video_thumb&id='+encodeURIComponent(v.id);
    h += '<div style="background:#161b22;border:1px solid #1d3a2a;border-radius:12px;overflow:hidden;display:flex;flex-direction:column">';
    // Thumbnail
    h += '<div style="position:relative;padding-bottom:56.25%;background:#0d1117;cursor:pointer" onclick="videoPeerPlay(\''+peerHost+'\',\''+eid+'\',\''+emime+'\',\''+etitle+'\')">';
    h += '<img src="'+thumbUrl+'" alt="" style="position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;object-fit:cover" onerror="this.style.display=\'none\'">';
    h += '<div style="position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center"><div style="background:rgba(0,0,0,.55);border:2px solid rgba(63,185,80,.7);border-radius:50%;width:38px;height:38px;display:flex;align-items:center;justify-content:center;color:#3fb950;font-size:1em">▶</div></div>';
    h += '<div style="position:absolute;top:7px;left:7px;background:rgba(0,0,0,.65);border-radius:5px;padding:2px 7px;font-size:.7em;color:#c9d1d9">'+catEmoji+'</div>';
    h += '<div style="position:absolute;top:7px;right:7px;background:rgba(13,17,23,.8);border-radius:5px;padding:2px 7px;font-size:.65em;color:#3fb950">'+peerLabel+'</div>';
    h += '</div>';
    // Info
    h += '<div style="padding:10px 12px;flex:1;display:flex;flex-direction:column;gap:4px">';
    h += '<div style="color:#c9d1d9;font-size:.84em;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+etitle+'">'+etitle+'</div>';
    h += '<div style="color:#484f58;font-size:.71em">'+enode+' · '+ago+(size?' · '+size:'')+'</div>';
    h += '</div></div>';
  });
  h += '</div>';
  el.innerHTML=h;
}

function videoPeerPlay(host, id, mime, title){
  _playingId = null; // can't vote on peer videos
  var player=document.getElementById('rr-video-player');
  var wrap=document.getElementById('video-player-wrap');
  var tEl=document.getElementById('video-player-title');
  if(!player||!wrap) return;
  player.pause(); player.src='';
  player.src='http://'+host+'/cgi-bin/rocket?video_stream&id='+encodeURIComponent(id);
  if(tEl) tEl.textContent=title+' · '+host;
  // Hide vote buttons for peer videos — you can only vote on your own node's content
  var pa=document.getElementById('video-player-actions');
  if(pa) pa.style.display='none';
  wrap.style.display='block';
  wrap.scrollIntoView({behavior:'smooth',block:'nearest'});
  player.load(); player.play().catch(function(){});
}

/* ── Mycelium AI chat ─────────────────────────────────────────────────────── */
var _aiMode='ram',_aiScope='router',_aiBusy=false,_aiPendingImg=null,_playingId=null;
function setAiMode(m){
  _aiMode=m;
  document.getElementById('btn-ram').classList.toggle('active',m==='ram');
  document.getElementById('btn-ssd').classList.toggle('active',m==='ssd');
  document.getElementById('ai-clear').style.display=m==='ssd'?'inline-block':'none';
  _updateAiDesc();
}
function setAiScope(s){
  _aiScope=s;
  try{localStorage.setItem('rr_ai_scope',s);}catch(e){}
  document.getElementById('btn-router').classList.toggle('active',s==='router');
  document.getElementById('btn-free').classList.toggle('active',s==='free');
  _updateAiDesc();
  var msg=s==='free'?'🔓 Free mode on — talk about anything. Mycelium is all yours.':'🔒 Back to router mode.';
  addAiBubble('bot',msg);
}
function _updateAiDesc(){
  var mem=_aiMode==='ssd'?'Persistent — saved to SSD':'Session only';
  var scope=_aiScope==='free'?'🔓 Free — talk about anything':'🔒 Router &amp; mesh topics';
  document.getElementById('ai-mode-desc').innerHTML=mem+' · '+scope;
}
(function(){try{var s=localStorage.getItem('rr_ai_scope');if(s==='free'){_aiScope='free';document.getElementById('btn-router').classList.remove('active');document.getElementById('btn-free').classList.add('active');_updateAiDesc();}}catch(e){}}());
function attachImage(){document.getElementById('ai-img-input').click();}
function clearPendingImg(){
  _aiPendingImg=null;
  document.getElementById('ai-img-strip').classList.remove('visible');
  document.getElementById('ai-img-thumb').src='';
  document.getElementById('ai-img-input').value='';
}
function handleImageSelect(input){
  var file=input.files[0];
  if(!file)return;
  var type=file.type.replace('image/','');
  if(!type||type==='svg+xml'||type==='webp')type='jpeg';
  var reader=new FileReader();
  reader.onload=function(e){
    var img=new Image();
    img.onload=function(){
      var MAX=800,w=img.width,h=img.height;
      if(w>MAX||h>MAX){if(w>h){h=Math.round(h*MAX/w);w=MAX;}else{w=Math.round(w*MAX/h);h=MAX;}}
      var c=document.createElement('canvas');
      c.width=w;c.height=h;
      c.getContext('2d').drawImage(img,0,0,w,h);
      var mime='image/'+(type==='png'?'png':'jpeg');
      var q=type==='png'?1:0.75;
      var dataUrl=c.toDataURL(mime,q);
      var b64=dataUrl.split(',')[1].replace(/\+/g,'-').replace(/\//g,'_').replace(/=/g,'');
      _aiPendingImg={b64:b64,type:(type==='png'?'png':'jpeg'),dataUrl:dataUrl};
      document.getElementById('ai-img-thumb').src=dataUrl;
      document.getElementById('ai-img-strip-lbl').textContent=file.name+' ('+Math.round(b64.length*3/4/1024)+'KB)';
      document.getElementById('ai-img-strip').classList.add('visible');
      input.value='';
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}
function aiKeyDown(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendAiMsg();}}
function sendAiMsg(){
  if(_aiBusy)return;
  var inp=document.getElementById('ai-input');
  var msg=inp.value.trim();
  if(!msg&&!_aiPendingImg)return;
  inp.value='';
  // Build user bubble
  if(_aiPendingImg){
    var msgs=document.getElementById('ai-msgs');
    var d=document.createElement('div');d.className='ai-msg ai-msg-user';
    var b=document.createElement('div');b.className='ai-bubble';
    var iEl=document.createElement('img');iEl.src=_aiPendingImg.dataUrl;b.appendChild(iEl);
    if(msg){var t=document.createElement('span');t.textContent=msg;b.appendChild(t);}
    d.appendChild(b);msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;
  } else {
    addAiBubble('user',msg);
  }
  var tid='think'+Date.now();
  addAiBubble('bot','⏳ thinking…',tid);
  _aiBusy=true;
  document.getElementById('ai-send').disabled=true;
  var body='msg='+encodeURIComponent(msg||'What is in this image?')+'&mode='+_aiMode+'&scope='+_aiScope;
  if(_aiPendingImg){body+='&img='+_aiPendingImg.b64+'&imgtype='+_aiPendingImg.type;clearPendingImg();}
  fetch('/cgi-bin/rocket?ai_chat',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
    .then(function(r){return r.json();})
    .then(function(d){
      var el=document.getElementById(tid);
      if(el)el.parentNode.removeChild(el);
      addAiBubble('bot',d.ok?d.reply:'⚠️ '+(d.error||'error'));
    })
    .catch(function(){
      var el=document.getElementById(tid);
      if(el)el.parentNode.removeChild(el);
      addAiBubble('bot','⚠️ Connection error.');
    })
    .finally(function(){_aiBusy=false;document.getElementById('ai-send').disabled=false;});
}
function addAiBubble(who,text,id){
  var msgs=document.getElementById('ai-msgs');
  var d=document.createElement('div');
  d.className='ai-msg ai-msg-'+(who==='user'?'user':'bot');
  if(id)d.id=id;
  var b=document.createElement('div');
  b.className='ai-bubble';
  b.innerHTML=text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\n/g,'\n').replace(/\n/g,'<br>').replace(/\`([^\`]+)\`/g,'<code>\$1</code>');
  d.appendChild(b);msgs.appendChild(d);
  msgs.scrollTop=msgs.scrollHeight;
}
function clearAiMem(){
  if(!confirm('Clear all saved AI memory?'))return;
  fetch('/cgi-bin/rocket?ai_mem_clear').then(function(r){return r.json();}).then(function(d){
    if(d.ok){document.getElementById('ai-msgs').innerHTML='';addAiBubble('bot','🗑️ Memory cleared.');}
  });
}
var _memPanelOpen=true;
function toggleMemPanel(){
  _memPanelOpen=!_memPanelOpen;
  document.getElementById('ai-mem-body').style.display=_memPanelOpen?'block':'none';
  document.getElementById('ai-mem-toggle').textContent=_memPanelOpen?'▲ hide':'▼ show';
}
function loadMemories(){
  fetch('/cgi-bin/rocket?ai_memory_read').then(function(r){return r.json();}).then(function(d){
    if(!d.ok)return;
    var list=document.getElementById('ai-mem-list');
    var empty=document.getElementById('ai-mem-empty');
    list.innerHTML='';
    if(!d.memories||d.memories.length===0){
      list.innerHTML='<div class="ai-mem-empty" id="ai-mem-empty">No memories yet. Add something below.</div>';
      return;
    }
    d.memories.forEach(function(m){
      var item=document.createElement('div');
      item.className='ai-mem-item';
      item.innerHTML='<span>'+m.line.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</span>'
        +'<button class="ai-mem-del" onclick="deleteMemory('+m.n+',this)" title="Delete">✕</button>';
      list.appendChild(item);
    });
  });
}
function saveMemory(){
  var inp=document.getElementById('ai-mem-input');
  var val=inp.value.trim();
  if(!val)return;
  fetch('/cgi-bin/rocket?ai_remember',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'mem='+encodeURIComponent(val)})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.ok){inp.value='';loadMemories();addAiBubble('bot','🧠 Remembered: '+val);}
    });
}
function deleteMemory(n,btn){
  fetch('/cgi-bin/rocket?ai_memory_del',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'n='+n})
    .then(function(r){return r.json();})
    .then(function(d){if(d.ok)loadMemories();});
}
// Show memory panel + load memories when SSD mode active
var _origSetAiMode=setAiMode;
setAiMode=function(m){
  _origSetAiMode(m);
  var panel=document.getElementById('ai-mem-panel');
  if(m==='ssd'){panel.classList.add('visible');loadMemories();}
  else{panel.classList.remove('visible');}
};

// ── Mycelium User Accounts ────────────────────────────────────────────────
var _acctMode = 'reg';

function userInit(){
  var uid  = localStorage.getItem('rr_user_id');
  var name = localStorage.getItem('rr_user_name');
  var tok  = localStorage.getItem('rr_user_token');
  var bar  = document.getElementById('user-bar');
  if(uid && tok){
    if(bar) bar.style.display='flex';
    var bn = document.getElementById('user-bar-name');
    var bi = document.getElementById('user-bar-id');
    if(bn) bn.textContent = '@'+(name||uid.replace(/^@([^:]+):.*$/,'$1'));
    if(bi) bi.textContent = uid;
    localStorage.setItem('rr_matrix_uid', uid);
  } else {
    if(bar) bar.style.display='none';
  }
}

function initAccount(){
  var uid = localStorage.getItem('rr_user_id');
  var tok = localStorage.getItem('rr_user_token');
  var li  = document.getElementById('account-loggedin');
  var lo  = document.getElementById('account-loggedout');
  if(uid && tok){
    if(li) li.style.display='block';
    if(lo) lo.style.display='none';
    var dn = document.getElementById('acct-display-name');
    var di = document.getElementById('acct-user-id');
    var name = localStorage.getItem('rr_user_name') || uid.replace(/^@([^:]+):.*$/,'$1');
    if(dn) dn.textContent = '@'+name;
    if(di) di.textContent = uid;
    // Populate avatar picker grid
    var grid = document.getElementById('av-pick-grid');
    if(grid && grid.children.length === 0){
      _AVATARS.forEach(function(svg, i){
        var btn = document.createElement('button');
        btn.id = 'av-pick-'+i;
        btn.className = 'av-pick-btn';
        btn.title = _AVATAR_NAMES[i];
        btn.style.cssText = 'background:none;border:2px solid transparent;border-radius:50%;padding:2px;cursor:pointer;width:38px;height:38px;overflow:hidden';
        btn.innerHTML = '<img src="'+_svgToDataUri(svg)+'" style="width:32px;height:32px;border-radius:50%">';
        btn.onclick = function(){ acctAvatarPick(i); };
        grid.appendChild(btn);
      });
    }
    // Load and show current avatar in header
    var ha = document.getElementById('acct-header-avatar');
    if(ha){ ha.innerHTML = _avatarWrap(uid, 52); }
    // Show claim ownership button if no owner set
    fetch('/cgi-bin/rocket?get_node_owner')
      .then(function(r){ return r.json(); })
      .then(function(d){
        _nodeOwner = d.owner || '';
        var w = document.getElementById('acct-owner-wrap');
        if(w) w.style.display = (!_nodeOwner) ? 'block' : 'none';
      }).catch(function(){});
  } else {
    if(li) li.style.display='none';
    if(lo) lo.style.display='block';
    acctTab('reg');
    // Show claim banner if no owner set
    fetch('/cgi-bin/rocket?get_node_owner')
      .then(function(r){ return r.json(); })
      .then(function(d){
        _nodeOwner = d.owner || '';
        var b = document.getElementById('acct-claim-banner');
        if(b) b.style.display = (!_nodeOwner) ? 'block' : 'none';
      }).catch(function(){});
  }
}

// Gender avatar picker — lady=index 0 (Astronaut slot), gent=index 8 (Chef), other=index 19 (Rocket)
// Avatars: 0=Astronaut,1=RockStar,2=Hacker,3=Scientist,4=Artist,5=Firefighter,6=Pilot,7=Farmer,8=Chef,9=Doctor
// 10=Superhero,11=Wizard,12=Ninja,13=Robot,14=Alien,15=Fox,16=Wolf,17=Lion,18=Dragon,19=Rocket
var _REG_GENDER_IDX = {lady:4, gent:10}; // Artist, Superhero
var _regGenderChosen = 'lady';
function regPickGender(g){
  _regGenderChosen = g;
  var idx = _REG_GENDER_IDX[g] !== undefined ? _REG_GENDER_IDX[g] : 4;
  var hidx = document.getElementById('reg-av-idx');
  if(hidx) hidx.value = idx;
  ['lady','gent'].forEach(function(k){
    var btn = document.getElementById('reg-av-'+k);
    if(!btn) return;
    var colors = {lady:'rgba(88,166,255,.35)', gent:'rgba(63,185,80,.35)'};
    var bgs    = {lady:'rgba(88,166,255,.15)', gent:'rgba(63,185,80,.15)'};
    if(k === g){
      btn.style.borderColor = colors[k];
      btn.style.background  = bgs[k];
    } else {
      btn.style.borderColor = '#30363d';
      btn.style.background  = 'none';
    }
  });
}
// Default to Lady on page load
(function(){ regPickGender('lady'); })();

function acctTab(t){
  _acctMode = t;
  var tr   = document.getElementById('acct-tab-reg');
  var tl   = document.getElementById('acct-tab-login');
  var p2   = document.getElementById('acct-pass2-wrap');
  var inv  = document.getElementById('acct-invite-wrap');
  var av   = document.getElementById('acct-avatar-wrap');
  var btn  = document.getElementById('acct-submit-btn');
  var hint = document.getElementById('acct-name-hint');
  var err  = document.getElementById('acct-err');
  if(err) err.style.display='none';
  if(t === 'reg'){
    if(tr){ tr.style.background='rgba(63,185,80,.15)'; tr.style.color='#3fb950'; tr.style.fontWeight='600'; }
    if(tl){ tl.style.background='none'; tl.style.color='#8b949e'; tl.style.fontWeight='400'; }
    if(p2)  p2.style.display='block';
    if(inv) inv.style.display='block';
    if(av)  av.style.display='block';
    if(btn) btn.textContent='Create Account';
    if(hint) hint.style.display='block';
  } else {
    if(tl){ tl.style.background='rgba(63,185,80,.15)'; tl.style.color='#3fb950'; tl.style.fontWeight='600'; }
    if(tr){ tr.style.background='none'; tr.style.color='#8b949e'; tr.style.fontWeight='400'; }
    if(p2)  p2.style.display='none';
    if(inv) inv.style.display='none';
    if(av)  av.style.display='none';
    if(btn) btn.textContent='Sign In';
    if(hint) hint.style.display='none';
  }
}

function acctSubmit(){
  var name   = ((document.getElementById('acct-inp-name')||{}).value||'').trim().toLowerCase();
  var pass   = (document.getElementById('acct-inp-pass')||{}).value||'';
  var pass2  = (document.getElementById('acct-inp-pass2')||{}).value||'';
  var invite = ((document.getElementById('acct-inp-invite')||{}).value||'').trim();
  var err    = document.getElementById('acct-err');
  var btn    = document.getElementById('acct-submit-btn');
  function showErr(m){ if(err){ err.textContent=m; err.style.display='block'; } }
  if(!name){ showErr('Enter a username'); return; }
  if(!pass){ showErr('Enter a password'); return; }
  if(_acctMode === 'reg'){
    if(!/^[a-z0-9._-]+$/.test(name)){ showErr('Username: letters, numbers, . _ - only'); return; }
    if(pass.length < 8){ showErr('Password must be at least 8 characters'); return; }
    if(pass !== pass2){ showErr("Passwords don't match"); return; }
  }
  if(btn){ btn.disabled=true; btn.textContent='…'; }
  if(err) err.style.display='none';
  var ep = _acctMode==='reg' ? 'user_register' : 'user_login';
  var body = {username:name, password:pass};
  if(_acctMode==='reg' && invite) body.invite = invite;
  fetch('/cgi-bin/rocket?'+ep, {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(btn){ btn.disabled=false; btn.textContent=(_acctMode==='reg'?'Create Account':'Sign In'); }
    if(d.ok){
      localStorage.setItem('rr_user_token', d.token);
      localStorage.setItem('rr_user_id',    d.user_id);
      localStorage.setItem('rr_user_name',  name);
      // Save chosen gender avatar index (registration only)
      if(_acctMode === 'reg'){
        var avIdx = parseInt((document.getElementById('reg-av-idx')||{}).value||'19', 10);
        fetch('/cgi-bin/rocket?profile_avatar_set&user='+encodeURIComponent(d.user_id)+'&idx='+avIdx, {
          method:'POST', credentials:'include',
          headers:{'Authorization':'Bearer '+d.token}
        }).catch(function(){});
      }
      // Clear fields so credentials don't linger in the DOM
      var _flds = ['acct-inp-name','acct-inp-pass','acct-inp-pass2','acct-inp-invite'];
      _flds.forEach(function(id){ var el=document.getElementById(id); if(el) el.value=''; });
      userInit();
      initAccount();
    } else {
      var msg = d.error||'Unknown error';
      if(/taken|exists|in use/i.test(msg)) msg='That username is already taken — try another or sign in.';
      if(_acctMode==='reg' && /forbidden|invalid.*token/i.test(msg)) msg='Invalid invite code — ask the router owner for the correct code.';
      if(_acctMode==='login' && /forbidden|invalid.*token|unauthorized/i.test(msg)) msg='Wrong username or password.';
      showErr(msg);
    }
  })
  .catch(function(){
    if(btn){ btn.disabled=false; btn.textContent=(_acctMode==='reg'?'Create Account':'Sign In'); }
    showErr('Network error — try again');
  });
}

function userLogout(){
  localStorage.removeItem('rr_user_token');
  localStorage.removeItem('rr_user_id');
  localStorage.removeItem('rr_user_name');
  var bar = document.getElementById('user-bar');
  if(bar) bar.style.display='none';
  initAccount();
}

function _getUserToken(){
  return localStorage.getItem('rr_user_token')||'';
}

function acctRevealCode(btn){
  var tok = _getUserToken();
  var disp = document.getElementById('acct-code-display');
  if(!tok||!disp) return;
  if(disp.style.display === 'block'){
    disp.style.display = 'none';
    if(btn) btn.textContent = 'Show current code';
    return;
  }
  if(btn){ btn.disabled=true; btn.textContent='…'; }
  fetch('/cgi-bin/rocket?user_invite_code', {
    headers:{'Authorization':'Bearer '+tok}
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(btn){ btn.disabled=false; btn.textContent='Hide code'; }
    if(d.ok && d.code){
      disp.textContent = d.code;
      disp.style.display = 'block';
    } else {
      disp.textContent = 'Could not read code — are you the router owner?';
      disp.style.display = 'block';
    }
  })
  .catch(function(){
    if(btn){ btn.disabled=false; btn.textContent='Show current code'; }
  });
}

function acctChangeCodePrompt(){
  var w = document.getElementById('acct-new-code-wrap');
  if(w) w.style.display = w.style.display==='block' ? 'none' : 'block';
  var inp = document.getElementById('acct-new-code-inp');
  if(inp) inp.focus();
}

function acctSaveCode(){
  var tok = _getUserToken();
  var inp = document.getElementById('acct-new-code-inp');
  var msg = document.getElementById('acct-code-msg');
  if(!inp||!tok) return;
  var code = inp.value.trim();
  if(code.length < 6){ if(msg){ msg.textContent='Code must be at least 6 characters'; msg.style.color='#f85149'; msg.style.display='block'; } return; }
  fetch('/cgi-bin/rocket?user_set_invite_code', {
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+tok},
    body:JSON.stringify({code:code})
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(d.ok){
      if(msg){ msg.textContent='✓ Invite code updated'; msg.style.color='#3fb950'; msg.style.display='block'; }
      inp.value='';
      var disp=document.getElementById('acct-code-display');
      if(disp && disp.style.display==='block') disp.textContent=code;
      setTimeout(function(){ var w=document.getElementById('acct-new-code-wrap'); if(w) w.style.display='none'; if(msg) msg.style.display='none'; }, 2000);
    } else {
      if(msg){ msg.textContent='Error: '+(d.error||'failed'); msg.style.color='#f85149'; msg.style.display='block'; }
    }
  })
  .catch(function(){
    if(msg){ msg.textContent='Network error'; msg.style.color='#f85149'; msg.style.display='block'; }
  });
}

// ── Mycelium Live — WebRTC peer-to-peer calls ─────────────────────────────
var _liveCallId    = null;   // active call UUID
var _livePeer      = null;   // RTCPeerConnection
var _liveLocal     = null;   // local MediaStream
var _liveMuted     = false;
var _liveCamOff    = false;
var _liveTarget    = null;   // remote user we're calling/called by
var _liveIsInit    = false;  // are we the initiator?
var _livePollTmr   = null;
var _liveProcessed = {};     // event IDs already handled
var _liveIgnored   = {};     // { "@user:mesh": ignoreCount }
var _liveRingData  = null;   // pending incoming call data
var _liveState     = 'idle'; // idle | calling | ringing | connected

var _LIVE_ICE = [{ urls: 'stun:stun.l.google.com:19302' }];

function _liveUUID(){
  var s=''; for(var i=0;i<32;i++) s+=Math.floor(Math.random()*16).toString(16);
  return s.slice(0,8)+'-'+s.slice(8,12)+'-4'+s.slice(13,16)+'-'+s.slice(16,20)+'-'+s.slice(20);
}

function initLive(){
  if(localStorage.getItem('rr_donate')!=='1'){
    var g=document.getElementById('live-gate'); if(g) g.style.display='block';
    var i=document.getElementById('live-idle-wrap'); if(i) i.style.display='none';
    return;
  }
  _loadLivePeers();
  _livePollTmr = setInterval(_livePoll, 2500);
  _livePoll();
}

function stopLive(){
  if(_livePollTmr){ clearInterval(_livePollTmr); _livePollTmr=null; }
  // Don't hang up just because user switched tabs — keep call alive
}

function _loadLivePeers(){
  var box = document.getElementById('live-peers-list');
  if(!box) return;
  fetch('/cgi-bin/rocket?peers_list')
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.peers || !d.peers.length){
        box.innerHTML='<div style="color:#3a3f44;font-size:.8em">No mesh peers online</div>';
        return;
      }
      var h='';
      d.peers.forEach(function(p){
        var uid = p.user_id || p.id || '';
        var name = p.display_name || uid.replace(/^@([^:]+):.*$/,'$1') || uid;
        if(!uid) return;
        h+='<div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(22,27,34,.7);border:1px solid #21262d;border-radius:8px">';
        h+='<span style="color:#3fb950;font-size:.8em">●</span>';
        h+='<span style="flex:1;color:#c9d1d9;font-size:.84em;font-weight:500">'+_esc(name)+'</span>';
        h+='<button onclick="liveCall(\''+_esc(uid)+'\')" style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.4);color:#3fb950;border-radius:7px;padding:5px 14px;font-size:.78em;font-weight:600;cursor:pointer">📞 Call</button>';
        h+='</div>';
      });
      box.innerHTML = h || '<div style="color:#3a3f44;font-size:.8em">No peers with Live enabled</div>';
    })
    .catch(function(){ box.innerHTML='<div style="color:#3a3f44;font-size:.8em">Could not load peers</div>'; });
}

function _liveGetUserMedia(constraints){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    var err = new Error('Camera/mic needs a secure connection.');
    err.httpInsecure = true;
    return Promise.reject(err);
  }
  return navigator.mediaDevices.getUserMedia(constraints);
}
// One click, same tab: hop to https:// on this router (self-signed cert — the
// browser shows its normal one-time "Advanced > Proceed" warning), which makes
// this a secure context so the native camera/mic permission prompt works.
function _liveSecureRedirect(){
  // ?tab=live travels with the actual HTTP request (unlike #live, which is
  // client-side only and can get dropped by Chrome's cert-warning interstitial),
  // so it's the reliable way to land back on the Live tab after the security
  // warning. The hash is also kept for browsers that do preserve it.
  var tab = (location.hash || '#live').replace('#','');
  location.href = 'https://' + location.host + location.pathname + '?tab=' + tab + '#' + tab;
}

function liveCall(targetUid){
  if(_liveState !== 'idle'){ alert('Already in a call'); return; }
  _liveGetUserMedia({video:true, audio:true})
    .then(function(stream){
      _liveLocal = stream;
      _liveCallId = _liveUUID();
      _liveTarget = targetUid;
      _liveIsInit = true;
      _liveState  = 'calling';
      _showLiveCallUI('Calling '+targetUid.replace(/^@([^:]+):.*$/,'$1')+'…');
      document.getElementById('live-local-vid').srcObject = stream;
      // Send invite signal
      _liveSignal('invite', {call_id:_liveCallId, target:targetUid, caller:_liveGetMyId()});
      // Set up peer and create offer
      _liveSetupPeer(true);
    })
    .catch(function(e){
      if(e && e.httpInsecure){
        if(confirm('Camera/mic needs a secure connection.\n\nClick OK to switch. Chrome will show a "Your connection is not private" warning — this is normal for this router and is safe.\n\nOn that page: click "Advanced", then click "Proceed to 192.168.1.1 (unsafe)". You\'ll land straight back here, ready to test.')) _liveSecureRedirect();
      } else {
        alert('Camera/mic access denied: '+e.message);
      }
    });
}

function liveAnswer(){
  if(!_liveRingData) return;
  var rd = _liveRingData;
  _liveRingData = null;
  _hideBanner();
  _liveGetUserMedia({video:true, audio:true})
    .then(function(stream){
      _liveLocal = stream;
      _liveCallId = rd.call_id;
      _liveTarget = rd.caller;
      _liveIsInit = false;
      _liveState  = 'ringing';
      _showLiveCallUI('Connecting to '+rd.caller.replace(/^@([^:]+):.*$/,'$1')+'…');
      document.getElementById('live-local-vid').srcObject = stream;
      _liveSetupPeer(false);
      // Process the offer that came with the invite (if present)
      if(rd.sdp){
        _livePeer.setRemoteDescription(new RTCSessionDescription({type:'offer', sdp:rd.sdp}))
          .then(function(){ return _livePeer.createAnswer(); })
          .then(function(ans){ return _livePeer.setLocalDescription(ans); })
          .then(function(){
            _liveSignal('answer', {call_id:_liveCallId, sdp:_livePeer.localDescription.sdp, target:_liveTarget});
          });
      } else {
        _liveSignal('accept', {call_id:_liveCallId, target:_liveTarget, caller:_liveGetMyId()});
      }
    })
    .catch(function(e){
      if(e && e.httpInsecure){
        if(confirm('Camera/mic needs a secure connection.\n\nClick OK to switch. Chrome will show a "Your connection is not private" warning — this is normal for this router and is safe.\n\nOn that page: click "Advanced", then click "Proceed to 192.168.1.1 (unsafe)". You\'ll land straight back here, ready to test.')) _liveSecureRedirect();
      } else {
        alert('Camera/mic access denied: '+e.message);
      }
    });
}

function liveDecline(){
  if(!_liveRingData) return;
  var rd = _liveRingData;
  _liveRingData = null;
  _hideBanner();
  _liveSignal('decline', {call_id:rd.call_id, target:rd.caller});
  // Track ignores
  _liveIgnored[rd.caller] = (_liveIgnored[rd.caller]||0)+1;
}

function liveHangup(){
  if(_liveCallId) _liveSignal('hangup', {call_id:_liveCallId, target:_liveTarget});
  _liveCleanup();
}


function liveToggleMute(){
  if(!_liveLocal) return;
  _liveMuted = !_liveMuted;
  _liveLocal.getAudioTracks().forEach(function(t){ t.enabled=!_liveMuted; });
  var btn=document.getElementById('live-btn-mute');
  if(btn){ btn.textContent=_liveMuted?'🔇':'🎤'; btn.style.background=_liveMuted?'rgba(248,81,73,.2)':'rgba(48,54,61,.6)'; }
}

function liveToggleCam(){
  if(!_liveLocal) return;
  _liveCamOff = !_liveCamOff;
  _liveLocal.getVideoTracks().forEach(function(t){ t.enabled=!_liveCamOff; });
  var btn=document.getElementById('live-btn-cam');
  if(btn){ btn.textContent=_liveCamOff?'🚫':'📷'; btn.style.background=_liveCamOff?'rgba(248,81,73,.2)':'rgba(48,54,61,.6)'; }
}

function _liveSetupPeer(initiator){
  _livePeer = new RTCPeerConnection({iceServers:_LIVE_ICE});
  if(_liveLocal) _liveLocal.getTracks().forEach(function(t){ _livePeer.addTrack(t, _liveLocal); });
  _livePeer.onicecandidate = function(e){
    if(e.candidate && _liveCallId && _liveTarget){
      _liveSignal('ice', {call_id:_liveCallId, target:_liveTarget, candidate:e.candidate});
    }
  };
  _livePeer.ontrack = function(e){
    var rv = document.getElementById('live-remote-vid');
    var rw = document.getElementById('live-wait-msg');
    var rl = document.getElementById('live-remote-label');
    if(rv){
      rv.srcObject = e.streams[0];
      rv.style.display='block';
      if(rw) rw.style.display='none';
      if(rl){ rl.style.display='block'; rl.textContent=(_liveTarget||'').replace(/^@([^:]+):.*$/,'$1'); }
    }
    _liveState='connected';
    _setCallStatus('● Connected');
  };
  _livePeer.onconnectionstatechange = function(){
    var s=_livePeer.connectionState;
    if(s==='connected'){ _liveState='connected'; _setCallStatus('● Connected'); }
    if(s==='disconnected'||s==='failed'){ _liveCleanup(); }
  };
  if(initiator){
    _livePeer.createOffer()
      .then(function(offer){ return _livePeer.setLocalDescription(offer); })
      .then(function(){
        _liveSignal('offer', {call_id:_liveCallId, target:_liveTarget, sdp:_livePeer.localDescription.sdp});
      });
  }
}

function _liveSignal(type, data){
  fetch('/cgi-bin/rocket?live_signal&type='+type, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify(data)
  }).catch(function(e){ console.warn('[live] signal failed', type, e); });
}

function _liveGetMyId(){
  return localStorage.getItem('rr_matrix_uid') || '@me:mesh';
}

function _livePoll(){
  fetch('/cgi-bin/rocket?live_poll')
    .then(function(r){ return r.json(); })
    .then(function(d){
      var events = d.chunk || [];
      events.forEach(function(ev){
        if(_liveProcessed[ev.event_id]) return;
        _liveProcessed[ev.event_id] = true;
        var t = ev.type || '';
        if(!t.startsWith('m.rr.call.')) return;
        var sig = t.replace('m.rr.call.','');
        var c = ev.content || {};
        _handleLiveSignal(sig, c, ev.sender);
      });
      var keys=Object.keys(_liveProcessed);
      if(keys.length>200){ delete _liveProcessed[keys[0]]; }
    })
    .catch(function(){});
}

function _handleLiveSignal(sig, c, sender){
  var myId = _liveGetMyId();
  if(c.target && c.target !== myId) return;
  if(sender === myId) return;
  if(sig === 'invite'){
    if(_liveState !== 'idle') return;
    var cnt = _liveIgnored[sender] || 0;
    if(cnt >= 2) return;
    _liveRingData = {call_id: c.call_id, caller: sender, sdp: c.sdp || null};
    _showBanner('@'+(sender.replace(/^@([^:]+):.*$/,'$1'))+' is calling you…');
    return;
  }
  if(sig === 'offer' && _liveCallId === c.call_id && _livePeer){
    _livePeer.setRemoteDescription(new RTCSessionDescription({type:'offer', sdp:c.sdp}))
      .then(function(){ return _livePeer.createAnswer(); })
      .then(function(ans){ return _livePeer.setLocalDescription(ans); })
      .then(function(){
        _liveSignal('answer', {call_id:_liveCallId, sdp:_livePeer.localDescription.sdp, target:_liveTarget});
      });
    return;
  }
  if(sig === 'answer' && _liveCallId === c.call_id && _livePeer){
    _livePeer.setRemoteDescription(new RTCSessionDescription({type:'answer', sdp:c.sdp}));
    return;
  }
  if(sig === 'ice' && _liveCallId === c.call_id && _livePeer){
    try{ _livePeer.addIceCandidate(new RTCIceCandidate(c.candidate)); }catch(e){}
    return;
  }
  if(sig === 'accept' && _liveCallId === c.call_id && _livePeer && _liveIsInit){
    _setCallStatus('Peer accepted — establishing connection…');
    return;
  }
  if(sig === 'hangup' && _liveCallId === c.call_id){
    _liveCleanup();
    return;
  }
  if(sig === 'decline' && _liveCallId === c.call_id){
    _liveCleanup();
    alert('Call declined.');
    return;
  }
}

function _showBanner(msg){
  var b=document.getElementById('live-ring-banner');
  var w=document.getElementById('live-ring-who');
  if(b){ b.style.display='flex'; }
  if(w){ w.textContent=msg; }
  setTimeout(function(){
    if(_liveRingData){ _liveRingData=null; _hideBanner(); }
  }, 30000);
}
function _hideBanner(){ var b=document.getElementById('live-ring-banner'); if(b) b.style.display='none'; }

function _showLiveCallUI(status){
  var iw=document.getElementById('live-idle-wrap');
  var cw=document.getElementById('live-call-wrap');
  if(iw) iw.style.display='none';
  if(cw) cw.style.display='block';
  _setCallStatus(status||'Connecting…');
}
function _setCallStatus(s){ var el=document.getElementById('live-call-status'); if(el) el.textContent=s; }

var _liveTestStream = null;
var _liveTestAudio  = null;
var _liveTestRaf    = null;
var _liveTestGain   = null;
var _liveTestAudioCtx = null;
function liveSetMicGain(v){
  v = parseFloat(v);
  if(_liveTestGain) _liveTestGain.gain.value = v;
  var el = document.getElementById('live-mic-gain-val');
  if(el) el.textContent = v.toFixed(1)+'×';
}

function liveTestCam(){
  var msg      = document.getElementById('live-test-msg');
  var vid      = document.getElementById('live-test-vid');
  var preview  = document.getElementById('live-test-preview');
  var audioBar = document.getElementById('live-test-audio-bar');
  var lvl      = document.getElementById('live-test-audio-level');
  var chat     = document.getElementById('live-chat-wrap');
  var btnStart = document.getElementById('live-test-btn');
  var btnStop  = document.getElementById('live-test-stop');
  if(msg) msg.textContent = 'Requesting camera & mic…';
  _liveGetUserMedia({video:true, audio:true})
    .then(function(stream){
      _liveTestStream = stream;
      if(vid){ vid.srcObject = stream; vid.play().catch(function(){}); }
      if(preview)  preview.style.display  = 'block';
      if(audioBar) audioBar.style.display = 'block';
      if(chat)     chat.style.display     = 'block';
      if(btnStart) btnStart.style.display = 'none';
      if(btnStop)  btnStop.style.display  = 'inline-block';
      if(msg) msg.textContent = '✓ Camera & mic ready';
      liveChatStart();
      // Mic level meter
      try {
        _liveTestAudioCtx = new (window.AudioContext||window.webkitAudioContext)();
        var src = _liveTestAudioCtx.createMediaStreamSource(stream);
        _liveTestGain = _liveTestAudioCtx.createGain();
        var gainEl = document.getElementById('live-mic-gain');
        _liveTestGain.gain.value = gainEl ? parseFloat(gainEl.value) : 1;
        var analyser = _liveTestAudioCtx.createAnalyser();
        analyser.fftSize = 256;
        src.connect(_liveTestGain);
        _liveTestGain.connect(analyser);
        var buf = new Uint8Array(analyser.frequencyBinCount);
        (function tick(){
          if(!_liveTestStream){ return; }
          analyser.getByteFrequencyData(buf);
          var sum=0; for(var i=0;i<buf.length;i++) sum+=buf[i];
          var pct = Math.min(100, Math.round(sum/buf.length/2.55));
          if(lvl) lvl.style.width = pct+'%';
          requestAnimationFrame(tick);
        })();
      } catch(e){}
    })
    .catch(function(e){
      if(e && e.httpInsecure){
        if(msg) msg.innerHTML = '🔒 Camera/mic needs a secure connection.<br>'
          +'<button onclick="_liveSecureRedirect()" style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.4);color:#3fb950;border-radius:6px;padding:4px 12px;font-size:.85em;font-weight:600;cursor:pointer;margin-top:6px">Switch to secure connection</button>'
          +'<div style="margin-top:8px;padding:8px 10px;background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.25);border-radius:8px;font-size:.82em;color:#c9d1d9;line-height:1.5">'
          +'<b style="color:#f0a500">What happens next — this is safe:</b><br>'
          +'1. Chrome will show a page saying <i>"Your connection is not private"</i>. This is expected — it just means your router signs its own security certificate, like all home routers do.<br>'
          +'2. Click <b>Advanced</b>, then click <b>Proceed to 192.168.1.1 (unsafe)</b>.<br>'
          +'3. You\'ll land straight back on this Live tab automatically — press <b>Start test</b> again and your camera/mic prompt will appear normally.'
          +'</div>';
      } else if(msg) {
        msg.textContent = '⚠ ' + (e.message||'Camera access denied');
      }
    });
}

function liveTestStop(){
  if(_liveTestStream){ _liveTestStream.getTracks().forEach(function(t){ t.stop(); }); _liveTestStream=null; }
  var preview  = document.getElementById('live-test-preview');
  var audioBar = document.getElementById('live-test-audio-bar');
  var chat     = document.getElementById('live-chat-wrap');
  var lvl      = document.getElementById('live-test-audio-level');
  var msg      = document.getElementById('live-test-msg');
  var btnStart = document.getElementById('live-test-btn');
  var btnStop  = document.getElementById('live-test-stop');
  var vid      = document.getElementById('live-test-vid');
  if(vid){ vid.srcObject=null; }
  if(preview)  preview.style.display  = 'none';
  if(audioBar) audioBar.style.display = 'none';
  if(chat)     chat.style.display     = 'none';
  if(lvl)      lvl.style.width        = '0%';
  if(msg)      msg.textContent        = '';
  if(btnStart) btnStart.style.display = 'inline-block';
  if(btnStop)  btnStop.style.display  = 'none';
  liveChatStop();
}

function acctUploadPic(){
  var inp = document.getElementById('acct-pic-file');
  if(!inp || !inp.files || !inp.files[0]) return;
  var uid = localStorage.getItem('rr_user_id') || '';
  if(!uid){ alert('Log in first'); return; }
  var msg = document.getElementById('acct-pic-msg');
  if(msg){ msg.textContent='⏳ Uploading…'; msg.style.color='#8b949e'; }
  var file = inp.files[0];
  var reader = new FileReader();
  reader.onload = function(e){
    var img = new Image();
    img.onload = function(){
      var canvas = document.createElement('canvas');
      canvas.width = 96; canvas.height = 96;
      var ctx = canvas.getContext('2d');
      var s = Math.min(img.width, img.height);
      var ox = (img.width - s) / 2, oy = (img.height - s) / 2;
      ctx.drawImage(img, ox, oy, s, s, 0, 0, 96, 96);
      var dataUrl = canvas.toDataURL('image/jpeg', 0.72);
      fetch('/cgi-bin/rocket?profile_pic_upload&user='+encodeURIComponent(uid), {
        method:'POST', body: dataUrl
      }).then(function(r){ return r.json(); })
        .then(function(d){
          if(d.ok){
            _avatarCache[uid] = {type:'custom', ts: Date.now()};
            var ha = document.getElementById('acct-header-avatar');
            var s = 'width:52px;height:52px;border-radius:50%;overflow:hidden;object-fit:cover';
            if(ha) ha.innerHTML = '<img src="/cgi-bin/rocket?profile_img&user='+encodeURIComponent(uid)+'&t='+Date.now()+'" style="'+s+'" onerror="this.parentElement.textContent=\'👤\'">';
            if(msg){ msg.textContent='✓ Profile picture saved!'; msg.style.color='#3fb950'; }
          } else {
            if(msg){ msg.textContent='Error: '+(d.error||'upload failed'); msg.style.color='#f85149'; }
          }
        }).catch(function(e){
          if(msg){ msg.textContent='Network error'; msg.style.color='#f85149'; }
        });
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

var _liveChatPollTimer = null;
var _liveChatLastTs = 0;

function liveChatSend(){
  var inp  = document.getElementById('live-chat-inp');
  var text = inp ? inp.value.trim() : '';
  if(!text) return;
  var user = localStorage.getItem('rr_user_name') || (localStorage.getItem('rr_user_id')||'').replace(/^@([^:]+):.*$/,'$1') || 'anon';
  inp.value = '';
  fetch('/cgi-bin/rocket?live_msg_send&user='+encodeURIComponent(user)+'&msg='+encodeURIComponent(text), {
    method:'POST'
  }).catch(function(){});
}

function liveChatPoll(){
  fetch('/cgi-bin/rocket?live_msg_poll&since='+_liveChatLastTs)
    .then(function(r){ return r.json(); })
    .then(function(resp){
      var msgs = Array.isArray(resp) ? resp : (resp.msgs || []);
      if(!msgs.length) return;
      var box = document.getElementById('live-chat-msgs');
      var cnt = document.getElementById('live-chat-count');
      if(!box) return;
      msgs.forEach(function(m){
        if(m.ts && m.ts <= _liveChatLastTs) return;
        if(m.ts) _liveChatLastTs = m.ts;
        if(!m.msg || !m.msg.trim()) return; // skip empty messages
        var div = document.createElement('div');
        div.style.cssText = 'padding:3px 0;border-bottom:1px solid rgba(255,255,255,.04)';
        var u = (m.user||'anon').replace(/^@([^:]+):.*$/,'$1');
        div.innerHTML = '<span style="color:#58a6ff;font-weight:600">'+_esc(u)+'</span> <span style="color:#c9d1d9">'+_esc(m.msg)+'</span>';
        box.appendChild(div);
      });
      box.scrollTop = box.scrollHeight;
      if(cnt) cnt.textContent = '('+box.children.length+')';
    }).catch(function(){});
}

function liveChatStart(){
  _liveChatLastTs = 0;
  var box = document.getElementById('live-chat-msgs');
  if(box) box.innerHTML = '';
  if(_liveChatPollTimer) clearInterval(_liveChatPollTimer);
  _liveChatPollTimer = setInterval(liveChatPoll, 2500);
  liveChatPoll();
}

function liveChatStop(){
  if(_liveChatPollTimer){ clearInterval(_liveChatPollTimer); _liveChatPollTimer=null; }
}

function acctClaimOwner(){
  var uid = localStorage.getItem('rr_user_name') || localStorage.getItem('rr_user_id') || '';
  var msg = document.getElementById('acct-owner-msg');
  if(!uid){ if(msg){msg.textContent='Not logged in';msg.style.color='#f85149';} return; }
  fetch('/cgi-bin/rocket?claim_node_owner',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({user:uid})
  }).then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){
      if(msg){msg.textContent='✓ You are now the router owner!';msg.style.color='#3fb950';}
      setTimeout(function(){ document.getElementById('acct-owner-wrap').style.display='none'; },2000);
      _nodeOwner = uid;
    } else {
      if(msg){msg.textContent=(d.owner?'Already claimed by @'+d.owner:'Error: '+d.error);msg.style.color='#f85149';}
    }
  }).catch(function(){if(msg){msg.textContent='Network error';msg.style.color='#f85149';}});
}

function acctShowInviteCode(){
  var inp = document.getElementById('acct-inp-invite');
  if(inp && inp.offsetParent !== null){
    fetch('/cgi-bin/rocket?user_invite_code')
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d.ok && d.code){
          inp.value = d.code;
          inp.style.borderColor = '#3fb950';
          var hint = document.getElementById('acct-invite-hint');
          if(hint) hint.textContent = '✓ Invite code filled in above';
        }
      }).catch(function(){});
    return;
  }
  show('account', document.getElementById('tab-account'));
  setTimeout(function(){
    acctRevealCode(document.getElementById('acct-reveal-btn'));
  }, 150);
}

function acctDeletePrompt(){
  var w = document.getElementById('acct-delete-wrap');
  if(!w) return;
  w.style.display = w.style.display === 'block' ? 'none' : 'block';
  var p = document.getElementById('acct-delete-pass');
  if(p && w.style.display === 'block') setTimeout(function(){ p.focus(); }, 50);
}

function acctDeleteConfirm(){
  var tok  = _getUserToken();
  var name = localStorage.getItem('rr_user_name') || '';
  var pass = (document.getElementById('acct-delete-pass')||{}).value || '';
  var btn  = document.getElementById('acct-delete-btn');
  var msg  = document.getElementById('acct-delete-msg');
  if(!tok){ if(msg){msg.textContent='Not logged in'; msg.style.color='#f85149'; msg.style.display='block';} return; }
  if(!pass){ if(msg){msg.textContent='Please enter your password'; msg.style.color='#f85149'; msg.style.display='block';} return; }
  if(btn){ btn.disabled=true; btn.textContent='Deleting…'; }
  if(msg){ msg.textContent=''; msg.style.display='none'; }
  // Pre-cleanup: clear owner file + profile while token still valid
  fetch('/cgi-bin/rocket?user_delete_account', {
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+(tok||'')},
    body:JSON.stringify({token:tok||''})
  }).catch(function(){});
  var SRV = window.location.hostname;
  // Step 1 — start UIAA session
  fetch('http://'+SRV+':6167/_matrix/client/v3/account/deactivate', {
    method:'POST', headers:{'Authorization':'Bearer '+tok,'Content-Type':'application/json'},
    body:JSON.stringify({erase:true})
  }).then(function(r){ return r.json(); })
  .then(function(d){
    // d.session is the UIAA session id
    var session = d.session || (d.flows && d.params && '');
    if(!session && !d.flows){
      // Already deactivated or unexpected response — treat as success
      _finishDelete();
      return;
    }
    // Step 2 — complete with password
    return fetch('http://'+SRV+':6167/_matrix/client/v3/account/deactivate', {
      method:'POST', headers:{'Authorization':'Bearer '+tok,'Content-Type':'application/json'},
      body:JSON.stringify({
        erase:true,
        auth:{type:'m.login.password', identifier:{type:'m.id.user',user:name}, password:pass, session:session}
      })
    }).then(function(r2){ return r2.json(); });
  })
  .then(function(d2){
    if(!d2 || d2.errcode){
      throw new Error(d2 ? (d2.error||d2.errcode) : 'failed');
    }
    _finishDelete();
  })
  .catch(function(e){
    if(btn){ btn.disabled=false; btn.textContent='Yes, delete forever'; }
    if(msg){ msg.textContent='Error: '+(e.message||'delete failed — check password'); msg.style.color='#f85149'; msg.style.display='block'; }
  });
}

function _finishDelete(){
  // Tell CGI to clean up owner file + profile files
  var tok = _getUserToken();
  var uid = localStorage.getItem('rr_user_id') || '';
  fetch('/cgi-bin/rocket?user_delete_account', {
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+(tok||'')},
    body:JSON.stringify({token:tok||'',uid:uid})
  }).catch(function(){});
  localStorage.removeItem('rr_user_token');
  localStorage.removeItem('rr_user_id');
  localStorage.removeItem('rr_user_name');
  localStorage.removeItem('rr_matrix_token');
  var msg = document.getElementById('acct-delete-msg');
  if(msg){ msg.textContent='✓ Account deleted. Reloading…'; msg.style.color='#3fb950'; msg.style.display='block'; }
  setTimeout(function(){ window.location.reload(); }, 1500);
}


var _nmapJobId = null;
var _nmapPollTimer = null;

function _nmapBuildOpts(){
  var opts = '';
  var checks = ['n','v','6','sn','Pn','PS','PE','sS','sT','sU','sA','F','pall','sV','O','ossguess','sC','A','T1','T2','T3','T4','T5'];
  checks.forEach(function(f){
    var el = document.getElementById('nmap-opt-'+f);
    if(el && el.checked) opts += ' -'+(f==='ossguess'?'-osscan-guess':f==='pall'?'p-':f);
  });
  var ports   = ((document.getElementById('nmap-ports')||{}).value||'').trim();
  var decoy   = ((document.getElementById('nmap-decoy')||{}).value||'').trim().replace(/[^a-zA-Z0-9.,: ]/g,'');
  var spoof   = ((document.getElementById('nmap-spoof')||{}).value||'').trim().replace(/[^a-zA-Z0-9.:]/g,'');
  var iface   = ((document.getElementById('nmap-iface')||{}).value||'').trim().replace(/[^a-zA-Z0-9._-]/g,'');
  var proxies = ((document.getElementById('nmap-proxies')||{}).value||'').trim().replace(/[^a-zA-Z0-9./:,@_-]/g,'');
  if(ports)   opts += ' -p '+ports;
  if(decoy)   opts += ' -D '+decoy;
  if(spoof)   opts += ' -S '+spoof;
  if(iface)   opts += ' -e '+iface;
  if(proxies) opts += ' --proxies '+proxies;
  return opts.trim();
}

function nmapScan(){
  var target = (document.getElementById('nmap-target')||{}).value || '192.168.1.0/24';
  var opts   = _nmapBuildOpts();
  var btn    = document.getElementById('nmap-btn');
  var canBtn = document.getElementById('nmap-cancel-btn');
  var out    = document.getElementById('nmap-out');
  if(btn){ btn.disabled=true; btn.textContent='Starting…'; }
  if(canBtn) canBtn.style.display='inline-block';
  if(out){ out.style.display='block'; out.textContent='Running: nmap '+opts+' '+target+'\n\nStarting scan…'; }
  fetch('/cgi-bin/rocket?nmap_start',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({target:target, opts:opts})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.error){ nmapDone('Error: '+d.error); return; }
    _nmapJobId = d.job;
    if(btn) btn.textContent='Scanning…';
    _nmapPollTimer = setInterval(function(){ nmapPoll(); }, 2000);
  })
  .catch(function(e){ nmapDone('Failed to start: '+e.message); });
}

function nmapPoll(){
  if(!_nmapJobId) return;
  fetch('/cgi-bin/rocket?nmap_poll&job='+_nmapJobId)
  .then(function(r){return r.json();})
  .then(function(d){
    var out = document.getElementById('nmap-out');
    if(out && d.output) out.textContent = d.output;
    if(d.done){ nmapDone(d.output); }
  })
  .catch(function(){});
}

function nmapCancel(){
  if(_nmapPollTimer){ clearInterval(_nmapPollTimer); _nmapPollTimer=null; }
  if(_nmapJobId){
    fetch('/cgi-bin/rocket?nmap_cancel&job='+_nmapJobId);
    _nmapJobId=null;
  }
  nmapDone('Scan cancelled.');
}

function nmapDone(output){
  if(_nmapPollTimer){ clearInterval(_nmapPollTimer); _nmapPollTimer=null; }
  _nmapJobId = null;
  var btn    = document.getElementById('nmap-btn');
  var canBtn = document.getElementById('nmap-cancel-btn');
  var out    = document.getElementById('nmap-out');
  if(btn){ btn.disabled=false; btn.innerHTML='&#9654; Run Scan'; }
  if(canBtn) canBtn.style.display='none';
  if(out && output) out.textContent = output;
}


function vnstatLoad(){
  var iface = (document.getElementById('vnstat-iface')||{}).value || 'usb1';
  var setEl = function(id,v){ var e=document.getElementById(id); if(e) e.textContent=v; };
  fetch('/cgi-bin/rocket?vnstat_data&iface='+iface)
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(!d.ok){ setEl('vnstat-hours','Error loading data'); return; }
      setEl('vnstat-today-rx', d.today_rx||'--');
      setEl('vnstat-today-tx', d.today_tx||'--');
      setEl('vnstat-month-rx', d.month_rx||'--');
      setEl('vnstat-month-tx', d.month_tx||'--');
      var h = document.getElementById('vnstat-hours');
      if(h){
        if(!d.hourly||!d.hourly.length){ h.textContent='No hourly data yet -- check back in a few minutes.'; return; }
        var lines = d.hourly.map(function(x){
          return (x.t||'').padEnd(14)+' rx: '+(x.rx||'?').padStart(10)+'  tx: '+(x.tx||'?').padStart(10);
        });
        h.textContent = lines.join('\n');
      }
    })
    .catch(function(){ setEl('vnstat-hours','vnstat not available'); });
}


// ── AI Packet Analyst ─────────────────────────────────────────────────────────
function capAnalyse(){
  var btn = document.getElementById('ai-analyse-btn');
  var out = document.getElementById('ai-out');
  if(!btn||!out) return;
  btn.disabled=true; btn.textContent='🤖 Analysing...';
  out.style.display='block';
  out.style.color='#8b949e';
  out.textContent='Sending capture to AI — this takes a few seconds...';
  fetch('/cgi-bin/rocket?ai_analyse',{method:'POST',headers:{'Content-Type':'application/json'}})
  .then(function(r){ return r.json(); })
  .then(function(d){
    btn.disabled=false; btn.textContent='🤖 Analyse with AI';
    if(d.error){ out.style.color='#f85149'; out.textContent='Error: '+(typeof d.error==='object'?(d.error.message||JSON.stringify(d.error)):d.error); return; }
    var txt = '';
    if(d.content && d.content[0] && d.content[0].text) txt = d.content[0].text;
    else if(d.error) txt = 'Error: '+d.error;
    else txt = JSON.stringify(d);
    out.style.color='#e6edf3';
    out.textContent=txt;
  })
  .catch(function(e){
    btn.disabled=false; btn.textContent='🤖 Analyse with AI';
    out.style.color='#f85149'; out.textContent='Network error: '+e;
  });
}

// ── Packet Capture JS ────────────────────────────────────────────────────────
var _capPollTimer = null;

function capStart(){
  var iface   = (document.getElementById('cap-iface')||{}).value||'br-lan';
  var filter  = ((document.getElementById('cap-filter')||{}).value||'').trim();
  var secs    = parseInt((document.getElementById('cap-duration')||{}).value)||10;
  var btn     = document.getElementById('cap-btn');
  var stopBtn = document.getElementById('cap-stop-btn');
  var statEl  = document.getElementById('cap-status');
  var outEl   = document.getElementById('cap-out');
  var aiBtn   = document.getElementById('ai-analyse-btn');
  if(btn){btn.disabled=true;}
  if(stopBtn){stopBtn.style.display='inline-block';}
  if(aiBtn){aiBtn.style.display='none';}
  if(statEl){statEl.style.display='block';statEl.textContent='Starting capture on '+iface+' for '+secs+'s…';}
  if(outEl){outEl.style.display='none';outEl.textContent='';}
  fetch('/cgi-bin/rocket?tcpdump_capture',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({iface:iface,secs:secs,filter:filter})
  }).then(function(r){return r.json();})
  .then(function(d){
    if(d.error){
      if(statEl){statEl.textContent='Error: '+d.error;}
      if(btn){btn.disabled=false;}
      if(stopBtn){stopBtn.style.display='none';}
      return;
    }
    _capPollTimer=setTimeout(capPoll,1000);
  }).catch(function(e){
    if(statEl){statEl.textContent='Error: '+e.message;}
    if(btn){btn.disabled=false;}
    if(stopBtn){stopBtn.style.display='none';}
  });
}

function capPoll(){
  fetch('/cgi-bin/rocket?tcpdump_poll')
  .then(function(r){return r.json();})
  .then(function(d){
    var statEl=document.getElementById('cap-status');
    if(!d.done){
      if(statEl){statEl.textContent='Capturing… '+d.packets+' packets · '+d.remaining+'s remaining';}
      _capPollTimer=setTimeout(capPoll,1000);
    } else {
      capFinish(d);
    }
  }).catch(function(){_capPollTimer=setTimeout(capPoll,2000);});
}

function capStop(){
  if(_capPollTimer){clearTimeout(_capPollTimer);_capPollTimer=null;}
  fetch('/cgi-bin/rocket?tcpdump_stop')
  .then(function(r){return r.json();})
  .then(function(){capFinish({done:true,output:'',packets:0,stopped:true});})
  .catch(function(){});
}

function capFinish(d){
  if(_capPollTimer){clearTimeout(_capPollTimer);_capPollTimer=null;}
  var btn    =document.getElementById('cap-btn');
  var stopBtn=document.getElementById('cap-stop-btn');
  var statEl =document.getElementById('cap-status');
  var outEl  =document.getElementById('cap-out');
  var aiBtn  =document.getElementById('ai-analyse-btn');
  if(btn){btn.disabled=false;}
  if(stopBtn){stopBtn.style.display='none';}
  if(statEl){statEl.textContent=d.stopped?'Capture stopped':(d.packets||0)+' packets captured'+(d.iface?' on '+d.iface:'');}
  if(d.output&&outEl){outEl.style.display='block';outEl.textContent=d.output;if(aiBtn)aiBtn.style.display='inline-block';}
}

// Show AI button once capture completes successfully
(function patchCapStart(){
  var orig = window.capStart;
  // patch after DOM ready — override in place
  window.capStart = function(){
    var out = document.getElementById('cap-out');
    var aiBtn = document.getElementById('ai-analyse-btn');
    var aiOut = document.getElementById('ai-out');
    if(aiBtn){ aiBtn.style.display='none'; }
    if(aiOut){ aiOut.style.display='none'; aiOut.textContent=''; }
    // call original
    if(typeof orig==='function') orig();
    // watch for output to appear, then show AI button
    var poll = setInterval(function(){
      if(!out || out.style.display==='none') return;
      if(out.textContent && out.textContent.length > 20){
        clearInterval(poll);
        if(aiBtn) aiBtn.style.display='inline-block';
      }
    }, 500);
  };
})();

// ── Device Names & Vendor Lookup (shared helpers) ──────────────────────────────
var _deviceNames = {};
var _ouiCache = {};

function _loadDeviceNames(){
  fetch('/cgi-bin/rocket?device_names')
  .then(function(r){ return r.json(); })
  .then(function(d){ _deviceNames = (d && d.names) || {}; })
  .catch(function(){});
}

function _getDevName(mac, fallback){
  var m=(mac||'').toLowerCase();
  return (m && _deviceNames[m]) || fallback || '';
}

function _ouiLookup(mac){
  var m=(mac||'').toLowerCase();
  return m ? (_ouiCache[m] || '') : '';
}

function _fetchVendor(mac, elId, cb){
  var m=(mac||'').toLowerCase();
  if(!m || _ouiCache[m]!==undefined) return;
  fetch('/cgi-bin/rocket?oui_vendor&mac='+encodeURIComponent(m))
  .then(function(r){ return r.json(); })
  .then(function(d){
    var v=(d && d.vendor) || '';
    _ouiCache[m]=v;
    if(v){
      if(elId){
        var el=document.getElementById(elId);
        if(el) el.textContent=v;
      }
      if(typeof cb==='function') cb(v);
    }
  })
  .catch(function(){});
}

// ── WiFi Device Scheduler ─────────────────────────────────────────────────────
function loadWifiDevices(){
  var rb=document.getElementById('wifi-refresh-btn');
  if(rb){rb.textContent='↻ Loading…';rb.disabled=true;}
  fetch('/cgi-bin/rocket?wifi_devices')
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(rb){rb.textContent='↻ Refresh';rb.disabled=false;}
    var list=document.getElementById('wifi-dev-list');
    if(!list) return;
    if(!d.devices||!d.devices.length){
      list.innerHTML='<div style="color:#484f58;font-size:.82em;font-style:italic;padding:10px 0">No devices found — connect a device and try again.</div>';
      return;
    }
    list.innerHTML=d.devices.map(function(dev){
      var paused=dev.paused==='true'||dev.paused===true;
      var schedOn=dev.sched_on==='1'||dev.sched_on===1;
      var schedInfo=dev.from&&dev.until?'<span style="font-size:.72em;color:#484f58;margin-left:6px">'+dev.from+'–'+dev.until+(schedOn?' ✓':' off')+'</span>':'';
      var mfrNow=dev.vendor||_ouiLookup(dev.mac||'');
      return '<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:'+( paused?'rgba(248,81,73,.05)':'#0d1117')
        +';border:1px solid '+(paused?'rgba(248,81,73,.2)':'#21262d')+';border-radius:10px;flex-wrap:wrap">'
        +'<div style="flex:1;min-width:120px">'
        +'<div style="font-size:.88em;font-weight:600;color:'+(paused?'#f85149':'#e6edf3')+'">'
        +'<span id="wdev-name-'+dev.mac+'" data-devmac="'+dev.mac+'" onclick="wdevRename(this,\''+dev.mac+'\')" style="cursor:pointer;border-bottom:1px dashed rgba(230,237,243,.15)" title="Click to rename">'+dev.name+'</span>'
        +(paused?' <span style="font-size:.72em;background:rgba(248,81,73,.12);color:#f85149;border-radius:4px;padding:1px 6px">PAUSED</span>':'')
        +'</div>'
        +'<div style="font-size:.75em;color:#484f58">'+dev.ip+' · '+dev.mac+schedInfo+'</div>'
        +'<div id="wdev-vendor-'+dev.mac+'" style="font-size:.72em;color:#58a6ff;min-height:.85em">'+(mfrNow||'')+'</div>'
        +'</div>'
        +'<button onclick="wifiPauseToggle(\''+dev.mac+'\',\''+dev.name+'\','+paused+')" '
        +'style="background:'+(paused?'rgba(63,185,80,.12)':'rgba(248,81,73,.12)')+';border:1px solid '
        +(paused?'rgba(63,185,80,.35)':'rgba(248,81,73,.35)')+';color:'+(paused?'#3fb950':'#f85149')
        +';border-radius:7px;padding:6px 12px;font-size:.78em;font-weight:600;cursor:pointer">'
        +(paused?'▶ Resume':'⏸ Pause')+'</button>'
        +'<button onclick="wifiOpenSchedule(\''+dev.mac+'\',\''+dev.name+'\',\''+dev.from+'\',\''+dev.until+'\',\''+dev.sched_on+'\')" '
        +'style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:7px;padding:6px 12px;font-size:.78em;font-weight:600;cursor:pointer">⏰ Schedule</button>'
        +'</div>';
    }).join('');
    // Vendor lookup — server vendor first, local OUI second, API only for anything still unknown
    d.devices.forEach(function(dev,i){
      if(!dev.mac||dev.vendor||_ouiLookup(dev.mac)) return;
      setTimeout(function(){ _fetchVendor(dev.mac,'wdev-vendor-'+dev.mac,null); },i*250);
    });
  })
  .catch(function(){
    var rb=document.getElementById('wifi-refresh-btn');
    if(rb){rb.textContent='↻ Refresh';rb.disabled=false;}
    var list=document.getElementById('wifi-dev-list');
    if(list) list.innerHTML='<div style="color:#f85149;font-size:.82em">Error loading devices — check router connection.</div>';
  });
}

function wifiPauseToggle(mac, name, currently_paused){
  fetch('/cgi-bin/rocket?wifi_pause_now', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({mac:mac, pause: !currently_paused})
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(d.ok) loadWifiDevices();
    else alert('Error: '+(d.error||'unknown'));
  })
  .catch(function(e){ alert('Error: '+e); });
}

function wifiOpenSchedule(mac, name, from, until, sched_on){
  var modal=document.getElementById('wifi-sched-modal');
  var nameEl=document.getElementById('ws-name');
  var fromEl=document.getElementById('ws-from');
  var untilEl=document.getElementById('ws-until');
  var enabledEl=document.getElementById('ws-enabled');
  var macEl=document.getElementById('ws-mac');
  if(!modal) return;
  if(nameEl) nameEl.value=name||'';
  if(fromEl) fromEl.value=from||'22:00';
  if(untilEl) untilEl.value=until||'07:00';
  if(enabledEl) enabledEl.checked=(sched_on==='1'||sched_on===1||sched_on===true);
  if(macEl) macEl.value=mac||'';
  wsUpdateToggleUI();
  modal.style.display='flex';
  modal.style.pointerEvents='auto';
}

function wsClose(){
  var modal=document.getElementById('wifi-sched-modal');
  if(modal){modal.style.display='none';modal.style.pointerEvents='none';}
}

function wsToggleEnabled(){
  var cb=document.getElementById('ws-enabled');
  if(cb) cb.checked=!cb.checked;
  wsUpdateToggleUI();
}

function wsUpdateToggleUI(){
  var cb=document.getElementById('ws-enabled');
  var track=document.getElementById('ws-toggle-track');
  var thumb=document.getElementById('ws-toggle-thumb');
  var lbl=document.getElementById('ws-enabled-label');
  var on=cb&&cb.checked;
  if(track) track.style.background=on?'#238636':'#30363d';
  if(thumb) thumb.style.left=on?'20px':'3px';
  if(lbl) lbl.textContent=on?'Schedule enabled':'Schedule disabled';
}

function wsSave(){
  var mac=(document.getElementById('ws-mac')||{}).value||'';
  var name=(document.getElementById('ws-name')||{}).value||'Device';
  var from=(document.getElementById('ws-from')||{}).value||'22:00';
  var until=(document.getElementById('ws-until')||{}).value||'07:00';
  var enabled=(document.getElementById('ws-enabled')||{}).checked?1:0;
  if(!mac){wsClose();return;}
  fetch('/cgi-bin/rocket?wifi_schedule_set',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({mac:mac,name:name,from:from,until:until,enabled:enabled})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    wsClose();
    if(d.ok) loadWifiDevices();
    else alert('Error saving schedule: '+(d.error||'unknown'));
  })
  .catch(function(e){wsClose();alert('Error: '+e);});
}

function ouiUpdate(callerBtn){
  var btn=document.getElementById('oui-update-btn');
  var st=document.getElementById('oui-update-status');
  var xBtn=(callerBtn&&callerBtn!==btn)?callerBtn:null;
  if(btn){btn.disabled=true;btn.textContent='⏳ Identifying…';}
  if(xBtn){xBtn.disabled=true;xBtn.textContent='⏳ Identifying…';}
  if(st){st.textContent='Fetching the official IEEE MAC vendor list — takes about 30 seconds…';st.style.display='block';st.style.color='#f0a500';}
  var _ouiAbort=null, _ouiTimedOut=false;
  try{ _ouiAbort=new AbortController(); }catch(e){}
  var _ouiTimer=setTimeout(function(){ _ouiTimedOut=true; if(_ouiAbort) _ouiAbort.abort(); },45000);
  fetch('/cgi-bin/rocket?oui_update', _ouiAbort?{signal:_ouiAbort.signal}:{})
  .then(function(r){clearTimeout(_ouiTimer);return r.json();})
  .then(function(d){
    if(btn){btn.disabled=false;btn.textContent='🔍 Identify Devices';}
    if(xBtn){xBtn.disabled=false;xBtn.textContent='🔍 Identify';}
    if(d.ok){
      if(st){st.textContent='✓ '+d.entries+' vendors loaded — refreshing device list…';st.style.color='#3fb950';}
      setTimeout(function(){
        loadWifiDevices();
        if(st) setTimeout(function(){st.style.display='none';},4000);
      },800);
    } else {
      if(st){st.textContent='✗ '+( d.error||'Update failed');st.style.color='#f85149';}
    }
  })
  .catch(function(e){
    clearTimeout(_ouiTimer);
    if(btn){btn.disabled=false;btn.textContent='🔍 Identify Devices';}
    if(xBtn){xBtn.disabled=false;xBtn.textContent='🔍 Identify';}
    if(st){
      st.textContent=_ouiTimedOut?'✗ Timed out waiting on the router — try again in a moment.':'✗ Could not reach router — check connection';
      st.style.color='#f85149';
    }
  });
}

function bandwidthInheritLoad(){
  var box=document.getElementById('bw-inherit-content');
  if(box){box.textContent='Loading…';box.style.color='#8b949e';}
  fetch('/cgi-bin/rocket?bandwidth_inherit_get')
  .then(function(r){return r.json();})
  .then(function(d){
    _bwInheritDevices=(d && d.devices)||[];
    var hier=(d && d.hierarchy)||[];
    var byMac={};
    _bwInheritDevices.forEach(function(dv){byMac[dv.mac]=dv;});
    var order=hier.filter(function(m){return byMac[m];});
    _bwInheritDevices.forEach(function(dv){ if(order.indexOf(dv.mac)===-1) order.push(dv.mac); });
    _bwInheritOrder=order;
    _bwInheritRender();
  })
  .catch(function(){
    if(box){box.textContent='✗ Could not load devices — check router connection.';box.style.color='#f85149';}
  });
}

var _bwInheritDevices=[];
var _bwInheritOrder=[];

function _bwInheritRender(){
  var box=document.getElementById('bw-inherit-content');
  if(!box) return;
  if(!_bwInheritOrder.length){ box.textContent='No devices found.'; box.style.color='#8b949e'; return; }
  box.style.color='';
  var byMac={};
  _bwInheritDevices.forEach(function(dv){byMac[dv.mac]=dv;});
  var html='<div style="font-size:.78em;color:#8b949e;margin-bottom:8px">Highest priority at top — that device keeps its bandwidth first. Use the arrows to reorder, then click Save.</div>';
  _bwInheritOrder.forEach(function(mac,i){
    var dv=byMac[mac]||{ip:'',name:'',online:0};
    var label=_esc(dv.name||dv.ip||mac);
    html+='<div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:#0d1117;border:1px solid #21262d;border-radius:6px;margin-bottom:4px">'
      +'<span style="color:#484f58;font-size:.75em;width:18px">'+(i+1)+'.</span>'
      +'<span style="flex:1;color:'+(dv.online?'#e6edf3':'#6e7681')+'">'+label+(dv.online?'':' (offline)')+'</span>'
      +'<span style="color:#484f58;font-size:.72em">'+_esc(dv.ip||'')+'</span>'
      +'<button onclick="_bwInheritMove('+i+',-1)" style="background:none;border:1px solid #30363d;color:#8b949e;border-radius:4px;padding:2px 8px;cursor:pointer">↑</button>'
      +'<button onclick="_bwInheritMove('+i+',1)" style="background:none;border:1px solid #30363d;color:#8b949e;border-radius:4px;padding:2px 8px;cursor:pointer">↓</button>'
      +'</div>';
  });
  box.innerHTML=html;
}

function _bwInheritMove(i,dir){
  var j=i+dir;
  if(j<0||j>=_bwInheritOrder.length) return;
  var tmp=_bwInheritOrder[i]; _bwInheritOrder[i]=_bwInheritOrder[j]; _bwInheritOrder[j]=tmp;
  _bwInheritRender();
}

function bandwidthInheritSave(){
  if(!_bwInheritOrder.length){ alert('Click Load first.'); return; }
  fetch('/cgi-bin/rocket?bandwidth_inherit_set',{method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(_bwInheritOrder)
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(d && d.ok){ alert('✓ Priority order saved.'); }
    else { alert('Failed to save: '+((d&&d.error)||'unknown error')); }
  })
  .catch(function(){ alert('Error contacting router.'); });
}

function deviceExport(){
  fetch('/cgi-bin/rocket?device_export')
  .then(function(r){return r.text();})
  .then(function(csv){
    var blob=new Blob([csv],{type:'text/csv'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='rocket-devices-'+new Date().toISOString().slice(0,10)+'.csv';
    document.body.appendChild(a);a.click();
    setTimeout(function(){document.body.removeChild(a);URL.revokeObjectURL(a.href);},1000);
  })
  .catch(function(){alert('Export failed — check router connection');});
}

function deviceImport(inp){
  var file=inp.files&&inp.files[0];
  if(!file)return;
  var reader=new FileReader();
  reader.onload=function(e){
    var lines=e.target.result.replace(/\r/g,'').split('\n');
    var tasks=[];
    for(var i=1;i<lines.length;i++){
      var line=lines[i].trim(); if(!line)continue;
      var parts=[]; var cur=''; var inQ=false;
      for(var c=0;c<line.length;c++){
        if(line[c]==='"'){inQ=!inQ;}
        else if(line[c]===','&&!inQ){parts.push(cur);cur='';}
        else cur+=line[c];
      }
      parts.push(cur);
      var mac=(parts[0]||'').toLowerCase().trim();
      var name=(parts[2]||'').trim();
      if(!mac||mac.length<11||!name)continue;
      tasks.push({mac:mac,name:name});
    }
    if(!tasks.length){alert('No named devices found in file');return;}
    var done=0;
    tasks.forEach(function(t){
      fetch('/cgi-bin/rocket?device_rename',{method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({mac:t.mac,name:t.name})
      }).then(function(){
        done++;
        if(done===tasks.length){
          inp.value='';
          _loadDeviceNames();
          setTimeout(loadWifiDevices,600);
          alert('✓ Restored names for '+done+' devices!');
        }
      });
    });
  };
  reader.readAsText(file);
}

function wdevRename(el,mac,topoMode){
  var cur=el.textContent;
  var inp=document.createElement('input');
  inp.value=cur==='Device'?'':cur;
  inp.placeholder='e.g. Nest Thermostat';
  inp.style.cssText='background:#161b22;border:1px solid #58a6ff;border-radius:4px;color:#e6edf3;font-size:.88em;font-weight:600;padding:2px 7px;width:180px;outline:none;font-family:inherit';
  el.replaceWith(inp);
  inp.focus();inp.select();
  var done=false;
  function _mkSpan(name){
    var s=document.createElement('span');
    s.id='wdev-name-'+mac; s.textContent=name;
    s.onclick=function(){wdevRename(this,mac);};
    s.style.cssText='cursor:pointer;border-bottom:1px dashed rgba(230,237,243,.15)';
    s.title='Click to rename'; return s;
  }
  function save(){
    if(done)return; done=true;
    var name=inp.value.trim()||cur;
    inp.replaceWith(_mkSpan(name));
    if(name!==cur){
      _deviceNames[mac]=name;
      // Sync all same-device name elements across the whole page
      document.querySelectorAll('[data-devmac="'+mac+'"]').forEach(function(s){s.textContent=name;});
      // Update topo SVG label if visible
      var topoLbl=document.getElementById('topo-lbl-'+mac.replace(/:/g,'-').replace(/\./g,'-'));
      if(topoLbl) topoLbl.textContent=name;
      // Update topo panel name if visible
      document.querySelectorAll('[id^="topo-panel-name-"]').forEach(function(s){if(s._devmac===mac)s.textContent=name;});
      fetch('/cgi-bin/rocket?device_rename',{method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({mac:mac,name:name})}).catch(function(){});
    }
  }
  function cancel(){if(done)return;done=true;inp.replaceWith(_mkSpan(cur));}
  inp.addEventListener('keydown',function(e){if(e.key==='Enter')save();if(e.key==='Escape')cancel();});
  inp.addEventListener('blur',save);
}
// Wire up refresh button and load on Overview tab open
(function(){
  _loadDeviceNames();
  var rb=document.getElementById('wifi-refresh-btn');
  if(rb) rb.addEventListener('click',loadWifiDevices);
  // Close modal on backdrop click
  var modal=document.getElementById('wifi-sched-modal');
  if(modal) modal.addEventListener('click',function(e){if(e.target===modal) wsClose();});
  // Load devices when Overview tab is opened
  var origShow=window.show;
  window.show=function(tab,el){
    if(typeof origShow==='function') origShow(tab,el);
    if(tab==='nov') setTimeout(loadWifiDevices,100);
    if(tab==='exp') setTimeout(topoInit,100);
  };
  // Auto-load if Overview is default active tab
  if(document.getElementById('t-nov')&&document.getElementById('t-nov').classList.contains('on')){
    setTimeout(loadWifiDevices,300);
  }
})();

// ── Live Network Topology Map ────────────────────────────────────────────────
var _topoTimer = null;
var _topoSim   = null;
var _topoInited= false;

function topoLoadD3(cb){
  if(window.d3){cb();return;}
  var urls=[
    '/d3.min.js',
    'https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js'
  ];
  function tryLoad(i){
    if(i>=urls.length){
      var el=document.getElementById('topo-loading');
      if(el){el.style.display='flex';el.textContent='D3 failed — run: wget -O /www/d3.min.js https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js';}
      var st=document.getElementById('topo-status');
      if(st){st.textContent='D3 load failed';st.style.color='#f85149';}
      return;
    }
    var s=document.createElement('script');
    s.src=urls[i];
    s.onload=function(){if(window.d3){cb();}else{tryLoad(i+1);}};
    s.onerror=function(){tryLoad(i+1);};
    document.head.appendChild(s);
  }
  tryLoad(0);
}

function topoInit(){
  if(_topoInited) return;
  _topoInited=true;
  var dot=document.getElementById('topo-live-dot');
  if(dot){dot.style.background='#f0a500';dot.style.boxShadow='0 0 6px #f0a500';}
  // Wait for tab to fully paint before measuring container width
  setTimeout(function(){
    topoLoadD3(function(){
      topoFetch();
      clearInterval(_topoTimer);
      _topoTimer=setInterval(topoFetch,5000);
    });
  },250);
}

function topoFetch(){
  fetch('/cgi-bin/rocket?net_topology')
  .then(function(r){return r.json();})
  .then(function(data){
    var dot=document.getElementById('topo-live-dot');
    var st=document.getElementById('topo-status');
    var ld=document.getElementById('topo-loading');
    if(dot){dot.style.background='#3fb950';dot.style.boxShadow='0 0 6px #3fb950';}
    var devCount=(data.nodes||[]).filter(function(n){return n.type==='device';}).length;
    var activeDevs=(data.nodes||[]).filter(function(n){return n.type==='device'&&(n.conns||0)>0;}).length;
    if(st){st.style.color='#3fb950';st.textContent=devCount+' device'+(devCount!==1?'s':'')+' · '+activeDevs+' active';}
    if(ld){ld.style.display='none';}
    topoRender(data);
  })
  .catch(function(){
    var dot=document.getElementById('topo-live-dot');
    var st=document.getElementById('topo-status');
    if(dot){dot.style.background='#f85149';dot.style.boxShadow='none';}
    if(st){st.textContent='Error';st.style.color='#f85149';}
  });
}

window.topoRefresh=function(){
  var st=document.getElementById('topo-status');
  if(st){st.textContent='Refreshing…';st.style.color='#58a6ff';}
  topoFetch();
};

function topoRender(data){
  if(!window.d3) return;
  var container=document.getElementById('topo-canvas');
  if(!container) return;
  var W=container.getBoundingClientRect().width||container.offsetWidth||680, H=520;
  if(W<100) W=680;
  d3.select('#topo-canvas svg').remove();
  var nodes=JSON.parse(JSON.stringify(data.nodes||[]));
  var links=JSON.parse(JSON.stringify(data.links||[]));
  if(!nodes.length){
    nodes=[{id:'router',label:'Router',type:'router',ip:data.router_ip||'192.168.1.1'},{id:'internet',label:'Internet',type:'internet'}];
  }
  nodes.forEach(function(n){
    if(n.type==='internet'){n.fx=W*0.82;n.fy=H/2;}
    if(n.type==='router'){n.fx=W*0.38;n.fy=H/2;}
  });
  var svg=d3.select('#topo-canvas').append('svg')
    .attr('width',W).attr('height',H)
    .attr('viewBox','0 0 '+W+' '+H)
    .style('max-width','100%').style('background','#010409').style('border-radius','10px');
  var defs=svg.append('defs');
  var filt=defs.append('filter').attr('id','t-glow').attr('x','-60%').attr('y','-60%').attr('width','220%').attr('height','220%');
  filt.append('feGaussianBlur').attr('stdDeviation','4').attr('result','blur');
  var fm=filt.append('feMerge');
  fm.append('feMergeNode').attr('in','blur');
  fm.append('feMergeNode').attr('in','SourceGraphic');
  var filt2=defs.append('filter').attr('id','t-glow-sm').attr('x','-40%').attr('y','-40%').attr('width','180%').attr('height','180%');
  filt2.append('feGaussianBlur').attr('stdDeviation','2').attr('result','blur2');
  var fm2=filt2.append('feMerge');
  fm2.append('feMergeNode').attr('in','blur2');
  fm2.append('feMergeNode').attr('in','SourceGraphic');
  defs.append('marker').attr('id','t-arrow').attr('viewBox','0 -4 8 8').attr('refX',8).attr('refY',0)
    .attr('markerWidth',6).attr('markerHeight',6).attr('orient','auto')
    .append('path').attr('d','M0,-4L8,0L0,4').attr('fill','#58a6ff').attr('opacity',0.6);
  // Pulse rings for router
  [48,36].forEach(function(r){
    svg.append('circle').attr('cx',W*0.38).attr('cy',H/2).attr('r',r)
      .attr('fill','none').attr('stroke','#f0a500').attr('stroke-width',1).attr('opacity',0.12);
  });
  var linkG=svg.append('g');
  var linkSel=linkG.selectAll('line').data(links).enter().append('line')
    .attr('stroke',function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'?'#58a6ff':'#21262d';
    })
    .attr('stroke-width',function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'?Math.min(Math.log((d.value||1)+1)*2+1,7):1.5;
    })
    .attr('stroke-opacity',function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'?0.65:0.3;
    })
    .attr('stroke-dasharray',function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'?'7 4':null;
    })
    .attr('marker-end',function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'?'url(#t-arrow)':null;
    });
  var edgeLabelSel=svg.append('g').selectAll('text')
    .data(links.filter(function(d){
      var tid=typeof d.target==='object'?d.target.id:d.target;
      return tid==='internet'&&(d.value||0)>0;
    })).enter().append('text')
    .attr('font-size','9px').attr('fill','#58a6ff').attr('text-anchor','middle').attr('opacity',0.8);
  var nodeG=svg.append('g');
  var nodeSel=nodeG.selectAll('g').data(nodes).enter().append('g').style('cursor','grab')
    .call(d3.drag()
      .on('start',function(event,d){if(!event.active)sim.alphaTarget(0.3).restart();d.fx=d.x;d.fy=d.y;})
      .on('drag',function(event,d){d.fx=event.x;d.fy=event.y;})
      .on('end',function(event,d){if(!event.active)sim.alphaTarget(0);if(d.type==='device'){d.fx=null;d.fy=null;}})
    );
  nodeSel.filter(function(d){return d.type==='internet';}).append('circle')
    .attr('r',32).attr('fill','rgba(88,166,255,0.05)').attr('stroke','#58a6ff').attr('stroke-width',1.5).attr('stroke-dasharray','4 3');
  nodeSel.filter(function(d){return d.type==='router';}).append('circle')
    .attr('r',30).attr('fill','rgba(240,165,0,0.07)').attr('stroke','rgba(240,165,0,0.4)').attr('stroke-width',1.5).attr('filter','url(#t-glow)');
  nodeSel.append('circle')
    .attr('r',function(d){
      if(d.type==='router') return 22;
      if(d.type==='internet') return 20;
      return 11+Math.min(Math.sqrt((d.conns||0))*2,10);
    })
    .attr('fill',function(d){
      if(d.type==='router') return '#271a00';
      if(d.type==='internet') return '#0c1e3d';
      return (d.conns||0)>0?'#0d1a0d':'#0d1117';
    })
    .attr('stroke',function(d){
      if(d.type==='router') return '#f0a500';
      if(d.type==='internet') return '#58a6ff';
      return (d.conns||0)>0?'#3fb950':'#30363d';
    })
    .attr('stroke-width',2)
    .attr('filter',function(d){
      if(d.type==='router') return 'url(#t-glow)';
      if((d.conns||0)>0) return 'url(#t-glow-sm)';
      return null;
    });
  nodeSel.append('text').attr('text-anchor','middle').attr('dominant-baseline','central')
    .attr('font-size',function(d){return d.type==='router'?'16px':d.type==='internet'?'14px':'0px';})
    .attr('pointer-events','none')
    .text(function(d){return d.type==='router'?'🚀':d.type==='internet'?'🌐':'';});
  nodeSel.filter(function(d){return d.type==='device'&&(d.conns||0)>0;})
    .append('text').attr('text-anchor','middle').attr('dominant-baseline','central')
    .attr('font-size','9px').attr('font-weight','700').attr('fill','#3fb950').attr('pointer-events','none')
    .text(function(d){return d.conns;});
  nodeSel.append('text').attr('text-anchor','middle')
    .attr('y',function(d){return d.type==='router'?36:d.type==='internet'?34:26;})
    .attr('font-size','10px')
    .attr('fill',function(d){
      if(d.type==='router') return '#f0a500';
      if(d.type==='internet') return '#58a6ff';
      return (d.conns||0)>0?'#3fb950':'#8b949e';
    })
    .attr('font-weight',function(d){return (d.conns||0)>0?'600':'400';})
    .attr('pointer-events','none')
    .attr('id',function(d){return d.type==='device'?'topo-lbl-'+d.id.replace(/\./g,'-'):null;})
    .text(function(d){
      if(d.type==='router') return 'Router';
      if(d.type==='internet') return 'Internet';
      return _getDevName(d.mac, d.label)||_ouiLookup(d.mac||'')||d.ip;
    });
  nodeSel.filter(function(d){return d.type==='device';}).append('text')
    .attr('text-anchor','middle').attr('y',38).attr('font-size','8px').attr('fill','#484f58').attr('pointer-events','none')
    .text(function(d){return d.ip;});
  nodeSel.filter(function(d){return d.type==='device';}).append('text')
    .attr('text-anchor','middle').attr('y',48).attr('font-size','7.5px').attr('fill','#30363d').attr('pointer-events','none')
    .attr('id',function(d){return 'topo-mfr-'+d.id.replace(/\./g,'-');})
    .text(function(d){
      var mfr=_ouiLookup(d.mac||'');
      return (mfr&&d.label)?mfr:'';
    });
  var sim=d3.forceSimulation(nodes)
    .force('link',d3.forceLink(links).id(function(d){return d.id;})
      .distance(function(d){var tid=typeof d.target==='object'?d.target.id:d.target;return tid==='internet'?220:110;})
      .strength(0.4))
    .force('charge',d3.forceManyBody().strength(-280))
    .force('collide',d3.forceCollide(50))
    .on('tick',function(){
      linkSel
        .attr('x1',function(d){return d.source.x;})
        .attr('y1',function(d){return d.source.y;})
        .attr('x2',function(d){
          var tid=typeof d.target==='object'?d.target.id:d.target;
          if(tid!=='internet') return d.target.x;
          var dx=d.target.x-d.source.x,dy=d.target.y-d.source.y,dist=Math.sqrt(dx*dx+dy*dy)||1;
          return d.target.x-dx/dist*24;
        })
        .attr('y2',function(d){
          var tid=typeof d.target==='object'?d.target.id:d.target;
          if(tid!=='internet') return d.target.y;
          var dx=d.target.x-d.source.x,dy=d.target.y-d.source.y,dist=Math.sqrt(dx*dx+dy*dy)||1;
          return d.target.y-dy/dist*24;
        });
      nodeSel.attr('transform',function(d){
        d.x=Math.max(40,Math.min(W-40,d.x));
        d.y=Math.max(40,Math.min(H-40,d.y));
        return 'translate('+d.x+','+d.y+')';
      });
      edgeLabelSel
        .attr('x',function(d){return (d.source.x+d.target.x)/2;})
        .attr('y',function(d){return (d.source.y+d.target.y)/2-6;})
        .text(function(d){return d.value+' conn'+(d.value!==1?'s':'');});
    });
  _topoSim=sim;
  // Animated dash offset
  var _dashOff=0;
  (function animDash(){
    _dashOff-=1;
    linkG.selectAll('line[stroke-dasharray]').attr('stroke-dashoffset',_dashOff);
    requestAnimationFrame(animDash);
  })();
  // Tooltip
  var _tip=document.getElementById('topo-tip');
  if(!_tip){
    _tip=document.createElement('div');
    _tip.id='topo-tip';
    _tip.style.cssText='position:fixed;background:#161b22;border:1px solid #30363d;border-radius:8px;padding:9px 14px;font-size:.78em;color:#e6edf3;pointer-events:none;z-index:9999;display:none;line-height:1.8;max-width:220px';
    document.body.appendChild(_tip);
  }
  nodeSel
    .on('mouseover',function(event,d){
      var html='';
      if(d.type==='router') html='<strong style="color:#f0a500">🚀 Router</strong><br>IP: '+d.ip+'<br>All traffic passes here';
      else if(d.type==='internet') html='<strong style="color:#58a6ff">🌐 Internet</strong><br>External traffic gateway';
      else{
        var cc=d.conns>0?'#3fb950':'#484f58';
        html='<strong style="color:#e6edf3">'+d.label+'</strong><br>'
          +'IP: <span style="color:#8b949e">'+d.ip+'</span><br>'
          +'MAC: <span style="color:#484f58;font-size:.9em">'+(d.mac||'unknown')+'</span><br>'
          +'Active connections: <span style="color:'+cc+';font-weight:700">'+(d.conns||0)+'</span>';
      }
      _tip.innerHTML=html;_tip.style.display='block';
      _tip.style.left=(event.clientX+16)+'px';_tip.style.top=(event.clientY-8)+'px';
    })
    .on('mousemove',function(event){_tip.style.left=(event.clientX+16)+'px';_tip.style.top=(event.clientY-8)+'px';})
    .on('mouseout',function(){_tip.style.display='none';});
  // Update tooltip to include manufacturer
  nodeSel.filter(function(d){return d.type==='device';})
    .on('mouseover',function(event,d){
      var mfr=_ouiLookup(d.mac||'')||(_ouiCache[d.mac]||'');
      var dispName=d.label||(mfr?mfr+' device':d.ip);
      var cc=d.conns>0?'#3fb950':'#484f58';
      var html='<strong style="color:#e6edf3">'+escH(dispName)+'</strong>'
        +(mfr&&d.label?'<br><span style="color:#484f58;font-size:.9em">'+escH(mfr)+'</span>':'')
        +'<br>IP: <span style="color:#8b949e">'+escH(d.ip)+'</span>'
        +'<br>MAC: <span style="color:#484f58;font-size:.9em">'+(d.mac||'unknown')+'</span>'
        +'<br>Active connections: <span style="color:'+cc+';font-weight:700">'+(d.conns||0)+'</span>'
        +'<br><span style="color:#58a6ff;font-size:.88em">Click to scan ports</span>';
      _tip.innerHTML=html;_tip.style.display='block';
      _tip.style.left=(event.clientX+16)+'px';_tip.style.top=(event.clientY-8)+'px';
    });
  // Click device node → port scan panel below map
  nodeSel.filter(function(d){return d.type==='device';}).style('cursor','crosshair')
    .on('click',function(event,d){
      event.stopPropagation();
      _tip.style.display='none';
      var canvas=document.getElementById('topo-canvas');
      var panel=document.getElementById('topo-port-panel');
      if(!panel){
        panel=document.createElement('div');
        panel.id='topo-port-panel';
        panel.style.cssText='background:#0d1117;border:1px solid #30363d;border-radius:10px;padding:12px 16px;margin-top:10px';
        canvas.parentNode.insertBefore(panel,canvas.nextSibling);
      }
      var mfr=_ouiLookup(d.mac||'')||(_ouiCache[d.mac]||'');
      var dispName=_getDevName(d.mac,d.label||(mfr?mfr+' device':d.ip));
      var renameBtn=d.mac?'<button onclick="wdevRename(document.getElementById(\'topo-lbl-'+d.id.replace(/\./g,'-')+'\'),\''+d.mac+'\',true)" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:5px;padding:2px 8px;font-size:.75em;cursor:pointer;margin-left:6px">✏️ Rename</button>':'';
      panel.innerHTML='<div style="display:flex;align-items:center;gap:6px;margin-bottom:8px"><span style="font-size:.85em;font-weight:600;color:#e6edf3" id="topo-panel-name-'+escH(d.ip)+'">'+escH(dispName)+'</span>'+renameBtn+'</div>'
        +'<span style="font-size:.8em;color:#58a6ff">🔍 Scanning ports on '+escH(d.ip)+'…</span>';
      if(_bwPortCache[d.ip]){_bwRenderPorts(d.ip,_bwPortCache[d.ip],panel);return;}
      fetch('/cgi-bin/rocket?device_ports&ip='+encodeURIComponent(d.ip))
      .then(function(r){return r.json();})
      .then(function(res){_bwPortCache[d.ip]=res.ports||[];_bwRenderPorts(d.ip,_bwPortCache[d.ip],panel);})
      .catch(function(){panel.innerHTML='<span style="font-size:.8em;color:#f85149">Scan failed — is the device online?</span>';});
    });
  // Live vendor fetch for nodes with unknown manufacturer
  nodes.forEach(function(n,i){
    if(n.type!=='device') return;
    var mfr=_ouiLookup(n.mac||'');
    if(!mfr&&n.mac){
      setTimeout(function(){
        _fetchVendor(n.mac,null,function(v){
          if(!v) return;
          var lblEl=document.getElementById('topo-lbl-'+n.id.replace(/\./g,'-'));
          var mfrEl=document.getElementById('topo-mfr-'+n.id.replace(/\./g,'-'));
          if(lblEl&&!n.label) lblEl.textContent=v+' device';
          if(mfrEl&&n.label) mfrEl.textContent=v;
        });
      },i*300);
    }
  });
}

// ── BGP Route Tracer / World Map ─────────────────────────────────────────────
var _bgpLeafletLoaded = false;

function bgpLoadLeaflet(cb){
  if(window.L){cb();return;}
  // Load Leaflet CSS
  var lnk=document.createElement('link');
  lnk.rel='stylesheet';
  lnk.href='https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
  document.head.appendChild(lnk);
  // Load Leaflet JS
  var s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
  s.onload=cb;
  s.onerror=function(){
    var st=document.getElementById('bgp-status');
    if(st){st.textContent='Leaflet failed to load';st.style.color='#f85149';}
  };
  document.head.appendChild(s);
}

var _bgpMap = null;
var _bgpMapLayers = [];

function bgpTrace(){
  var target=(document.getElementById('bgp-target')||{}).value||'';
  target=target.trim().replace(/^https?:\/\//,'').replace(/\/.*/,'');
  if(!target) return;
  var btn=document.getElementById('bgp-btn');
  var st=document.getElementById('bgp-status');
  var mapDiv=document.getElementById('bgp-map');
  var hopsDiv=document.getElementById('bgp-hops');
  if(btn){btn.disabled=true;btn.textContent='⏳ Tracing…';}
  if(st){st.textContent='Running traceroute on router…';st.style.color='#f0a500';}
  if(mapDiv) mapDiv.style.display='block';
  if(hopsDiv){hopsDiv.style.display='block';hopsDiv.textContent='Running traceroute — this takes up to 30s…';}

  fetch('/cgi-bin/rocket?traceroute_map',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({target:target})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.error){
      if(btn){btn.disabled=false;btn.textContent='▶ Trace Route';}
      if(st){st.textContent='Error: '+d.error;st.style.color='#f85149';}
      return;
    }
    // Poll for completion every 2s
    var _trPoll=setInterval(function(){
      fetch('/cgi-bin/rocket?traceroute_poll')
      .then(function(r){return r.json();})
      .then(function(p){
        if(p.done){
          clearInterval(_trPoll);
          if(btn){btn.disabled=false;btn.textContent='▶ Trace Route';}
          if(!p.hops||!p.hops.length){
            if(st){st.textContent='No hops returned — target unreachable?';st.style.color='#f85149';}
            if(hopsDiv) hopsDiv.textContent=p.raw||'No output';
            return;
          }
          if(hopsDiv) hopsDiv.textContent=p.raw||'';
          if(st){st.textContent=p.hops.length+' hops to '+p.target;st.style.color='#3fb950';}
          var ips=p.hops.map(function(h){return h.ip;});
          var body=JSON.stringify(ips.map(function(ip){return {query:ip,fields:'status,country,countryCode,regionName,city,lat,lon,isp,org,as,query'};}));
          fetch('http://ip-api.com/batch?fields=status,country,countryCode,regionName,city,lat,lon,isp,org,as,query',{
            method:'POST',headers:{'Content-Type':'application/json'},body:body
          })
          .then(function(r){return r.json();})
          .then(function(geo){bgpLoadLeaflet(function(){bgpRenderMap(p.hops,geo,p.target);});})
          .catch(function(){bgpLoadLeaflet(function(){bgpRenderMap(p.hops,[],p.target);});});
        } else {
          if(st){st.textContent='Tracing… '+p.elapsed+'s elapsed · '+(p.hops_so_far||0)+' hops found';st.style.color='#f0a500';}
        }
      }).catch(function(){});
    },2000);
  })
  .catch(function(e){
    if(btn){btn.disabled=false;btn.textContent='▶ Trace Route';}
    if(st){st.textContent='Error: '+e;st.style.color='#f85149';}
  });
}

function bgpRenderMap(hops, geo, target){
  var mapDiv=document.getElementById('bgp-map');
  if(!mapDiv||!window.L) return;

  // Build geo lookup: ip -> {lat,lon,...}
  var geoMap={};
  (geo||[]).forEach(function(g){
    if(g.status==='success'&&g.lat&&g.lon) geoMap[g.query]=g;
  });

  // Init map if not already created
  if(!_bgpMap){
    _bgpMap=L.map('bgp-map',{center:[30,0],zoom:2});

    // Tile layers
    _bgpLayers={
      osm: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        attribution:'© OpenStreetMap',maxZoom:19}),
      sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',{
        attribution:'© Esri World Imagery',maxZoom:19}),
      hybrid: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',{
        attribution:'© Esri',maxZoom:19})
    };
    _bgpLayers.osm.addTo(_bgpMap);

    // Layer switcher buttons
    var ctrl=L.control({position:'topright'});
    ctrl.onAdd=function(){
      var div=L.DomUtil.create('div');
      div.style.cssText='background:#161b22;border:1px solid #30363d;border-radius:8px;overflow:hidden;display:flex;';
      ['Map','Sat','Hybrid'].forEach(function(lbl,i){
        var key=['osm','sat','hybrid'][i];
        var btn=document.createElement('button');
        btn.textContent=lbl;
        btn.dataset.layer=key;
        btn.style.cssText='background:transparent;border:none;color:#8b949e;padding:6px 10px;font-size:11px;cursor:pointer;font-family:monospace;';
        btn.onclick=function(){
          Object.keys(_bgpLayers).forEach(function(k){_bgpMap.removeLayer(_bgpLayers[k]);});
          _bgpLayers[key].addTo(_bgpMap);
          div.querySelectorAll('button').forEach(function(b){b.style.color='#8b949e';b.style.background='transparent';});
          btn.style.color='#f0a500';btn.style.background='rgba(240,165,0,.15)';
          L.DomEvent.stopPropagation(arguments[0]);
        };
        if(i===0){btn.style.color='#f0a500';btn.style.background='rgba(240,165,0,.15)';}
        div.appendChild(btn);
      });
      L.DomEvent.disableClickPropagation(div);
      return div;
    };
    ctrl.addTo(_bgpMap);
  } else {
    // Clear old layers
    _bgpMapLayers.forEach(function(l){try{_bgpMap.removeLayer(l);}catch(e){}});
    _bgpMapLayers=[];
  }

  // Annotate hops with geo data
  var annotated=hops.map(function(h){
    var g=geoMap[h.ip]||null;
    return {hop:h.hop,ip:h.ip,rtt:parseFloat(h.rtt)||0,
      lat:g?g.lat:null,lon:g?g.lon:null,
      city:g?g.city:'',country:g?g.country:'',
      org:g?(g.org||g.isp):'',as:g?g.as:''};
  });

  // Only points with geo data
  var geoPoints=annotated.filter(function(h){return h.lat!==null;});

  if(!geoPoints.length){
    var st=document.getElementById('bgp-status');
    if(st){st.textContent='Could not geolocate any hops (carrier/private IPs)';st.style.color='#f85149';}
    return;
  }

  // RTT colour scale: <30ms green, 30-100ms yellow, >100ms red
  function rttColor(rtt){
    if(!rtt||rtt===0) return '#484f58';
    if(rtt<30)  return '#3fb950';
    if(rtt<100) return '#f0a500';
    return '#f85149';
  }

  // Draw individual hop SEGMENTS with RTT colours
  for(var i=0;i<geoPoints.length-1;i++){
    var a=geoPoints[i], b=geoPoints[i+1];
    var avgRtt=(a.rtt+b.rtt)/2;
    var col=rttColor(avgRtt);
    var seg=L.polyline([[a.lat,a.lon],[b.lat,b.lon]],{
      color:col,weight:3,opacity:0.85,dashArray:'8 4'
    }).addTo(_bgpMap);
    (function(seg,a,b,col){
      seg.on('click',function(){
        seg.bindPopup(
          '<div style="font-family:monospace;font-size:11px;line-height:1.8">'
          +'<strong style="color:'+col+'">Segment: Hop '+a.hop+' → Hop '+b.hop+'</strong><br>'
          +'RTT: <span style="color:'+col+'">'+a.rtt.toFixed(1)+'ms → '+b.rtt.toFixed(1)+'ms</span><br>'
          +(a.city?a.city+', '+a.country+' → '+(b.city?b.city+', '+b.country:''):'')
          +'</div>'
        ).openPopup();
      });
    })(seg,a,b,col);
    _bgpMapLayers.push(seg);
  }

  // Glow trail (thin solid line underneath)
  var trail=L.polyline(geoPoints.map(function(p){return[p.lat,p.lon];}),{
    color:'#ffffff',weight:1,opacity:0.1
  }).addTo(_bgpMap);
  _bgpMapLayers.push(trail);

  // Markers for each geolocated hop
  geoPoints.forEach(function(p,i){
    var isLast=i===geoPoints.length-1;
    var isFirst=i===0;
    var col=isLast?'#3fb950':isFirst?'#58a6ff':rttColor(p.rtt);
    var sz=isLast?14:isFirst?12:9;

    var icon=L.divIcon({
      className:'',
      html:'<div style="width:'+sz+'px;height:'+sz+'px;border-radius:50%;background:'+col
        +';border:2px solid #010409;box-shadow:0 0 '+(isLast?'10':'5')+'px '+col+'"></div>',
      iconSize:[sz,sz],iconAnchor:[sz/2,sz/2]
    });

    var marker=L.marker([p.lat,p.lon],{icon:icon}).addTo(_bgpMap);
    _bgpMapLayers.push(marker);

    var hopLabel=isLast?'🎯 Destination (Hop '+p.hop+')':isFirst?'⬆ Hop '+p.hop+' (first public)':'Hop '+p.hop;
    marker.bindPopup(
      '<div style="font-family:monospace;font-size:12px;line-height:1.9;min-width:190px">'
      +'<strong style="color:'+col+'">'+hopLabel+'</strong><br>'
      +'IP: <strong>'+p.ip+'</strong><br>'
      +(p.rtt?'RTT: <span style="color:'+col+'">'+p.rtt.toFixed(1)+' ms</span><br>':'')
      +(p.city?'📍 '+p.city+', '+p.country+'<br>':'')
      +(p.org?'🏢 <span style="font-size:.9em">'+p.org+'</span><br>':'')
      +(p.as?'🔌 <span style="color:#8b949e;font-size:.9em">'+p.as+'</span>':'')
      +'</div>',
      {maxWidth:280}
    );

    if(isLast) setTimeout(function(){marker.openPopup();},600);
  });

  // Count skipped private hops
  var skipped=annotated.length-geoPoints.length;
  var st=document.getElementById('bgp-status');
  if(st){
    st.style.color='#3fb950';
    st.textContent=geoPoints.length+' hops mapped'+(skipped?' · '+skipped+' carrier/private skipped':'');
  }

  _bgpMap.fitBounds(trail.getBounds(),{padding:[40,40]});
}

var _bgpLayers={};


// ── Who's Eating My Internet? ─────────────────────────────────────────────────
function fmtBytes(b){
  b=parseInt(b)||0;
  if(b>=1073741824) return (b/1073741824).toFixed(1)+' GB';
  if(b>=1048576) return (b/1048576).toFixed(1)+' MB';
  if(b>=1024) return (b/1024).toFixed(0)+' KB';
  return b+' B';
}
function devIcon(name){
  var n=(name||'').toLowerCase();
  if(/iphone|android|phone|mobile|pixel|galaxy/.test(n)) return '📱';
  if(/ps[2345]|playstation|xbox|nintendo|switch/.test(n)) return '🎮';
  if(/samsung|lg|\btv\b|smart.?tv|roku|firetv|appletv/.test(n)) return '📺';
  if(/macbook|laptop|thinkpad|dell|surface|chromebook/.test(n)) return '💻';
  if(/alexa|echo|ring|nest|hub|bridge|hue/.test(n)) return '🏠';
  if(/ipad|tablet/.test(n)) return '📱';
  if(/printer|print/.test(n)) return '🖨️';
  return '📡';
}
// ── Live System Metrics (Netdata-style) ───────────────────────────────────────
var _sm = {
  timer: null,
  prev: null,
  prevNet: null,
  pts: 60,
  cpu:  new Array(60).fill(null),
  ram:  new Array(60).fill(null),
  net:  new Array(60).fill(null), // {rx,tx} bps
  conn: new Array(60).fill(null)
};

function smStart(){
  if(_sm.timer) return;
  smTick();
  _sm.timer = setInterval(smTick, 1000);
}
function smStop(){
  if(_sm.timer){ clearInterval(_sm.timer); _sm.timer=null; }
}

function smTick(){
  fetch('/cgi-bin/rocket?sysmetrics')
  .then(function(r){return r.json();})
  .then(function(d){
    var ts=parseInt(d.ts)||Date.now();
    // CPU
    var cpu=parseFloat(d.cpu)||0;
    _sm.cpu.push(cpu); _sm.cpu.shift();
    smSet('sm-cpu-val', cpu.toFixed(0)+'%', cpu>80?'#f85149':cpu>60?'#f0a500':'#58a6ff');
    smBar('sm-cpu-fill', cpu, cpu>80?'#f85149':cpu>60?'#f0a500':'#58a6ff');
    // RAM
    var mem=d.mem||{}; var rp=parseInt(mem.pct)||0;
    _sm.ram.push(rp); _sm.ram.shift();
    smSet('sm-ram-val', rp+'%', rp>85?'#f85149':rp>65?'#f0a500':'#3fb950');
    smBar('sm-ram-fill', rp, rp>85?'#f85149':rp>65?'#f0a500':'#3fb950');
    // Temp
    var temp=parseFloat(d.temp)||0;
    var tc=temp>75?'#f85149':temp>60?'#f0a500':'#3fb950';
    smSet('sm-temp-val', temp>0?temp.toFixed(0)+'°':'–', tc);
    smBar('sm-temp-fill', Math.min(temp/100*100,100), tc);
    // Load
    var load=(d.load&&d.load[0])||0;
    _sm.conn.push(parseInt(d.conns)||0); _sm.conn.shift();
    smSet('sm-conns-val', (d.conns||0)+'', '#bc8cff');
    smSet('sm-load-val', parseFloat(load).toFixed(2), load>2?'#f85149':load>1?'#f0a500':'#ff7b72');
    smBar('sm-load-fill', Math.min(load/4*100,100), load>2?'#f85149':load>1?'#f0a500':'#ff7b72');
    // Network bps delta
    var net=d.net||[];
    var rxTotal=0,txTotal=0;
    net.forEach(function(i){rxTotal+=parseInt(i.rx)||0; txTotal+=parseInt(i.tx)||0;});
    if(_sm.prevNet){
      var dt=Math.max((ts-_sm.prevNet.ts)/1000,0.1);
      var rxBps=Math.max(0,Math.round((rxTotal-_sm.prevNet.rx)/dt));
      var txBps=Math.max(0,Math.round((txTotal-_sm.prevNet.tx)/dt));
      _sm.net.push({rx:rxBps,tx:txBps}); _sm.net.shift();
      var dl=document.getElementById('sm-dl-label');
      var ul=document.getElementById('sm-ul-label');
      if(dl) dl.textContent='↓ '+smFmt(rxBps);
      if(ul) ul.textContent='↑ '+smFmt(txBps);
    }
    _sm.prevNet={ts:ts,rx:rxTotal,tx:txTotal};
    // Pulse
    var p=document.getElementById('sm-pulse');
    var t=document.getElementById('sm-ts');
    if(p){p.style.background='#3fb950';setTimeout(function(){if(p)p.style.background='#21262d';},300);}
    if(t){var u=parseInt(d.uptime)||0;t.textContent='up '+smUptime(u);}
    // Draw charts
    smDraw('sm-cpu-chart',  _sm.cpu,  '#58a6ff', 100);
    smDraw('sm-ram-chart',  _sm.ram,  '#3fb950', 100);
    smDrawNet('sm-net-chart', _sm.net);
    smDraw('sm-conn-chart', _sm.conn, '#bc8cff', null);
  }).catch(function(){
    var p=document.getElementById('sm-pulse');
    if(p) p.style.background='#f85149';
  });
}

function smSet(id,val,color){
  var el=document.getElementById(id);
  if(el){el.textContent=val;if(color)el.style.color=color;}
}
function smBar(id,pct,color){
  var el=document.getElementById(id);
  if(el){el.style.width=Math.min(100,Math.max(0,pct))+'%';if(color)el.style.background=color;}
}
function smFmt(bps){
  if(bps>=1000000000) return (bps/1000000000).toFixed(1)+' Gbps';
  if(bps>=1000000)    return (bps/1000000).toFixed(1)+' Mbps';
  if(bps>=1000)       return Math.round(bps/1000)+' Kbps';
  return bps+' bps';
}
function smUptime(s){
  var d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60);
  if(d>0) return d+'d '+h+'h';
  if(h>0) return h+'h '+m+'m';
  return m+'m';
}

function smDraw(id, data, color, maxVal){
  var c=document.getElementById(id);
  if(!c||!c.getContext) return;
  c.width=c.offsetWidth||400;
  var ctx=c.getContext('2d'),W=c.width,H=c.height;
  ctx.fillStyle='#010409'; ctx.fillRect(0,0,W,H);
  // Grid lines
  ctx.strokeStyle='#161b22'; ctx.lineWidth=1;
  [0.25,0.5,0.75].forEach(function(f){
    var y=Math.round(H-f*H)+0.5;
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  });
  var vals=data.filter(function(v){return v!==null;});
  if(!vals.length) return;
  var mx=maxVal||(Math.max.apply(null,vals.concat([1]))*1.2);
  var pw=W/data.length;
  ctx.beginPath();
  ctx.strokeStyle=color; ctx.lineWidth=2; ctx.lineJoin='round';
  var started=false;
  data.forEach(function(v,i){
    if(v===null) return;
    var x=i*pw, y=H-Math.max(2,(v/mx)*H*0.9);
    if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);
  });
  ctx.stroke();
  // Fill
  ctx.lineTo((data.length-1)*pw,H);ctx.lineTo(0,H);ctx.closePath();
  ctx.fillStyle=color.replace(')',',0.08)').replace('rgb(','rgba(').replace('#','');
  // Simple fill — use globalAlpha instead
  ctx.save();ctx.globalAlpha=0.08;ctx.fillStyle=color;ctx.fill();ctx.restore();
}

function smDrawNet(id, data){
  var c=document.getElementById(id);
  if(!c||!c.getContext) return;
  c.width=c.offsetWidth||400;
  var ctx=c.getContext('2d'),W=c.width,H=c.height;
  ctx.fillStyle='#010409'; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#161b22'; ctx.lineWidth=1;
  [0.25,0.5,0.75].forEach(function(f){
    var y=Math.round(H-f*H)+0.5;
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  });
  var allVals=[];
  data.forEach(function(v){if(v){allVals.push(v.rx,v.tx);}});
  var mx=Math.max.apply(null,allVals.concat([1024]))*1.1;
  var pw=W/data.length;
  function drawLine(col,getter){
    ctx.beginPath();ctx.strokeStyle=col;ctx.lineWidth=2;ctx.lineJoin='round';
    var started=false;
    data.forEach(function(v,i){
      if(!v) return;
      var x=i*pw,y=H-Math.max(2,(getter(v)/mx)*H*0.9);
      if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);
    });
    ctx.stroke();
    ctx.save();ctx.globalAlpha=0.07;ctx.fillStyle=col;
    ctx.lineTo((data.length-1)*pw,H);ctx.lineTo(0,H);ctx.closePath();ctx.fill();ctx.restore();
  }
  drawLine('#3fb950',function(v){return v.rx;});
  drawLine('#58a6ff',function(v){return v.tx;});
}

function toggleAdblock(btn){
  var enabling = btn.getAttribute('data-ab-state') !== 'on';
  var allBtns = document.querySelectorAll('[data-ab-btn]');
  allBtns.forEach(function(b){ b.disabled=true; b.textContent = enabling ? '⏳ Downloading…' : '⏳ Disabling…'; });
  fetch('/cgi-bin/rocket?adblock=' + (enabling?'1':'0'))
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(!d.ok){
      allBtns.forEach(function(b){ b.disabled=false; });
      alert('Failed: ' + (d.error||'unknown error'));
      return;
    }
    window.location.href = window.location.pathname + '?_=' + Date.now() + '#nov';
  })
  .catch(function(){
    allBtns.forEach(function(b){ b.disabled=false; });
    alert('Network error — could not reach the router. Try again.');
  });
}
function loadBwHogs(){
  var list=document.getElementById('bw-hog-list');
  var btn=document.getElementById('bw-refresh-btn');
  if(btn){btn.textContent='↻ Loading…';btn.disabled=true;}
  fetch('/cgi-bin/rocket?bw_hogs')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.textContent='↻ Refresh';btn.disabled=false;}
    if(!list) return;
    if(!d.devices||!d.devices.length){
      list.innerHTML='<div style="color:#484f58;font-size:.82em">No devices tracked yet — traffic will appear as devices use the network.</div>';
      return;
    }
    var maxBytes=parseInt(d.devices[0].bytes)||1;
    list.innerHTML=d.devices.map(function(dev){
      var bytes=parseInt(dev.bytes)||0;
      var pct=maxBytes>0?Math.round(bytes/maxBytes*100):0;
      var pkts=parseInt(dev.packets)||0;
      var barColor=bytes>536870912?'#f85149':bytes>104857600?'#f0a500':'#3fb950';
      var dispName=_getDevName(dev.mac,dev.name);
      var icon=devIcon(dispName);
      var mfrNow=dev.mac?(_ouiLookup(dev.mac)||''):'';
      return '<div style="display:flex;flex-direction:column;gap:4px;padding:10px 12px;background:#161b22;border:1px solid #21262d;border-radius:10px">'
        +'<div style="display:flex;justify-content:space-between;align-items:center">'
        +'<span style="font-size:.88em;font-weight:600;color:#e6edf3">'+icon
        +' <span'+(dev.mac?' data-devmac="'+dev.mac+'" onclick="wdevRename(this,\''+dev.mac+'\')" title="Click to rename" style="cursor:pointer;border-bottom:1px dashed rgba(230,237,243,.15)"':'')
        +'>'+dispName+'</span></span>'
        +'<span style="font-family:monospace;font-size:.82em;color:'+barColor+';font-weight:700">'+fmtBytes(bytes)+'</span>'
        +'</div>'
        +'<div style="height:6px;background:#21262d;border-radius:3px;overflow:hidden">'
        +'<div style="height:100%;width:'+pct+'%;background:'+barColor+';border-radius:3px;transition:width .4s"></div>'
        +'</div>'
        +'<div style="font-size:.72em;color:#484f58">'+dev.ip+(mfrNow?' · <span style="color:#58a6ff">'+mfrNow+'</span>':'')+(dev.mac?' · '+dev.mac:'')+(pkts?' · '+pkts+' packets':'')+'</div>'
        +'</div>';
    }).join('');
  })
  .catch(function(){
    if(btn){btn.textContent='↻ Refresh';btn.disabled=false;}
    if(list) list.innerHTML='<div style="color:#f85149;font-size:.82em">Error loading bandwidth data.</div>';
  });
}
function bwReset(){
  if(!confirm('Reset all bandwidth counters?')) return;
  fetch('/cgi-bin/rocket?bw_reset',{method:'POST'})
  .then(function(r){return r.json();})
  .then(function(){loadBwHogs();})
  .catch(function(){});
}

// ── Honeypot Mode ─────────────────────────────────────────────────────────────
var _hpTimer=null;
var _hpEnabled=false;

function loadHoneypot(){
  fetch('/cgi-bin/rocket?honeypot_status')
  .then(function(r){return r.json();})
  .then(function(d){
    _hpEnabled=d.enabled;
    var dot=document.getElementById('hp-status-dot');
    var txt=document.getElementById('hp-status-text');
    var btn=document.getElementById('hp-toggle-btn');
    var summary=document.getElementById('hp-summary');
    var feed=document.getElementById('hp-feed');
    var total=document.getElementById('hp-total');
    var log=document.getElementById('hp-log');
    if(dot){dot.style.background=d.enabled?'#f85149':'#484f58';dot.style.boxShadow=d.enabled?'0 0 8px #f85149':'';}
    if(txt){txt.textContent=d.enabled?'ACTIVE — hunting attackers':'Inactive';txt.style.color=d.enabled?'#f85149':'#484f58';}
    if(btn){btn.textContent=d.enabled?'Disable Honeypot':'Enable Honeypot';}
    if(summary) summary.style.display=d.enabled?'block':'none';
    if(feed) feed.style.display=d.enabled?'block':'none';
    if(total) total.textContent=d.total||0;
    if(log){
      if(d.attacks&&d.attacks.length){
        var portNames={21:'FTP',23:'Telnet',22:'SSH',2222:'SSH',3389:'RDP',8080:'HTTP',8888:'HTTP'};
        log.innerHTML=d.attacks.slice().reverse().map(function(a){
          var svc=portNames[a.port]||'port '+a.port;
          return '<div><span style="color:#484f58">'+a.time+'</span>  '
            +'<span style="color:#f85149;font-weight:700">'+a.ip+'</span>'
            +'  →  <span style="color:#8b949e">'+svc+'</span>'
            +'  <span style="color:#484f58">🚫</span></div>';
        }).join('');
        log.scrollTop=log.scrollHeight;
      } else {
        log.innerHTML='<span style="color:#484f58">No attacks logged yet — the trap is set.</span>';
      }
    }
  })
  .catch(function(){});
}

function honeypotToggle(){
  var action=_hpEnabled?'disable':'enable';
  var btn=document.getElementById('hp-toggle-btn');
  if(btn){btn.disabled=true;btn.textContent='…';}
  fetch('/cgi-bin/rocket?honeypot_toggle',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({action:action})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.disabled=false;}
    _hpEnabled=d.enabled;
    loadHoneypot();
    if(d.enabled){
      clearInterval(_hpTimer);
      _hpTimer=setInterval(loadHoneypot,4000);
    } else {
      clearInterval(_hpTimer);
    }
  })
  .catch(function(){if(btn){btn.disabled=false;}});
}

// ── Cake SQM (Bufferbloat Eliminator) ──────────────────────────────────────────
var _cakeEnabled = false;
var _cakePingTimer = null;
var _cakePingHist = [];

function cakeLoad(){
  fetch('/cgi-bin/rocket?cake_status')
  .then(function(r){ return r.json(); })
  .then(function(d){
    var st=document.getElementById('cake-status-line');
    var btn=document.getElementById('cake-toggle-btn');
    var dlInp=document.getElementById('cake-dl');
    var ulInp=document.getElementById('cake-ul');
    _cakeEnabled = !!(d && Number(d.enabled)===1);
    if(!d || !d.sqm_installed){
      if(st){st.textContent='⚠ sqm-scripts not installed — it will be installed automatically when you enable Cake.';st.style.color='#f0a500';}
    } else if(_cakeEnabled){
      if(st){st.textContent=(d.running?'✓ Running':'⏳ Enabled, not yet running')+' on '+d.interface+' · '+d.download_mbps+' Mbps down / '+d.upload_mbps+' Mbps up';st.style.color=d.running?'#3fb950':'#f0a500';}
    } else if(st){
      st.textContent='Disabled — enter your speeds below and click Enable Cake.';
      st.style.color='#484f58';
    }
    if(dlInp && !dlInp.value && d && d.download_mbps>0) dlInp.value=d.download_mbps;
    if(ulInp && !ulInp.value && d && d.upload_mbps>0) ulInp.value=d.upload_mbps;
    if(btn){
      btn.textContent=_cakeEnabled?'Disable Cake':'Enable Cake';
      btn.style.background=_cakeEnabled?'linear-gradient(135deg,#7a1a1a,#601414)':'linear-gradient(135deg,#196127,#238636)';
    }
  })
  .catch(function(){
    var st=document.getElementById('cake-status-line');
    if(st){st.textContent='Error loading Cake SQM status — check router connection.';st.style.color='#f85149';}
  });
}

function cakeToggle(){
  var btn=document.getElementById('cake-toggle-btn');
  var dlInp=document.getElementById('cake-dl');
  var ulInp=document.getElementById('cake-ul');
  var enabling=!_cakeEnabled;
  if(enabling && (!dlInp.value || !ulInp.value)){
    alert('Enter your download and upload speed (Mbps) first — click "Test My Speed" if you don\'t know them.');
    return;
  }
  if(btn){btn.disabled=true;btn.textContent='⏳ Applying…';}
  fetch('/cgi-bin/rocket?cake_set',{method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({enabled:enabling, download_mbps:Number(dlInp.value)||50, upload_mbps:Number(ulInp.value)||20})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn) btn.disabled=false;
    if(!d || !d.ok){ alert('Failed to update Cake SQM.'); }
    cakeLoad();
  })
  .catch(function(){
    if(btn) btn.disabled=false;
    alert('Error contacting router.');
    cakeLoad();
  });
}

function cakeSaveSpeeds(){
  var dlInp=document.getElementById('cake-dl');
  var ulInp=document.getElementById('cake-ul');
  var status=document.getElementById('cake-spd-status');
  if(!dlInp || !ulInp || !dlInp.value || !ulInp.value){
    alert('Enter both download and upload speed (Mbps) first — click "Test My Speed" if you don\'t know your download speed.');
    return;
  }
  if(status){status.textContent='Saving…';status.style.color='#f0a500';}
  fetch('/cgi-bin/rocket?cake_set',{method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({enabled:_cakeEnabled, download_mbps:Number(dlInp.value)||50, upload_mbps:Number(ulInp.value)||20})
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(status){
      status.textContent=(d&&d.ok)?'✓ Speeds saved.':'Failed to save speeds.';
      status.style.color=(d&&d.ok)?'#3fb950':'#f85149';
    }
    cakeLoad();
  })
  .catch(function(){
    if(status){status.textContent='Error contacting router.';status.style.color='#f85149';}
  });
}

function cakeSpeedTest(){
  var btn=document.getElementById('cake-spd-btn');
  var status=document.getElementById('cake-spd-status');
  var dlInp=document.getElementById('cake-dl');
  var ulInp=document.getElementById('cake-ul');
  if(btn){btn.disabled=true;btn.textContent='⏳ Testing…';}
  if(status){status.textContent='Measuring download and upload speed…';status.style.color='#f0a500';}
  fetch('/cgi-bin/rocket?speedtest_run')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.disabled=false;btn.textContent='🚀 Test My Speed';}
    if(d && d.ok){
      var dlAdj=Math.round(parseFloat(d.dl)*0.9);
      var ulAdj=Math.round(parseFloat(d.ul)*0.9);
      if(dlInp) dlInp.value=dlAdj;
      if(ulInp) ulInp.value=ulAdj;
      if(status){status.textContent='✓ '+d.dl+' down / '+d.ul+' up Mbps — set to '+dlAdj+'/'+ulAdj+' (10% headroom). Enable Cake when ready.';status.style.color='#3fb950';}
    } else if(status){
      status.textContent='Speed test failed — check internet connection.';status.style.color='#f85149';
    }
  })
  .catch(function(){
    if(btn){btn.disabled=false;btn.textContent='🚀 Test My Speed';}
    if(status){status.textContent='Speed test failed — check internet connection.';status.style.color='#f85149';}
  });
}

function cakePingTick(){
  fetch('/cgi-bin/rocket?cake_ping')
  .then(function(r){return r.json();})
  .then(function(d){
    var ms=(d && d.ms!=null)?parseFloat(d.ms):null;
    _cakePingHist.push(ms);
    if(_cakePingHist.length>60) _cakePingHist.shift();
    var live=document.getElementById('cake-ping-live');
    if(live) live.textContent=(ms!=null?ms.toFixed(1)+' ms':'timeout');
    cakePingDraw();
  }).catch(function(){
    _cakePingHist.push(null);
    if(_cakePingHist.length>60) _cakePingHist.shift();
    cakePingDraw();
  });
}

function cakePingDraw(){
  var canvas=document.getElementById('cake-ping-canvas');
  if(!canvas||!canvas.getContext) return;
  var ctx=canvas.getContext('2d');
  var W=canvas.width,H=canvas.height;
  ctx.fillStyle='#0d1117';ctx.fillRect(0,0,W,H);
  var vals=_cakePingHist.filter(function(v){return v!=null;});
  var peak=Math.max.apply(null,vals.concat([20]));
  ctx.strokeStyle='#21262d';ctx.lineWidth=1;
  for(var g=1;g<=3;g++){var yg=Math.round(H-g*(H/3))+0.5;ctx.beginPath();ctx.moveTo(0,yg);ctx.lineTo(W,yg);ctx.stroke();ctx.fillStyle='#30363d';ctx.font='10px monospace';ctx.fillText(Math.round(peak*(g/3))+'ms',4,yg-3);}
  var pts=_cakePingHist.length,pw=W/Math.max(pts,1);
  ctx.beginPath();ctx.strokeStyle='#3fb950';ctx.lineWidth=2;ctx.lineJoin='round';
  var started=false;
  for(var i=0;i<pts;i++){
    var v=_cakePingHist[i];
    if(v==null) continue;
    var x=i*pw,y=H-Math.min((v/peak)*H*0.88,H-2);
    if(!started){ctx.moveTo(x,y);started=true;} else ctx.lineTo(x,y);
  }
  ctx.stroke();
}

function cakePingStart(){
  if(_cakePingTimer) return;
  var startBtn=document.getElementById('cake-ping-start');
  var stopBtn=document.getElementById('cake-ping-stop');
  if(startBtn) startBtn.style.display='none';
  if(stopBtn) stopBtn.style.display='inline-block';
  var canvas=document.getElementById('cake-ping-canvas');
  if(canvas){var w=canvas.offsetWidth;canvas.width=(w>10?w:800);}
  cakePingTick();
  _cakePingTimer=setInterval(cakePingTick,1000);
}

function cakePingStop(){
  if(_cakePingTimer){clearInterval(_cakePingTimer);_cakePingTimer=null;}
  var startBtn=document.getElementById('cake-ping-start');
  var stopBtn=document.getElementById('cake-ping-stop');
  if(startBtn) startBtn.style.display='inline-block';
  if(stopBtn) stopBtn.style.display='none';
}

// ── Yggdrasil global mesh status (Expert tab) ──────────────────────────────────
function updateExpMeshStatus(){
  var el=document.getElementById('exp-mesh-status');
  if(!el) return;
  fetch('/cgi-bin/rocket?peer_info')
  .then(function(r){return r.json();})
  .then(function(d){
    if(d && d.ok && d.ygg_addr){
      var n=parseInt(d.local_peers)||0;
      el.innerHTML='<span style="color:#3fb950">&#9679; Active</span> · '+n+' direct peer'+(n===1?'':'s')+' · <span style="color:#8b949e">'+d.ygg_addr+'</span>';
    } else {
      el.innerHTML='<span style="color:#484f58">&#9675; Yggdrasil not running</span>';
    }
  })
  .catch(function(){
    el.innerHTML='<span style="color:#f85149">&#9888; Could not read mesh status</span>';
  });
}

// Hook both into tab opens
(function(){
  var _origShow=window.show;
  window.show=function(tab,el){
    if(typeof _origShow==='function') _origShow(tab,el);
    if(tab==='nov'){setTimeout(loadBwHogs,200);setTimeout(smStart,300);}else{smStop();}
    if(tab==='exp'){ setTimeout(loadHoneypot,200); }
  };
  // Auto-load on Overview if active
  if(document.getElementById('t-nov')&&document.getElementById('t-nov').classList.contains('on')){
    setTimeout(loadBwHogs,500);
    setTimeout(smStart,600); setTimeout(updateHageziStatus,800);
  }
  // Always load these on page init regardless of active tab
  setTimeout(cakeLoad,700);
  setTimeout(dnsLoad,1000);
  setTimeout(initLocalMesh,1100);
  setTimeout(updateExpMeshStatus,1200);
})();


// ── Search Web Tab ────────────────────────────────────────────────────────────
var _searchEngine = 'brave';
var _searchLocation = null;
var _searchLocationOn = false;
var _imgDataUrl = null;
var _imgFile = null;

var _engineUrls = {
  brave:  'https://search.brave.com/search?q=',
  google: 'https://www.google.com/search?q=',
  ddg:    'https://duckduckgo.com/?q=',
  bing:   'https://www.bing.com/search?q='
};

function setEngine(eng){
  _searchEngine = eng;
  document.querySelectorAll('.eng-btn').forEach(function(b){
    b.style.background='rgba(255,255,255,.05)';
    b.style.borderColor='#30363d';
    b.style.color='#8b949e';
  });
  var active = document.getElementById('eng-'+eng);
  if(active){
    var colors={brave:'rgba(255,107,53,.15)|rgba(255,107,53,.5)|#ff6b35',
                google:'rgba(66,133,244,.15)|rgba(66,133,244,.5)|#4285f4',
                ddg:'rgba(222,88,34,.15)|rgba(222,88,34,.5)|#de5822',
                bing:'rgba(0,120,212,.15)|rgba(0,120,212,.5)|#0078d4'};
    var c=(colors[eng]||'rgba(255,255,255,.1)|#30363d|#e6edf3').split('|');
    active.style.background=c[0];active.style.borderColor=c[1];active.style.color=c[2];
  }
}

function toggleLocation(){
  var btn=document.getElementById('loc-btn');
  var st=document.getElementById('loc-status');
  if(_searchLocationOn){
    _searchLocationOn=false; _searchLocation=null;
    if(btn){btn.style.color='#484f58';btn.style.borderColor='#30363d';btn.style.background='#161b22';}
    if(st) st.textContent='';
    return;
  }
  if(st) st.textContent='Getting your location…';
  if(!navigator.geolocation){
    if(st){st.textContent='Location not available in this browser';} return;
  }
  navigator.geolocation.getCurrentPosition(
    function(pos){
      _searchLocation={lat:pos.coords.latitude,lon:pos.coords.longitude};
      _searchLocationOn=true;
      if(btn){btn.style.color='#3fb950';btn.style.borderColor='rgba(63,185,80,.5)';btn.style.background='rgba(63,185,80,.12)';}
      // Reverse geocode using nominatim (free, no key)
      fetch('https://nominatim.openstreetmap.org/reverse?lat='+pos.coords.latitude+'&lon='+pos.coords.longitude+'&format=json')
      .then(function(r){return r.json();})
      .then(function(d){
        var city=(d.address&&(d.address.city||d.address.town||d.address.village))||'your location';
        if(st) st.textContent='📍 Location set: '+city+' — searches will include "near '+city+'"';
      })
      .catch(function(){
        if(st) st.textContent='📍 Location active (coordinates)';
      });
    },
    function(){
      if(st) st.textContent='Location denied — searches will work without it';
    }
  );
}

// ── Uncensored Search — SearXNG via router CGI ──────────────────────────────
var _srchCategory = 'general';
var _srchLastQuery = '';

function setCategory(cat){
  _srchCategory = cat;
  document.querySelectorAll('.cat-btn').forEach(function(b){
    b.style.background='rgba(255,255,255,.04)';
    b.style.borderColor='#30363d';
    b.style.color='#8b949e';
  });
  var map={general:'cat-general',news:'cat-news',images:'cat-images',videos:'cat-videos',
           'social media':'cat-social',science:'cat-science',it:'cat-it',map:'cat-map'};
  var el=document.getElementById(map[cat]||'cat-general');
  if(el){el.style.background='rgba(63,185,80,.15)';el.style.borderColor='rgba(63,185,80,.4)';el.style.color='#3fb950';}
}

function doSearch(){
  var q=(document.getElementById('search-query')||{}).value||'';
  q=q.trim();
  if(!q){ document.getElementById('search-query').focus(); return; }
  openInEngine(_searchEngine||'brave');
}

function srchQuick(term){
  var input=document.getElementById('search-query');
  if(input){input.value=term;input.focus();}
  doSearch();
}
function srchSuggestion(term){
  var input=document.getElementById('search-query');
  if(input) input.value=term;
  doSearch();
}
function quickSearch(term){ srchQuick(term); }

function openInEngine(eng){
  var q=(document.getElementById('search-query')||{}).value||'';
  q=q.trim();
  _searchEngine = eng;
  // Highlight active engine button
  var engIds=['also-brave','also-ddg','also-presearch','also-marginalia','also-yep','also-google'];
  var engMap={'brave':'also-brave','ddg':'also-ddg','presearch':'also-presearch',
              'marginalia':'also-marginalia','yep':'also-yep','google':'also-google'};
  engIds.forEach(function(id){
    var b=document.getElementById(id);
    if(!b) return;
    if(id===engMap[eng]){
      b.style.background='rgba(255,107,53,.18)';b.style.borderColor='rgba(255,107,53,.5)';b.style.color='#ff6b35';
    } else {
      b.style.background='rgba(255,255,255,.05)';b.style.borderColor='#30363d';b.style.color='#8b949e';
    }
  });
  // Category-aware URLs
  var qe=encodeURIComponent(q);
  var cat=_srchCategory||'general';
  var urls={
    brave:{
      general:'https://search.brave.com/search?q='+qe,
      news:'https://search.brave.com/news?q='+qe,
      images:'https://search.brave.com/images?q='+qe,
      videos:'https://search.brave.com/videos?q='+qe,
      _default:'https://search.brave.com/search?q='+qe
    },
    ddg:{
      general:'https://duckduckgo.com/?q='+qe,
      news:'https://duckduckgo.com/?q='+qe+'&ia=news',
      images:'https://duckduckgo.com/?q='+qe+'&ia=images&iax=images',
      videos:'https://duckduckgo.com/?q='+qe+'&ia=videos&iax=videos',
      _default:'https://duckduckgo.com/?q='+qe
    },
    presearch:{_default:'https://presearch.com/search?q='+qe},
    marginalia:{_default:'https://search.marginalia.nu/search?query='+qe},
    yep:{_default:'https://yep.com/web?q='+qe},
    google:{
      general:'https://www.google.com/search?q='+qe,
      news:'https://www.google.com/search?q='+qe+'&tbm=nws',
      images:'https://www.google.com/search?q='+qe+'&tbm=isch',
      videos:'https://www.google.com/search?q='+qe+'&tbm=vid',
      _default:'https://www.google.com/search?q='+qe
    }
  };
  var engUrls=urls[eng]||urls.brave;
  var url=engUrls[cat]||engUrls._default;
  if(q) window.open(url,'_blank');
  else { var inp=document.getElementById('search-query'); if(inp) inp.focus(); }
}

function escHtml(str){
  if(!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ── Image Search ──────────────────────────────────────────────────────────────
function handleImgDrop(event){
  event.preventDefault();
  document.getElementById('img-dropzone').style.borderColor='#30363d';
  document.getElementById('img-dropzone').style.background='#0d1117';
  var file=event.dataTransfer.files[0];
  if(file&&file.type.startsWith('image/')) handleImgFile(file);
}

function handleImgFile(file){
  if(!file) return;
  _imgFile=file;
  var reader=new FileReader();
  reader.onload=function(e){
    _imgDataUrl=e.target.result;
    showImgPreview(e.target.result);
  };
  reader.readAsDataURL(file);
}

function previewImgUrl(url){
  if(!url||!url.match(/^https?:\/\//)) return;
  _imgDataUrl=null; _imgFile=null;
  showImgPreview(url);
}

function showImgPreview(src){
  var wrap=document.getElementById('img-preview-wrap');
  var img=document.getElementById('img-preview');
  var lbl=document.getElementById('img-dropzone-label');
  if(img) img.src=src;
  if(wrap) wrap.style.display='block';
  if(lbl) lbl.style.display='none';
  document.getElementById('img-dropzone').style.borderColor='rgba(88,166,255,.4)';
}

function clearImage(){
  _imgDataUrl=null; _imgFile=null;
  var wrap=document.getElementById('img-preview-wrap');
  var lbl=document.getElementById('img-dropzone-label');
  var inp=document.getElementById('img-url');
  if(wrap) wrap.style.display='none';
  if(lbl) lbl.style.display='block';
  if(inp) inp.value='';
  document.getElementById('img-dropzone').style.borderColor='#30363d';
  document.getElementById('img-dropzone').style.background='#0d1117';
}

// Ctrl+V paste anywhere on search tab
document.addEventListener('paste',function(e){
  if(!document.getElementById('t-search')||!document.getElementById('t-search').classList.contains('on')) return;
  var items=e.clipboardData&&e.clipboardData.items;
  if(!items) return;
  for(var i=0;i<items.length;i++){
    if(items[i].type.startsWith('image/')){
      var file=items[i].getAsFile();
      if(file){handleImgFile(file); break;}
    }
  }
});

function imgSearch(type){
  var imgUrl=(document.getElementById('img-url')||{}).value||'';
  imgUrl=imgUrl.trim();

  // If we have an uploaded/pasted file
  if(_imgFile){
    if(type==='bing'){
      // Use Bing's multipart upload form
      var bingForm=document.getElementById('bing-upload-form');
      var bingInput=document.getElementById('bing-file-input');
      if(bingForm&&bingInput){
        // Transfer our file to the hidden input using DataTransfer
        try{
          var dt=new DataTransfer();
          dt.items.add(_imgFile);
          bingInput.files=dt.files;
          bingForm.submit();
        }catch(e){
          // Fallback: open Bing visual search
          window.open('https://www.bing.com/visualsearch','_blank');
        }
      }
      return;
    }
    if(type==='tineye'){
      window.open('https://tineye.com/','_blank');
      return;
    }
    // For Google services with uploaded file: convert to blob URL and use Google Lens upload
    var blobUrl=URL.createObjectURL(_imgFile);
    if(type==='lens'||type==='shopping'||type==='maps'){
      // Open Google Lens — user can paste/drop the file there too
      // Best we can do without a public URL: open lens and notify
      window.open('https://lens.google.com/','_blank');
      alert('Google Lens opened. Drag your image into it, or paste it (Ctrl+V) — your image is ready in the clipboard if you copied it.');
    }
    return;
  }

  // If we have an image URL
  var url=imgUrl||'';
  if(!url){
    alert('Drop an image, paste one (Ctrl+V), or enter an image URL first.');
    return;
  }

  var enc=encodeURIComponent(url);
  switch(type){
    case 'lens':
      window.open('https://lens.google.com/uploadbyurl?url='+enc,'_blank'); break;
    case 'shopping':
      window.open('https://www.google.com/searchbyimage?image_url='+enc+'&safe=off','_blank'); break;
    case 'maps':
      window.open('https://lens.google.com/uploadbyurl?url='+enc+'&re=df&hl=en&gl=uk','_blank'); break;
    case 'tineye':
      window.open('https://tineye.com/search?url='+enc,'_blank'); break;
    case 'bing':
      window.open('https://www.bing.com/images/search?q=imgurl:'+enc+'&view=detailv2&iss=sbi','_blank'); break;
    case 'yandex':
      window.open('https://yandex.com/images/search?rpt=imageview&url='+enc,'_blank'); break;
  }
}


// ── Is My Internet Broken? ────────────────────────────────────────────────────
function runNetHealth(){
  var btn=document.getElementById('net-health-btn');
  var result=document.getElementById('net-health-result');
  if(btn){btn.disabled=true;btn.textContent='⏳ Checking…';}
  if(result) result.style.display='none';
  fetch('/cgi-bin/rocket?net_health')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.disabled=false;btn.textContent='▶ Run Check';}
    if(!result) return;
    result.style.display='block';
    var box=document.getElementById('net-verdict-box');
    var icon=document.getElementById('net-verdict-icon');
    var title=document.getElementById('net-verdict-title');
    var msg=document.getElementById('net-verdict-msg');
    var grid=document.getElementById('net-checks-grid');
    var latLine=document.getElementById('net-latency-line');
    // Verdict styling
    var verdicts={
      ok:    {bg:'rgba(63,185,80,.08)',border:'rgba(63,185,80,.3)',color:'#3fb950', icon:'✅',title:'Your internet is working fine'},
      degraded:{bg:'rgba(240,165,0,.08)',border:'rgba(240,165,0,.3)',color:'#f0a500',icon:'⚠️',title:'Internet is degraded'},
      broken:{bg:'rgba(248,81,73,.08)',border:'rgba(248,81,73,.3)',color:'#f85149',icon:'❌',title:'Internet appears broken'}
    };
    var v=verdicts[d.verdict]||verdicts.ok;
    if(box){box.style.background=v.bg;box.style.border='1px solid '+v.border;}
    if(icon) icon.textContent=v.icon;
    if(title){title.textContent=v.title;title.style.color=v.color;}
    if(msg) msg.textContent=d.msg||'';
    // Service checks
    var checks=[
      {label:'Google',    ok:d.checks.google,     icon:'G'},
      {label:'Netflix',   ok:d.checks.netflix,    icon:'N'},
      {label:'YouTube',   ok:d.checks.youtube,    icon:'▶'},
      {label:'Cloudflare',ok:d.checks.cloudflare, icon:'⚡'},
      {label:'Ping 8.8.8.8',ok:d.checks.ping_google,icon:'📡'},
      {label:'DNS',       ok:d.checks.dns,        icon:'🔤'}
    ];
    if(grid){
      grid.innerHTML=checks.map(function(c){
        var col=c.ok?'#3fb950':'#f85149';
        var bg=c.ok?'rgba(63,185,80,.08)':'rgba(248,81,73,.08)';
        var brd=c.ok?'rgba(63,185,80,.25)':'rgba(248,81,73,.25)';
        var tick=c.ok?'✓':'✗';
        return '<div style="background:'+bg+';border:1px solid '+brd+';border-radius:8px;padding:10px;text-align:center">'
          +'<div style="font-size:.82em;margin-bottom:2px">'+c.icon+'</div>'
          +'<div style="font-size:.75em;color:#8b949e;margin-bottom:4px">'+c.label+'</div>'
          +'<div style="font-size:1em;font-weight:700;color:'+col+'">'+tick+'</div>'
          +'</div>';
      }).join('');
    }
    if(latLine){
      var lat=parseInt(d.latency_ms)||0;
      var latCol=lat<50?'#3fb950':lat<150?'#f0a500':'#f85149';
      latLine.innerHTML='WAN IP: <span style="color:#8b949e">'+d.wan_ip+'</span>'
        +(lat?'  ·  Latency to 8.8.8.8: <span style="color:'+latCol+'">'+lat+'ms</span>':'');
    }
  })
  .catch(function(){
    if(btn){btn.disabled=false;btn.textContent='▶ Run Check';}
  });
}

// ── Monthly Report Card ───────────────────────────────────────────────────────
function fmtBytesReport(b){
  b=parseInt(b)||0;
  if(b>=1099511627776) return (b/1099511627776).toFixed(2)+' TB';
  if(b>=1073741824) return (b/1073741824).toFixed(2)+' GB';
  if(b>=1048576) return (b/1048576).toFixed(1)+' MB';
  if(b>=1024) return (b/1024).toFixed(0)+' KB';
  return b+' B';
}

function loadMonthlyReport(){
  var el=document.getElementById('monthly-report-content');
  if(el) el.innerHTML='<div style="color:#484f58;font-size:.82em">Loading…</div>';
  fetch('/cgi-bin/rocket?monthly_report')
  .then(function(r){return r.json();})
  .then(function(d){
    if(!el) return;
    var rx=0,tx=0;
    try{
      if(d.vnstat&&d.vnstat.interfaces&&d.vnstat.interfaces[0]){
        var iface=d.vnstat.interfaces[0];
        if(iface.traffic&&iface.traffic.month&&iface.traffic.month.length){
          var m=iface.traffic.month[iface.traffic.month.length-1];
          rx=(m.rx||0); tx=(m.tx||0);
        }
      }
    }catch(e){}
    var total=rx+tx;
    var load=parseFloat(d.load)||0;
    var days=parseInt(d.uptime_days)||0;
    var hrs=parseInt(d.uptime_hrs)||0;
    var totalUpHrs=days*24+hrs;
    var healthScore=0;
    if(totalUpHrs>=72) healthScore+=50; else if(totalUpHrs>=24) healthScore+=35; else if(totalUpHrs>=6) healthScore+=20; else healthScore+=5;
    if(load<0.5) healthScore+=30; else if(load<1.0) healthScore+=20; else if(load<2.0) healthScore+=10;
    if(days>=7) healthScore+=20; else if(days>=3) healthScore+=10;
    var grade,gradeColor,gradeNote;
    if(healthScore>=85){grade='A';gradeColor='#3fb950';gradeNote='Excellent';}
    else if(healthScore>=65){grade='B';gradeColor='#58a6ff';gradeNote='Good';}
    else if(healthScore>=40){grade='C';gradeColor='#f0a500';gradeNote='Fair';}
    else{grade='D';gradeColor='#f85149';gradeNote='Needs attention';}
    el.innerHTML=
      '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:16px">'
        +'<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Network Grade</div>'
          +'<div style="font-size:2.8em;font-weight:900;color:'+gradeColor+';line-height:1;font-family:monospace">'+grade+'</div>'
          +'<div style="font-size:.68em;color:'+gradeColor+';margin-top:4px">'+gradeNote+'</div>'
          +'<div style="margin-top:10px;padding-top:10px;border-top:1px solid #21262d;text-align:left">'
            +'<div style="font-size:.65em;color:#484f58;line-height:1.7">'
              +'<span style="color:#3fb950;font-weight:700">A</span> ≥85 · <span style="color:#58a6ff;font-weight:700">B</span> ≥65 · <span style="color:#f0a500;font-weight:700">C</span> ≥40 · <span style="color:#f85149;font-weight:700">D</span> &lt;40'
              +'<br>Uptime: up to 50pts · CPU load: up to 30pts · Longevity: up to 20pts'
            +'</div>'
          +'</div>'
        +'</div>'
        +'<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Data Used</div>'
          +'<div style="font-size:1.5em;font-weight:700;color:#58a6ff;line-height:1.2">'+fmtBytesReport(total)+'</div>'
          +'<div style="font-size:.68em;color:#484f58;margin-top:4px">↓ '+fmtBytesReport(rx)+' · ↑ '+fmtBytesReport(tx)+'</div>'
        +'</div>'
        +'<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Uptime</div>'
          +'<div style="font-size:1.5em;font-weight:700;color:'+(totalUpHrs>=24?'#3fb950':'#f0a500')+';line-height:1.2">'+days+'d '+hrs+'h</div>'
          +'<div style="font-size:.68em;color:#484f58;margin-top:4px">since last reboot</div>'
        +'</div>'
        +(d.top_hog?
        '<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Top Device</div>'
          +'<div style="font-size:1em;font-weight:700;color:#f0a500;line-height:1.3">'+d.top_hog+'</div>'
          +'<div style="font-size:.68em;color:#484f58;margin-top:4px">'+fmtBytesReport(d.top_hog_bytes)+' this session</div>'
        +'</div>':'')
        +'<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Ads Blocked</div>'
          +'<div style="font-size:1.5em;font-weight:700;color:#3fb950;line-height:1.2">'+(parseInt(d.blocked_domains)||0).toLocaleString()+'</div>'
          +'<div style="font-size:.68em;color:#484f58;margin-top:4px">domains blocked</div>'
        +'</div>'
        +'<div style="background:#161b22;border:1px solid #21262d;border-radius:10px;padding:14px;text-align:center">'
          +'<div style="font-size:.68em;color:#484f58;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">CPU Load</div>'
          +'<div style="font-size:1.5em;font-weight:700;color:#8b949e;line-height:1.2">'+(d.load||'?')+'</div>'
          +'<div style="font-size:.68em;color:#484f58;margin-top:4px">15min average</div>'
        +'</div>'
      +'</div>'
      +'<div style="font-size:.72em;color:#484f58;text-align:center">Interface: '+d.iface+' · Report generated live from router data</div>';
  })
  .catch(function(){
    if(el) el.innerHTML='<div style="color:#f85149;font-size:.82em">Error loading report.</div>';
  });
}

// Auto-load monthly report + internet checker when Overview tab opens
(function(){
  var _origShowNov=window.show;
  window.show=function(tab,el){
    if(typeof _origShowNov==='function') _origShowNov(tab,el);
    if(tab==='nov') setTimeout(loadMonthlyReport,400);
  };
  if(document.getElementById('t-nov')&&document.getElementById('t-nov').classList.contains('on')){
    setTimeout(loadMonthlyReport,600);
  }
})();

// ── Speed Test ────────────────────────────────────────────────────────────────
function runSpeedTest(){
  var btn=document.getElementById('speed-btn');
  var result=document.getElementById('speed-result');
  var progress=document.getElementById('speed-progress');
  var msg=document.getElementById('speed-progress-msg');
  if(btn){btn.disabled=true;btn.textContent='⏳ Testing…';}
  if(result) result.style.display='none';
  if(progress) progress.style.display='block';
  var msgs=['Starting speed test…','Downloading test data from Cloudflare…','Measuring upload speed…','Calculating results…'];
  var mi=0;
  var ticker=setInterval(function(){if(msg&&mi<msgs.length-1){mi++;msg.textContent=msgs[mi];}},7000);
  fetch('/cgi-bin/rocket?speed_check')
  .then(function(r){return r.json();})
  .then(function(d){
    clearInterval(ticker);
    if(btn){btn.disabled=false;btn.textContent='▶ Test Again';}
    if(progress) progress.style.display='none';
    if(!result) return;
    result.style.display='block';
    var dl=parseFloat(d.dl_mbps)||0;
    var ul=parseFloat(d.ul_mbps)||0;
    var lat=parseInt(d.latency_ms)||0;
    var dlEl=document.getElementById('speed-dl');
    var ulEl=document.getElementById('speed-ul');
    var latEl=document.getElementById('speed-lat');
    if(dlEl){dlEl.textContent=dl.toFixed(1);dlEl.style.color=dl>50?'#3fb950':dl>10?'#f0a500':'#f85149';}
    if(ulEl){ulEl.textContent=ul.toFixed(1);ulEl.style.color=ul>10?'#3fb950':ul>5?'#f0a500':'#f85149';}
    if(latEl){latEl.textContent=lat;latEl.style.color=lat<50?'#3fb950':lat<150?'#f0a500':'#f85149';}
    var cases=[
      {name:'Netflix 4K',icon:'🎬',needDl:25,needUl:0,needLat:0},
      {name:'Netflix HD',icon:'📺',needDl:5,needUl:0,needLat:0},
      {name:'Video Call HD',icon:'📹',needDl:3,needUl:3,needLat:150},
      {name:'4K Video Call',icon:'🎥',needDl:10,needUl:5,needLat:100},
      {name:'Online Gaming',icon:'🎮',needDl:3,needUl:1,needLat:50},
      {name:'Music Streaming',icon:'🎵',needDl:0.5,needUl:0,needLat:0},
      {name:'Smart Home',icon:'🏠',needDl:1,needUl:0,needLat:0},
      {name:'8K Streaming',icon:'🚀',needDl:100,needUl:0,needLat:0}
    ];
    var vEl=document.getElementById('speed-verdicts');
    if(vEl){
      vEl.innerHTML=cases.map(function(c){
        var ok=(dl>=c.needDl)&&(!c.needUl||ul>=c.needUl)&&(!c.needLat||lat<=c.needLat);
        var warn=!ok&&(dl>=c.needDl*0.7);
        var col=ok?'#3fb950':warn?'#f0a500':'#f85149';
        var bg=ok?'rgba(63,185,80,.07)':warn?'rgba(240,165,0,.07)':'rgba(248,81,73,.07)';
        var brd=ok?'rgba(63,185,80,.2)':warn?'rgba(240,165,0,.2)':'rgba(248,81,73,.2)';
        return '<div style="background:'+bg+';border:1px solid '+brd+';border-radius:9px;padding:10px 12px;display:flex;align-items:center;gap:8px">'
          +'<span>'+c.icon+'</span><span style="flex:1;font-size:.82em;color:#e6edf3">'+c.name+'</span>'
          +'<span style="font-weight:700;color:'+col+'">'+(ok?'✓':warn?'~':'✗')+'</span></div>';
      }).join('');
    }
  })
  .catch(function(){
    clearInterval(ticker);
    if(btn){btn.disabled=false;btn.textContent='▶ Test My Speed';}
    if(progress) progress.style.display='none';
  });
}

// ── DNS Spy Mode ──────────────────────────────────────────────────────────────
var _dnsTimer=null;
var _dnsEnabled=false;
var _dnsAllQueries=[];

function dnsToggle(){
  var action=_dnsEnabled?'disable':'enable';
  var btn=document.getElementById('dns-toggle-btn');
  if(btn){btn.disabled=true;btn.textContent='…';}
  fetch('/cgi-bin/rocket?dns_toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:action})})
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn) btn.disabled=false;
    _dnsEnabled=d.enabled;
    dnsUpdateUI();
    if(d.enabled){clearInterval(_dnsTimer);_dnsTimer=setInterval(dnsLoad,2000);dnsLoad();}
    else clearInterval(_dnsTimer);
  }).catch(function(){if(btn) btn.disabled=false;});
}

function dnsLoad(){
  fetch('/cgi-bin/rocket?dns_spy')
  .then(function(r){return r.json();})
  .then(function(d){
    _dnsEnabled=d.enabled; dnsUpdateUI();
    if(d.queries&&d.queries.length){_dnsAllQueries=d.queries.slice().reverse(); dnsFilterFeed();}
    // Restart poll loop if spy is on but timer was lost (e.g. page reload)
    if(_dnsEnabled && !_dnsTimer){_dnsTimer=setInterval(dnsLoad,2000);}
  }).catch(function(){});
}

function dnsUpdateUI(){
  var dot=document.getElementById('dns-dot');
  var st=document.getElementById('dns-status');
  var btn=document.getElementById('dns-toggle-btn');
  var feed=document.getElementById('dns-feed');
  var frow=document.getElementById('dns-filter-row');
  var cnt=document.getElementById('dns-count');
  if(dot){dot.style.background=_dnsEnabled?'#58a6ff':'#484f58';dot.style.boxShadow=_dnsEnabled?'0 0 6px #58a6ff':'';}
  if(st){st.textContent=_dnsEnabled?'ACTIVE':'Off';st.style.color=_dnsEnabled?'#58a6ff':'#484f58';}
  if(btn) btn.textContent=_dnsEnabled?'Disable Spy Mode':'Enable Spy Mode';
  if(feed) feed.style.display=_dnsEnabled?'block':'none';
  if(frow) frow.style.display=_dnsEnabled?'block':'none';
  if(cnt) cnt.style.display=_dnsEnabled?'block':'none';
}

function dnsFilterFeed(){
  var filter=((document.getElementById('dns-filter')||{}).value||'').toLowerCase().trim();
  var feed=document.getElementById('dns-feed');
  var cnt=document.getElementById('dns-count');
  if(!feed) return;
  var filtered=filter?_dnsAllQueries.filter(function(q){return (q.domain||'').toLowerCase().indexOf(filter)!==-1;}):_dnsAllQueries;
  var adKw=['doubleclick','googlesyndication','amazon-adsystem','adserver','tracker','telemetry','analytics','metrics','pixel','beacon','chartbeat'];
  feed.innerHTML=filtered.slice(0,100).map(function(q){
    var isAd=adKw.some(function(k){return (q.domain||'').indexOf(k)!==-1;});
    var col=isAd?'#f85149':q.type==='AAAA'?'#484f58':'#3fb950';
    return '<div><span style="color:#30363d">'+q.time+'</span>  <span style="color:#484f58">'+q.src+'</span>  <span style="color:'+col+'">'+q.domain+'</span>'+(isAd?' <span style="color:#f85149;font-size:.8em">⚠ tracker</span>':'')+'</div>';
  }).join('')||'<span style="color:#484f58">No queries'+(filter?' matching "'+filter+'"':' yet')+'</span>';
  feed.scrollTop=feed.scrollHeight;
  if(cnt) cnt.textContent=_dnsAllQueries.length+' queries'+(filter?' · '+filtered.length+' matching':'');
}

// ── WAN interface auto-detect (shared by Bandwidth Graph + vnstat) ─────────────
var _wanIfaceDetected=null;

function detectWanIface(cb){
  fetch('/cgi-bin/rocket?wan_iface')
  .then(function(r){return r.json();})
  .then(function(d){
    var iface=(d && d.iface) || 'usb1';
    _wanIfaceDetected=iface;
    cb(iface);
  })
  .catch(function(){ cb(_wanIfaceDetected||'usb1'); });
}

function _applyWanIfaceToSelect(selId, iface){
  var sel=document.getElementById(selId);
  if(!sel || !iface) return;
  var found=false;
  for(var i=0;i<sel.options.length;i++){
    if(sel.options[i].value===iface){found=true;break;}
  }
  if(!found){
    var opt=document.createElement('option');
    opt.value=iface; opt.textContent=iface+' (WAN — detected)';
    sel.insertBefore(opt, sel.firstChild);
  }
  sel.value=iface;
}

function initWanIfaceDefaults(){
  detectWanIface(function(iface){
    _applyWanIfaceToSelect('bw-graph-iface', iface);
    _applyWanIfaceToSelect('vnstat-iface', iface);
    _bwIface=iface;
  });
}

// ── Real-time Bandwidth Graph ─────────────────────────────────────────────────
var _bwTimer=null;
var _bwPrev={};
var _bwHistRx=new Array(60).fill(0);
var _bwHistTx=new Array(60).fill(0);
var _bwMaxSeen=1024;
var _bwIface='usb1';

function bwGraphChangeIface(){
  _bwIface=(document.getElementById('bw-graph-iface')||{}).value||'usb1';
  _bwPrev={};_bwHistRx=new Array(60).fill(0);_bwHistTx=new Array(60).fill(0);_bwMaxSeen=1024;
}

function bwFmt(bps){
  if(bps>=1000000000) return (bps/1000000000).toFixed(1)+' Gbps';
  if(bps>=1000000) return (bps/1000000).toFixed(1)+' Mbps';
  if(bps>=1000) return (bps/1000).toFixed(0)+' Kbps';
  return bps+' bps';
}

function bwGraphTick(){
  fetch('/cgi-bin/rocket?bw_live')
  .then(function(r){return r.json();})
  .then(function(d){
    var now=parseInt(d.ts)||Date.now();
    var found=null;
    (d.interfaces||[]).forEach(function(i){if(i.iface===_bwIface) found=i;});
    if(!found) return;
    var rxBps=0,txBps=0;
    if(_bwPrev.ts&&_bwPrev.rx!==undefined){
      var dt=(now-_bwPrev.ts)/1000;
      if(dt>0&&dt<5){rxBps=Math.max(0,Math.round((found.rx-_bwPrev.rx)/dt));txBps=Math.max(0,Math.round((found.tx-_bwPrev.tx)/dt));}
    }
    _bwPrev={ts:now,rx:found.rx,tx:found.tx};
    _bwHistRx.push(rxBps);_bwHistRx.shift();
    _bwHistTx.push(txBps);_bwHistTx.shift();
    var peak=Math.max.apply(null,_bwHistRx.concat(_bwHistTx).concat([1024]));
    if(peak>_bwMaxSeen) _bwMaxSeen=peak;
    var dlEl=document.getElementById('bw-graph-dl');
    var ulEl=document.getElementById('bw-graph-ul');
    if(dlEl) dlEl.textContent='↓ '+bwFmt(rxBps);
    if(ulEl) ulEl.textContent='↑ '+bwFmt(txBps);
    bwGraphDraw();
  }).catch(function(){});
}

function bwGraphDraw(){
  var canvas=document.getElementById('bw-graph-canvas');
  if(!canvas||!canvas.getContext) return;
  var ctx=canvas.getContext('2d');
  var W=canvas.width,H=canvas.height;
  ctx.fillStyle='#010409';ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#21262d';ctx.lineWidth=1;
  for(var g=1;g<=4;g++){var yg=Math.round(H-g*(H/4))+0.5;ctx.beginPath();ctx.moveTo(0,yg);ctx.lineTo(W,yg);ctx.stroke();ctx.fillStyle='#30363d';ctx.font='10px monospace';ctx.fillText(bwFmt(_bwMaxSeen*(g/4)),4,yg-3);}
  function drawLine(hist,color,fillColor){
    var pts=hist.length,pw=W/pts;
    ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=2;ctx.lineJoin='round';
    for(var i=0;i<pts;i++){var x=i*pw,v=hist[i],y=H-Math.min((v/_bwMaxSeen)*H*0.88,H-2);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);}
    ctx.stroke();
    ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.closePath();ctx.fillStyle=fillColor;ctx.fill();
  }
  drawLine(_bwHistRx,'#3fb950','rgba(63,185,80,0.1)');
  drawLine(_bwHistTx,'#58a6ff','rgba(88,166,255,0.08)');
}

function bwGraphInit(){
  var canvas=document.getElementById('bw-graph-canvas');
  if(!canvas) return;
  // Always reset width — offsetWidth may be 0 if tab not fully painted yet
  var w=canvas.offsetWidth;
  canvas.width=(w>10?w:800);
  bwGraphDraw();
  // Always restart ticker so fresh page loads get live data
  if(_bwTimer){clearInterval(_bwTimer);}
  _bwTimer=setInterval(bwGraphTick,1000);
  bwGraphTick();
}

// ── loadDataMap stub (widget removed) ─────────────────────────────────────────
function loadDataMap(){} // widget removed

function _dead_dataMapLoad(){
  var btn=document.getElementById('data-map-btn');
  var st=document.getElementById('data-map-status');
  var wrap=document.getElementById('data-map-svg-wrap');
  var leg=document.getElementById('data-map-legend');
  if(btn){btn.disabled=true;btn.textContent='⏳ Scanning…';}
  if(wrap) wrap.style.display='none';
  if(leg) leg.style.display='none';
  if(st){st.textContent='Reading active connections from firewall table…';st.style.color='#f0a500';}

  fetch('/cgi-bin/rocket?traffic_countries')
  .then(function(r){return r.json();})
  .then(function(d){
    var ips=(d.ips||[]);
    if(!ips.length){
      if(st){st.textContent='No external connections active right now — try browsing something first.';st.style.color='#484f58';}
      if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
      return;
    }
    if(st){st.textContent='Geo-locating '+ips.length+' destination IP'+(ips.length!==1?'s':'')+'…';st.style.color='#f0a500';}
    // Batch geolocate — up to 100 per request
    var chunks=[];
    for(var i=0;i<ips.length;i+=100) chunks.push(ips.slice(i,i+100));
    var promises=chunks.map(function(chunk){
      return fetch('http://ip-api.com/batch?fields=status,country,countryCode,lat,lon,query',{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify(chunk.map(function(ip){return {query:ip};}))
      }).then(function(r){return r.json();}).catch(function(){return [];});
    });
    return Promise.all(promises).then(function(all){
      var results=[].concat.apply([],all);
      var countries={};
      results.forEach(function(r){
        if(r.status==='success'&&r.countryCode){
          if(!countries[r.countryCode]) countries[r.countryCode]={name:r.country,count:0};
          countries[r.countryCode].count++;
        }
      });
      var total=Object.keys(countries).length;
      if(!total){
        if(st){st.textContent='Geo-lookup returned no results — check internet connectivity.';st.style.color='#484f58';}
        if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
        return;
      }
      if(st){st.textContent='Found traffic to '+total+' countr'+(total===1?'y':'ies')+' · loading map…';st.style.color='#3fb950';}
      if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
      dataMapLoadDeps(function(){dataMapRender(countries);});
    });
  })
  .catch(function(e){
    if(st){st.textContent='Error fetching connections: '+e;st.style.color='#f85149';}
    if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
  });
}

function dataMapLoadDeps(cb){
  // Load topojson (D3 loaded via existing helper)
  function loadTopojson(cb2){
    if(window.topojson){cb2();return;}
    var s=document.createElement('script');
    s.src='https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js';
    s.onload=cb2;
    s.onerror=function(){if(cb2)cb2();};
    document.head.appendChild(s);
  }
  topoLoadD3(function(){loadTopojson(cb);});
}

function dataMapRender(countries){
  var svg=document.getElementById('data-map-svg');
  var wrap=document.getElementById('data-map-svg-wrap');
  var leg=document.getElementById('data-map-legend');
  var st=document.getElementById('data-map-status');
  if(!svg||!window.d3){
    if(st){st.textContent='Map library failed to load.';st.style.color='#f85149';}
    return;
  }
  d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
  .then(function(world){
    if(!world||!window.topojson){
      if(st){st.textContent='World map data failed to load.';st.style.color='#f85149';}
      return;
    }
    var counts=Object.keys(countries).map(function(k){return countries[k].count;});
    var maxCount=Math.max.apply(null,counts)||1;
    var colorScale=d3.scaleSequential().domain([0,maxCount]).interpolator(d3.interpolate('#0d3a6e','#3fb950'));

    var d3svg=d3.select('#data-map-svg');
    d3svg.selectAll('*').remove();
    var W=960,H=500;
    var projection=d3.geoNaturalEarth1().scale(160).translate([W/2,H/2]);
    var path=d3.geoPath().projection(projection);
    var tip=document.getElementById('data-map-tip');

    // ISO numeric → alpha2 lookup
    var numToA2={"4":"AF","8":"AL","12":"DZ","20":"AD","24":"AO","28":"AG","32":"AR","51":"AM","36":"AU","40":"AT","31":"AZ","44":"BS","48":"BH","50":"BD","52":"BB","112":"BY","56":"BE","84":"BZ","204":"BJ","64":"BT","68":"BO","70":"BA","72":"BW","76":"BR","96":"BN","100":"BG","854":"BF","108":"BI","132":"CV","116":"KH","120":"CM","124":"CA","140":"CF","148":"TD","152":"CL","156":"CN","170":"CO","174":"KM","180":"CD","178":"CG","188":"CR","191":"HR","192":"CU","196":"CY","203":"CZ","208":"DK","262":"DJ","212":"DM","214":"DO","218":"EC","818":"EG","222":"SV","226":"GQ","232":"ER","233":"EE","748":"SZ","231":"ET","242":"FJ","246":"FI","250":"FR","266":"GA","270":"GM","268":"GE","276":"DE","288":"GH","300":"GR","308":"GD","320":"GT","324":"GN","624":"GW","328":"GY","332":"HT","340":"HN","348":"HU","352":"IS","356":"IN","360":"ID","364":"IR","368":"IQ","372":"IE","376":"IL","380":"IT","388":"JM","392":"JP","400":"JO","398":"KZ","404":"KE","296":"KI","414":"KW","417":"KG","418":"LA","428":"LV","422":"LB","426":"LS","430":"LR","434":"LY","438":"LI","440":"LT","442":"LU","450":"MG","454":"MW","458":"MY","462":"MV","466":"ML","470":"MT","584":"MH","478":"MR","480":"MU","484":"MX","583":"FM","498":"MD","492":"MC","496":"MN","499":"ME","504":"MA","508":"MZ","104":"MM","516":"NA","520":"NR","524":"NP","528":"NL","554":"NZ","558":"NI","562":"NE","566":"NG","578":"NO","512":"OM","586":"PK","585":"PW","591":"PA","598":"PG","600":"PY","604":"PE","608":"PH","616":"PL","620":"PT","634":"QA","642":"RO","643":"RU","646":"RW","659":"KN","662":"LC","670":"VC","882":"WS","674":"SM","678":"ST","682":"SA","686":"SN","688":"RS","690":"SC","694":"SL","702":"SG","703":"SK","705":"SI","90":"SB","706":"SO","710":"ZA","728":"SS","724":"ES","144":"LK","729":"SD","740":"SR","752":"SE","756":"CH","760":"SY","158":"TW","762":"TJ","834":"TZ","764":"TH","626":"TL","768":"TG","776":"TO","780":"TT","788":"TN","792":"TR","795":"TM","798":"TV","800":"UG","804":"UA","784":"AE","826":"GB","840":"US","858":"UY","860":"UZ","548":"VU","862":"VE","704":"VN","887":"YE","894":"ZM","716":"ZW","275":"PS","807":"MK","408":"KP","410":"KR","250":"FR","304":"GL","238":"FK","732":"EH"};

    // Ocean/sphere background
    d3svg.append('path').datum({type:'Sphere'}).attr('d',path).attr('fill','#0a1628');
    // Graticule
    d3svg.append('path').datum(d3.geoGraticule()()).attr('d',path).attr('fill','none').attr('stroke','#161b22').attr('stroke-width','0.4');
    // Countries
    var features=topojson.feature(world,world.objects.countries).features;
    d3svg.selectAll('.dm-country')
      .data(features).enter().append('path')
      .attr('class','dm-country')
      .attr('d',path)
      .attr('fill',function(f){
        var a2=numToA2[String(f.id)];
        return (a2&&countries[a2])?colorScale(countries[a2].count):'#1a1f28';
      })
      .attr('stroke',function(f){
        var a2=numToA2[String(f.id)];
        return (a2&&countries[a2])?'rgba(88,166,255,0.5)':'#21262d';
      })
      .attr('stroke-width',function(f){
        var a2=numToA2[String(f.id)];
        return (a2&&countries[a2])?'0.9':'0.4';
      })
      .on('mouseover',function(event,f){
        var a2=numToA2[String(f.id)];
        var c=a2&&countries[a2];
        if(c&&tip){
          tip.innerHTML='<strong style="color:#e6edf3">'+c.name+'</strong><br>'
            +'<span style="color:#58a6ff;font-family:monospace">'+c.count+' active connection'+(c.count!==1?'s':'')+'</span>';
          tip.style.display='block';
          tip.style.left=(event.clientX+16)+'px';
          tip.style.top=(event.clientY-8)+'px';
        }
      })
      .on('mousemove',function(event){
        if(tip){tip.style.left=(event.clientX+16)+'px';tip.style.top=(event.clientY-8)+'px';}
      })
      .on('mouseout',function(){if(tip)tip.style.display='none';});

    // Country borders outline
    d3svg.append('path')
      .datum(topojson.mesh(world,world.objects.countries,function(a,b){return a!==b;}))
      .attr('d',path).attr('fill','none').attr('stroke','#21262d').attr('stroke-width','0.4');

    if(wrap) wrap.style.display='block';
    if(leg) leg.style.display='block';

    // Build top-destinations legend
    var sorted=Object.keys(countries).map(function(k){return {cc:k,name:countries[k].name,count:countries[k].count};})
      .sort(function(a,b){return b.count-a.count;}).slice(0,12);
    var ll=document.getElementById('data-map-legend-list');
    if(ll){
      ll.innerHTML=sorted.map(function(e){
        var flag=e.cc.toUpperCase().replace(/./g,function(c){return String.fromCodePoint(c.charCodeAt(0)+127397);});
        var barPct=Math.round((e.count/sorted[0].count)*100);
        return '<div style="display:flex;align-items:center;gap:6px;background:#161b22;border:1px solid #21262d;border-radius:6px;padding:5px 10px;font-size:.78em">'
          +'<span style="font-size:1.1em">'+flag+'</span>'
          +'<span style="color:#e6edf3;min-width:80px">'+e.name+'</span>'
          +'<div style="width:50px;height:4px;background:#21262d;border-radius:2px;overflow:hidden"><div style="width:'+barPct+'%;height:100%;background:#58a6ff;border-radius:2px"></div></div>'
          +'<span style="color:#58a6ff;font-family:monospace;min-width:20px;text-align:right">'+e.count+'</span>'
          +'</div>';
      }).join('');
    }
    var total=Object.keys(countries).length;
    if(st){st.textContent='Traffic detected in '+total+' countr'+(total===1?'y':'ies')+' · hover a country for details';st.style.color='#3fb950';}
  })
  .catch(function(){
    var st=document.getElementById('data-map-status');
    if(st){st.textContent='Could not load world map — check internet connection.';st.style.color='#f85149';}
  });
}

// ── Admin login / logout ──────────────────────────────────────────────────────
function adminLoginShow(){
  var m=document.getElementById('admin-modal');
  if(m){m.style.display='flex';m.style.pointerEvents='auto';setTimeout(function(){var u=document.getElementById('admin-modal-user');if(u)u.focus();},80);}
}
function adminLoginHide(){
  var m=document.getElementById('admin-modal');
  if(m){m.style.display='none';m.style.pointerEvents='none';}
  var e=document.getElementById('admin-modal-err');
  if(e)e.style.display='none';
}
function adminLoginSubmit(){
  var u=(document.getElementById('admin-modal-user')||{}).value||'';
  var p=(document.getElementById('admin-modal-pass')||{}).value||'';
  var btn=document.getElementById('admin-modal-btn');
  var err=document.getElementById('admin-modal-err');
  if(!u||!p){if(err){err.textContent='Enter username and password.';err.style.display='block';}return;}
  if(btn){btn.disabled=true;btn.textContent='Signing in…';}
  var body='rr_user='+encodeURIComponent(u)+'&rr_pass='+encodeURIComponent(p);
  fetch('/cgi-bin/rocket?admin_login',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){
      window.location.reload();
    } else {
      if(err){err.textContent=d.error||'Wrong username or password.';err.style.display='block';}
      if(btn){btn.disabled=false;btn.textContent='Sign In →';}
      var pp=document.getElementById('admin-modal-pass');
      if(pp){pp.value='';pp.focus();}
    }
  }).catch(function(){
    if(err){err.textContent='Network error — try again.';err.style.display='block';}
    if(btn){btn.disabled=false;btn.textContent='Sign In →';}
  });
}
function changeAdminPass(){
  var old=(document.getElementById('chpass-old')||{}).value||'';
  var n1=(document.getElementById('chpass-new')||{}).value||'';
  var n2=(document.getElementById('chpass-new2')||{}).value||'';
  var msg=document.getElementById('chpass-msg');
  function showMsg(text,ok){if(msg){msg.textContent=text;msg.style.background=ok?'rgba(63,185,80,.1)':'rgba(248,81,73,.1)';msg.style.border='1px solid '+(ok?'rgba(63,185,80,.35)':'rgba(248,81,73,.35)');msg.style.color=ok?'#3fb950':'#f85149';msg.style.display='block';}}
  if(!old||!n1||!n2){showMsg('Fill in all three fields.',false);return;}
  if(n1!==n2){showMsg('New passwords do not match.',false);return;}
  if(n1.length<6){showMsg('New password must be at least 6 characters.',false);return;}
  fetch('/cgi-bin/rocket?admin_chpass',{
    method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:'old='+encodeURIComponent(old)+'&new='+encodeURIComponent(n1)
  }).then(function(r){return r.json();}).then(function(d){
    if(d.ok){
      showMsg('Password changed! You will need to sign in again.',true);
      document.getElementById('chpass-old').value='';
      document.getElementById('chpass-new').value='';
      document.getElementById('chpass-new2').value='';
    } else {
      showMsg(d.error||'Failed.',false);
    }
  }).catch(function(){showMsg('Network error.',false);});
}

function adminLogout(){
  if(!confirm('Sign out of admin? The Router Explorer will be hidden until you sign back in.')) return;
  window.location.href='/cgi-bin/rocket?admin_logout';
}
// Close modal on backdrop click
document.addEventListener('click',function(e){
  var m=document.getElementById('admin-modal');
  if(m&&e.target===m)adminLoginHide();
});

// ── Router Explorer ───────────────────────────────────────────────────────────
var _exPath = '/';
var _exCurrentFile = null;
var _exEditing = false;

function explorerInit(){
  explorerNav('/');
}

function explorerNav(path){
  _exPath = path;
  _exCurrentFile = null;
  _exEditing = false;
  explorerBreadcrumb(path);
  explorerSetStatus('Loading '+path+'…');
  var encoded=encodeURIComponent(path).replace(/%2F/g,'%2F');
  fetch('/cgi-bin/rocket?explorer_list='+encodeURIComponent(path))
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.error){explorerSetStatus('Error: '+d.error);return;}
    explorerRenderList(d.entries||[], path);
    explorerSetStatus(path+' — '+(d.entries||[]).length+' items');
    // Clear viewer
    var v=document.getElementById('explorer-viewer');
    var vt=document.getElementById('explorer-viewer-toolbar');
    var ed=document.getElementById('explorer-editor');
    if(v){v.style.display='block';v.innerHTML='<span style="color:#30363d">Select a file to view it →</span>';}
    if(vt) vt.style.display='none';
    if(ed) ed.style.display='none';
  }).catch(function(e){explorerSetStatus('Error: '+e);});
}

function explorerRenderList(entries, path){
  var el=document.getElementById('explorer-list');
  if(!el) return;
  var html='';
  // Parent dir link
  if(path !== '/'){
    var parent=path.replace(/\/[^\/]+\/?$/,'') || '/';
    html+='<div onclick="explorerNav(\''+escX(parent)+'\')" style="padding:8px 14px;cursor:pointer;color:#58a6ff;border-bottom:1px solid #161b22;display:flex;align-items:center;gap:8px" onmouseover="this.style.background=\'#161b22\'" onmouseout="this.style.background=\'\'">'+
      '<span style="font-size:.9em">&#8593;</span><span>.. (up)</span></div>';
  }
  // Sort: dirs first, then files
  var dirs=entries.filter(function(e){return e.type==='dir';}).sort(function(a,b){return a.name.localeCompare(b.name);});
  var files=entries.filter(function(e){return e.type!=='dir';}).sort(function(a,b){return a.name.localeCompare(b.name);});
  dirs.concat(files).forEach(function(e){
    if(e.name==='..'||e.name==='.') return;
    var fp=(path.replace(/\/$/,'')+'/'+e.name);
    var icon = e.type==='dir' ? '&#128193;' : explorerFileIcon(e.name);
    var color = e.type==='dir' ? '#f0a500' : '#e6edf3';
    var action = e.type==='dir'
      ? 'explorerNav(\''+escX(fp)+'\')'
      : 'explorerOpenFile(\''+escX(fp)+'\',\''+escX(e.name)+'\')';
    html+='<div onclick="'+action+'" style="padding:7px 14px;cursor:pointer;border-bottom:1px solid #0d1117;display:flex;align-items:center;gap:8px" '+
      'onmouseover="this.style.background=\'#161b22\'" onmouseout="this.style.background=\'\'">'+
      '<span style="flex-shrink:0;font-size:.9em">'+icon+'</span>'+
      '<span style="color:'+color+';flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.85em">'+escH(e.name)+'</span>'+
      '<span style="color:#484f58;font-size:.7em;flex-shrink:0">'+explorerFmtSize(e.size)+'</span>'+
      '</div>';
  });
  if(!html) html='<div style="padding:20px;color:#484f58;font-size:.82em;text-align:center">Empty directory</div>';
  el.innerHTML=html;
}

function explorerFileIcon(name){
  var ext=(name.split('.').pop()||'').toLowerCase();
  var icons={sh:'&#128736;',conf:'&#9881;',json:'&#9881;',lua:'&#128196;',py:'&#128013;',js:'&#128196;',html:'&#127758;',css:'&#127912;',log:'&#128203;',txt:'&#128196;',gz:'&#128230;',tar:'&#128230;',zip:'&#128230;',bz2:'&#128230;'};
  return icons[ext]||'&#128196;';
}
function explorerFmtSize(s){
  var n=parseInt(s)||0;
  if(n>=1048576) return (n/1048576).toFixed(1)+'M';
  if(n>=1024) return Math.round(n/1024)+'K';
  if(n>0) return n+'B';
  return '';
}

function explorerOpenFile(path, name){
  _exCurrentFile=path;
  _exEditing=false;
  var v=document.getElementById('explorer-viewer');
  var vt=document.getElementById('explorer-viewer-toolbar');
  var vn=document.getElementById('explorer-viewer-name');
  var ed=document.getElementById('explorer-editor');
  var sb=document.getElementById('explorer-save-btn');
  var eb=document.getElementById('explorer-edit-btn');
  var cb=document.getElementById('explorer-cancel-btn');
  if(v){v.style.display='block';v.innerHTML='<span style="color:#484f58">Loading '+escH(name)+'…</span>';}
  if(ed) ed.style.display='none';
  if(vt){vt.style.display='flex';}
  if(vn) vn.textContent=path;
  if(sb) sb.style.display='none';
  if(cb) cb.style.display='none';
  if(eb) eb.style.display='inline-block';
  explorerSetStatus('Reading '+path+'…');
  fetch('/cgi-bin/rocket?explorer_read='+encodeURIComponent(path))
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.error){
      if(v) v.innerHTML='<span style="color:#f85149">'+escH(d.error)+'</span>';
      explorerSetStatus('Error reading file.');
      return;
    }
    if(d.binary){
      if(v) v.innerHTML='<div style="color:#f0a500;padding:8px 0">&#128230; Binary file ('+explorerFmtSize(d.size)+')<br><span style="color:#484f58;font-size:.9em">Cannot display — use Download to get a copy</span></div>';
      if(eb) eb.style.display='none';
      explorerSetStatus(path+' — binary, '+explorerFmtSize(d.size));
      return;
    }
    var content=d.content||'';
    // Unescape the JSON-escaped content
    content=content.replace(/\\n/g,String.fromCharCode(10)).replace(/\\t/g,String.fromCharCode(9)).replace(/\\"/g,'"').replace(/\\\\/g,String.fromCharCode(92));
    if(v) v.innerHTML='<code style="color:#e6edf3;font-size:.78em;line-height:1.8;display:block">'+escH(content)+'</code>';
    // Store for editing
    v._rawContent=content;
    explorerSetStatus(path+' — '+explorerFmtSize(d.size));
  }).catch(function(e){
    if(v) v.innerHTML='<span style="color:#f85149">Error: '+e+'</span>';
    explorerSetStatus('Error.');
  });
}

function explorerStartEdit(){
  var v=document.getElementById('explorer-viewer');
  var ed=document.getElementById('explorer-editor');
  var sb=document.getElementById('explorer-save-btn');
  var eb=document.getElementById('explorer-edit-btn');
  var cb=document.getElementById('explorer-cancel-btn');
  if(!v||!ed) return;
  var content=v._rawContent||v.textContent||'';
  ed.value=content;
  v.style.display='none';
  ed.style.display='block';
  _exEditing=true;
  if(sb) sb.style.display='inline-block';
  if(cb) cb.style.display='inline-block';
  if(eb) eb.style.display='none';
  ed.focus();
}
function explorerCancelEdit(){
  var v=document.getElementById('explorer-viewer');
  var ed=document.getElementById('explorer-editor');
  var sb=document.getElementById('explorer-save-btn');
  var eb=document.getElementById('explorer-edit-btn');
  var cb=document.getElementById('explorer-cancel-btn');
  if(v) v.style.display='block';
  if(ed) ed.style.display='none';
  _exEditing=false;
  if(sb) sb.style.display='none';
  if(cb) cb.style.display='none';
  if(eb) eb.style.display='inline-block';
}
function explorerSave(){
  if(!_exCurrentFile){return;}
  var ed=document.getElementById('explorer-editor');
  if(!ed) return;
  var content=ed.value;
  if(!confirm('Save changes to '+_exCurrentFile+'?')) return;
  explorerSetStatus('Saving…');
  fetch('/cgi-bin/rocket?explorer_write='+encodeURIComponent(_exCurrentFile),{
    method:'POST',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:'content='+encodeURIComponent(content)
  })
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){
      explorerSetStatus('Saved: '+_exCurrentFile);
      explorerCancelEdit();
      explorerOpenFile(_exCurrentFile, _exCurrentFile.split('/').pop());
    } else {
      explorerSetStatus('Save failed: '+(d.error||'unknown error'));
    }
  }).catch(function(){explorerSetStatus('Save error.');});
}
function explorerDownload(){
  if(!_exCurrentFile) return;
  var a=document.createElement('a');
  a.href='/cgi-bin/rocket?explorer_read='+encodeURIComponent(_exCurrentFile);
  a.download=_exCurrentFile.split('/').pop();
  document.body.appendChild(a);a.click();document.body.removeChild(a);
}
function explorerDeleteCurrent(){
  if(!_exCurrentFile) return;
  if(!confirm('Delete '+_exCurrentFile+'?\nThis cannot be undone.')) return;
  explorerSetStatus('Deleting…');
  fetch('/cgi-bin/rocket?explorer_delete='+encodeURIComponent(_exCurrentFile))
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){
      explorerSetStatus('Deleted: '+_exCurrentFile);
      _exCurrentFile=null;
      var v=document.getElementById('explorer-viewer');
      var vt=document.getElementById('explorer-viewer-toolbar');
      if(v){v.innerHTML='<span style="color:#484f58">File deleted.</span>';}
      if(vt) vt.style.display='none';
      explorerNav(_exPath);
    } else {
      explorerSetStatus('Delete failed: '+(d.error||'unknown'));
    }
  }).catch(function(){explorerSetStatus('Delete error.');});
}
function explorerRefresh(){ explorerNav(_exPath); }
function explorerMkdir(){
  var name=prompt('New folder name:');
  if(!name) return;
  var fp=(_exPath.replace(/\/$/,'')+'/'+name);
  fetch('/cgi-bin/rocket?explorer_mkdir='+encodeURIComponent(fp))
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){explorerNav(_exPath);}
    else{alert('Failed: '+(d.error||'unknown'));}
  }).catch(function(){alert('Network error.');});
}
function explorerUploadClick(){
  var i=document.getElementById('explorer-upload-input');
  if(i) i.click();
}
function explorerUploadFile(input){
  if(!input.files||!input.files[0]) return;
  var file=input.files[0];
  var fp=(_exPath.replace(/\/$/,'')+'/'+file.name);
  explorerSetStatus('Uploading '+file.name+'…');
  var reader=new FileReader();
  reader.onload=function(e){
    var content=e.target.result;
    fetch('/cgi-bin/rocket?explorer_write='+encodeURIComponent(fp),{
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:'content='+encodeURIComponent(content)
    })
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.ok){explorerSetStatus('Uploaded: '+fp);explorerNav(_exPath);}
      else{explorerSetStatus('Upload failed: '+(d.error||'unknown'));}
    }).catch(function(){explorerSetStatus('Upload error.');});
  };
  reader.readAsText(file);
  input.value='';
}
function explorerBreadcrumb(path){
  var el=document.getElementById('explorer-breadcrumb');
  if(!el) return;
  var parts=path.replace(/\/$/,'').split('/').filter(function(p){return p!==undefined;});
  var html='<span onclick="explorerNav(\'/\')" style="cursor:pointer;color:#58a6ff" onmouseover="this.style.color=\'#79c0ff\'" onmouseout="this.style.color=\'#58a6ff\'">/ root</span>';
  var built='/';
  parts.forEach(function(p){
    if(!p) return;
    built+=(built==='/'?'':'/') + p;
    var bp=built;
    html+='<span style="color:#30363d">/</span><span onclick="explorerNav(\''+escX(bp)+'\')" style="cursor:pointer;color:#58a6ff" onmouseover="this.style.color=\'#79c0ff\'" onmouseout="this.style.color=\'#58a6ff\'">'+escH(p)+'</span>';
  });
  el.innerHTML=html;
}
function explorerSetStatus(msg){
  var el=document.getElementById('explorer-status');
  if(el) el.textContent=msg;
}
function escH(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function escX(s){return String(s).replace(/'/g,"\\'");}

// Hook Expert tab
(function(){
  var _origShowEx=window.show;
  window.show=function(tab,el){
    if(typeof _origShowEx==='function') _origShowEx(tab,el);
    if(tab==='exp'){setTimeout(initWanIfaceDefaults,150);setTimeout(cakeLoad,400);setTimeout(bwGraphInit,700);setTimeout(dnsLoad,200);setTimeout(initLocalMesh,600);setTimeout(updateExpMeshStatus,700);setTimeout(vnstatLoad,800);}
    if(tab==='map'){if(!_dmtAutoLoaded){_dmtAutoLoaded=true;setTimeout(dataMapTabLoad,300);}}
    if(tab==='explorer'){explorerInit();}
  };
})();

// ── World Map tab implementation ───────────────────────────────────────────────
var _dmtAutoLoaded = false;

function dataMapTabLoad(){
  var btn=document.getElementById('dmt-btn');
  var st=document.getElementById('dmt-status');
  var wrap=document.getElementById('dmt-svg-wrap');
  var leg=document.getElementById('dmt-legend');
  if(btn){btn.disabled=true;btn.textContent='⏳ Scanning…';}
  if(wrap) wrap.style.display='none';
  if(leg) leg.style.display='none';
  if(st){st.textContent='Reading active connections from firewall table…';st.style.color='#f0a500';}
  fetch('/cgi-bin/rocket?traffic_countries')
  .then(function(r){return r.json();})
  .then(function(d){
    var ips=(d.ips||[]);
    if(!ips.length){
      if(st){st.textContent='No external connections active right now — try browsing something first.';st.style.color='#484f58';}
      if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
      return;
    }
    if(st){st.textContent='Geo-locating '+ips.length+' IP'+(ips.length!==1?'s':'')+'…';st.style.color='#f0a500';}
    var chunks=[];
    for(var i=0;i<ips.length;i+=100) chunks.push(ips.slice(i,i+100));
    var promises=chunks.map(function(chunk){
      return fetch('http://ip-api.com/batch?fields=status,country,countryCode,query',{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify(chunk.map(function(ip){return {query:ip};}))
      }).then(function(r){return r.json();}).catch(function(){return [];});
    });
    return Promise.all(promises).then(function(all){
      var results=[].concat.apply([],all);
      var countries={};
      results.forEach(function(r){if(r.status==='success'&&r.countryCode){if(!countries[r.countryCode])countries[r.countryCode]={name:r.country,count:0};countries[r.countryCode].count++;}});
      var total=Object.keys(countries).length;
      if(!total){if(st){st.textContent='Geo-lookup returned no results.';st.style.color='#484f58';}if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}return;}
      if(st){st.textContent='Found traffic to '+total+' countr'+(total===1?'y':'ies')+' · loading map…';st.style.color='#3fb950';}
      if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
      dataMapLoadDeps(function(){dataMapTabRender(countries);});
    });
  }).catch(function(e){
    if(st){st.textContent='Error: '+e;st.style.color='#f85149';}
    if(btn){btn.disabled=false;btn.textContent='🔄 Refresh';}
  });
}

function dataMapTabRender(countries){
  var svgEl=document.getElementById('dmt-svg');
  var wrap=document.getElementById('dmt-svg-wrap');
  var leg=document.getElementById('dmt-legend');
  var st=document.getElementById('dmt-status');
  if(!svgEl||!window.d3) return;
  d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
  .then(function(world){
    if(!world||!window.topojson) return;
    var counts=Object.keys(countries).map(function(k){return countries[k].count;});
    var maxCount=Math.max.apply(null,counts)||1;
    var colorScale=d3.scaleSequential().domain([0,maxCount]).interpolator(d3.interpolate('#0d3a6e','#3fb950'));
    var d3svg=d3.select('#dmt-svg');
    d3svg.selectAll('*').remove();
    var W=960,H=500;
    var projection=d3.geoNaturalEarth1().scale(160).translate([W/2,H/2]);
    var path=d3.geoPath().projection(projection);
    var tip=document.getElementById('dmt-tip');
    var numToA2={"4":"AF","8":"AL","12":"DZ","20":"AD","24":"AO","28":"AG","32":"AR","51":"AM","36":"AU","40":"AT","31":"AZ","44":"BS","48":"BH","50":"BD","52":"BB","112":"BY","56":"BE","84":"BZ","204":"BJ","64":"BT","68":"BO","70":"BA","72":"BW","76":"BR","96":"BN","100":"BG","854":"BF","108":"BI","132":"CV","116":"KH","120":"CM","124":"CA","140":"CF","148":"TD","152":"CL","156":"CN","170":"CO","174":"KM","180":"CD","178":"CG","188":"CR","191":"HR","192":"CU","196":"CY","203":"CZ","208":"DK","262":"DJ","212":"DM","214":"DO","218":"EC","818":"EG","222":"SV","226":"GQ","232":"ER","233":"EE","748":"SZ","231":"ET","242":"FJ","246":"FI","250":"FR","266":"GA","270":"GM","268":"GE","276":"DE","288":"GH","300":"GR","308":"GD","320":"GT","324":"GN","624":"GW","328":"GY","332":"HT","340":"HN","348":"HU","352":"IS","356":"IN","360":"ID","364":"IR","368":"IQ","372":"IE","376":"IL","380":"IT","388":"JM","392":"JP","400":"JO","398":"KZ","404":"KE","296":"KI","414":"KW","417":"KG","418":"LA","428":"LV","422":"LB","426":"LS","430":"LR","434":"LY","438":"LI","440":"LT","442":"LU","450":"MG","454":"MW","458":"MY","462":"MV","466":"ML","470":"MT","584":"MH","478":"MR","480":"MU","484":"MX","583":"FM","498":"MD","492":"MC","496":"MN","499":"ME","504":"MA","508":"MZ","104":"MM","516":"NA","520":"NR","524":"NP","528":"NL","554":"NZ","558":"NI","562":"NE","566":"NG","578":"NO","512":"OM","586":"PK","585":"PW","591":"PA","598":"PG","600":"PY","604":"PE","608":"PH","616":"PL","620":"PT","634":"QA","642":"RO","643":"RU","646":"RW","659":"KN","662":"LC","670":"VC","882":"WS","674":"SM","678":"ST","682":"SA","686":"SN","688":"RS","690":"SC","694":"SL","702":"SG","703":"SK","705":"SI","90":"SB","706":"SO","710":"ZA","728":"SS","724":"ES","144":"LK","729":"SD","740":"SR","752":"SE","756":"CH","760":"SY","158":"TW","762":"TJ","834":"TZ","764":"TH","626":"TL","768":"TG","776":"TO","780":"TT","788":"TN","792":"TR","795":"TM","798":"TV","800":"UG","804":"UA","784":"AE","826":"GB","840":"US","858":"UY","860":"UZ","548":"VU","862":"VE","704":"VN","887":"YE","894":"ZM","716":"ZW","275":"PS","807":"MK","408":"KP","410":"KR","304":"GL","238":"FK","732":"EH"};
    d3svg.append('path').datum({type:'Sphere'}).attr('d',path).attr('fill','#0a1628');
    d3svg.append('path').datum(d3.geoGraticule()()).attr('d',path).attr('fill','none').attr('stroke','#161b22').attr('stroke-width','0.4');
    var features=topojson.feature(world,world.objects.countries).features;
    d3svg.selectAll('.dmt-country').data(features).enter().append('path')
      .attr('class','dmt-country').attr('d',path)
      .attr('fill',function(f){var a2=numToA2[String(f.id)];return (a2&&countries[a2])?colorScale(countries[a2].count):'#1a1f28';})
      .attr('stroke',function(f){var a2=numToA2[String(f.id)];return (a2&&countries[a2])?'rgba(88,166,255,0.5)':'#21262d';})
      .attr('stroke-width',function(f){var a2=numToA2[String(f.id)];return (a2&&countries[a2])?'0.9':'0.4';})
      .on('mouseover',function(event,f){
        var a2=numToA2[String(f.id)],c=a2&&countries[a2];
        if(c&&tip){tip.innerHTML='<strong style="color:#e6edf3">'+c.name+'</strong><br><span style="color:#58a6ff;font-family:monospace">'+c.count+' connection'+(c.count!==1?'s':'')+'</span>';tip.style.display='block';tip.style.left=(event.clientX+16)+'px';tip.style.top=(event.clientY-8)+'px';}
      })
      .on('mousemove',function(event){if(tip){tip.style.left=(event.clientX+16)+'px';tip.style.top=(event.clientY-8)+'px';}})
      .on('mouseout',function(){if(tip)tip.style.display='none';});
    d3svg.append('path').datum(topojson.mesh(world,world.objects.countries,function(a,b){return a!==b;})).attr('d',path).attr('fill','none').attr('stroke','#21262d').attr('stroke-width','0.4');
    if(wrap) wrap.style.display='block';
    if(leg) leg.style.display='block';
    var sorted=Object.keys(countries).map(function(k){return {cc:k,name:countries[k].name,count:countries[k].count};}).sort(function(a,b){return b.count-a.count;}).slice(0,12);
    var ll=document.getElementById('dmt-legend-list');
    if(ll){
      ll.innerHTML=sorted.map(function(e){
        var flag=e.cc.toUpperCase().replace(/./g,function(c){return String.fromCodePoint(c.charCodeAt(0)+127397);});
        var barPct=Math.round((e.count/sorted[0].count)*100);
        return '<div style="display:flex;align-items:center;gap:6px;background:#161b22;border:1px solid #21262d;border-radius:6px;padding:5px 10px;font-size:.78em">'
          +'<span style="font-size:1.1em">'+flag+'</span><span style="color:#e6edf3;min-width:80px">'+e.name+'</span>'
          +'<div style="width:50px;height:4px;background:#21262d;border-radius:2px;overflow:hidden"><div style="width:'+barPct+'%;height:100%;background:#58a6ff;border-radius:2px"></div></div>'
          +'<span style="color:#58a6ff;font-family:monospace;min-width:20px;text-align:right">'+e.count+'</span></div>';
      }).join('');
    }
    var total=Object.keys(countries).length;
    if(st){st.textContent='Traffic in '+total+' countr'+(total===1?'y':'ies')+' · hover a country for details';st.style.color='#3fb950';}
  }).catch(function(){if(st){st.textContent='Could not load world map data.';st.style.color='#f85149';}});
}


// ══════════════════════════════════════════════════════════════════════════════
// INTEL TAB — JS
// ══════════════════════════════════════════════════════════════════════════════

function initIntel(){
  intelLoadSignal();
  intelLoadSpeeds();
  intelCheckAnomalies();
  intelCheckCronStatus();
  constitutionLoad();
}

function intelCheckCronStatus(){
  fetch('/cgi-bin/rocket?insights_cron_status')
  .then(function(r){return r.json();})
  .then(function(d){intelSetCronBtn(d.active);})
  .catch(function(){});
}

function intelSetCronBtn(active){
  var btn=document.getElementById('intel-cron-btn');
  if(!btn) return;
  if(active){
    btn.textContent='⏹ Disable Background Monitoring';
    btn.style.background='rgba(248,81,73,.1)';
    btn.style.borderColor='rgba(248,81,73,.3)';
    btn.style.color='#f85149';
  } else {
    btn.textContent='⚡ Enable Background Monitoring';
    btn.style.background='rgba(63,185,80,.12)';
    btn.style.borderColor='rgba(63,185,80,.3)';
    btn.style.color='#3fb950';
  }
  btn.disabled=false;
}

function intelToggleCron(){
  var btn=document.getElementById('intel-cron-btn');
  var isActive=btn&&btn.textContent.indexOf('Disable')!==-1;
  if(btn){btn.disabled=true;btn.textContent=isActive?'Stopping...':'Starting...';}
  var endpoint=isActive?'insights_cron_disable':'insights_cron_setup';
  fetch('/cgi-bin/rocket?'+endpoint)
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.error==='admin_required'){alert('Admin login required.');if(btn){btn.disabled=false;intelSetCronBtn(!isActive);}return;}
    intelSetCronBtn(!isActive);
  })
  .catch(function(){if(btn){btn.disabled=false;intelSetCronBtn(isActive);}});
}

// ── Signal Trend ─────────────────────────────────────────────────────────────
function intelLoadSignal(){
  var btn=document.querySelector('[onclick="intelLoadSignal()"]');
  if(btn){btn.textContent='↻ Loading...';btn.disabled=true;}
  fetch('/cgi-bin/rocket?signal_history')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.textContent='↻ Refresh';btn.disabled=false;}
    var data=d.readings||[];
    if(!data.length){
      var el=document.getElementById('intel-sig-analysis');
      if(el) el.textContent='No signal history yet. Enable background monitoring to start logging.';
      return;
    }
    intelDrawSignalChart(data);
    intelAnalyseSignal(data);
  }).catch(function(){if(btn){btn.textContent='↻ Refresh';btn.disabled=false;}});
}

function intelDrawSignalChart(data){
  var canvas=document.getElementById('intel-sig-canvas');
  if(!canvas) return;
  var ctx=canvas.getContext('2d');
  var W=canvas.offsetWidth||800; canvas.width=W; var H=140;
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d1117'; ctx.fillRect(0,0,W,H);
  var n=data.length; if(n<2) return;
  var rsrpVals=data.map(function(r){return r[1];});
  var sinrVals=data.map(function(r){return r[2];});
  var rsrpMin=Math.min.apply(null,rsrpVals)-5, rsrpMax=Math.max.apply(null,rsrpVals)+5;
  var sinrMin=Math.min.apply(null,sinrVals)-2, sinrMax=Math.max.apply(null,sinrVals)+2;
  function xP(i){return Math.round(i/(n-1)*(W-20)+10);}
  function yR(v){return Math.round(H*0.1+(1-(v-rsrpMin)/(rsrpMax-rsrpMin))*H*0.8);}
  function yS(v){return Math.round(H*0.1+(1-(v-sinrMin)/(sinrMax-sinrMin))*H*0.8);}
  ctx.beginPath(); ctx.strokeStyle='#58a6ff'; ctx.lineWidth=1.5;
  data.forEach(function(r,i){i===0?ctx.moveTo(xP(i),yR(r[1])):ctx.lineTo(xP(i),yR(r[1]));});
  ctx.stroke();
  ctx.beginPath(); ctx.strokeStyle='#3fb950'; ctx.lineWidth=1.5;
  data.forEach(function(r,i){i===0?ctx.moveTo(xP(i),yS(r[2])):ctx.lineTo(xP(i),yS(r[2]));});
  ctx.stroke();
  ctx.fillStyle='#484f58'; ctx.font='10px monospace';
  ctx.fillText('RSRP: '+rsrpVals[rsrpVals.length-1]+' dBm',10,12);
  ctx.fillText('SINR: '+sinrVals[sinrVals.length-1]+' dB',W-110,12);
  ctx.fillText(n+' readings',W/2-20,H-4);
}

function intelAnalyseSignal(data){
  var el=document.getElementById('intel-sig-analysis');
  if(!el||data.length<6) return;
  var recent=data.slice(-12), older=data.slice(0,12);
  var avgR=recent.reduce(function(s,r){return s+r[2];},0)/recent.length;
  var avgO=older.reduce(function(s,r){return s+r[2];},0)/older.length;
  var trend=avgR-avgO;
  var trendStr=trend>1?'improving':trend<-1?'declining':'stable';
  var sinrNow=data[data.length-1][2];
  var qual=sinrNow>=20?'Excellent':sinrNow>=13?'Good':sinrNow>=0?'Fair':'Poor';
  var worst=data.reduce(function(m,r){return r[2]<m[2]?r:m;},data[0]);
  var wt=new Date(worst[0]*1000);
  el.innerHTML='Signal trend: <strong style="color:#e6edf3">'+trendStr+'</strong> &nbsp;|&nbsp; '
    +'Current SINR: <strong style="color:#3fb950">'+sinrNow+' dB ('+qual+')</strong> &nbsp;|&nbsp; '
    +'Worst: <strong style="color:#f0a500">'+worst[2]+' dB</strong> at '
    +wt.toLocaleTimeString()+' '+wt.toLocaleDateString()
    +' &nbsp;<span style="color:#8b949e;font-size:.9em">· refreshed '+new Date().toLocaleTimeString()+'</span>';
}

// ── ISP Evidence Reporter ─────────────────────────────────────────────────────
function intelLoadSpeeds(){
  fetch('/cgi-bin/rocket?speedtest_history')
  .then(function(r){return r.json();})
  .then(function(d){
    var results=d.data||d.results||[];
    intelDrawSpeedChart(results);
    intelSpeedSummary(results);
  }).catch(function(){});
}

function intelRunSpeedtest(){
  var btn=document.getElementById('intel-spd-btn');
  var st=document.getElementById('intel-spd-status');
  if(btn) btn.disabled=true;
  if(st) st.textContent='Running speed test (up to 30s)...';
  fetch('/cgi-bin/rocket?speedtest_run')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn) btn.disabled=false;
    if(st) st.innerHTML='<span style="color:#3fb950;font-weight:600">✓ '+parseFloat(d.dl).toFixed(1)+' Mbps</span> &nbsp;·&nbsp; tested at '+new Date(d.ts*1000).toLocaleTimeString()+' on '+new Date(d.ts*1000).toLocaleDateString();
    intelLoadSpeeds();
  }).catch(function(){
    if(btn) btn.disabled=false;
    if(st) st.textContent='Test failed — check internet connection';
  });
}

function intelDrawSpeedChart(results){
  var canvas=document.getElementById('intel-spd-canvas');
  if(!canvas||!results.length) return;
  var ctx=canvas.getContext('2d');
  // getBoundingClientRect gives the true CSS pixel width when the tab is visible,
  // avoiding the offsetWidth=800 (HTML attribute) vs actual display width mismatch
  var rect=canvas.getBoundingClientRect();
  var W=Math.round(rect.width)||canvas.clientWidth||canvas.offsetWidth||600;
  canvas.width=W; var H=120; canvas.height=H;
  ctx.clearRect(0,0,W,H); ctx.fillStyle='#0d1117'; ctx.fillRect(0,0,W,H);
  var n=results.length; if(!n) return;
  var speeds=results.map(function(r){return parseFloat(r.dl)||0;});
  var maxS=Math.max.apply(null,speeds)||1;
  // Proportional slot distribution — bars always fill full canvas width
  var slot=W/n;
  var gap=n>1?Math.max(1,Math.round(slot*0.1)):0;
  var barW=Math.max(2,Math.floor(slot-gap));
  speeds.forEach(function(s,i){
    var x=Math.round(i*slot)+Math.floor(gap/2);
    var h=Math.round((s/maxS)*(H-24));
    var pct=s/maxS;
    ctx.fillStyle=pct>0.7?'#3fb950':pct>0.4?'#f0a500':'#f85149';
    ctx.fillRect(x,H-12-h,barW,h);
  });
  ctx.fillStyle='#484f58'; ctx.font='10px monospace';
  ctx.fillText('Max: '+maxS.toFixed(1)+' Mbps',8,12);
  ctx.fillText(n+' tests recorded',W/2-40,12);
}

function intelSpeedSummary(results){
  var el=document.getElementById('intel-spd-summary');
  if(!el) return;
  if(!results.length){
    el.textContent='No tests recorded yet. Run a test now or enable background monitoring (auto-tests every 6 hours).';
    return;
  }
  var speeds=results.map(function(r){return parseFloat(r.dl)||0;});
  var avg=speeds.reduce(function(a,b){return a+b;},0)/speeds.length;
  var min=Math.min.apply(null,speeds), max=Math.max.apply(null,speeds);
  var lastResult=results[results.length-1];
  var lastTime=new Date(lastResult.ts*1000);
  el.innerHTML='<div style="margin-bottom:6px;font-size:.85em;color:#c9d1d9">Last test: <strong style="color:#3fb950">'+parseFloat(lastResult.dl).toFixed(1)+' Mbps</strong> &nbsp;·&nbsp; '+lastTime.toLocaleTimeString()+' on '+lastTime.toLocaleDateString()+'</div>'
    +'Avg: <strong style="color:#3fb950">'+avg.toFixed(1)+' Mbps</strong> &nbsp;|&nbsp; '
    +'Min: <strong style="color:#f85149">'+min.toFixed(1)+'</strong> &nbsp;|&nbsp; '
    +'Max: <strong style="color:#58a6ff">'+max.toFixed(1)+'</strong> &nbsp;|&nbsp; '
    +results.length+' tests recorded &nbsp;|&nbsp; <span style="color:#c9d1d9">Export CSV to build an ISP complaint file.</span>';
}

function intelExportSpeeds(){
  fetch('/cgi-bin/rocket?speedtest_history')
  .then(function(r){return r.json();})
  .then(function(d){
    var results=d.data||d.results||[];
    if(!results.length){alert('No tests recorded yet.');return;}
    var csv='Timestamp,Date,Download_Mbps\n';
    results.forEach(function(r){csv+=r.ts+','+new Date(r.ts*1000).toISOString()+','+r.dl+'\n';});
    var blob=new Blob([csv],{type:'text/csv'});
    var url=URL.createObjectURL(blob);
    var a=document.createElement('a');
    a.href=url; a.download='isp-evidence-'+new Date().toISOString().slice(0,10)+'.csv';
    a.click(); URL.revokeObjectURL(url);
  });
}

// ── Network Time Machine ──────────────────────────────────────────────────────
function intelSnapshotNow(btn){
  var orig = btn ? btn.textContent : '';
  if(btn){ btn.textContent='⏳ Snapping…'; btn.disabled=true; }
  fetch('/cgi-bin/rocket?timemachine_snapshot')
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(btn){ btn.textContent='✓ Done'; setTimeout(function(){ btn.textContent=orig; btn.disabled=false; },1800); }
    setTimeout(intelLoadTimeMachine, 400);
  }).catch(function(){
    if(btn){ btn.textContent='✗ Failed'; setTimeout(function(){ btn.textContent=orig; btn.disabled=false; },2000); }
  });
}
function intelLoadTimeMachine(){
  var el=document.getElementById('intel-tm-content');
  if(el) el.innerHTML='<span style="color:#484f58">Loading snapshots...</span>';
  fetch('/cgi-bin/rocket?timemachine_data')
  .then(function(r){
    if(!r.ok) throw new Error('HTTP '+r.status);
    return r.json();
  })
  .then(function(d){
    var snaps=d.snapshots||[];
    if(!snaps.length){
      if(el) el.innerHTML='<span style="color:#8b949e">No snapshots yet. Background monitoring takes a traffic snapshot every hour on the hour. If you just enabled it, check back after the next full hour.</span>';
      return;
    }
    try{ intelRenderTimeMachine(snaps); }
    catch(e){ if(el) el.innerHTML='<span style="color:#8b949e">'+snaps.length+' snapshot'+(snaps.length!==1?'s':'')+' found. Render error: '+escH(String(e))+'</span>'; }
  }).catch(function(e){if(el) el.innerHTML='<span style="color:#8b949e">Could not load snapshots — check router connection. ('+escH(String(e))+')</span>';});
}

function intelRenderTimeMachine(snaps){
  var el=document.getElementById('intel-tm-content');
  if(!el) return;
  var devices={};
  snaps.forEach(function(snap){
    if(!snap.devices) return;
    Object.keys(snap.devices).forEach(function(ip){
      var d=snap.devices[ip];
      if(!devices[ip]) devices[ip]={name:d.name,peak:0};
      if(d.bytes>devices[ip].peak) devices[ip].peak=d.bytes;
    });
  });
  var devList=Object.keys(devices).sort(function(a,b){return devices[b].peak-devices[a].peak;});
  var html='<div style="font-size:.78em;color:#484f58;margin-bottom:10px">'+snaps.length+' snapshots &nbsp;|&nbsp; '+devList.length+' devices</div>';
  html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:8px">';
  devList.forEach(function(ip){
    var d=devices[ip], b=d.peak;
    var lbl=b>1073741824?(b/1073741824).toFixed(2)+' GB':b>1048576?(b/1048576).toFixed(1)+' MB':(b/1024).toFixed(0)+' KB';
    html+='<div style="background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:10px">'
      +'<div style="font-size:.82em;font-weight:600;color:#e6edf3">'+escH(d.name)+'</div>'
      +'<div style="font-size:.72em;color:#484f58">'+ip+'</div>'
      +'<div style="font-size:.84em;color:#58a6ff;margin-top:4px">Peak: '+lbl+'</div></div>';
  });
  html+='</div>';
  el.innerHTML=html;
}

// ── Anomaly Watchdog ──────────────────────────────────────────────────────────
function intelCheckAnomalies(){
  var btn=document.querySelector('[onclick="intelCheckAnomalies()"]');
  if(btn){btn.textContent='↻ Checking...';btn.disabled=true;}
  fetch('/cgi-bin/rocket?anomaly_check')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.textContent='↻ Check Now';btn.disabled=false;}
    intelRenderAnomalies(d.alerts||[]);
  })
  .catch(function(){if(btn){btn.textContent='↻ Check Now';btn.disabled=false;}});
}

function intelClearAnomalies(){
  fetch('/cgi-bin/rocket?anomaly_clear').then(function(){
    var el=document.getElementById('intel-anom-feed');
    if(el) el.innerHTML='<span style="color:#3fb950">Cleared.</span>';
  });
}

function intelRenderAnomalies(alerts){
  var el=document.getElementById('intel-anom-feed');
  if(!el) return;
  if(!alerts.length){
    el.innerHTML='<span style="color:#3fb950">No anomalies detected.</span> '
      +'<span style="color:#c9d1d9">Cron checks every 5 min. Alert threshold: 200MB in a 5-minute window.</span>';
    return;
  }
  var html='';
  alerts.slice(0,20).forEach(function(a){
    var t=new Date(a.ts*1000);
    html+='<div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #21262d;align-items:flex-start">'
      +'<span style="color:#f85149;flex-shrink:0">!</span>'
      +'<div><div style="font-size:.82em;color:#e6edf3">'+escH(a.msg||'Traffic spike detected')+'</div>'
      +'<div style="font-size:.72em;color:#484f58">'+t.toLocaleString()+'</div></div></div>';
  });
  el.innerHTML=html;
}

// ── Per-Device VPN Routing ────────────────────────────────────────────────────
function intelLoadVpnRouting(){
  var el=document.getElementById('intel-vpn-content');
  if(el) el.innerHTML='<span style="color:#484f58">Loading...</span>';
  fetch('/cgi-bin/rocket?vpn_routing_get')
  .then(function(r){return r.json();})
  .then(function(d){intelRenderVpnRouting(d);})
  .catch(function(){if(el) el.textContent='Load failed';});
}

function intelRenderVpnRouting(d){
  var el=document.getElementById('intel-vpn-content');
  if(!el) return;
  var tunnels=d.tunnels||[], devices=d.devices||[];
  if(!devices.length){el.innerHTML='<span style="color:#484f58">No DHCP devices found.</span>';return;}
  var opts='<option value="direct">Direct Internet</option>';
  tunnels.forEach(function(t){opts+='<option value="'+t.iface+'">'+t.iface+' ('+t.addr+')</option>';});
  if(!tunnels.length) opts+='<option disabled>No WireGuard interfaces configured</option>';
  var html='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px">';
  devices.forEach(function(dev){
    var selOpts=opts.replace('value="'+dev.tunnel+'"','value="'+dev.tunnel+'" selected');
    var vpnDispName=_getDevName(dev.mac,dev.name);
    var vpnMac=dev.mac||'';
    html+='<div style="background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:12px">'
      +'<div style="font-size:.85em;font-weight:600;color:#e6edf3;margin-bottom:2px">'
      +(vpnMac?'<span data-devmac="'+vpnMac+'" onclick="wdevRename(this,\''+vpnMac+'\')" title="Click to rename" style="cursor:pointer;border-bottom:1px dashed rgba(230,237,243,.15)">'+escH(vpnDispName)+'</span>':escH(vpnDispName))
      +'</div>'
      +'<div style="font-size:.72em;color:#484f58;margin-bottom:8px">'+dev.ip+(vpnMac?' · <span style="color:#58a6ff;font-size:.9em">'+(_ouiLookup(vpnMac)||'')+'</span>':'')+'</div>'
      +'<select onchange="intelSetVpnRoute(\''+dev.ip+'\',this.value)" '
      +'style="width:100%;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px;font-size:.78em">'
      +selOpts+'</select></div>';
  });
  html+='</div>';
  el.innerHTML=html;
}

function intelSetVpnRoute(ip,tunnel){
  fetch('/cgi-bin/rocket?vpn_routing_set&ip='+encodeURIComponent(ip)+'&tunnel='+encodeURIComponent(tunnel))
  .then(function(r){return r.json();})
  .then(function(d){if(!d.ok) alert('Error: '+(d.error||'unknown'));})
  .catch(function(){alert('Request failed');});
}

// ── Device Obituary ──────────────────────────────────────────────────────────
function obituaryLoad(){
  var el=document.getElementById('obit-content');
  if(el) el.innerHTML='<span style="color:#484f58">Checking...</span>';
  fetch('/cgi-bin/rocket?device_obituaries_read')
  .then(function(r){
    if(!r.ok) throw new Error('HTTP '+r.status);
    return r.json();
  })
  .then(function(d){
    var obits=d.obituaries||[];
    if(!obits.length){
      if(el) el.innerHTML='<span style="color:#8b949e">No departed devices yet — the router checks hourly and writes a farewell for any device not seen for 30+ days.</span>';
      return;
    }
    var html='';
    obits.slice().reverse().forEach(function(o){
      html+='<div style="border-bottom:1px solid #21262d;padding:12px 0">'
        +'<div style="display:flex;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:6px">'
        +'<span style="font-size:.85em;font-weight:600;color:#e6edf3">'+escH(o.name||'Unknown Device')+'</span>'
        +'<span style="font-size:.72em;color:#484f58">Last seen: '+escH(o.last_seen||'')+'</span>'
        +'</div>'
        +'<div style="font-size:.84em;color:#c9d1d9;line-height:1.8;font-style:italic;margin-bottom:6px">'+escH(o.farewell||'')+'</div>'
        +'<div style="font-size:.72em;color:#484f58">'+escH(o.ip||'')+' &nbsp;·&nbsp; '+escH(String(o.days||0))+' days on network &nbsp;·&nbsp; peak '+escH(String(o.peak_gb||0))+'GB</div>'
        +'</div>';
    });
    if(el) el.innerHTML=html;
  }).catch(function(e){if(el) el.innerHTML='<span style="color:#8b949e">Could not load obituaries — check router connection. ('+escH(String(e))+')</span>';});
}

// ── Router Diary ─────────────────────────────────────────────────────────────
function diaryLoad(){
  var el=document.getElementById('diary-content');
  if(el) el.innerHTML='<span style="color:#484f58">Loading...</span>';
  fetch('/cgi-bin/rocket?diary_read&count=30')
  .then(function(r){return r.json();})
  .then(function(d){
    var entries=d.entries||[];
    if(!entries.length){
      if(el) el.innerHTML='<span style="color:#8b949e">No diary entries yet. The router writes one at midnight — or click Write Today\'s Entry to generate one now.</span>';
      return;
    }
    diaryRender(entries.reverse());
  }).catch(function(){if(el) el.innerHTML='<span style="color:#f85149">Load failed.</span>';});
}

function diaryRender(entries){
  var el=document.getElementById('diary-content');
  if(!el) return;
  var today=entries[0];
  var html='';
  if(today){
    html+='<div style="background:#0d1117;border:1px solid rgba(63,185,80,.25);border-radius:10px;padding:16px;margin-bottom:14px">'
      +'<div style="font-size:.72em;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#3fb950;margin-bottom:8px">'+escH(today.date||'')+'</div>'
      +'<div style="font-size:.9em;color:#e6edf3;line-height:1.85;font-style:italic">'+escH(today.entry||'')+'</div>'
      +'<div style="margin-top:10px;display:flex;gap:16px;font-size:.75em;color:#484f58">'
      +(today.sinr?'<span>SINR '+today.sinr+'dB</span>':'')
      +(today.spd&&today.spd!=='N/A'?'<span>'+today.spd+' Mbps avg</span>':'')
      +(today.top&&today.top!=='none'?'<span>Top: '+escH(today.top)+'</span>':'')
      +(today.upd?'<span>Up '+escH(today.upd)+'</span>':'')
      +'</div></div>';
  }
  if(entries.length>1){
    html+='<div style="font-size:.72em;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#484f58;margin-bottom:8px">Previous entries</div>';
    entries.slice(1).forEach(function(e){
      html+='<div style="border-bottom:1px solid #21262d;padding:10px 0">'
        +'<div style="font-size:.72em;color:#8b949e;margin-bottom:4px">'+escH(e.date||'')+'</div>'
        +'<div style="font-size:.84em;color:#c9d1d9;line-height:1.75;font-style:italic">'+escH(e.entry||'')+'</div>'
        +'</div>';
    });
  }
  el.innerHTML=html;
}

function diaryWriteNow(){
  var btn=document.getElementById('diary-write-btn');
  if(btn){btn.disabled=true;btn.textContent='✍ Writing...';}
  fetch('/cgi-bin/rocket?diary_write')
  .then(function(r){return r.json();})
  .then(function(d){
    if(btn){btn.disabled=false;btn.textContent='✍ Write Today\'s Entry';}
    if(d.ok) diaryLoad();
  }).catch(function(){if(btn){btn.disabled=false;btn.textContent='✍ Write Today\'s Entry';}});
}

