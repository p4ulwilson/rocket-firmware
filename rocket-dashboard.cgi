#!/bin/sh
# /www/cgi-bin/rocket
# Rocket Routers — System Dashboard v3.8.1
# Accessible at http://192.168.1.1/cgi-bin/rocket

# ── Authentication ────────────────────────────────────────────────────────────
RR_AUTH="/etc/rr_auth"     # sha256hash:username  (written by credential tool)
RR_SESS="/tmp/rr_session"  # active session token (tmpfs — cleared on reboot)

_show_login(){
  ERR_HTML="${1:-}"
  printf "Content-Type: text/html
Cache-Control: no-store, no-cache, must-revalidate\r\n\r\n"
  cat << LOGINEOF
<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Rocket Routers</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;font-family:system-ui,sans-serif}
.c{background:#161b22;border:1px solid #30363d;border-radius:16px;padding:38px 32px;width:100%;max-width:340px}
.logo{text-align:center;margin-bottom:28px}
.logo h1{color:#3fb950;font-size:1.3em;font-weight:700;letter-spacing:-.5px}
.logo p{color:#484f58;font-size:.76em;margin-top:6px}
label{font-size:.8em;color:#8b949e;display:block;margin-bottom:5px}
input[type=text],input[type=password]{width:100%;background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:11px 14px;color:#e6edf3;font-size:.92em;outline:none;margin-bottom:15px;transition:.15s}
input:focus{border-color:#3fb950}
.btn{width:100%;background:linear-gradient(135deg,#196127,#2ea043);color:#fff;border:none;border-radius:10px;padding:14px;font-size:1em;font-weight:700;cursor:pointer;letter-spacing:.3px;margin-top:2px}
.err{background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.38);color:#f85149;border-radius:8px;padding:10px 14px;font-size:.82em;margin-bottom:14px;line-height:1.5}
</style></head>
<body><div class="c">
<div class="logo"><h1>🚀 Rocket Routers</h1><p>Mycelium Firmware v3.10.0</p></div>
${ERR_HTML}
<form method="POST" action="/cgi-bin/rocket">
<label>Username</label>
<input type="text" name="rr_user" autocomplete="username" autocapitalize="none" spellcheck="false" required>
<label>Password</label>
<input type="password" name="rr_pass" autocomplete="current-password" required>
<button class="btn" type="submit">Sign In →</button>
</form>
</div></body></html>
LOGINEOF
  exit 0
}

# ── Admin session check (dashboard is open to all LAN; explorer requires admin) ─
RR_COOK=$(printf '%s' "${HTTP_COOKIE:-}" | grep -oE 'rr_session=[a-f0-9]{32}' | cut -d= -f2)
RR_TOK=$(cat "$RR_SESS" 2>/dev/null)
_IS_ADMIN=0
if [ -n "$RR_COOK" ] && [ -n "$RR_TOK" ] && [ "$RR_COOK" = "$RR_TOK" ]; then
  _IS_ADMIN=1
fi

# ── Admin login endpoint ───────────────────────────────────────────────────────
if [ "$QUERY_STRING" = "admin_login" ]; then
  if [ "$REQUEST_METHOD" != "POST" ]; then
    printf "Content-Type: application/json\r\n\r\n"
    printf '{"ok":false,"error":"POST required"}'; exit 0
  fi
  # Read POST body — head -c is more reliable than dd on busybox
  POST_RAW=$(head -c "${CONTENT_LENGTH:-0}")
  # Full URL decode function using awk
  urldecode(){ printf '%s' "$1" | sed 's/+/ /g' | awk '
    BEGIN{for(i=0;i<256;i++) h[sprintf("%02x",i)]=sprintf("%c",i)}
    {while(match($0,/%[0-9A-Fa-f][0-9A-Fa-f]/)){
      k=tolower(substr($0,RSTART+1,2))
      printf "%s%s",substr($0,1,RSTART-1),h[k]
      $0=substr($0,RSTART+RLENGTH)}
    printf "%s",$0}'; }
  RR_U_ENC=$(printf '%s' "$POST_RAW" | grep -oE 'rr_user=[^&]+' | cut -d= -f2-)
  RR_P_ENC=$(printf '%s' "$POST_RAW" | grep -oE 'rr_pass=[^&]+' | cut -d= -f2-)
  RR_U=$(urldecode "$RR_U_ENC")
  RR_P=$(urldecode "$RR_P_ENC")
  # Verify against system shadow password (same as LuCI/SSH)
  LOGIN_OK=0
  if [ "$RR_U" = "root" ] && command -v login >/dev/null 2>&1; then
    printf '%s\n' "$RR_P" | login -f "$RR_U" >/dev/null 2>&1 && LOGIN_OK=1
  fi
  # Fallback: check /etc/shadow directly using openssl or busybox
  if [ "$LOGIN_OK" = "0" ] && [ "$RR_U" = "root" ]; then
    SHADOW_LINE=$(grep "^root:" /etc/shadow 2>/dev/null)
    SHADOW_HASH=$(printf '%s' "$SHADOW_LINE" | cut -d: -f2)
    SHADOW_TYPE=$(printf '%s' "$SHADOW_HASH" | cut -c1-3)
    SHADOW_SALT=$(printf '%s' "$SHADOW_HASH" | awk -F'$' '{print $3}')
    if [ -n "$SHADOW_HASH" ] && [ -n "$SHADOW_SALT" ]; then
      case "$SHADOW_TYPE" in
        '$1$') ALGO="-1" ;;
        '$5$') ALGO="-5" ;;
        '$6$') ALGO="-6" ;;
        *) ALGO="" ;;
      esac
      if [ -n "$ALGO" ]; then
        COMPUTED=$(openssl passwd "$ALGO" -salt "$SHADOW_SALT" "$RR_P" 2>/dev/null)
        [ "$COMPUTED" = "$SHADOW_HASH" ] && LOGIN_OK=1
      fi
    fi
  fi
  if [ "$LOGIN_OK" = "1" ]; then
    RR_TOKEN=$(cat /dev/urandom | tr -dc 'a-f0-9' | head -c 32)
    printf '%s' "$RR_TOKEN" > "$RR_SESS"
    printf "Content-Type: application/json\r\nSet-Cookie: rr_session=%s; Path=/; HttpOnly\r\n\r\n" "$RR_TOKEN"
    printf '{"ok":true}'
  else
    printf "Content-Type: application/json\r\n\r\n"
    printf '{"ok":false,"error":"Wrong username or password"}'
  fi
  exit 0
fi

# ── Admin logout endpoint ──────────────────────────────────────────────────────
if [ "$QUERY_STRING" = "admin_logout" ]; then
  rm -f "$RR_SESS"
  printf "Content-Type: text/html\r\nSet-Cookie: rr_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT\r\n\r\n"
  printf '<html><head><meta http-equiv="refresh" content="0;url=/cgi-bin/rocket"></head></html>\r\n'
  exit 0
fi

# ── Explorer endpoints — admin only ───────────────────────────────────────────
case "$QUERY_STRING" in
  explorer_list*|explorer_read*|explorer_write*|explorer_delete*|explorer_mkdir*|explorer_upload*)
    if [ "$_IS_ADMIN" != "1" ]; then
      printf "Content-Type: application/json\r\n\r\n"
      printf '{"error":"Admin access required","code":403}'
      exit 0
    fi
    ;;
esac

# ── Explorer: list directory ───────────────────────────────────────────────────
case "$QUERY_STRING" in
explorer_list*)
  printf "Content-Type: application/json\r\n\r\n"
  EX_PATH=$(printf '%s' "$QUERY_STRING" | sed 's/explorer_list=//' | sed 's/%2F/\//g;s/%20/ /g;s/%2E/./g')
  [ -z "$EX_PATH" ] && EX_PATH="/"
  # Safety: block dangerous virtual fs paths that can hang
  case "$EX_PATH" in
    /proc/kmsg*|/proc/kcore*|/dev/*|/sys/kernel/debug*) printf '{"error":"Path blocked for safety"}'; exit 0;;
  esac
  if [ ! -d "$EX_PATH" ]; then printf '{"error":"Not a directory"}'; exit 0; fi
  printf '{"path":"%s","entries":[' "$EX_PATH"
  FIRST=1
  ls -la "$EX_PATH" 2>/dev/null | tail -n +2 | while read -r PERMS LINKS OWNER GROUP SIZE MON DAY TIMEYEAR NAME; do
    [ "$NAME" = "." ] && continue
    FPATH="${EX_PATH%/}/${NAME}"
    FTYPE="file"
    [ -d "$FPATH" ] && FTYPE="dir"
    [ -L "$FPATH" ] && FTYPE="link"
    [ "$FIRST" = "1" ] && FIRST=0 || printf ','
    printf '{"name":"%s","type":"%s","size":"%s","perms":"%s","owner":"%s","modified":"%s %s %s"}' \
      "$NAME" "$FTYPE" "$SIZE" "$PERMS" "$OWNER" "$MON" "$DAY" "$TIMEYEAR"
  done
  printf ']}'
  exit 0
  ;;
esac

# ── Explorer: read file ────────────────────────────────────────────────────────
case "$QUERY_STRING" in
explorer_read*)
  printf "Content-Type: application/json\r\n\r\n"
  EX_PATH=$(printf '%s' "$QUERY_STRING" | sed 's/explorer_read=//' | sed 's/%2F/\//g;s/%20/ /g;s/%2E/./g;s/%2D/-/g;s/%5F/_/g')
  case "$EX_PATH" in
    /proc/kmsg*|/proc/kcore*|/dev/*|/sys/kernel/debug*) printf '{"error":"Path blocked for safety"}'; exit 0;;
  esac
  if [ ! -f "$EX_PATH" ]; then printf '{"error":"Not a file"}'; exit 0; fi
  FSIZE=$(wc -c < "$EX_PATH" 2>/dev/null || echo 0)
  if [ "$FSIZE" -gt 524288 ]; then printf '{"error":"File too large to display (>512KB)","size":%s}' "$FSIZE"; exit 0; fi
  # Check if binary
  if file "$EX_PATH" 2>/dev/null | grep -qiE 'binary|executable|ELF|compressed'; then
    printf '{"binary":true,"size":%s,"name":"%s"}' "$FSIZE" "$(basename "$EX_PATH")"
    exit 0
  fi
  CONTENT=$(cat "$EX_PATH" 2>/dev/null | head -c 524288 | awk '{gsub(/\\/,"\\\\");gsub(/"/,"\\\"");gsub(/\t/,"\\t");printf "%s\\n",$0}' | head -c 524288)
  printf '{"content":"%s","size":%s,"name":"%s"}' "$CONTENT" "$FSIZE" "$(basename "$EX_PATH")"
  exit 0
  ;;
esac

# ── Explorer: write file ───────────────────────────────────────────────────────
case "$QUERY_STRING" in
explorer_write*)
  printf "Content-Type: application/json\r\n\r\n"
  EX_PATH=$(printf '%s' "$QUERY_STRING" | sed 's/explorer_write=//' | sed 's/%2F/\//g;s/%20/ /g;s/%2E/./g;s/%2D/-/g;s/%5F/_/g')
  case "$EX_PATH" in
    /proc/*|/dev/*|/sys/*) printf '{"error":"Path not writable"}'; exit 0;;
  esac
  POST_BODY=$(dd bs=1 count="${CONTENT_LENGTH:-0}" 2>/dev/null)
  EX_CONTENT=$(printf '%s' "$POST_BODY" | grep -oE 'content=.*' | cut -d= -f2- | sed 's/+/ /g' | awk '{gsub(/%0A/,"\n");gsub(/%0D/,"");gsub(/%09/,"\t");print}')
  printf '%s' "$EX_CONTENT" > "$EX_PATH" 2>/dev/null && printf '{"ok":true}' || printf '{"error":"Write failed — check permissions"}'
  exit 0
  ;;
esac

# ── Explorer: delete ───────────────────────────────────────────────────────────
case "$QUERY_STRING" in
explorer_delete*)
  printf "Content-Type: application/json\r\n\r\n"
  EX_PATH=$(printf '%s' "$QUERY_STRING" | sed 's/explorer_delete=//' | sed 's/%2F/\//g;s/%20/ /g;s/%2E/./g;s/%2D/-/g;s/%5F/_/g')
  case "$EX_PATH" in
    /|/etc|/etc/config|/bin|/sbin|/usr|/lib|/www|/proc|/dev|/sys|/tmp|/overlay) printf '{"error":"Refusing to delete system path"}'; exit 0;;
  esac
  rm -rf "$EX_PATH" 2>/dev/null && printf '{"ok":true}' || printf '{"error":"Delete failed"}'
  exit 0
  ;;
esac

# ── Explorer: mkdir ────────────────────────────────────────────────────────────
case "$QUERY_STRING" in
explorer_mkdir*)
  printf "Content-Type: application/json\r\n\r\n"
  EX_PATH=$(printf '%s' "$QUERY_STRING" | sed 's/explorer_mkdir=//' | sed 's/%2F/\//g;s/%20/ /g;s/%2E/./g;s/%2D/-/g;s/%5F/_/g')
  mkdir -p "$EX_PATH" 2>/dev/null && printf '{"ok":true}' || printf '{"error":"mkdir failed"}'
  exit 0
  ;;
esac

# ── Change admin password (admin only) ────────────────────────────────────────
if [ "$QUERY_STRING" = "admin_chpass" ]; then
  printf "Content-Type: application/json\r\n\r\n"
  if [ "$_IS_ADMIN" != "1" ]; then printf '{"ok":false,"error":"Not authorised"}'; exit 0; fi
  POST_RAW=$(head -c "${CONTENT_LENGTH:-0}")
  urldecode(){ printf '%s' "$1" | sed 's/+/ /g' | awk 'BEGIN{for(i=0;i<256;i++) h[sprintf("%02x",i)]=sprintf("%c",i)}{while(match($0,/%[0-9A-Fa-f][0-9A-Fa-f]/)){k=tolower(substr($0,RSTART+1,2));printf "%s%s",substr($0,1,RSTART-1),h[k];$0=substr($0,RSTART+RLENGTH)}printf "%s",$0}'; }
  OLD_ENC=$(printf '%s' "$POST_RAW" | grep -oE 'old=[^&]+' | cut -d= -f2-)
  NEW_ENC=$(printf '%s' "$POST_RAW" | grep -oE 'new=[^&]+' | cut -d= -f2-)
  OLD_P=$(urldecode "$OLD_ENC")
  NEW_P=$(urldecode "$NEW_ENC")
  OLD_HASH=$(printf '%s' "$OLD_P" | sha256sum | cut -d' ' -f1)
  CUR_HASH=$(cut -d: -f1 "$RR_AUTH" 2>/dev/null)
  if [ "$OLD_HASH" != "$CUR_HASH" ]; then printf '{"ok":false,"error":"Current password is wrong"}'; exit 0; fi
  if [ ${#NEW_P} -lt 6 ]; then printf '{"ok":false,"error":"New password must be at least 6 characters"}'; exit 0; fi
  NEW_HASH=$(printf '%s' "$NEW_P" | sha256sum | cut -d' ' -f1)
  printf '%s' "${NEW_HASH}:root" > "$RR_AUTH"
  printf '{"ok":true}'
  exit 0
fi

# ── Dashboard served to all LAN users ─────────────────────────────────────────

# ── WiFi channel data + action handler (must run before Content-Type) ─────────
# Skip for JSON API calls — they exit before the HTML render, no WiFi vars needed
if ! echo "$QUERY_STRING" | grep -qE '^(chat_|room_|msg_|gov_|dns_block_|local_mesh_|signal_raw|peer_|gossip_|peers_list|video_|ai_|thumb|chat_file|live_|user_|signal_|speedtest|timemachine|anomaly|vpn_routing|diary_|obituary|device_|insights_|sysmetrics|traffic_|sovereignty|ghost_|constitution|discomfort|predictive|bandwidth_inherit|nmap_start|nmap_poll|nmap_cancel|nmap|honeypot|dns_spy|bw_|explorer|device_ports|memory_distill|memory_export|memory_receive|memory_sync|mycelium_mind|cake_|net_roles_|net_wizard_|hw_discover|monthly_report|wifi_devices|oui_update|oui_vendor|device_names|device_rename|device_export|wan_iface|vnstat_debug|adblock)'; then
WIFI_CH0=$(uci -q get wireless.radio0.channel 2>/dev/null || echo "?")
WIFI_CH1=$(uci -q get wireless.radio1.channel 2>/dev/null || echo "?")
WIFI_CH2=$(uci -q get wireless.radio2.channel 2>/dev/null || echo "?")
# Scan 2.4GHz neighbours — cache 60s so page load stays snappy
SCAN_CACHE="/tmp/rr_wifi_scan"
if [ -f "$SCAN_CACHE" ] && [ -n "$(find /tmp -name rr_wifi_scan -mmin -1 2>/dev/null)" ]; then
    SCAN_RAW=$(cat "$SCAN_CACHE" 2>/dev/null)
else
    SCAN_RAW=$(iw dev wlan0 scan ap-force 2>/dev/null \
        | grep -oE "DS Parameter set: channel [0-9]+" \
        | grep -oE "[0-9]+$" | tr '\n' ' ')
    printf '%s' "$SCAN_RAW" > "$SCAN_CACHE" 2>/dev/null
fi
wifi_n(){ printf '%s\n' $SCAN_RAW | grep -c "^${1}$" 2>/dev/null; }
CH1_N=$(wifi_n 1);  CH2_N=$(wifi_n 2);  CH3_N=$(wifi_n 3);  CH4_N=$(wifi_n 4)
CH5_N=$(wifi_n 5);  CH6_N=$(wifi_n 6);  CH7_N=$(wifi_n 7);  CH8_N=$(wifi_n 8)
CH9_N=$(wifi_n 9);  CH10_N=$(wifi_n 10); CH11_N=$(wifi_n 11); CH12_N=$(wifi_n 12)
CH13_N=$(wifi_n 13)
# Score: direct neighbours × 2 + adjacent channel interference
CH1_S=$(( ${CH1_N:-0}*2 + ${CH2_N:-0} + ${CH3_N:-0} + ${CH4_N:-0} ))
CH6_S=$(( ${CH6_N:-0}*2 + ${CH4_N:-0} + ${CH5_N:-0} + ${CH7_N:-0} + ${CH8_N:-0} ))
CH11_S=$(( ${CH11_N:-0}*2 + ${CH9_N:-0} + ${CH10_N:-0} + ${CH12_N:-0} + ${CH13_N:-0} ))
if [ "${CH1_S:-0}" -le "${CH6_S:-0}" ] && [ "${CH1_S:-0}" -le "${CH11_S:-0}" ]; then BEST_CH24=1
elif [ "${CH6_S:-0}" -le "${CH11_S:-0}" ]; then BEST_CH24=6
else BEST_CH24=11; fi
TOTAL_NBR=$(( ${CH1_N:-0}+${CH2_N:-0}+${CH3_N:-0}+${CH4_N:-0}+${CH5_N:-0}+${CH6_N:-0}+${CH7_N:-0}+${CH8_N:-0}+${CH9_N:-0}+${CH10_N:-0}+${CH11_N:-0}+${CH12_N:-0}+${CH13_N:-0} ))
# Colour per channel: green=least congested, amber=mid, red=worst
_wlo=$(printf '%s\n' "${CH1_S:-0}" "${CH6_S:-0}" "${CH11_S:-0}" | sort -n | head -1)
_whi=$(printf '%s\n' "${CH1_S:-0}" "${CH6_S:-0}" "${CH11_S:-0}" | sort -n | tail -1)
wifi_cc(){ [ "${1:-0}" -le "$_wlo" ] && echo "#3fb950" || { [ "${1:-0}" -ge "$_whi" ] && echo "#f85149" || echo "#d29922"; }; }
CH1_C=$(wifi_cc "${CH1_S:-0}"); CH6_C=$(wifi_cc "${CH6_S:-0}"); CH11_C=$(wifi_cc "${CH11_S:-0}")
CH1_REC=$([ "$BEST_CH24" = "1"  ] && echo '<span style="color:#3fb950;font-size:.78em"> ✓ best</span>' || echo '')
CH6_REC=$([ "$BEST_CH24" = "6"  ] && echo '<span style="color:#3fb950;font-size:.78em"> ✓ best</span>' || echo '')
CH11_REC=$([ "$BEST_CH24" = "11" ] && echo '<span style="color:#3fb950;font-size:.78em"> ✓ best</span>' || echo '')
# Channel airtime busy% from kernel survey (passive — no disruption)
BUSY0=$(iw dev wlan0 survey dump 2>/dev/null | awk '/\[in use\]/{f=1} f&&/channel busy time:/{b=$4} f&&/channel active time:/{a=$4;if(a>0){printf "%d",b*100/a};f=0}')
BUSY1=$(iw dev wlan1 survey dump 2>/dev/null | awk '/\[in use\]/{f=1} f&&/channel busy time:/{b=$4} f&&/channel active time:/{a=$4;if(a>0){printf "%d",b*100/a};f=0}')
BUSY2=$(iw dev wlan2 survey dump 2>/dev/null | awk '/\[in use\]/{f=1} f&&/channel busy time:/{b=$4} f&&/channel active time:/{a=$4;if(a>0){printf "%d",b*100/a};f=0}')
# Display versions — show X% when data present, dash when not
BUSY0_D=$([ -n "$BUSY0" ] && echo "${BUSY0}%" || echo "—")
BUSY1_D=$([ -n "$BUSY1" ] && echo "${BUSY1}%" || echo "—")
BUSY2_D=$([ -n "$BUSY2" ] && echo "${BUSY2}%" || echo "—")
fi  # end WiFi scan guard — skipped for JSON API calls

# ── Handle WiFi optimise action ───────────────────────────────────────────────
_redir(){ printf "Content-Type: text/html\r\nCache-Control: no-store, no-cache, must-revalidate\r\n\r\n"; printf '<!DOCTYPE html><html><head><meta charset="UTF-8"><meta http-equiv="refresh" content="1;url=/cgi-bin/rocket#exp"><style>body{background:#0d1117;color:#3fb950;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;font-size:1.1em;text-align:center}</style></head><body>'"$1"' ✓&nbsp; Redirecting…</body></html>\r\n'; exit 0; }
_redir_p(){ printf "Content-Type: text/html\r\nCache-Control: no-store, no-cache, must-revalidate\r\n\r\n"; printf '<!DOCTYPE html><html><head><meta charset="UTF-8"><meta http-equiv="refresh" content="1;url=/cgi-bin/rocket#protect"><style>body{background:#0d1117;color:#3fb950;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;font-size:1.1em;text-align:center}</style></head><body>'"$1"' ✓&nbsp; Redirecting…</body></html>\r\n'; exit 0; }
_redir_earn(){ printf "Content-Type: text/html\r\nCache-Control: no-store, no-cache, must-revalidate\r\n\r\n"; printf '<!DOCTYPE html><html><head><meta charset="UTF-8"><meta http-equiv="refresh" content="1;url=/cgi-bin/rocket#earn"><style>body{background:#0d1117;color:#3fb950;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;font-size:1.1em;text-align:center}</style></head><body>'"$1"' ✓&nbsp; Redirecting…</body></html>\r\n'; exit 0; }

# ── OUI vendor lookup (server-side) ──────────────────────────────────────────
# File format: AABBCC Vendor Name  (one per line, uppercase hex, no separator)
# Stored at /mnt/ssd/oui.txt (preferred) or /etc/rocket/oui.txt (fallback)
_oui_file(){ [ -f /mnt/ssd/oui.txt ] && printf '/mnt/ssd/oui.txt' || printf '/etc/rocket/oui.txt'; }
oui_lookup(){
    local _mac
    local _oui
    local _f
    _mac="$1"
    _oui=$(printf '%s' "$_mac" | tr -d ':.-' | tr 'a-z' 'A-Z' | cut -c1-6)
    [ ${#_oui} -lt 6 ] && { printf ''; return; }
    _f=$(_oui_file)
    [ -f "$_f" ] || { printf ''; return; }
    grep "^${_oui} " "$_f" | head -1 | cut -d' ' -f2- | tr -d '"\\\015' | cut -c1-60
}

case "$QUERY_STRING" in
logout=1)
    rm -f "$RR_SESS" 2>/dev/null
    _show_login ''
    ;;
wifi_opt=1)
    uci set wireless.radio0.channel="$BEST_CH24"
    uci -q set wireless.radio1.channel="auto" 2>/dev/null
    uci -q set wireless.radio2.channel="auto" 2>/dev/null
    uci commit wireless
    wifi reload >/dev/null 2>&1 &
    printf "Content-Type: text/html\r\nCache-Control: no-store, no-cache, must-revalidate\r\n\r\n"
    cat << RECONHTML
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Rocket Routers — Reconnecting</title>
<style>*{margin:0;padding:0;box-sizing:border-box}body{background:#0d1117;color:#e6edf3;font-family:'Segoe UI',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center}.box{background:#161b22;border:1px solid #3fb950;border-radius:16px;padding:44px 52px;max-width:420px;width:90%}h2{color:#3fb950;font-size:1.3em;margin-bottom:10px}.sub{color:#8b949e;font-size:.88em;line-height:1.7;margin-bottom:22px}.cnt{font-size:3em;font-weight:700;color:#ff6b35;margin-bottom:6px}.clab{font-size:.78em;color:#484f58;margin-bottom:22px}.bar{background:#21262d;border-radius:4px;height:5px;overflow:hidden}.bf{height:100%;border-radius:4px;background:linear-gradient(90deg,#3fb950,#ff6b35);animation:p 10s linear forwards}@keyframes p{from{width:0}to{width:100%}}</style></head>
<body><div class="box">
  <h2>📡 Channels Optimised</h2>
  <p class="sub">2.4 GHz → Channel ${BEST_CH24}<br>5 GHz → Auto &nbsp;·&nbsp; 6 GHz → Auto<br><br>WiFi is restarting — you'll reconnect in a moment.</p>
  <div class="cnt" id="cnt">10</div>
  <div class="clab">seconds until dashboard reloads</div>
  <div class="bar"><div class="bf"></div></div>
</div>
<script>var n=10,t=setInterval(function(){document.getElementById('cnt').textContent=--n;if(n<=0){clearInterval(t);window.location.replace('/cgi-bin/rocket#exp');}},1000);
function rrRequestNotifyPermission(){
  var btn=document.getElementById('notify-enable-btn');
  if(!('Notification' in window)){
    if(btn){btn.textContent='\u2717 Not supported by this browser';btn.style.color='#f85149';}
    return;
  }
  if(Notification.permission==='granted'){
    if(btn){btn.textContent='\u2713 Notifications already enabled';btn.style.color='#3fb950';btn.disabled=true;}
    return;
  }
  Notification.requestPermission().then(function(result){
    if(result==='granted'){
      if(btn){btn.textContent='\u2713 Notifications enabled';btn.style.color='#3fb950';btn.disabled=true;}
    } else {
      if(btn){btn.textContent='\u2717 Permission denied \u2014 check browser settings';btn.style.color='#f85149';}
    }
  });
}

</script>
</body></html>
RECONHTML
    exit 0
    ;;
dns=cloudflare)
    uci -q set network.wan.peerdns="0" 2>/dev/null
    uci set network.wan.dns="1.1.1.1 1.0.0.1"
    uci commit network
    /etc/init.d/network reload >/dev/null 2>&1
    _redir "DNS → Cloudflare 1.1.1.1"
    ;;
dns=google)
    uci -q set network.wan.peerdns="0" 2>/dev/null
    uci set network.wan.dns="8.8.8.8 8.8.4.4"
    uci commit network
    /etc/init.d/network reload >/dev/null 2>&1
    _redir "DNS → Google 8.8.8.8"
    ;;
dns=family)
    uci -q set network.wan.peerdns="0" 2>/dev/null
    uci set network.wan.dns="1.1.1.3 1.0.0.3"
    uci commit network
    /etc/init.d/network reload >/dev/null 2>&1
    _redir_p "Protection enabled — Cloudflare Family Shield active"
    ;;
dns=family_off)
    uci -q set network.wan.peerdns="1" 2>/dev/null
    uci -q delete network.wan.dns 2>/dev/null
    uci commit network
    /etc/init.d/network reload >/dev/null 2>&1
    _redir_p "Protection disabled — DNS returned to auto"
