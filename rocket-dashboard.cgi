// ═══════════════════════════════════════════════════════════════════════════════
// 6 WORLD-FIRST FEATURES — JS
// ═══════════════════════════════════════════════════════════════════════════════

// ── 1. Digital Sovereignty Audit ─────────────────────────────────────────────
function sovereigntyLoad(){
  var btn=document.getElementById('sov-btn');
  var status=document.getElementById('sov-status');
  var results=document.getElementById('sov-results');
  if(btn){btn.disabled=true;btn.textContent='...';}
  if(status) status.textContent='Reading active connections…';
  if(results) results.textContent='';
  fetch('/cgi-bin/rocket?sovereignty_audit')
  .then(function(r){return r.json();})
  .then(function(d){
    var ips=d.ips||[];
    if(!ips.length){
      if(btn){btn.disabled=false;btn.textContent='Audit Now';}
      if(status) status.textContent='';
      if(results) results.textContent='No active external connections. Try browsing something first.';
      return;
    }
    if(status) status.textContent='Resolving ownership of '+ips.length+' connections…';
    var chunks=[];
    for(var i=0;i<ips.length;i+=100) chunks.push(ips.slice(i,i+100));
    Promise.all(chunks.map(function(chunk){
      return fetch('http://ip-api.com/batch?fields=status,org,query',{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify(chunk.map(function(ip){return {query:ip};}))
      }).then(function(r){return r.json();}).catch(function(){return [];});
    })).then(function(all){
      var flat=[].concat.apply([],all);
      var orgs={},total=0;
      flat.forEach(function(r){
        if(r.status==='success'&&r.org){
          var org=r.org.replace(/^AS\d+\s+/,'').replace(/,.*$/,'').trim();
          var f=org;
          if(/amazon|aws/i.test(org)) f='Amazon (AWS)';
          else if(/google/i.test(org)) f='Google';
          else if(/cloudflare/i.test(org)) f='Cloudflare';
          else if(/microsoft|azure/i.test(org)) f='Microsoft';
          else if(/akamai/i.test(org)) f='Akamai';
          else if(/meta|facebook/i.test(org)) f='Meta (Facebook)';
          else if(/apple/i.test(org)) f='Apple';
          else if(/fastly/i.test(org)) f='Fastly';
          orgs[f]=(orgs[f]||0)+1; total++;
        }
      });
      if(btn){btn.disabled=false;btn.textContent='Audit Now';}
      if(status) status.textContent='';
      if(!results) return;
      if(!Object.keys(orgs).length){results.textContent='Could not resolve ownership. Try again after some browsing.';return;}
      var sorted=Object.keys(orgs).sort(function(a,b){return orgs[b]-orgs[a];});
      var top3=sorted.slice(0,3).reduce(function(s,k){return s+orgs[k];},0);
      var topPct=total?Math.round(top3/total*100):0;
      var html='<div style="font-size:.88em;color:#f0a500;font-weight:700;margin-bottom:12px">'+topPct+'% of your connections run through just '+Math.min(3,sorted.length)+' organisation'+(sorted.length!==1?'s':'')+'.</div>';
      html+='<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:8px">';
      sorted.forEach(function(org){
        var pct=total?Math.round(orgs[org]/total*100):0;
        var col=pct>30?'#f85149':(pct>15?'#f0a500':'#3fb950');
        html+='<div style="background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:10px">'
          +'<div style="font-size:.85em;font-weight:700;color:#e6edf3">'+escH(org)+'</div>'
          +'<div style="font-size:.78em;color:'+col+';font-weight:600">'+orgs[org]+' conn ('+pct+'%)</div>'
          +'<div style="margin-top:5px;height:5px;background:#21262d;border-radius:3px"><div style="height:100%;width:'+pct+'%;background:'+col+';border-radius:3px"></div></div>'
          +'</div>';
      });
      html+='</div>';
      results.innerHTML=html;
      fetch('/cgi-bin/rocket?sovereignty_save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({orgs:orgs,total:total,ts:Math.floor(Date.now()/1000)})}).catch(function(){});
    });
  }).catch(function(){
    if(btn){btn.disabled=false;btn.textContent='Audit Now';}
    if(status) status.textContent='';
    if(results) results.textContent='Audit error.';
  });
}

// ── 2. Ghost Device Detector ──────────────────────────────────────────────────
function ghostDevicesLoad(){
  var el=document.getElementById('ghost-results');
  if(el) el.textContent='Scanning…';
  fetch('/cgi-bin/rocket?ghost_devices')
  .then(function(r){return r.json();})
  .then(function(d){
    if(!el) return;
    var orphans=d.conntrack_orphans||[];
    if(!orphans.length){el.innerHTML='<span style="color:#3fb950">No ghost devices detected. All traffic sources are accounted for.</span>';return;}
    var html='<div style="font-size:.82em;color:#f0a500;font-weight:600;margin-bottom:10px">Found '+orphans.length+' ghost device'+(orphans.length!==1?'s':'')+' — active connections from unlisted IPs:</div>';
    html+='<div style="display:flex;flex-direction:column;gap:6px">';
    orphans.forEach(function(g){
      html+='<div style="background:#0d1117;border:1px solid rgba(248,81,73,.2);border-radius:8px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between">'
        +'<div><div style="font-size:.85em;font-weight:600;color:#e6edf3">'+escH(g.hostname&&g.hostname!=='*'?g.hostname+' — ':'')+escH(g.ip||'')+'</div>'
        +'<div style="font-size:.75em;color:#484f58">Active in conntrack - not in DHCP leases</div></div>'
        +'<span style="font-size:.72em;color:#f85149;font-weight:700;background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.2);border-radius:5px;padding:3px 8px">GHOST</span>'
        +'</div>';
    });
    el.innerHTML=html+'</div>';
  }).catch(function(){if(el)el.textContent='Scan error.';});
}

// ── 3. Network Constitution ───────────────────────────────────────────────────
var _constRules=[];
function constitutionLoad(){
  var el=document.getElementById('const-rules-list');
  if(el) el.innerHTML='<span style="color:#484f58;font-size:.82em">Loading…</span>';
  fetch('/cgi-bin/rocket?constitution_get')
  .then(function(r){return r.json();})
  .then(function(d){_constRules=Array.isArray(d)?d:[];_constRender();})
  .catch(function(){if(el)el.innerHTML='<span style="color:#f85149;font-size:.82em">Could not load rules — check router connection.</span>';});
}
function _constRender(){
  var el=document.getElementById('const-rules-list');
  if(!el) return;
  if(!_constRules.length){
    el.innerHTML='<div style="color:#8b949e;font-size:.82em;padding:8px 0">No rules yet — type a rule above and click Add Rule. Examples:<br>'
      +'<span style="color:#484f58">"Kids tablets off at 9pm" · "Limit TV to 20Mbps" · "Gaming PC gets priority evenings"</span></div>';
    return;
  }
  var html='';
  _constRules.forEach(function(rule,i){
    html+='<div style="background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:10px 14px;margin-bottom:6px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px">'
      +'<div style="flex:1"><div style="font-size:.85em;color:#e6edf3;font-weight:600">'+escH(rule.text||'')+'</div>'
      +(rule.translated?'<div style="font-size:.76em;color:#484f58;font-family:monospace">'+escH(rule.translated)+'</div>':'')+'</div>'
      +'<button onclick="_constDelete('+i+')" style="background:none;border:none;color:#484f58;cursor:pointer;font-size:1em;padding:0">x</button></div>';
  });
  el.innerHTML=html;
}
function constitutionAddRule(){
  var inp=document.getElementById('const-rule-input');
  if(!inp||!inp.value.trim()) return;
  var text=inp.value.trim();
  var tl=text.toLowerCase();
  var translated='Saved (manual wiring may be needed)';
  var tm=tl.match(/off at (\d+)\s*(am|pm)?/i)||tl.match(/block at (\d+)\s*(am|pm)?/i);
  if(tm){var h=parseInt(tm[1]);if(tm[2]==='pm'&&h<12)h+=12;translated='cron: 0 '+h+' * * * [block rule]';}
  var bm=tl.match(/limit.*?(\d+)\s*mbps?/i);
  if(bm) translated='tc: rate '+bm[1]+'mbit [device]';
  _constRules.push({text:text,translated:translated,id:Date.now()});
  inp.value='';
  _constSave();
}
function _constDelete(i){_constRules.splice(i,1);_constSave();}
function _constSave(){
  fetch('/cgi-bin/rocket?constitution_set',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(_constRules)})
  .then(function(r){return r.json();}).then(function(){_constRender();}).catch(function(){_constRender();});
}

// ── 4. Corporate Discomfort Index ─────────────────────────────────────────────
function discomfortLoad(){
  var scoreEl=document.getElementById('discomfort-score');
  var labelEl=document.getElementById('discomfort-label');
  var detailEl=document.getElementById('discomfort-detail');
  var canvas=document.getElementById('discomfort-canvas');
  if(labelEl) labelEl.textContent='Calculating…';
  fetch('/cgi-bin/rocket?discomfort_score')
  .then(function(r){return r.json();})
  .then(function(d){
    var score=d.score||0,trackers=d.trackers||0,total=d.total||0,hist=d.history||[];
    var loggingOn=d.logging===true||d.logging==='true';
    var col=score<20?'#3fb950':(score<50?'#f0a500':'#f85149');
    var mood=score<10?'Clean — barely a whisper':score<25?'Mild — a few eyes on you':score<50?'Moderate — you are a product today':score<75?'High — your data is their lunch':'Maximum — corporate party on your data';
    if(scoreEl){scoreEl.textContent=score;scoreEl.style.color=col;}
    if(labelEl) labelEl.innerHTML='<span style="color:'+col+'">'+mood+'</span>';
    if(detailEl){
      if(total>0){
        detailEl.innerHTML='Today: <strong style="color:#e6edf3">'+trackers+'</strong> tracker queries / <strong style="color:#e6edf3">'+total+'</strong> total DNS lookups. '+(trackers===0?'<span style="color:#3fb950">HaGeZi is earning its keep.</span>':'<span style="color:#f0a500">Consider upgrading HaGeZi level in the Protect tab.</span>');
      } else if(loggingOn){
        detailEl.innerHTML='<span style="color:#3fb950">Query logging is enabled.</span> No queries logged yet today — scores will accumulate through the day. Refresh again later.';
      } else {
        detailEl.innerHTML='DNS query logging is off — enable it to get accurate tracking counts. '
          +'<button onclick="discomfortEnableLog()" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:5px;padding:3px 10px;font-size:.78em;font-weight:600;cursor:pointer">Enable query logging</button>'
          +' <span style="font-size:.75em;color:#484f58">(requires admin)</span>';
      }
    }
    if(canvas&&hist.length>1){
      canvas.style.display='block';
      var ctx=canvas.getContext('2d'),W=canvas.width,H=canvas.height;
      ctx.clearRect(0,0,W,H);ctx.fillStyle='#0d1117';ctx.fillRect(0,0,W,H);
      var bw=Math.max(4,Math.floor(W/hist.length)-2);
      hist.forEach(function(h,i){var s=h.score||0,ht=Math.max(3,Math.floor(s/100*(H-6)));ctx.fillStyle=s<25?'#3fb950':(s<50?'#f0a500':'#f85149');ctx.fillRect(i*(bw+2)+1,H-ht-2,bw,ht);});
    }
  }).catch(function(){if(labelEl)labelEl.textContent='Error — check dnsmasq.';});
}

function discomfortEnableLog(){
  fetch('/cgi-bin/rocket?dns_toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:'{"action":"enable"}'})
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){
      var det=document.getElementById('discomfort-detail');
      if(det) det.innerHTML='<span style="color:#3fb950">Query logging enabled. Scores will build up throughout the day.</span>';
    } else {
      alert('Could not enable — sign in as admin first.');
    }
  }).catch(function(){alert('Error enabling query logging — are you signed in as admin?');});
}

// ── 5. Predictive Modem Reboot ────────────────────────────────────────────────
function predictiveRebootLoad(){
  var status=document.getElementById('pred-reboot-status');
  var actions=document.getElementById('pred-reboot-actions');
  var cancelBtn=document.getElementById('pred-cancel-btn');
  if(status) status.textContent='Analysing signal history…';
  fetch('/cgi-bin/rocket?predictive_reboot_check')
  .then(function(r){return r.json();})
  .then(function(d){
    if(!status) return;
    if(d.status==='no_data'||d.status==='insufficient_data'||d.status==='no_signal_data'){
      status.innerHTML='<span style="color:#484f58">'+escH(d.message||d.status)+'</span>';
      if(actions) actions.style.display='none'; return;
    }
    var cols={improving:'#3fb950',stable:'#3fb950',declining:'#f0a500',critical:'#f85149'};
    var icons={improving:'trend-up',stable:'right',declining:'trend-down',critical:'warning'};
    var col=cols[d.status]||'#c9d1d9';
    var html='Signal trend: <strong style="color:'+col+'">'+escH(d.status)+'</strong>'
      +' | First-half avg: <span style="color:#58a6ff">'+d.first_avg+' dBm</span>'
      +' | Recent avg: <span style="color:'+col+'">'+d.second_avg+' dBm</span>'
      +' | Latest: <span style="color:#e6edf3">'+d.latest+' dBm</span>';
    if(d.status==='declining'||d.status==='critical')
      html+='<div style="margin-top:8px;padding:8px 12px;background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.2);border-radius:6px;font-size:.82em;color:#f0a500">Signal degrading. Schedule a modem restart at a quiet hour to restore quality before a dropout.</div>';
    status.innerHTML=html;
    if(actions) actions.style.display='block';
    if(d.existing_prediction&&d.existing_prediction!=='null'){
      try{var pred=typeof d.existing_prediction==='string'?JSON.parse(d.existing_prediction):d.existing_prediction;
        if(pred&&pred.scheduled_at){status.innerHTML+='<div style="margin-top:6px;font-size:.78em;color:#3fb950">Reboot scheduled at '+escH(pred.hour||'?')+'</div>';if(cancelBtn)cancelBtn.style.display='inline-block';}}catch(e){}
    }
  }).catch(function(){if(status)status.textContent='Error reading signal data.';});
}
function predictiveRebootSchedule(){
  var sel=document.getElementById('pred-reboot-hour');
  var hour=sel?sel.value:'03';
  fetch('/cgi-bin/rocket?predictive_reboot_schedule&hour='+encodeURIComponent(hour))
  .then(function(r){return r.json();})
  .then(function(d){
    if(d.ok){var s=document.getElementById('pred-reboot-status');if(s)s.innerHTML+='<div style="font-size:.78em;color:#3fb950;margin-top:6px">Scheduled for '+escH(d.scheduled||hour+':00')+'</div>';var cb=document.getElementById('pred-cancel-btn');if(cb)cb.style.display='inline-block';}
    else alert('Failed: '+(d.error||'unknown'));
  }).catch(function(){alert('Error.');});
}
function predictiveRebootCancel(){
  fetch('/cgi-bin/rocket?predictive_reboot_cancel').then(function(r){return r.json();}).then(function(d){if(d.ok){var cb=document.getElementById('pred-cancel-btn');if(cb)cb.style.display='none';predictiveRebootLoad();}}).catch(function(){});
}

