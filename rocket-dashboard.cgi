    <!-- Embedded live chat -->
    <div style="background:rgba(13,17,23,.92);border:1px solid rgba(48,54,61,.8);border-radius:14px;overflow:hidden;margin-bottom:18px" id="chat-box">
      <div style="padding:11px 18px;border-bottom:1px solid rgba(48,54,61,.55);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px">
        <div style="display:flex;align-items:center;gap:6px">
          <button onclick="switchChatTab('local')" id="chat-tab-local"
            style="background:rgba(88,166,255,.18);border:1px solid rgba(88,166,255,.5);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.76em;font-weight:600;cursor:pointer">Local</button>
          <button onclick="switchChatTab('global')" id="chat-tab-global"
            style="background:none;border:1px solid rgba(48,54,61,.6);color:#484f58;border-radius:6px;padding:4px 12px;font-size:.76em;font-weight:600;cursor:pointer">&#x1F30D; Global</button>
          <span id="chat-status" style="font-size:.72em;color:#484f58;margin-left:4px">&#x27F3; connecting&#x2026;</span>
        </div>
        <button onclick="chatTabRefresh()" title="Refresh" style="background:none;border:none;color:#484f58;cursor:pointer;font-size:1em;padding:3px 8px;border-radius:6px;transition:.15s" onmouseover="this.style.color='#58a6ff'" onmouseout="this.style.color='#484f58'">&#x27F3;</button>
      </div>
      <div id="chat-room-crumb" style="display:none;padding:5px 18px 6px;border-bottom:1px solid rgba(48,54,61,.4);background:rgba(13,17,23,.5)">
        <button onclick="leaveRoom()" style="background:none;border:none;color:#484f58;cursor:pointer;font-size:.79em;padding:0;text-decoration:underline">&#x2190; Rooms</button>
        <span style="color:#3a3f44;font-size:.79em;margin:0 5px">&#x2502;</span>
        <span id="chat-room-name" style="color:#e6edf3;font-size:.82em;font-weight:600"></span>
      </div>
      <div id="chat-msgs" style="height:260px;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:7px;scroll-behavior:smooth">
        <span style="color:#3a3f44;font-size:.82em;align-self:center;margin:auto">⟳ Loading messages…</span>
      </div>
      <div id="chat-pending-strip" style="display:none;padding:8px 12px 4px;border-top:1px solid rgba(48,54,61,.4);flex-wrap:wrap;gap:6px;align-items:center"></div>
      <div style="padding:10px 12px;border-top:1px solid rgba(48,54,61,.55);display:flex;gap:9px;align-items:flex-end">
        <input type="file" id="chat-file-input" style="display:none" multiple onchange="handleChatFile(this)">
        <button onclick="chatAttach()" title="Share images or files" style="background:none;border:1px solid #30363d;border-radius:8px;padding:9px 10px;color:#484f58;cursor:pointer;flex-shrink:0;font-size:.9em;transition:.15s" onmouseover="this.style.borderColor='#58a6ff';this.style.color='#58a6ff'" onmouseout="this.style.borderColor='#30363d';this.style.color='#484f58'">📎</button>
        <textarea id="chat-input" rows="1" placeholder="Say something to the mesh…"
          onkeydown="chatKeydown(event)"
          oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,90)+'px'"
          onfocus="this.style.borderColor='#58a6ff'" onblur="this.style.borderColor='#30363d'"
          style="flex:1;background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:9px 12px;color:#e6edf3;font-size:.86em;resize:none;height:38px;max-height:90px;font-family:system-ui,sans-serif;outline:none;transition:.15s;overflow-y:auto;line-height:1.5"></textarea>
        <button onclick="chatSend()" id="chat-send-btn"
          style="background:rgba(88,166,255,.13);border:1px solid rgba(88,166,255,.38);color:#58a6ff;border-radius:8px;padding:9px 16px;font-size:.86em;font-weight:600;cursor:pointer;flex-shrink:0;transition:.15s;white-space:nowrap"
          onmouseover="this.style.background='rgba(88,166,255,.22)'" onmouseout="this.style.background='rgba(88,166,255,.13)'">Send 🍄</button>
      </div>
    </div>

    <!-- Neighbourhood peers — rendered by initPeers() -->
    <div style="background:rgba(13,17,23,.82);border:1px solid rgba(48,54,61,.8);border-radius:14px;padding:22px;margin-bottom:18px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
        <div>
          <div style="font-size:.72em;font-weight:700;letter-spacing:.1em;color:#3fb950;text-transform:uppercase;margin-bottom:3px">Mesh Neighbourhood</div>
          <div style="font-size:.75em;color:#484f58">Rocket Routers on your Yggdrasil peers — forms itself automatically</div>
        </div>
        <button onclick="scanPeers()" id="peers-scan-btn"
          style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:7px;padding:7px 14px;font-size:.78em;font-weight:600;cursor:pointer;flex-shrink:0">
          Scan peers
        </button>
      </div>
      <div id="peers-inner" style="min-height:38px">
        <span style="color:#3a3f44;font-size:.82em">&#x27F3; Scanning neighbourhood&#x2026;</span>
      </div>
    </div>

    <!-- Governance section — rendered by initGov() -->
    <div style="background:rgba(13,17,23,.82);border:1px solid rgba(48,54,61,.8);border-radius:14px;padding:24px;margin-bottom:18px">
      <div style="font-size:.72em;font-weight:700;letter-spacing:.1em;color:#e6edf3;text-transform:uppercase;margin-bottom:4px">Community Governance</div>
      <div style="font-size:.75em;color:#484f58;margin-bottom:14px">Three-button system · Ed25519 signed · Mesh-enforced · Cannot be faked</div>
      <div id="gov-inner" style="min-height:60px"><span style="color:#3a3f44;font-size:.82em">&#x27F3; Loading&#x2026;</span></div>
    </div>

    </div><!-- /chat-content-wrap -->
  </div>
</div>

<div class="tc rr-gated" id="t-live">
<div class="rr-gate-pitch" id="gp-live"><div style="max-width:940px;margin:0 auto;padding:14px 16px"><div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px"><div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div><div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">Three companies run the intelligence layer of the internet. Five companies own most of the bandwidth. You pay them monthly for the privilege of having a wire in the wall.<br><br>There&#8217;s another way.<br><br>When you join the Mesh, your router becomes a node in a global peer-to-peer network. Your bandwidth doesn&#8217;t just carry your data &#8212; it carries the freedom of everyone in the Mycelium. You share a little. You gain resilience, redundancy, and a network with no landlords. You help prove the internet can work without permission.<br><br>This is the opposite of an ISP. This is the users owning the network.</div><div style="font-size:.84em;color:#484f58;font-style:italic;margin-bottom:12px">&#8220;ISPs sell you a pipe. We&#8217;re building the water supply.&#8221;</div><div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&#8230;</div><button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &#8212; SHARE THE FREEDOM</button><div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div></div><div style="background:#0d1117;border:2px solid rgba(63,185,80,.3);border-radius:14px;padding:18px 20px"><div style="font-size:.79em;color:#8b949e;line-height:1.7;margin:0 0 14px">Joining is the only step. The mesh doesn&#8217;t ask you to give anything up &#8212; it just asks your router to share what it&#8217;s already running. <span style="color:#484f58">Leave any time, no guilt either way.</span></div><div style="font-size:.78em;font-weight:700;color:#e6edf3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;border-top:1px solid #21262d;padding-top:12px"><span class="gp-feat-hdr">Unlock all 21 features &#8212; everything below, on every tab:</span></div><div style="border:1px solid #21262d;border-radius:8px;overflow:hidden"><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Anomaly Watchdog<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; traffic spike alerts, every 5 minutes, 24/7</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Bandwidth Inheritance</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; when a device goes offline, its priority passes down automatically</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Community Chat<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; encrypted Matrix rooms hosted on your own hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Corporate Discomfort Index<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; daily corporate surveillance score from your DNS logs</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Device Obituaries<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI-written farewell for every device that leaves your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Digital Sovereignty Audit</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; reveals which 3 corporations own 80% of your data path</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Ghost Device Detector</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; surfaces devices generating traffic while claiming to be off</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">ISP Evidence Reporter<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; timestamped speed logs, CSV export ready for Ofcom complaint</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Bandwidth Graph</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; 1-second canvas, every device, right now</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Network Topology</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; visual map of every connection on your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Constitution</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; plain English &#8594; real firewall rules &#40;&#34;kids&#39; tablets off at 9pm&#34;&#41;</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Time Machine<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; hourly snapshots, scroll back through traffic history</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">P2P Video Platform<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; censorship-resistant, no algorithm, no landlord, no plug to pull</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Per-Device VPN Routing</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; different tunnel for every device, applied instantly</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Predictive Modem Reboot<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; detects signal decline and schedules restart before dropout</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router AI (Claude)<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; natural-language network assistant, running on your hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router Diary<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI writes one paragraph every midnight about your network&#39;s day</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router File Explorer</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; full two-pane filesystem manager, in the browser</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Signal Trend Predictor<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; RSRP/SINR history, trend analysis, worst-point detection</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">&#34;Where Did My Data Go?&#34;</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; live world map of every active connection, country and owner</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">WiFi Device Scheduler</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; block any device on any schedule, no app needed</span></div><div style="padding:10px 12px;background:rgba(240,165,0,.06);border-top:2px solid rgba(240,165,0,.2);display:flex;gap:10px;align-items:flex-start"><span style="color:#f0a500;font-size:1em;flex-shrink:0">&#128440;</span><div style="font-size:.78em;color:#8b949e;line-height:1.6"><strong style="color:#f0a500">USB SSD required for &#128440; features.</strong> Connect any USB SSD or USB flash drive to your router's USB port — formatted ext4, 32GB minimum (128GB+ for video). The router mounts it automatically at <code style="color:#e6edf3">/mnt/ssd</code>. Without it, marked features have nowhere to store data and will not log, remember, or record anything. Features without &#128440; work fully from router memory and config storage.</div></div></div></div></div></div>
<div class="rr-gate-veil"></div>
  <!-- Incoming call banner -->
  <div id="live-ring-banner" style="display:none;background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.4);border-radius:12px;padding:14px 18px;margin-bottom:16px;display:none;align-items:center;gap:14px;flex-wrap:wrap">
    <span style="font-size:1.4em;animation:livering 1s infinite">📞</span>
    <div style="flex:1;min-width:140px">
      <div style="color:#3fb950;font-weight:700;font-size:.92em" id="live-ring-who">Incoming call…</div>
      <div style="color:#8b949e;font-size:.77em">Mycelium Live</div>
    </div>
    <button onclick="liveAnswer()" style="background:rgba(63,185,80,.2);border:1px solid rgba(63,185,80,.5);color:#3fb950;border-radius:8px;padding:8px 18px;font-weight:700;cursor:pointer;font-size:.88em">Answer ✅</button>
    <button onclick="liveDecline()" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:8px;padding:8px 18px;font-weight:700;cursor:pointer;font-size:.88em">Decline ❌</button>
  </div>

  <!-- Active call view -->
  <div id="live-call-wrap" style="display:none;background:#0d1117;border:1px solid #30363d;border-radius:14px;overflow:hidden;margin-bottom:16px">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:#21262d;min-height:260px" id="live-video-grid">
      <div style="position:relative;background:#000;min-height:200px">
        <video id="live-local-vid" autoplay muted playsinline style="width:100%;height:100%;object-fit:cover;display:block"></video>
        <div style="position:absolute;bottom:6px;left:8px;background:rgba(0,0,0,.6);color:#e6edf3;font-size:.72em;padding:2px 7px;border-radius:4px">You</div>
      </div>
      <div style="position:relative;background:#161b22;min-height:200px;display:flex;align-items:center;justify-content:center" id="live-remote-wrap">
        <div id="live-wait-msg" style="color:#484f58;font-size:.82em;text-align:center">Waiting for peer…<br><span style="font-size:.8em">Connecting via mesh</span></div>
        <video id="live-remote-vid" autoplay playsinline style="width:100%;height:100%;object-fit:cover;display:none"></video>
        <div id="live-remote-label" style="display:none;position:absolute;bottom:6px;left:8px;background:rgba(0,0,0,.6);color:#e6edf3;font-size:.72em;padding:2px 7px;border-radius:4px"></div>
      </div>
    </div>
    <!-- Call controls -->
    <div style="display:flex;align-items:center;justify-content:center;gap:10px;padding:12px;background:rgba(13,17,23,.95)">
      <button id="live-btn-mute" onclick="liveToggleMute()" title="Mute" style="background:rgba(48,54,61,.6);border:1px solid #30363d;color:#e6edf3;border-radius:50%;width:44px;height:44px;font-size:1.1em;cursor:pointer">🎤</button>
      <button id="live-btn-cam"  onclick="liveToggleCam()"  title="Camera" style="background:rgba(48,54,61,.6);border:1px solid #30363d;color:#e6edf3;border-radius:50%;width:44px;height:44px;font-size:1.1em;cursor:pointer">📷</button>
      <button onclick="liveHangup()" title="Hang up" style="background:rgba(248,81,73,.2);border:1px solid rgba(248,81,73,.4);color:#f85149;border-radius:50%;width:52px;height:52px;font-size:1.3em;cursor:pointer">📵</button>
    </div>
    <div style="text-align:center;padding:4px 0 10px;font-size:.75em;color:#484f58" id="live-call-status">Connecting…</div>
  </div>

  <!-- Idle: peer list and start call -->
  <div id="live-idle-wrap">
    <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:20px 22px;margin-bottom:16px">
      <div style="font-size:.88em;font-weight:700;color:#e6edf3;margin-bottom:4px">📞 Mycelium Live</div>
      <div style="font-size:.78em;color:#8b949e;line-height:1.65;margin-bottom:16px">Peer-to-peer video calls over your mesh. No servers, no accounts, no surveillance. Calls stay inside your network unless both nodes are internet-connected.</div>
      <div style="font-size:.77em;font-weight:600;color:#484f58;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Online Mesh Peers</div>
      <div id="live-peers-list" style="display:flex;flex-direction:column;gap:7px;min-height:40px">
        <div style="color:#3a3f44;font-size:.8em">Loading peers…</div>
      </div>
    </div>
    <!-- Camera/mic test -->
    <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:20px 22px;margin-bottom:16px">
      <div style="font-size:.82em;font-weight:600;color:#8b949e;margin-bottom:12px">🔬 Test your camera &amp; mic</div>
      <div id="live-test-preview" style="display:none;margin-bottom:12px;position:relative;border-radius:10px;overflow:hidden;background:#000;max-width:340px">
        <video id="live-test-vid" autoplay muted playsinline style="width:100%;display:block;border-radius:10px"></video>
        <div style="position:absolute;bottom:8px;left:8px;right:8px;display:flex;align-items:center;gap:8px">
          <div style="flex:1;height:6px;background:rgba(0,0,0,.5);border-radius:3px;overflow:hidden">
            <div id="live-mic-bar" style="height:100%;width:0%;background:#3fb950;border-radius:3px;transition:width .08s"></div>
          </div>
          <span style="font-size:.7em;color:#8b949e">🎤</span>
        </div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button id="live-test-btn" onclick="liveTestCam()" style="background:rgba(88,166,255,.12);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:8px;padding:8px 16px;font-size:.82em;font-weight:600;cursor:pointer">▶ Start test</button>
        <button id="live-test-stop" onclick="liveTestStop()" style="display:none;background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:8px;padding:8px 16px;font-size:.82em;font-weight:600;cursor:pointer">■ Stop</button>
      </div>
      <video id="live-test-video" autoplay muted playsinline style="display:none;width:100%;max-width:340px;border-radius:10px;margin-top:10px;background:#000"></video>
      <div id="live-test-audio-bar" style="display:none;margin-top:8px;max-width:340px">
        <div style="font-size:.72em;color:#8b949e;margin-bottom:4px">🎤 Mic level</div>
        <div style="background:#21262d;border-radius:4px;height:8px;overflow:hidden">
          <div id="live-test-audio-level" style="height:100%;width:0%;background:linear-gradient(90deg,#3fb950,#f0a500);transition:width .08s"></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
          <span style="font-size:.7em;color:#484f58">🔇</span>
          <input type="range" id="live-mic-gain" min="0" max="5" step="0.05" value="1"
            oninput="liveSetMicGain(this.value)"
            style="flex:1;accent-color:#3fb950;cursor:pointer">
          <span style="font-size:.7em;color:#484f58">🔊</span>
          <span id="live-mic-gain-val" style="font-size:.7em;color:#8b949e;min-width:28px">1.0×</span>
        </div>
      </div>
      <div id="live-test-msg" style="font-size:.75em;color:#484f58;margin-top:8px"></div>

      <!-- Live chat box — shown when stream is active -->
      <div id="live-chat-wrap" style="display:none;margin-top:14px;max-width:420px">
        <div style="font-size:.78em;font-weight:600;color:#8b949e;margin-bottom:6px">💬 Live Chat <span id="live-chat-count" style="color:#484f58;font-weight:400"></span></div>
        <div id="live-chat-msgs" style="background:#0d1117;border:1px solid #21262d;border-radius:8px;height:160px;overflow-y:auto;padding:8px 10px;font-size:.76em;color:#c9d1d9;display:flex;flex-direction:column;gap:4px"></div>
        <div style="display:flex;gap:6px;margin-top:6px">
          <input id="live-chat-inp" type="text" placeholder="Say something…" maxlength="300"
            style="flex:1;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:7px;padding:7px 10px;font-size:.8em;outline:none"
            onkeydown="if(event.key==='Enter')liveChatSend()">
          <button onclick="liveChatSend()" style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.4);color:#3fb950;border-radius:7px;padding:7px 14px;font-size:.8em;font-weight:600;cursor:pointer">Send</button>
        </div>
      </div>
    </div>

    <div id="live-gate" style="display:none;background:rgba(248,81,73,.06);border:1px solid rgba(248,81,73,.2);border-radius:10px;padding:12px 16px;font-size:.8em;color:#8b949e">
      Join the mesh to make calls.
    </div>
  </div>
</div>
<div class="tc rr-gated" id="t-search">
<div class="rr-gate-pitch" id="gp-search"><div style="max-width:940px;margin:0 auto;padding:14px 16px"><div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px"><div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div><div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">Three companies run the intelligence layer of the internet. Five companies own most of the bandwidth. You pay them monthly for the privilege of having a wire in the wall.<br><br>There&#8217;s another way.<br><br>When you join the Mesh, your router becomes a node in a global peer-to-peer network. Your bandwidth doesn&#8217;t just carry your data &#8212; it carries the freedom of everyone in the Mycelium. You share a little. You gain resilience, redundancy, and a network with no landlords. You help prove the internet can work without permission.<br><br>This is the opposite of an ISP. This is the users owning the network.</div><div style="font-size:.84em;color:#484f58;font-style:italic;margin-bottom:12px">&#8220;ISPs sell you a pipe. We&#8217;re building the water supply.&#8221;</div><div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&#8230;</div><button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &#8212; SHARE THE FREEDOM</button><div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div></div><div style="background:#0d1117;border:2px solid rgba(63,185,80,.3);border-radius:14px;padding:18px 20px"><div style="font-size:.79em;color:#8b949e;line-height:1.7;margin:0 0 14px">Joining is the only step. The mesh doesn&#8217;t ask you to give anything up &#8212; it just asks your router to share what it&#8217;s already running. <span style="color:#484f58">Leave any time, no guilt either way.</span></div><div style="font-size:.78em;font-weight:700;color:#e6edf3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;border-top:1px solid #21262d;padding-top:12px"><span class="gp-feat-hdr">Unlock all 21 features &#8212; everything below, on every tab:</span></div><div style="border:1px solid #21262d;border-radius:8px;overflow:hidden"><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Anomaly Watchdog<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; traffic spike alerts, every 5 minutes, 24/7</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Bandwidth Inheritance</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; when a device goes offline, its priority passes down automatically</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Community Chat<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; encrypted Matrix rooms hosted on your own hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Corporate Discomfort Index<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; daily corporate surveillance score from your DNS logs</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Device Obituaries<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI-written farewell for every device that leaves your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Digital Sovereignty Audit</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; reveals which 3 corporations own 80% of your data path</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Ghost Device Detector</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; surfaces devices generating traffic while claiming to be off</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">ISP Evidence Reporter<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; timestamped speed logs, CSV export ready for Ofcom complaint</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Bandwidth Graph</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; 1-second canvas, every device, right now</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Network Topology</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; visual map of every connection on your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Constitution</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; plain English &#8594; real firewall rules &#40;&#34;kids&#39; tablets off at 9pm&#34;&#41;</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Time Machine<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; hourly snapshots, scroll back through traffic history</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">P2P Video Platform<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; censorship-resistant, no algorithm, no landlord, no plug to pull</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Per-Device VPN Routing</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; different tunnel for every device, applied instantly</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Predictive Modem Reboot<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; detects signal decline and schedules restart before dropout</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router AI (Claude)<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; natural-language network assistant, running on your hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router Diary<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI writes one paragraph every midnight about your network&#39;s day</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router File Explorer</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; full two-pane filesystem manager, in the browser</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Signal Trend Predictor<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; RSRP/SINR history, trend analysis, worst-point detection</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">&#34;Where Did My Data Go?&#34;</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; live world map of every active connection, country and owner</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">WiFi Device Scheduler</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; block any device on any schedule, no app needed</span></div><div style="padding:10px 12px;background:rgba(240,165,0,.06);border-top:2px solid rgba(240,165,0,.2);display:flex;gap:10px;align-items:flex-start"><span style="color:#f0a500;font-size:1em;flex-shrink:0">&#128440;</span><div style="font-size:.78em;color:#8b949e;line-height:1.6"><strong style="color:#f0a500">USB SSD required for &#128440; features.</strong> Connect any USB SSD or USB flash drive to your router's USB port — formatted ext4, 32GB minimum (128GB+ for video). The router mounts it automatically at <code style="color:#e6edf3">/mnt/ssd</code>. Without it, marked features have nowhere to store data and will not log, remember, or record anything. Features without &#128440; work fully from router memory and config storage.</div></div></div></div></div></div>
<div class="rr-gate-veil"></div>
<div style="max-width:860px;margin:0 auto;padding:0 0 48px">

  <!-- Header -->
  <div style="padding:28px 0 20px;border-bottom:1px solid #21262d;margin-bottom:22px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px">
      <span style="font-size:1.6em">🔍</span>
      <h2 style="font-size:1.25em;font-weight:700;color:#e6edf3;margin:0">Uncensored Search</h2>
      <span style="font-size:.7em;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:rgba(63,185,80,.12);color:#3fb950;border:1px solid rgba(63,185,80,.3);border-radius:20px;padding:3px 10px">No corporate filter</span>
    </div>
    <p style="color:#484f58;font-size:.82em;margin:0;line-height:1.7">Pick your engine, type, search. Brave, DDG, Presearch, Marginalia — no ads, no bubble, no tracking. Your query goes straight to the engine you trust.</p>
  </div>

  <!-- Search bar -->
  <div style="display:flex;gap:8px;margin-bottom:10px">
    <input id="search-query" type="text" placeholder="Search anything — no filter, no ads, no bubble…"
      style="flex:1;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:10px;padding:14px 18px;font-size:1em;outline:none;transition:border-color .2s"
      onfocus="this.style.borderColor='#3fb950'" onblur="this.style.borderColor='#30363d'"
      onkeydown="if(event.key==='Enter')doSearch()">
    <button onclick="toggleLocation()" id="loc-btn" title="Add my location to search"
      style="background:#161b22;border:1px solid #30363d;color:#484f58;border-radius:10px;padding:14px 15px;font-size:1.1em;cursor:pointer;transition:.2s">📍</button>
    <button onclick="doSearch()"
      style="background:linear-gradient(135deg,#196127,#2ea043);border:1px solid rgba(63,185,80,.4);color:#fff;border-radius:10px;padding:14px 26px;font-size:.95em;font-weight:700;cursor:pointer;white-space:nowrap">Search →</button>
  </div>
  <div id="loc-status" style="font-size:.74em;color:#484f58;margin-bottom:12px;min-height:16px;padding-left:4px"></div>

  <!-- Category chips -->
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px" id="cat-row">
    <button onclick="setCategory('general')" id="cat-general" class="cat-btn cat-active"
      style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.4);color:#3fb950;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">🌐 Web</button>
    <button onclick="setCategory('news')" id="cat-news" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">📰 News</button>
    <button onclick="setCategory('images')" id="cat-images" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">🖼️ Images</button>
    <button onclick="setCategory('videos')" id="cat-videos" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">🎬 Videos</button>
    <button onclick="setCategory('social media')" id="cat-social" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">💬 Reddit</button>
    <button onclick="setCategory('science')" id="cat-science" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">🔬 Science</button>
    <button onclick="setCategory('it')" id="cat-it" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">💻 Tech</button>
    <button onclick="setCategory('map')" id="cat-map" class="cat-btn"
      style="background:rgba(255,255,255,.04);border:1px solid #30363d;color:#8b949e;border-radius:20px;padding:5px 14px;font-size:.78em;font-weight:700;cursor:pointer">🗺️ Maps</button>
  </div>

  <!-- Quick searches -->
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:24px">
    <span style="font-size:.72em;color:#484f58;padding:5px 2px;white-space:nowrap">Try:</span>
    <button onclick="srchQuick('rocket routers review')" style="background:none;border:1px solid #21262d;color:#484f58;border-radius:20px;padding:4px 12px;font-size:.75em;cursor:pointer">rocket routers review</button>
    <button onclick="srchQuick('5G router UK 2025')" style="background:none;border:1px solid #21262d;color:#484f58;border-radius:20px;padding:4px 12px;font-size:.75em;cursor:pointer">5G router UK 2025</button>
    <button onclick="srchQuick('best uncensored search engine')" style="background:none;border:1px solid #21262d;color:#484f58;border-radius:20px;padding:4px 12px;font-size:.75em;cursor:pointer">best uncensored search</button>
    <button onclick="srchQuick('OpenWrt vs stock firmware')" style="background:none;border:1px solid #21262d;color:#484f58;border-radius:20px;padding:4px 12px;font-size:.75em;cursor:pointer">OpenWrt vs stock firmware</button>
  </div>

  <!-- Engine picker (always visible) -->
  <div style="margin-bottom:20px">
    <div style="font-size:.74em;color:#484f58;margin-bottom:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase">Search with:</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button id="also-brave" onclick="openInEngine('brave')"
        style="background:rgba(255,107,53,.18);border:1px solid rgba(255,107,53,.5);color:#ff6b35;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">🦁 Brave</button>
      <button id="also-ddg" onclick="openInEngine('ddg')"
        style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">🦆 DuckDuckGo</button>
      <button id="also-presearch" onclick="openInEngine('presearch')"
        style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">🔗 Presearch</button>
      <button id="also-marginalia" onclick="openInEngine('marginalia')"
        style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">📖 Marginalia</button>
      <button id="also-yep" onclick="openInEngine('yep')"
        style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">🔵 Yep</button>
      <button id="also-google" onclick="openInEngine('google')"
        style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:8px;padding:7px 16px;font-size:.82em;font-weight:700;cursor:pointer">G Google</button>
    </div>
  </div>

  <div style="border-top:1px solid #21262d;margin:32px 0 24px"></div>

  <!-- Image Search section -->
  <div style="margin-bottom:12px;display:flex;align-items:center;gap:10px">
    <span style="font-size:1em;font-weight:700;color:#e6edf3">🖼️ Image Search</span>
    <span style="font-size:.72em;color:#484f58">Find anything by picture — products, places, people, artwork</span>
  </div>
  <div id="img-dropzone"
    style="border:2px dashed #30363d;border-radius:12px;padding:28px;text-align:center;cursor:pointer;transition:.2s;margin-bottom:12px;background:#0d1117;position:relative"
    onclick="document.getElementById('img-file-input').click()"
    ondragover="event.preventDefault();this.style.borderColor='#3fb950';this.style.background='rgba(63,185,80,.04)'"
    ondragleave="this.style.borderColor='#30363d';this.style.background='#0d1117'"
    ondrop="handleImgDrop(event)">
    <input type="file" id="img-file-input" accept="image/*" style="display:none" onchange="handleImgFile(this.files[0])">
    <div id="img-preview-wrap" style="display:none;position:relative">
      <img id="img-preview" style="max-height:180px;max-width:100%;border-radius:8px;margin-bottom:10px">
      <button onclick="event.stopPropagation();clearImage()" style="position:absolute;top:-8px;right:-8px;background:#f85149;border:none;color:#fff;border-radius:50%;width:22px;height:22px;font-size:.75em;cursor:pointer;line-height:22px">✕</button>
    </div>
    <div id="img-dropzone-label">
      <div style="font-size:1.8em;margin-bottom:8px">📸</div>
      <div style="color:#3fb950;font-weight:600;font-size:.88em;margin-bottom:4px">Drop image here · Click to upload · Ctrl+V to paste</div>
      <div style="color:#484f58;font-size:.76em">JPG, PNG, WebP, GIF — any image from your device or clipboard</div>
    </div>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:16px;align-items:center">
    <span style="color:#484f58;font-size:.82em;white-space:nowrap">or image URL:</span>
    <input id="img-url" type="text" placeholder="https://example.com/image.jpg"
      style="flex:1;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:8px;padding:9px 14px;font-size:.82em;outline:none;font-family:monospace"
      onfocus="this.style.borderColor='#3fb950'" onblur="this.style.borderColor='#30363d'"
      oninput="previewImgUrl(this.value)">
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-bottom:12px">
    <button onclick="imgSearch('lens')" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      🔍 Find This Image<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">Google Lens</div>
    </button>
    <button onclick="imgSearch('shopping')" style="background:rgba(240,165,0,.1);border:1px solid rgba(240,165,0,.3);color:#f0a500;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      🛒 Find Cheaper<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">Google Shopping</div>
    </button>
    <button onclick="imgSearch('tineye')" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      👁️ Who/What Is This?<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">TinEye · original source</div>
    </button>
    <button onclick="imgSearch('yandex')" style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      🔴 Yandex Images<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">Products &amp; art</div>
    </button>
    <button onclick="imgSearch('bing')" style="background:rgba(255,255,255,.05);border:1px solid #30363d;color:#8b949e;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      🔷 Bing Visual<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">Microsoft</div>
    </button>
    <button onclick="imgSearch('maps')" style="background:rgba(63,185,80,.08);border:1px solid rgba(63,185,80,.2);color:#3fb950;border-radius:10px;padding:11px 8px;font-size:.8em;font-weight:700;cursor:pointer;text-align:center">
      🌍 Where Is This?<div style="font-size:.72em;font-weight:400;color:#8b949e;margin-top:3px">Google Maps</div>
    </button>
