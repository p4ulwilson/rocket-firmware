<div class="tc rr-gated" id="t-account">
<div class="rr-gate-pitch" id="gp-account"><div style="max-width:940px;margin:0 auto;padding:14px 16px"><div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px"><div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div><div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">Three companies run the intelligence layer of the internet. Five companies own most of the bandwidth. You pay them monthly for the privilege of having a wire in the wall.<br><br>There&#8217;s another way.<br><br>When you join the Mesh, your router becomes a node in a global peer-to-peer network. Your bandwidth doesn&#8217;t just carry your data &#8212; it carries the freedom of everyone in the Mycelium. You share a little. You gain resilience, redundancy, and a network with no landlords. You help prove the internet can work without permission.<br><br>This is the opposite of an ISP. This is the users owning the network.</div><div style="font-size:.84em;color:#484f58;font-style:italic;margin-bottom:12px">&#8220;ISPs sell you a pipe. We&#8217;re building the water supply.&#8221;</div><div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&#8230;</div><button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &#8212; SHARE THE FREEDOM</button><div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div></div><div style="background:#0d1117;border:2px solid rgba(63,185,80,.3);border-radius:14px;padding:18px 20px"><div style="font-size:.79em;color:#8b949e;line-height:1.7;margin:0 0 14px">Joining is the only step. The mesh doesn&#8217;t ask you to give anything up &#8212; it just asks your router to share what it&#8217;s already running. <span style="color:#484f58">Leave any time, no guilt either way.</span></div><div style="font-size:.78em;font-weight:700;color:#e6edf3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;border-top:1px solid #21262d;padding-top:12px"><span class="gp-feat-hdr">Unlock all 21 features &#8212; everything below, on every tab:</span></div><div style="border:1px solid #21262d;border-radius:8px;overflow:hidden"><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Anomaly Watchdog<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; traffic spike alerts, every 5 minutes, 24/7</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Bandwidth Inheritance</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; when a device goes offline, its priority passes down automatically</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Community Chat<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; encrypted Matrix rooms hosted on your own hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Corporate Discomfort Index<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; daily corporate surveillance score from your DNS logs</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Device Obituaries<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI-written farewell for every device that leaves your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Digital Sovereignty Audit</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; reveals which 3 corporations own 80% of your data path</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Ghost Device Detector</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; surfaces devices generating traffic while claiming to be off</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">ISP Evidence Reporter<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; timestamped speed logs, CSV export ready for Ofcom complaint</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Bandwidth Graph</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; 1-second canvas, every device, right now</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Network Topology</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; visual map of every connection on your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Constitution</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; plain English &#8594; real firewall rules &#40;&#34;kids&#39; tablets off at 9pm&#34;&#41;</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Time Machine<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; hourly snapshots, scroll back through traffic history</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">P2P Video Platform<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; censorship-resistant, no algorithm, no landlord, no plug to pull</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Per-Device VPN Routing</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; different tunnel for every device, applied instantly</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Predictive Modem Reboot<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; detects signal decline and schedules restart before dropout</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router AI (Claude)<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; natural-language network assistant, running on your hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router Diary<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI writes one paragraph every midnight about your network&#39;s day</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router File Explorer</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; full two-pane filesystem manager, in the browser</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Signal Trend Predictor<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; RSRP/SINR history, trend analysis, worst-point detection</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">&#34;Where Did My Data Go?&#34;</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; live world map of every active connection, country and owner</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">WiFi Device Scheduler</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; block any device on any schedule, no app needed</span></div><div style="padding:10px 12px;background:rgba(240,165,0,.06);border-top:2px solid rgba(240,165,0,.2);display:flex;gap:10px;align-items:flex-start"><span style="color:#f0a500;font-size:1em;flex-shrink:0">&#128440;</span><div style="font-size:.78em;color:#8b949e;line-height:1.6"><strong style="color:#f0a500">USB SSD required for &#128440; features.</strong> Connect any USB SSD or USB flash drive to your router's USB port — formatted ext4, 32GB minimum (128GB+ for video). The router mounts it automatically at <code style="color:#e6edf3">/mnt/ssd</code>. Without it, marked features have nowhere to store data and will not log, remember, or record anything. Features without &#128440; work fully from router memory and config storage.</div></div></div></div></div></div>
<div class="rr-gate-veil"></div>

  <!-- Logged in view -->
  <div id="account-loggedin" style="display:none;max-width:560px;margin:0 auto">
    <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:24px 26px;margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:18px">
        <div id="acct-header-avatar" style="width:52px;height:52px;border-radius:50%;overflow:hidden;flex-shrink:0;background:#161b22">👤</div>
        <div>
          <div style="font-size:1.05em;font-weight:700;color:#e6edf3" id="acct-display-name"></div>
          <div style="font-size:.78em;color:#484f58;margin-top:2px" id="acct-user-id"></div>
        </div>
      </div>

      <!-- Avatar picker -->
      <div style="border-top:1px solid #21262d;padding-top:18px;margin-bottom:18px">
        <div style="font-size:.8em;font-weight:600;color:#8b949e;margin-bottom:10px">🎭 Choose your avatar</div>
        <div style="display:grid;grid-template-columns:repeat(10,1fr);gap:6px;margin-bottom:12px" id="av-pick-grid"></div>
        <div style="font-size:.78em;font-weight:600;color:#8b949e;margin-bottom:6px">📷 Or upload a photo</div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <input type="file" id="acct-pic-file" accept="image/*" style="font-size:.78em;color:#8b949e;background:#0d1117;border:1px solid #30363d;border-radius:7px;padding:5px 8px;cursor:pointer">
          <button onclick="acctUploadPic()" style="background:rgba(88,166,255,.12);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:7px;padding:7px 14px;font-size:.78em;cursor:pointer">Upload</button>
          <span id="acct-pic-msg" style="font-size:.76em;color:#3fb950"></span>
        </div>
      </div>

      <div style="background:#0d1117;border:1px solid #21262d;border-radius:10px;padding:14px 16px;font-size:.8em;line-height:1.9;color:#8b949e">
        <div>💬 <strong style="color:#c9d1d9">Chat</strong> — messages appear as you</div>
        <div>📹 <strong style="color:#c9d1d9">Video</strong> — uploads tagged to your channel <span style="color:#3a3f44">(coming soon)</span></div>
        <div>📞 <strong style="color:#c9d1d9">Live</strong> — calls use your mesh identity</div>
        <div>📧 <strong style="color:#c9d1d9">Email</strong> — your@rocketrouters.co.uk <span style="color:#3a3f44">(coming soon)</span></div>
      </div>
      <!-- Change invite code (router owner option) -->
      <div id="acct-change-code-wrap" style="margin-top:20px;border-top:1px solid #21262d;padding-top:18px">
        <div style="font-size:.8em;font-weight:600;color:#8b949e;margin-bottom:6px">🔑 Mesh invite code</div>
        <div style="font-size:.75em;color:#484f58;margin-bottom:10px">Share this code with people you want to join your mesh. <strong style="color:#3fb950">Changing it never affects existing accounts</strong> — only new sign-ups need the new code.</div>
        <div id="acct-code-display" style="display:none;background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:10px 14px;font-family:monospace;font-size:.9em;color:#3fb950;margin-bottom:10px;letter-spacing:.05em"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button onclick="acctRevealCode(this)" id="acct-reveal-btn" style="background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:7px;padding:7px 16px;font-size:.8em;cursor:pointer">Show current code</button>
          <button onclick="acctChangeCodePrompt()" style="background:none;border:1px solid #30363d;color:#8b949e;border-radius:7px;padding:7px 16px;font-size:.8em;cursor:pointer">Change code</button>
        </div>
        <div id="acct-new-code-wrap" style="display:none;margin-top:12px">
          <div style="font-size:.75em;color:#f0a500;margin-bottom:8px;line-height:1.5">⚠️ Only change this if you want to stop the current code working for new sign-ups. <strong>Existing accounts are completely unaffected.</strong></div>
          <div style="display:flex;gap:8px">
            <input id="acct-new-code-inp" type="text" placeholder="New invite code" style="flex:1;background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:7px;padding:8px 12px;font-size:.85em;outline:none">
            <button onclick="acctSaveCode()" style="background:rgba(240,165,0,.15);border:1px solid rgba(240,165,0,.4);color:#f0a500;border-radius:7px;padding:8px 14px;font-size:.8em;cursor:pointer;white-space:nowrap">Save</button>
            <button onclick="document.getElementById('acct-new-code-wrap').style.display='none'" style="background:none;border:1px solid #30363d;color:#484f58;border-radius:7px;padding:8px 10px;font-size:.8em;cursor:pointer">✕</button>
          </div>
          <div id="acct-code-msg" style="display:none;font-size:.75em;margin-top:7px"></div>
        </div>
      </div>
      <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
        <button onclick="userLogout();show('account',document.getElementById('tab-account'))" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:8px;padding:9px 20px;font-size:.82em;font-weight:600;cursor:pointer">Sign out of this device</button>
        <button onclick="acctDeletePrompt()" style="background:none;border:1px solid #30363d;color:#484f58;border-radius:8px;padding:9px 20px;font-size:.82em;cursor:pointer">Delete account</button>
      </div>
      <!-- Node owner claim -->
      <div id="acct-owner-wrap" style="display:none;margin-top:14px;background:rgba(240,165,0,.06);border:1px solid rgba(240,165,0,.25);border-radius:10px;padding:14px 16px">
        <div style="font-size:.82em;font-weight:700;color:#f0a500;margin-bottom:4px">👑 Claim router ownership</div>
        <div style="font-size:.76em;color:#8b949e;margin-bottom:10px;line-height:1.6">No owner is set on this router. As the first registered user you can claim ownership — this lets you delete any video and manage the mesh.</div>
        <button onclick="acctClaimOwner()" style="background:rgba(240,165,0,.15);border:1px solid rgba(240,165,0,.4);color:#f0a500;border-radius:7px;padding:8px 18px;font-size:.82em;font-weight:700;cursor:pointer">👑 Claim ownership</button>
        <div id="acct-owner-msg" style="font-size:.76em;margin-top:8px"></div>
      </div>
      <!-- Delete account confirmation -->
      <div id="acct-delete-wrap" style="display:none;margin-top:14px;background:rgba(248,81,73,.06);border:1px solid rgba(248,81,73,.25);border-radius:10px;padding:14px 16px">
        <div style="font-size:.82em;font-weight:700;color:#f85149;margin-bottom:6px">⚠️ Delete your account?</div>
        <div style="font-size:.76em;color:#8b949e;margin-bottom:10px;line-height:1.6">This will permanently delete your account. This cannot be undone. Enter your password to confirm.<br><br>⚠️ Your username is <strong style="color:#f85149">permanently retired</strong> — you cannot reuse it. Any videos you uploaded will become anonymous. All your chat history will be lost.</div>
        <input id="acct-delete-pass" type="password" placeholder="Your password" style="width:100%;background:#0d1117;border:1px solid rgba(248,81,73,.4);color:#e6edf3;border-radius:7px;padding:8px 12px;font-size:.85em;outline:none;box-sizing:border-box;margin-bottom:10px">
        <div style="display:flex;gap:8px">
          <button onclick="acctDeleteConfirm()" id="acct-delete-btn" style="background:rgba(248,81,73,.2);border:1px solid rgba(248,81,73,.5);color:#f85149;border-radius:7px;padding:8px 18px;font-size:.82em;font-weight:700;cursor:pointer">Yes, delete forever</button>
          <button onclick="document.getElementById('acct-delete-wrap').style.display='none'" style="background:none;border:1px solid #30363d;color:#8b949e;border-radius:7px;padding:8px 14px;font-size:.82em;cursor:pointer">Cancel</button>
        </div>
        <div id="acct-delete-msg" style="display:none;font-size:.76em;margin-top:8px"></div>
      </div>
    </div>
  </div>

  <!-- Logged out view -->
  <div id="account-loggedout" style="max-width:460px;margin:0 auto">
    <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:24px 26px;margin-bottom:16px">
      <div style="font-size:1.05em;font-weight:700;color:#e6edf3;margin-bottom:6px">🍄 Your Mycelium Identity</div>
      <div style="font-size:.82em;color:#8b949e;line-height:1.75;margin-bottom:20px">
        One account on this router. Works across chat, video, live calls and — coming soon — mesh email. Your credentials never leave the router. No central server. No company holding your data.
        <br><br>
        <span style="color:#484f58">Want to invite others? Share the mesh invite code with them — they'll enter it when creating their account.</span>
      </div>

      <!-- Claim ownership banner (shown when no owner set) -->
      <div id="acct-claim-banner" style="display:none;background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.3);border-radius:10px;padding:12px 14px;margin-bottom:16px">
        <div style="font-size:.82em;font-weight:700;color:#f0a500;margin-bottom:3px">👑 No owner set on this router</div>
        <div style="font-size:.75em;color:#8b949e;margin-bottom:8px;line-height:1.5">Register your account then claim ownership — this lets you manage videos and the mesh.</div>
      </div>

      <!-- Tab switcher -->
      <div style="display:flex;border:1px solid #30363d;border-radius:9px;overflow:hidden;margin-bottom:18px">
        <button id="acct-tab-reg"   onclick="acctTab('reg')"   style="flex:1;padding:9px;background:rgba(63,185,80,.15);border:none;color:#3fb950;font-weight:600;font-size:.84em;cursor:pointer">Create Account</button>
        <button id="acct-tab-login" onclick="acctTab('login')" style="flex:1;padding:9px;background:none;border:none;color:#8b949e;font-size:.84em;cursor:pointer">Sign In</button>
      </div>

      <div id="acct-err" style="display:none;background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);border-radius:7px;padding:9px 13px;font-size:.8em;color:#f85149;margin-bottom:14px"></div>

      <div style="display:flex;flex-direction:column;gap:11px">
        <div>
          <label style="font-size:.75em;color:#484f58;display:block;margin-bottom:4px">Username</label>
          <input id="acct-inp-name" type="text" placeholder="e.g. fannybottom" autocomplete="off" style="background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:8px;padding:10px 13px;font-size:.88em;outline:none;width:100%;box-sizing:border-box">
          <div id="acct-name-hint" style="font-size:.72em;color:#484f58;margin-top:3px">Letters, numbers, . _ - only. Your address will be @you:rocketrouters.co.uk<br><span style="color:#f0a500">⚠️ Choose carefully — your username is permanent. If you ever delete your account, this name can never be reused.</span></div>
        </div>
        <div>
          <label style="font-size:.75em;color:#484f58;display:block;margin-bottom:4px">Password</label>
          <input id="acct-inp-pass" type="password" placeholder="Min 8 characters" autocomplete="new-password" style="background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:8px;padding:10px 13px;font-size:.88em;outline:none;width:100%;box-sizing:border-box">
        </div>
        <div id="acct-pass2-wrap">
          <label style="font-size:.75em;color:#484f58;display:block;margin-bottom:4px">Confirm password</label>
          <input id="acct-inp-pass2" type="password" placeholder="Repeat password" autocomplete="new-password" style="background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:8px;padding:10px 13px;font-size:.88em;outline:none;width:100%;box-sizing:border-box">
        </div>
        <div id="acct-invite-wrap">
          <label style="font-size:.75em;color:#484f58;display:block;margin-bottom:4px">Mesh invite code</label>
          <input id="acct-inp-invite" type="text" placeholder="Ask the router owner for this" autocomplete="off" style="background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:8px;padding:10px 13px;font-size:.88em;outline:none;width:100%;box-sizing:border-box">
          <div style="font-size:.72em;color:#484f58;margin-top:3px" id="acct-invite-hint">Ask the router owner &mdash; or if <em>you are</em> the owner, <a href="#" onclick="acctShowInviteCode();return false" style="color:#3fb950">tap here to reveal yours</a>.</div>
        </div>
        <div id="acct-avatar-wrap">
          <label style="font-size:.75em;color:#484f58;display:block;margin-bottom:8px">Choose a starter avatar</label>
          <div style="display:flex;gap:10px;align-items:center">
            <button type="button" id="reg-av-lady" onclick="regPickGender('lady')" style="flex:1;padding:10px 6px;background:rgba(88,166,255,.08);border:2px solid rgba(88,166,255,.35);border-radius:10px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px">
              <span style="font-size:1.9em">👩</span>
              <span style="font-size:.72em;color:#8b949e">Lady</span>
            </button>
            <button type="button" id="reg-av-gent" onclick="regPickGender('gent')" style="flex:1;padding:10px 6px;background:none;border:2px solid #30363d;border-radius:10px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px">
              <span style="font-size:1.9em">🧑</span>
              <span style="font-size:.72em;color:#8b949e">Gent</span>
            </button>
          </div>
          <input type="hidden" id="reg-av-idx" value="4">
        </div>
      </div>

      <button id="acct-submit-btn" onclick="acctSubmit()" style="width:100%;margin-top:16px;background:rgba(63,185,80,.2);border:1px solid rgba(63,185,80,.5);color:#3fb950;border-radius:9px;padding:12px;font-size:.9em;font-weight:700;cursor:pointer">Create Account</button>
      <div style="text-align:center;margin-top:10px;font-size:.72em;color:#3a3f44">Your password never leaves this router · No tracking · No cloud</div>
    </div>
  </div>

</div>

<div class="tc rr-gated" id="t-ssd">

<!-- donate + mesh cards at top — same as all tabs -->
<div style="max-width:940px;margin:0 auto;padding:14px 16px 0">
  <div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px">
    <div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div>
    <div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">When you join the Mesh, your router becomes a node in a global peer-to-peer network. No landlords. No ISP. Just users sharing bandwidth and building something that can't be switched off.</div>
    <div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&hellip;</div>
    <button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &mdash; SHARE THE FREEDOM</button>
    <div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div>
    <div style="font-size:.78em;color:#8b949e;line-height:1.6;margin-top:12px">Joining unlocks everything below &mdash; no separate donation needed.</div>
  </div>
</div>

<!-- SSD Setup wizard -->
<div style="max-width:560px;margin:0 auto;padding:0 16px 48px">

  <div style="text-align:center;margin-bottom:24px">
    <div style="font-size:2em;margin-bottom:8px">&#128440;</div>
    <div style="font-size:1.1em;font-weight:800;color:#e6edf3;margin-bottom:6px">SSD Setup</div>
    <div style="font-size:.82em;color:#8b949e;line-height:1.65">Plug a USB SSD or USB stick into your router&rsquo;s USB port, then follow the steps below. Once set up, all &#128440; features unlock automatically.</div>
  </div>

  <!-- step: checking -->
  <div id="ssd-step-check" style="text-align:center;padding:24px 0;color:#484f58;font-size:.85em">&#8987; Checking SSD status&hellip;</div>

  <!-- step: already mounted (success state on load) -->
  <div id="ssd-step-ready" style="display:none">
    <div style="background:rgba(63,185,80,.1);border:2px solid rgba(63,185,80,.4);border-radius:12px;padding:20px 22px;text-align:center">
      <div style="font-size:1.8em;margin-bottom:8px">&#9989;</div>
      <div style="font-size:1em;font-weight:800;color:#3fb950;margin-bottom:6px">SSD is mounted and ready</div>
      <div id="ssd-ready-info" style="font-size:.8em;color:#8b949e;line-height:1.6;margin-bottom:14px"></div>
      <div style="font-size:.75em;color:#484f58">All &#128440; features are active. No further setup needed.</div>
    </div>
    <div style="text-align:center;margin-top:16px">
      <a onclick="ssdShowStep('ssd-step-scan')" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Reformat or replace this drive</a>
    </div>
  </div>

  <!-- step: scan -->
  <div id="ssd-step-scan" style="display:none;text-align:center">
    <div style="font-size:.85em;color:#8b949e;margin-bottom:18px">Connect your USB drive to the router&rsquo;s USB port, then scan to detect it.</div>
    <button onclick="ssdScan()" style="background:rgba(88,166,255,.15);border:1px solid rgba(88,166,255,.4);color:#58a6ff;border-radius:9px;padding:11px 28px;font-size:.88em;font-weight:700;cursor:pointer">&#128269; Scan for Drives</button>
  </div>

  <!-- step: drive list -->
  <div id="ssd-step-list" style="display:none">
    <div style="font-size:.82em;color:#8b949e;margin-bottom:12px;text-align:center">Select the drive to set up as your Rocket SSD:</div>
    <div id="ssd-drive-cards" style="display:flex;flex-direction:column;gap:10px"></div>
    <div style="text-align:center;margin-top:14px">
      <a onclick="ssdScan()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Rescan</a>
    </div>
  </div>

  <!-- step: warning -->
  <div id="ssd-step-warn" style="display:none">
    <div style="background:rgba(248,81,73,.08);border:2px solid rgba(248,81,73,.5);border-radius:12px;padding:20px 22px">
      <div style="font-size:1em;font-weight:800;color:#f85149;margin-bottom:10px">&#9888; This will erase everything on the drive</div>
      <div id="ssd-warn-info" style="font-size:.82em;color:#c9d1d9;line-height:1.65;margin-bottom:14px"></div>
      <div style="font-size:.8em;color:#8b949e;line-height:1.6">The drive will be formatted as ext4 with the label <code style="color:#e6edf3">RocketSSD</code> and mounted at <code style="color:#e6edf3">/mnt/ssd</code>. All &#128440; features will activate once formatting is complete.</div>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px">
      <button onclick="ssdShowStep('ssd-step-scan')" style="flex:1;background:none;border:1px solid #30363d;color:#8b949e;border-radius:9px;padding:10px;font-size:.85em;cursor:pointer">&#8592; Back</button>
      <button onclick="ssdShowStep('ssd-step-confirm')" style="flex:2;background:rgba(248,81,73,.2);border:1px solid rgba(248,81,73,.5);color:#f85149;border-radius:9px;padding:10px;font-size:.85em;font-weight:700;cursor:pointer">I understand &mdash; continue</button>
    </div>
  </div>

  <!-- step: confirm -->
  <div id="ssd-step-confirm" style="display:none">
    <div style="font-size:.85em;color:#8b949e;margin-bottom:10px;text-align:center">Type <strong style="color:#f85149">ERASE</strong> to confirm you want to wipe the drive:</div>
    <input id="ssd-erase-input" type="text" placeholder="ERASE" autocomplete="off" autocorrect="off" spellcheck="false"
      style="width:100%;box-sizing:border-box;background:#0d1117;border:2px solid #30363d;color:#e6edf3;border-radius:9px;padding:11px 14px;font-size:1em;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;outline:none;text-align:center"
      oninput="document.getElementById('ssd-erase-input').style.borderColor=this.value==='ERASE'?'rgba(248,81,73,.7)':'#30363d'">
    <button onclick="ssdFormat()" style="width:100%;background:rgba(248,81,73,.25);border:2px solid rgba(248,81,73,.6);color:#f85149;border-radius:9px;padding:12px;font-size:.92em;font-weight:800;cursor:pointer">&#128308; FORMAT AND SET UP DRIVE</button>
    <div style="text-align:center;margin-top:12px">
      <a onclick="ssdShowStep('ssd-step-warn')" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">&#8592; Back</a>
    </div>
  </div>

  <!-- step: formatting spinner -->
  <div id="ssd-step-formatting" style="display:none;text-align:center;padding:28px 0">
    <div style="font-size:.88em;color:#f0a500;margin-bottom:8px">&#128308; Formatting&hellip;</div>
    <div style="font-size:.78em;color:#484f58">This takes about 10&ndash;30 seconds. Do not unplug the drive.</div>
  </div>

  <!-- step: done -->
  <div id="ssd-step-done" style="display:none">
    <div style="background:rgba(63,185,80,.1);border:2px solid rgba(63,185,80,.4);border-radius:12px;padding:24px 22px;text-align:center">
      <div style="font-size:2em;margin-bottom:10px">&#127881;</div>
      <div style="font-size:1em;font-weight:800;color:#3fb950;margin-bottom:6px">SSD formatted and mounted</div>
      <div style="font-size:.8em;color:#8b949e;line-height:1.65;margin-bottom:14px">Your drive is live at <code style="color:#e6edf3">/mnt/ssd</code>. All &#128440; features are now active. Head to any tab to start using them.</div>
      <div style="font-size:.78em;color:#484f58">Folders created: tuwunel-db &middot; rr-profiles &middot; rr-claude &middot; rr-logs &middot; video</div>
    </div>
  </div>

  <!-- error display -->
  <div id="ssd-error" style="display:none;margin-top:14px;background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.3);border-radius:8px;padding:10px 14px;font-size:.8em;color:#f85149;text-align:center"></div>

</div>

<script>
(function(){
  var _ssdDev = '';

  window.ssdShowStep = function(id) {
    ['ssd-step-check','ssd-step-ready','ssd-step-scan','ssd-step-list',
     'ssd-step-warn','ssd-step-confirm','ssd-step-formatting','ssd-step-done'].forEach(function(s){
      var el = document.getElementById(s);
      if(el) el.style.display = 'none';
    });
    document.getElementById('ssd-error').style.display = 'none';
    var show = document.getElementById(id);
    if(show) show.style.display = '';
  };

  window.ssdErr = function(msg) {
    var e = document.getElementById('ssd-error');
    e.textContent = msg;
    e.style.display = '';
  };

  window.initSsd = function() {
    ssdShowStep('ssd-step-check');
    fetch('/cgi-bin/rocket?ssd_status').then(function(r){return r.json();}).then(function(d){
      if(d.mounted) {
        document.getElementById('ssd-ready-info').innerHTML =
          'Device: <code style="color:#e6edf3">' + d.device + '</code> &nbsp;&middot;&nbsp; Used: ' + d.used + ' &nbsp;&middot;&nbsp; Free: ' + d.avail + ' (' + d.pct + ' full)';
        ssdShowStep('ssd-step-ready');
      } else {
        ssdShowStep('ssd-step-scan');
      }
    }).catch(function(){ ssdShowStep('ssd-step-scan'); });
  };

  window.ssdScan = function() {
    ssdShowStep('ssd-step-check');
    document.getElementById('ssd-step-check').textContent = '⏳ Scanning for drives…';
    fetch('/cgi-bin/rocket?ssd_detect').then(function(r){return r.json();}).then(function(d){
      if(!d.drives || d.drives.length === 0) {
        ssdShowStep('ssd-step-scan');
        ssdErr('No external drives found. Plug in a USB drive and try again.');
        return;
      }
      var cards = document.getElementById('ssd-drive-cards');
      cards.innerHTML = '';
      d.drives.forEach(function(drv) {
        var sizeGb = drv.size ? (parseInt(drv.size,10)/1e9).toFixed(0)+'GB' : '';
        var mounted = drv.mounted && drv.mounted !== '' ? ' &middot; mounted at ' + drv.mounted : '';
        var btn = document.createElement('button');
        btn.style.cssText = 'display:block;width:100%;background:#0d1117;border:2px solid #30363d;border-radius:10px;padding:14px 16px;text-align:left;cursor:pointer;color:#e6edf3;transition:border-color .15s';
        btn.innerHTML = '<div style="font-weight:700;font-size:.92em;margin-bottom:3px">&#128190; ' + drv.name + '</div><div style="font-size:.78em;color:#8b949e">' + sizeGb + mounted + '</div>';
        btn.onmouseover = function(){ this.style.borderColor='rgba(88,166,255,.5)'; };
        btn.onmouseout  = function(){ this.style.borderColor='#30363d'; };
        btn.onclick = function(){
          _ssdDev = drv.name;
          document.getElementById('ssd-warn-info').innerHTML =
            'Drive: <code style="color:#e6edf3">' + drv.name + '</code> (' + sizeGb + '). <strong style="color:#f85149">All data on this drive will be permanently destroyed.</strong>';
          ssdShowStep('ssd-step-warn');
        };
        cards.appendChild(btn);
      });
      ssdShowStep('ssd-step-list');
    }).catch(function(){ ssdShowStep('ssd-step-scan'); ssdErr('Scan failed. Try again.'); });
  };

  window.ssdFormat = function() {
    var inp = document.getElementById('ssd-erase-input').value.trim().toUpperCase();
    if(inp !== 'ERASE') { ssdErr('Type ERASE in the box to confirm.'); return; }
    if(!_ssdDev) { ssdErr('No drive selected.'); return; }
    ssdShowStep('ssd-step-formatting');
    var url = '/cgi-bin/rocket?ssd_format&dev=' + encodeURIComponent(_ssdDev) + '&confirm=ERASE';
    fetch(url).then(function(r){return r.json();}).then(function(d){
      if(d.ok) {
        ssdShowStep('ssd-step-done');
      } else {
        ssdShowStep('ssd-step-confirm');
        ssdErr(d.error || 'Format failed.');
      }
    }).catch(function(){ ssdShowStep('ssd-step-confirm'); ssdErr('Request failed. Try again.'); });
  };

  // run on tab switch — called from tab onclick
  if(document.getElementById('t-ssd') && document.getElementById('t-ssd').style.display !== 'none') {
    window.initSsd();
  }
})();
</script>

</div>

<div class="tc rr-gated" id="t-app">
<div class="rr-gate-pitch" id="gp-app"><div style="max-width:940px;margin:0 auto;padding:14px 16px"><div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px"><div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div><div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">Three companies run the intelligence layer of the internet. Five companies own most of the bandwidth. You pay them monthly for the privilege of having a wire in the wall.<br><br>There&#8217;s another way.<br><br>When you join the Mesh, your router becomes a node in a global peer-to-peer network. Your bandwidth doesn&#8217;t just carry your data &#8212; it carries the freedom of everyone in the Mycelium. You share a little. You gain resilience, redundancy, and a network with no landlords. You help prove the internet can work without permission.<br><br>This is the opposite of an ISP. This is the users owning the network.</div><div style="font-size:.84em;color:#484f58;font-style:italic;margin-bottom:12px">&#8220;ISPs sell you a pipe. We&#8217;re building the water supply.&#8221;</div><div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&#8230;</div><button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &#8212; SHARE THE FREEDOM</button><div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div></div><div style="background:#0d1117;border:2px solid rgba(63,185,80,.3);border-radius:14px;padding:18px 20px"><div style="font-size:.79em;color:#8b949e;line-height:1.7;margin:0 0 14px">Joining is the only step. The mesh doesn&#8217;t ask you to give anything up &#8212; it just asks your router to share what it&#8217;s already running. <span style="color:#484f58">Leave any time, no guilt either way.</span></div><div style="font-size:.78em;font-weight:700;color:#e6edf3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;border-top:1px solid #21262d;padding-top:12px"><span class="gp-feat-hdr">Unlock all 21 features &#8212; everything below, on every tab:</span></div><div style="border:1px solid #21262d;border-radius:8px;overflow:hidden"><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Anomaly Watchdog<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; traffic spike alerts, every 5 minutes, 24/7</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Bandwidth Inheritance</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; when a device goes offline, its priority passes down automatically</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Community Chat<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; encrypted Matrix rooms hosted on your own hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Corporate Discomfort Index<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; daily corporate surveillance score from your DNS logs</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Device Obituaries<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI-written farewell for every device that leaves your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Digital Sovereignty Audit</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; reveals which 3 corporations own 80% of your data path</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Ghost Device Detector</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; surfaces devices generating traffic while claiming to be off</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">ISP Evidence Reporter<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; timestamped speed logs, CSV export ready for Ofcom complaint</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Bandwidth Graph</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; 1-second canvas, every device, right now</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Network Topology</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; visual map of every connection on your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Constitution</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; plain English &#8594; real firewall rules &#40;&#34;kids&#39; tablets off at 9pm&#34;&#41;</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Time Machine<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; hourly snapshots, scroll back through traffic history</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">P2P Video Platform<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; censorship-resistant, no algorithm, no landlord, no plug to pull</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Per-Device VPN Routing</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; different tunnel for every device, applied instantly</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Predictive Modem Reboot<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; detects signal decline and schedules restart before dropout</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router AI (Claude)<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; natural-language network assistant, running on your hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router Diary<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI writes one paragraph every midnight about your network&#39;s day</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router File Explorer</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; full two-pane filesystem manager, in the browser</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Signal Trend Predictor<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; RSRP/SINR history, trend analysis, worst-point detection</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">&#34;Where Did My Data Go?&#34;</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; live world map of every active connection, country and owner</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">WiFi Device Scheduler</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; block any device on any schedule, no app needed</span></div><div style="padding:10px 12px;background:rgba(240,165,0,.06);border-top:2px solid rgba(240,165,0,.2);display:flex;gap:10px;align-items:flex-start"><span style="color:#f0a500;font-size:1em;flex-shrink:0">&#128440;</span><div style="font-size:.78em;color:#8b949e;line-height:1.6"><strong style="color:#f0a500">USB SSD required for &#128440; features.</strong> Connect any USB SSD or USB flash drive to your router's USB port — formatted ext4, 32GB minimum (128GB+ for video). The router mounts it automatically at <code style="color:#e6edf3">/mnt/ssd</code>. Without it, marked features have nowhere to store data and will not log, remember, or record anything. Features without &#128440; work fully from router memory and config storage.</div></div></div></div></div></div>
<div class="rr-gate-veil"></div>
<div style="max-width:560px;margin:0 auto">

  <!-- Install section -->
  <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:24px 26px;margin-bottom:16px">
    <div style="font-size:1.05em;font-weight:700;color:#e6edf3;margin-bottom:4px">&#128241; Install Rocket Routers on your phone</div>
    <div style="font-size:.82em;color:#8b949e;line-height:1.65;margin-bottom:20px">No App Store. No Google Play. No tracking. Your router <em>is</em> the app &#8212; updates itself when firmware updates.</div>

    <!-- Android -->
    <div style="background:#0d1117;border:1px solid rgba(63,185,80,.3);border-radius:12px;padding:16px 18px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
        <div style="font-size:1.4em">&#129309;</div>
        <div>
          <div style="font-size:.88em;font-weight:700;color:#3fb950">Android App</div>
          <div style="font-size:.72em;color:#484f58">Real app &#8212; no Play Store, no Google, no tracking</div>
        </div>
      </div>
      <a href="/app/rocketrouters.apk" download="rocketrouters.apk" target="_blank" style="display:block;text-align:center;background:linear-gradient(135deg,#196127,#2ea043);border:none;border-radius:10px;color:#fff;font-size:.92em;font-weight:700;padding:14px;text-decoration:none;margin-bottom:10px">&#8681; Download Rocket Routers APK</a>
      <div style="background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px 14px">
        <div style="font-size:.76em;color:#f0a500;font-weight:600;margin-bottom:8px">&#128072; How to install:</div>
        <div style="font-size:.76em;color:#c9d1d9;line-height:2.1">
          <span style="background:#21262d;border-radius:4px;padding:2px 7px">1</span> Tap the download button above &nbsp;
          <span style="background:#21262d;border-radius:4px;padding:2px 7px">2</span> Open the downloaded <strong>.apk</strong> file &nbsp;
          <span style="background:#21262d;border-radius:4px;padding:2px 7px">3</span> If prompted, allow <strong>Install unknown apps</strong> for your browser &nbsp;
          <span style="background:#21262d;border-radius:4px;padding:2px 7px">4</span> Tap <strong>Install</strong> &#8212; done!
        </div>
      </div>
    </div>

    <!-- iPhone -->
    <div style="background:#0d1117;border:1px solid rgba(99,102,241,.3);border-radius:12px;padding:16px 18px;margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <div style="font-size:1.4em">&#63743;</div>
        <div>
          <div style="font-size:.88em;font-weight:700;color:#a78bfa">iPhone / iPad</div>
          <div style="font-size:.72em;color:#484f58">Safari only &#8212; Apple blocks install buttons, sorry!</div>
        </div>
      </div>
      <div style="background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px 14px">
        <div style="font-size:.78em;color:#a78bfa;font-weight:600;margin-bottom:10px">&#128072; Open this page in Safari, then:</div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="display:flex;align-items:center;gap:10px">
            <div style="background:#21262d;border-radius:6px;padding:4px 10px;font-size:.8em;color:#e6edf3;font-weight:700;flex-shrink:0">1</div>
            <div style="font-size:.78em;color:#c9d1d9">Tap the <strong style="color:#a78bfa">&#11014; Share</strong> button at the bottom of Safari</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <div style="background:#21262d;border-radius:6px;padding:4px 10px;font-size:.8em;color:#e6edf3;font-weight:700;flex-shrink:0">2</div>
            <div style="font-size:.78em;color:#c9d1d9">Scroll down and tap <strong style="color:#a78bfa">Add to Home Screen</strong></div>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <div style="background:#21262d;border-radius:6px;padding:4px 10px;font-size:.8em;color:#e6edf3;font-weight:700;flex-shrink:0">3</div>
            <div style="font-size:.78em;color:#c9d1d9">Tap <strong style="color:#a78bfa">Add</strong> &#8212; done! Full screen, no browser bar &#127918;</div>
          </div>
        </div>
      </div>
    </div>

    <div style="font-size:.72em;color:#3a3f44;text-align:center">Must be on your home Wi-Fi &#183; Works on Android, iPhone, iPad and desktop</div>
  </div>

  <!-- Notifications section -->
  <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:24px 26px;margin-bottom:16px">
    <div style="font-size:1.05em;font-weight:700;color:#e6edf3;margin-bottom:6px">&#128276; Notifications</div>
    <div style="font-size:.82em;color:#8b949e;line-height:1.75;margin-bottom:16px">
      Get notified when someone messages you in Community Chat or rings you on Live &#8212; even when the app is in the background.
      No push servers, no Google, no Apple. The browser handles it all locally.
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#0d1117;border:1px solid #30363d;border-radius:8px">
        <div><div style="font-size:.84em;color:#c9d1d9;font-weight:600">&#128172; Chat messages</div><div style="font-size:.72em;color:#484f58;margin-top:2px">Buzz when someone sends you a message</div></div>
        <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
          <input type="checkbox" id="notif-chat" onchange="rrSaveNotifPref()" style="opacity:0;width:0;height:0">
          <span onclick="document.getElementById('notif-chat').click()" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#30363d;border-radius:24px;transition:.2s" id="notif-chat-sl"></span>
        </label>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#0d1117;border:1px solid #30363d;border-radius:8px">
        <div><div style="font-size:.84em;color:#c9d1d9;font-weight:600">&#128222; Live call rings</div><div style="font-size:.72em;color:#484f58;margin-top:2px">Ring when someone calls you</div></div>
        <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
          <input type="checkbox" id="notif-live" onchange="rrSaveNotifPref()" style="opacity:0;width:0;height:0">
          <span onclick="document.getElementById('notif-live').click()" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#30363d;border-radius:24px;transition:.2s" id="notif-live-sl"></span>
        </label>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#0d1117;border:1px solid #30363d;border-radius:8px">
        <div><div style="font-size:.84em;color:#c9d1d9;font-weight:600">&#127916; New mesh videos</div><div style="font-size:.72em;color:#484f58;margin-top:2px">Alert when someone uploads to the mesh</div></div>
        <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
          <input type="checkbox" id="notif-video" onchange="rrSaveNotifPref()" style="opacity:0;width:0;height:0">
          <span onclick="document.getElementById('notif-video').click()" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#30363d;border-radius:24px;transition:.2s" id="notif-video-sl"></span>
        </label>
      </div>
    </div>
    <button id="notify-enable-btn" onclick="rrRequestNotifyPermission()" style="width:100%;background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);border-radius:8px;color:#3fb950;font-size:.84em;font-weight:600;padding:10px;cursor:pointer">
      &#128276; Enable notifications in browser
    </button>
    <div style="font-size:.72em;color:#3a3f44;margin-top:8px;text-align:center">Browser will ask permission once. You can revoke any time in browser settings.</div>
  </div>

  <!-- Away mode section -->
  <div style="background:#161b22;border:1px solid #30363d;border-radius:14px;padding:24px 26px;margin-bottom:16px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <div style="font-size:1.05em;font-weight:700;color:#e6edf3">&#127769; Away Mode</div>
      <label style="position:relative;display:inline-block;width:48px;height:26px;flex-shrink:0">
        <input type="checkbox" id="away-toggle" onchange="rrToggleAway()" style="opacity:0;width:0;height:0">
        <span onclick="document.getElementById('away-toggle').click()" style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#30363d;border-radius:26px;transition:.2s" id="away-sl"></span>
      </label>
    </div>
    <div style="font-size:.82em;color:#8b949e;line-height:1.75;margin-bottom:16px">
      Still connected to the mesh, still receiving everything &#8212; but all notifications are silenced. A &#127769; moon appears next to your name so people know you might not reply instantly.
    </div>
    <div style="background:#0d1117;border:1px solid #30363d;border-radius:10px;padding:14px 16px;margin-bottom:12px">
      <div style="font-size:.8em;font-weight:600;color:#8b949e;margin-bottom:10px">&#9201; Quiet hours &#8212; auto-enable Away between these times</div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:6px">
          <label style="font-size:.76em;color:#484f58">From</label>
          <input type="time" id="quiet-from" onchange="rrSaveQuietHours()" value="23:00" style="background:#161b22;border:1px solid #30363d;border-radius:6px;color:#c9d1d9;font-size:.82em;padding:5px 8px">
        </div>
        <div style="display:flex;align-items:center;gap:6px">
          <label style="font-size:.76em;color:#484f58">To</label>
          <input type="time" id="quiet-to" onchange="rrSaveQuietHours()" value="07:00" style="background:#161b22;border:1px solid #30363d;border-radius:6px;color:#c9d1d9;font-size:.82em;padding:5px 8px">
        </div>
        <label style="display:flex;align-items:center;gap:5px;cursor:pointer">
          <input type="checkbox" id="quiet-enabled" onchange="rrSaveQuietHours()" style="accent-color:#3fb950">
          <span style="font-size:.76em;color:#8b949e">Enable quiet hours</span>
        </label>
      </div>
    </div>
    <div id="away-status-line" style="font-size:.76em;color:#484f58;text-align:center"></div>
  </div>

</div>
</div><!-- /t-app -->

<!-- ═══════════════════════════════════════════════════════════════════════════
     INTEL TAB
════════════════════════════════════════════════════════════════════════════ -->
<div class="tc rr-gated" id="t-intel">
<div class="rr-gate-pitch" id="gp-intel"><div style="max-width:940px;margin:0 auto;padding:14px 16px"><div style="background:#0d1117;border:2px solid rgba(88,166,255,.3);border-radius:14px;padding:18px 20px;margin-bottom:12px"><div style="font-size:1.15em;font-weight:800;color:#e6edf3;line-height:1.3;margin-bottom:10px">You already own the pipe.<br><span style="color:#58a6ff">Now own the network.</span></div><div style="font-size:.82em;color:#8b949e;line-height:1.72;margin-bottom:12px">Three companies run the intelligence layer of the internet. Five companies own most of the bandwidth. You pay them monthly for the privilege of having a wire in the wall.<br><br>There&#8217;s another way.<br><br>When you join the Mesh, your router becomes a node in a global peer-to-peer network. Your bandwidth doesn&#8217;t just carry your data &#8212; it carries the freedom of everyone in the Mycelium. You share a little. You gain resilience, redundancy, and a network with no landlords. You help prove the internet can work without permission.<br><br>This is the opposite of an ISP. This is the users owning the network.</div><div style="font-size:.84em;color:#484f58;font-style:italic;margin-bottom:12px">&#8220;ISPs sell you a pipe. We&#8217;re building the water supply.&#8221;</div><div class="gp-ygg-status" style="font-size:.78em;color:#484f58;margin-bottom:10px">&#8987; checking mesh status&#8230;</div><button class="rr-big-btn rr-btn-blue gp-join-btn" onclick="joinMesh()">JOIN THE MESH &#8212; SHARE THE FREEDOM</button><div class="gp-leave-wrap" style="display:none;margin-top:6px;text-align:center"><a onclick="leaveMesh()" style="font-size:.78em;color:#484f58;cursor:pointer;text-decoration:underline">Leave the mesh</a></div></div><div style="background:#0d1117;border:2px solid rgba(63,185,80,.3);border-radius:14px;padding:18px 20px"><div style="font-size:.79em;color:#8b949e;line-height:1.7;margin:0 0 14px">Joining is the only step. The mesh doesn&#8217;t ask you to give anything up &#8212; it just asks your router to share what it&#8217;s already running. <span style="color:#484f58">Leave any time, no guilt either way.</span></div><div style="font-size:.78em;font-weight:700;color:#e6edf3;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;border-top:1px solid #21262d;padding-top:12px"><span class="gp-feat-hdr">Unlock all 21 features &#8212; everything below, on every tab:</span></div><div style="border:1px solid #21262d;border-radius:8px;overflow:hidden"><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Anomaly Watchdog<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; traffic spike alerts, every 5 minutes, 24/7</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Bandwidth Inheritance</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; when a device goes offline, its priority passes down automatically</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Community Chat<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; encrypted Matrix rooms hosted on your own hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Corporate Discomfort Index<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; daily corporate surveillance score from your DNS logs</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Device Obituaries<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI-written farewell for every device that leaves your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Digital Sovereignty Audit</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; reveals which 3 corporations own 80% of your data path</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Ghost Device Detector</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; surfaces devices generating traffic while claiming to be off</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">ISP Evidence Reporter<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; timestamped speed logs, CSV export ready for Ofcom complaint</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Bandwidth Graph</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; 1-second canvas, every device, right now</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Live Network Topology</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; visual map of every connection on your network</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Constitution</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; plain English &#8594; real firewall rules &#40;&#34;kids&#39; tablets off at 9pm&#34;&#41;</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Network Time Machine<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; hourly snapshots, scroll back through traffic history</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">P2P Video Platform<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; censorship-resistant, no algorithm, no landlord, no plug to pull</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Per-Device VPN Routing</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; different tunnel for every device, applied instantly</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Predictive Modem Reboot<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; detects signal decline and schedules restart before dropout</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router AI (Claude)<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; natural-language network assistant, running on your hardware</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router Diary<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; AI writes one paragraph every midnight about your network&#39;s day</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Router File Explorer</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; full two-pane filesystem manager, in the browser</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">Signal Trend Predictor<span style="color:#f0a500;font-size:.7em;font-weight:700;margin-left:5px;vertical-align:middle" title="Requires USB SSD drive">&#128440; SSD</span></span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; RSRP/SINR history, trend analysis, worst-point detection</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">&#34;Where Did My Data Go?&#34;</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; live world map of every active connection, country and owner</span></div><div style="padding:7px 10px;border-bottom:1px solid #21262d;display:flex;gap:8px;align-items:baseline"><span style="color:#58a6ff;font-size:.82em;font-weight:700;min-width:190px;flex-shrink:0">WiFi Device Scheduler</span><span style="color:#8b949e;font-size:.79em;line-height:1.5">&#8212; block any device on any schedule, no app needed</span></div><div style="padding:10px 12px;background:rgba(240,165,0,.06);border-top:2px solid rgba(240,165,0,.2);display:flex;gap:10px;align-items:flex-start"><span style="color:#f0a500;font-size:1em;flex-shrink:0">&#128440;</span><div style="font-size:.78em;color:#8b949e;line-height:1.6"><strong style="color:#f0a500">USB SSD required for &#128440; features.</strong> Connect any USB SSD or USB flash drive to your router's USB port — formatted ext4, 32GB minimum (128GB+ for video). The router mounts it automatically at <code style="color:#e6edf3">/mnt/ssd</code>. Without it, marked features have nowhere to store data and will not log, remember, or record anything. Features without &#128440; work fully from router memory and config storage.</div></div></div></div></div></div>
<div class="rr-gate-veil"></div>
  <div style="padding:18px 16px;max-width:900px;margin:0 auto">

    <!-- Header + cron setup -->
    <div style="margin-bottom:20px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:12px">
        <div>
          <div style="font-size:1.15em;font-weight:700;color:#e6edf3">📊 Intel — Network Intelligence</div>
          <div style="font-size:.82em;color:#c9d1d9;margin-top:4px">Five live intelligence tools built into your router. No cloud. No subscription.</div>
        </div>
        <button onclick="intelToggleCron()" id="intel-cron-btn" style="background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:8px;padding:7px 16px;font-size:.78em;font-weight:600;cursor:pointer">⚡ Enable Background Monitoring</button>
      </div>
      <div style="background:#0d1117;border:1px solid #21262d;border-radius:10px;padding:12px 16px">
        <div style="font-size:.78em;font-weight:600;color:#8b949e;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px">What background monitoring does and when it runs</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px">
          <div style="display:flex;gap:8px;align-items:flex-start">
            <span style="color:#58a6ff;font-size:1em;flex-shrink:0">📶</span>
            <div><div style="font-size:.82em;color:#e6edf3;font-weight:600">Signal Quality</div><div style="font-size:.78em;color:#c9d1d9">Logged every 15 minutes, all day — 00:00, 00:15, 00:30…</div></div>
          </div>
          <div style="display:flex;gap:8px;align-items:flex-start">
            <span style="color:#3fb950;font-size:1em;flex-shrink:0">⚡</span>
            <div><div style="font-size:.82em;color:#e6edf3;font-weight:600">Speed Test</div><div style="font-size:.78em;color:#c9d1d9">Every 6 hours automatically — 00:00, 06:00, 12:00, 18:00</div></div>
          </div>
          <div style="display:flex;gap:8px;align-items:flex-start">
            <span style="color:#f0a500;font-size:1em;flex-shrink:0">⏱</span>
            <div><div style="font-size:.82em;color:#e6edf3;font-weight:600">Traffic Snapshot</div><div style="font-size:.78em;color:#c9d1d9">Every hour on the hour — builds Time Machine history</div></div>
          </div>
          <div style="display:flex;gap:8px;align-items:flex-start">
            <span style="color:#f85149;font-size:1em;flex-shrink:0">🚨</span>
            <div><div style="font-size:.82em;color:#e6edf3;font-weight:600">Anomaly Watchdog</div><div style="font-size:.78em;color:#c9d1d9">Every 5 minutes all day — flags unusual traffic spikes</div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── 1. Signal Trend Predictor ─────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">📶 Signal Trend Predictor</div>
        <button onclick="intelLoadSignal()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Refresh</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Shows your mobile signal strength (RSRP) and quality (SINR) over time as a live chart. RSRP is how strong the signal is from the tower — higher (less negative) is better. SINR is how clean the signal is with no interference — higher is better. The analysis below the chart tells you if your signal is improving, stable, or declining, and flags your worst point so you know when your connection struggles.</div>
      <canvas id="intel-sig-canvas" width="800" height="140" style="width:100%;height:140px;display:block;border-radius:6px"></canvas>
      <div id="intel-sig-analysis" style="margin-top:10px;font-size:.82em;color:#c9d1d9;line-height:1.75"></div>
    </div>

    <!-- ── 2. ISP Evidence Reporter ──────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">⚡ ISP Evidence Reporter</div>
        <div style="display:flex;gap:8px">
          <button onclick="intelRunSpeedtest()" id="intel-spd-btn" style="background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">▶ Run Test Now</button>
          <button onclick="intelExportSpeeds()" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">⬇ Export CSV</button>
        </div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Tests your actual download speed by pulling data from Cloudflare and measuring how fast it arrives. Every result is logged with a timestamp. The bar chart shows your speed history — green bars mean good speeds, amber means fair, red means poor. If your ISP is throttling you or not delivering what you pay for, this builds the evidence. Hit Export CSV to download a dated file you can send to your ISP or Ofcom as a formal complaint.</div>
      <div id="intel-spd-status" style="font-size:.82em;color:#c9d1d9;margin-bottom:8px"></div>
      <canvas id="intel-spd-canvas" width="800" height="120" style="width:100%;height:120px;display:block;border-radius:6px"></canvas>
      <div id="intel-spd-summary" style="margin-top:10px;font-size:.82em;color:#c9d1d9;line-height:1.75"></div>
    </div>

    <!-- ── 3. Network Time Machine ───────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">⏱ Network Time Machine</div>
        <div style="display:flex;gap:8px">
          <button onclick="intelSnapshotNow(this)" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">📸 Snap Now</button>
          <button onclick="intelLoadTimeMachine()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load</button>
          <button onclick="intelClearTimeMachine()" style="background:rgba(248,81,73,.06);border:1px solid rgba(248,81,73,.15);color:#8b949e;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">🗑 Clear</button>
        </div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Takes a snapshot of every device's traffic every hour and stores it. Load it here to see the peak data usage for every device on your network since monitoring started. Useful for answering "what was hammering my connection last night?" — just check which device had a spike. The more hours background monitoring has been running, the more history you have to scroll through.</div>
      <div id="intel-tm-content" style="font-size:.85em;color:#c9d1d9">Click Load to fetch traffic history snapshots.</div>
    </div>

    <!-- ── 4. AI Anomaly Watchdog ────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(248,81,73,.2);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🚨 Anomaly Watchdog</div>
        <div style="display:flex;gap:8px">
          <button onclick="intelCheckAnomalies()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Check Now</button>
          <button onclick="intelClearAnomalies()" style="background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.2);color:#f85149;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">Clear</button>
        </div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Watches every device on your network for unusual traffic spikes. Every 5 minutes it checks how much data each device has sent and compares it to what it was doing before. If any device suddenly pushes more than 200MB in a single 5-minute window — far above normal for a home device — it logs an alert here with the device name, time, and how much data it moved. Useful for catching rogue apps, unexpected backups, or a device that's been compromised and is sending data out.</div>
      <div id="intel-anom-feed" style="font-size:.85em;color:#c9d1d9">No anomalies detected yet. Enable background monitoring above to start watching.</div>
    </div>

    <!-- ── 5. Per-Device VPN Routing ─────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🔀 Per-Device VPN Routing</div>
        <div style="display:flex;gap:6px"><button onclick="intelLoadVpnRouting()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load Devices</button><button onclick="ouiUpdate(this)" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">🔍 Identify</button><button onclick="deviceExport()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">📥 Export</button><button onclick="document.getElementById('dev-restore-input').click()" style="background:rgba(240,165,0,.1);border:1px solid rgba(240,165,0,.3);color:#f0a500;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">📤 Restore</button></div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Lets you choose which WireGuard VPN tunnel each device on your network uses — or send it direct to the internet with no VPN at all. Every other router applies VPN settings to the whole network or nothing. This router lets you say: gaming PC goes direct for lowest ping, work laptop goes through the office VPN, TV goes through a privacy VPN to avoid tracking. Each device gets its own routing decision. Changes apply instantly via the firewall — no reboot needed. Requires admin login.</div>
      <div id="intel-vpn-content" style="font-size:.85em;color:#c9d1d9">Click Load Devices to see your network.</div>
    </div>

    <!-- ── 6. Router Diary ────────────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(63,185,80,.2);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">📓 Router Diary</div>
        <div style="display:flex;gap:8px">
          <button onclick="diaryLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load</button>
          <button onclick="diaryWriteNow()" id="diary-write-btn" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">✍ Write Today's Entry</button>
        </div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:14px;line-height:1.6">Every night at midnight, the router reads the day's data — signal quality, speeds, which devices were active, any anomalies — and writes one paragraph about what happened. Stored on the SSD. After a year you have 365 entries: a real chronicle of your household's digital life. Requires your Anthropic API key in <code style="color:#f0a500;background:rgba(240,165,0,.1);padding:1px 5px;border-radius:3px">/etc/rocket/ai-key</code> for Claude-written entries — falls back to a structured summary if not set.</div>
      <div id="diary-content" style="font-size:.85em;color:#c9d1d9">Click Load to read the diary.</div>
    </div>

    <!-- ── 7. Device Obituary ─────────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🪦 Device Obituaries</div>
        <button onclick="obituaryLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">When a device hasn't been seen on this network for 30 days, the router writes it a farewell — its name, how long it was known here, how much data it moved, and a brief goodbye. Stored permanently. A record of every device that ever called this network home.</div>
      <div id="obit-content" style="font-size:.85em;color:#c9d1d9">Click Load to check for departed devices.</div>
    </div>

    <!-- ── 8. Digital Sovereignty Audit ──────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(88,166,255,.25);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🏛️ Digital Sovereignty Audit</div>
        <button onclick="sovereigntyLoad()" id="sov-btn" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Audit Now</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Your traffic goes through the internet — but who actually owns the servers it touches? This audit takes every active connection on your network and traces which corporation owns the infrastructure. Not geography — ownership. You might find 80% of your household's traffic goes through just three companies. This is the first step to knowing what you're actually paying for and who profits from your connection.</div>
      <div id="sov-status" style="font-size:.82em;color:#8b949e;margin-bottom:10px"></div>
      <div id="sov-results" style="font-size:.85em;color:#c9d1d9">Click Audit Now to scan active connections.</div>
    </div>

    <!-- ── 9. Ghost Device Detector ────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(248,81,73,.2);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">👻 Ghost Device Detector</div>
        <button onclick="ghostDevicesLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Scan</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Some devices lie. They appear offline — switched off, disconnected, gone — but they're still sending packets through your router. A ghost device is one that's no longer in your device list but is still generating traffic. This could be a smart TV phoning home, a forgotten IoT device that never truly sleeps, or something more interesting. This scanner surfaces them in plain language so you know what's actually on your network versus what claims to be on it.</div>
      <div id="ghost-results" style="font-size:.85em;color:#c9d1d9">Click Scan to check for ghost devices.</div>
    </div>

    <!-- ── 10. Network Constitution ─────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(63,185,80,.2);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">📜 Network Constitution</div>
        <button onclick="constitutionLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load Rules</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Write your network rules in plain English. "Kids' tablets off at 9pm." "No social media before 7am." "Gaming console gets priority on Friday nights." The router reads your rules and translates them into real firewall, cron, and QoS entries automatically. No command line. No router admin menus. Just describe what you want — the network obeys.</div>
      <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
        <input id="const-rule-input" type="text" placeholder='e.g. "Kids tablets off at 9pm" or "Limit phone to 10Mbps"' style="flex:1;min-width:200px;background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:7px 11px;font-size:.82em;outline:none">
        <button onclick="constitutionAddRule()" style="background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:7px 14px;font-size:.78em;font-weight:600;cursor:pointer;white-space:nowrap">+ Add Rule</button>
      </div>
      <div id="const-rules-list" style="font-size:.85em;color:#c9d1d9">Loading rules…</div>
    </div>

    <!-- ── 11. Corporate Discomfort Index ────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid rgba(240,165,0,.2);border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">😤 Corporate Discomfort Index</div>
        <button onclick="discomfortLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Refresh</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">A single daily number: how many corporate tracking attempts hit your network today. Not jargon — just a score from 0 to 100. A low score means the corporations are having a bad day. A high score means they're having a field day with your household's data. This is DNS-level — it catches the trackers that never load anything visible. Requires dnsmasq query logging to be enabled for full accuracy.</div>
      <div id="discomfort-display" style="text-align:center;padding:16px 0">
        <div id="discomfort-score" style="font-size:3.5em;font-weight:700;color:#3fb950;font-variant-numeric:tabular-nums">—</div>
        <div id="discomfort-label" style="font-size:.85em;color:#8b949e;margin-top:4px">Click Refresh to calculate today's score</div>
      </div>
      <canvas id="discomfort-canvas" width="800" height="80" style="width:100%;height:80px;display:block;border-radius:6px;display:none"></canvas>
      <div id="discomfort-detail" style="font-size:.82em;color:#c9d1d9;margin-top:8px"></div>
    </div>

    <!-- ── 12. Predictive Modem Reboot ──────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🔮 Predictive Modem Reboot</div>
        <button onclick="predictiveRebootLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Analyse Signal</button>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Instead of waiting for the connection to drop, the router watches your signal quality trend over time. If RSRP (signal strength) has been steadily declining for the last hour, a dropout becomes statistically likely. This tool detects that pattern and lets you schedule a modem restart at a quiet time — 3am, before you wake up — so the connection comes back clean before you need it. Needs signal history data from background monitoring.</div>
      <div id="pred-reboot-status" style="font-size:.85em;color:#c9d1d9;margin-bottom:10px">Click Analyse Signal to check the trend.</div>
      <div id="pred-reboot-actions" style="display:none">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="font-size:.82em;color:#c9d1d9">Schedule reboot at</span>
          <select id="pred-reboot-hour" style="background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 8px;font-size:.82em">
            <option value="01">01:00</option><option value="02">02:00</option>
            <option value="03" selected>03:00</option><option value="04">04:00</option>
            <option value="05">05:00</option><option value="06">06:00</option>
          </select>
          <button onclick="predictiveRebootSchedule()" style="background:rgba(240,165,0,.12);border:1px solid rgba(240,165,0,.3);color:#f0a500;border-radius:6px;padding:5px 14px;font-size:.78em;font-weight:600;cursor:pointer">📅 Schedule</button>
          <button onclick="predictiveRebootCancel()" id="pred-cancel-btn" style="background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.2);color:#f85149;border-radius:6px;padding:5px 14px;font-size:.78em;font-weight:600;cursor:pointer;display:none">✕ Cancel Scheduled</button>
        </div>
      </div>
    </div>

    <!-- ── 13. Bandwidth Inheritance ────────────────────────────────────────── -->
    <div style="background:#161b22;border:1px solid #21262d;border-radius:12px;padding:16px;margin-bottom:16px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
        <div style="font-size:.95em;font-weight:700;color:#e6edf3">🏆 Bandwidth Inheritance</div>
        <div style="display:flex;gap:8px">
          <button onclick="bandwidthInheritLoad()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">↻ Load</button>
          <button onclick="ouiUpdate(this)" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">🔍 Identify</button>
          <button onclick="deviceExport()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">📥 Export</button>
          <button onclick="document.getElementById('dev-restore-input').click()" style="background:rgba(240,165,0,.1);border:1px solid rgba(240,165,0,.3);color:#f0a500;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">📤 Restore</button>
          <button onclick="bandwidthInheritSave()" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:4px 12px;font-size:.75em;font-weight:600;cursor:pointer">💾 Save</button>
        </div>
      </div>
      <div style="font-size:.82em;color:#c9d1d9;margin-bottom:12px;line-height:1.6">Every network has a pecking order. When the gaming PC goes to sleep, should the work laptop inherit its bandwidth priority? When the kids' devices go offline, does the TV get to fill that space? Bandwidth Inheritance lets you define a priority hierarchy. When a higher-priority device disconnects, its bandwidth allocation flows down to the next device in line automatically — no manual rule changes. The network adapts to who's actually using it.</div>
      <div id="bw-inherit-content" style="font-size:.85em;color:#c9d1d9">Click Load to see your devices and set the inheritance order.</div>
    </div>

  </div>
</div><!-- /t-intel -->

</div><!-- /body -->

<div class="foot" id="foot-refresh">Stats refresh every 30s on Overview &amp; Expert · Last updated: ${NOW}</div>

<script>
// ── Signal history data (injected from shell) ─────────────────────────────────
var SIG = [${SIGNAL_JS}];

// ── Signal sparkline ──────────────────────────────────────────────────────────
function _drawSparklineData(data){
  var canvas = document.getElementById('sigcanvas');
  if(!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);
  if(!data || data.length < 2){
    ctx.fillStyle = '#30363d';
    ctx.font = '13px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText('No signal data yet — enable background monitoring', W/2, H/2+4);
    return;
  }
  var rsrps = data.map(function(d){ return parseFloat(d[1]) || 0; });
  var sinrs  = data.map(function(d){ return parseFloat(d[2]) || 0; });
  function line(vals, color, pad){
    var mn = Math.min.apply(null, vals) - pad;
    var mx = Math.max.apply(null, vals) + pad;
    var range = mx - mn || 1;
    ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.lineJoin = 'round';
    vals.forEach(function(v, i){
      var x = i / (vals.length - 1) * W;
      var y = H - 4 - ((v - mn) / range * (H - 8));
      if(i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.lineTo(W, H); ctx.lineTo(0, H); ctx.closePath();
    ctx.globalAlpha = 0.07; ctx.fill(); ctx.globalAlpha = 1;
  }
  line(rsrps, '#58a6ff', 3);
  line(sinrs,  '#3fb950', 2);
  // Update the reading count label
  var lbl = document.getElementById('sig-count-lbl');
  if(lbl) lbl.textContent = data.length + ' readings';
}

function drawSparkline(){
  // Try inline-injected data first (fast), fall back to API (uses SSD log too)
  if(SIG && SIG.length >= 2){
    _drawSparklineData(SIG);
    return;
  }
  fetch('/cgi-bin/rocket?signal_history')
  .then(function(r){return r.json();})
  .then(function(d){ _drawSparklineData(d.readings||[]); })
  .catch(function(){
    var canvas = document.getElementById('sigcanvas');
    if(!canvas) return;
    var ctx = canvas.getContext('2d');
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = '#30363d'; ctx.font = '13px system-ui'; ctx.textAlign = 'center';
    ctx.fillText('Signal data unavailable', canvas.width/2, canvas.height/2+4);
  });
}

// ── Matrix phrases — whispered into the noise ─────────────────────────────────
var matrixPhrases = [
  'ROCKET ROUTERS','JOIN THE MESH','CHANGE THE WORLD','OWN THE NETWORK',
  'NO LANDLORDS','THE MYCELIUM','SHARE THE FREEDOM',
  'INTELLIGENCE BELONGS TO EVERYONE'
];
// Slow-reveal: one char every PHRASE_SPEED draw-frames (~0.45s per char at 20fps)
// Random drops are untouched — they still fall at full speed every frame
var PHRASE_SPEED = 9;
function _makePhrase(ph, startY){
  return {phrase:ph, pos:0, timer:0, startY:startY, hold:0};
}

// ── Claude tab matrix ─────────────────────────────────────────────────────────
var matrixRunning = false;
var matrixRAF = null;
var mSpecialQ = {};
function startMatrix(){
  var canvas = document.getElementById('mcanvas');
  if(!canvas || matrixRunning) return;
  mSpecialQ = {};
  var ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth || window.innerWidth;
  canvas.height = canvas.offsetHeight || window.innerHeight;
  var cols = Math.floor(canvas.width / 18);
  var drops = [];
  for(var i=0;i<cols;i++) drops[i] = Math.floor(Math.random() * canvas.height / 18);
  var chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホ0123456789ABCDEF';
  matrixRunning = true;
  var tick = 0;
  function draw(){
    if(!matrixRunning){ ctx.clearRect(0,0,canvas.width,canvas.height); return; }
    tick++;
    if(tick % 3 !== 0){ matrixRAF = requestAnimationFrame(draw); return; }
    // Occasionally queue a new phrase on a free column
    if(Math.random() > 0.991){
      var ph = matrixPhrases[Math.floor(Math.random()*matrixPhrases.length)];
      var pc = Math.floor(Math.random()*cols);
      if(!mSpecialQ[pc]) mSpecialQ[pc] = _makePhrase(ph, drops[pc]);
    }
    // Fade pass
    ctx.fillStyle = 'rgba(13,17,23,0.06)';
    ctx.fillRect(0,0,canvas.width,canvas.height);
    // Random drops — full speed, unaffected by phrase logic
    ctx.font = '14px monospace';
    for(var i=0;i<drops.length;i++){
      ctx.fillStyle = (Math.random() > 0.93) ? '#3fb950' : '#0d3a1a';
      ctx.fillText(chars[Math.floor(Math.random()*chars.length)], i*18, drops[i]*18);
      if(drops[i]*18 > canvas.height && Math.random() > 0.97) drops[i] = 0;
      drops[i]++;
    }
    // Phrase slow-reveal overlay — redrawn bright every frame so canvas fade can't erase them
    ctx.font = 'bold 14px monospace';
    for(var ci in mSpecialQ){
      var q = mSpecialQ[ci];
      if(q.pos < q.phrase.length){
        q.timer++;
        if(q.timer >= PHRASE_SPEED){ q.timer = 0; q.pos++; }
      } else {
        q.hold++;
        if(q.hold > 110){ delete mSpecialQ[ci]; continue; }
      }
      for(var j=0;j<q.pos;j++){
        ctx.fillStyle = '#e8e6d0';
        ctx.fillText(q.phrase[j], ci*18, (q.startY + j + 1)*18);
      }
    }
    matrixRAF = requestAnimationFrame(draw);
  }
  draw();
}
function stopMatrix(){
  matrixRunning = false;
  if(matrixRAF) cancelAnimationFrame(matrixRAF);
}

// ── Earn tab matrix (mesh-join section) ───────────────────────────────────────
var earnMxRunning = false;
var earnMxRAF = null;
var eSpecialQ = {};
function startEarnMatrix(){
  var canvas = document.getElementById('ecanvas');
  if(!canvas || earnMxRunning) return;
  eSpecialQ = {};
  var ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth || 800;
  canvas.height = canvas.offsetHeight || 500;
  var cols = Math.floor(canvas.width / 16);
  var drops = [];
  for(var i=0;i<cols;i++) drops[i] = Math.floor(Math.random() * canvas.height / 16);
  var chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789ABCDEF';
  earnMxRunning = true;
  var tick = 0;
  function draw(){
    if(!earnMxRunning){ ctx.clearRect(0,0,canvas.width,canvas.height); return; }
    tick++;
    if(tick % 3 !== 0){ earnMxRAF = requestAnimationFrame(draw); return; }
    if(Math.random() > 0.992){
      var ph = matrixPhrases[Math.floor(Math.random()*matrixPhrases.length)];
      var pc = Math.floor(Math.random()*cols);
      if(!eSpecialQ[pc]) eSpecialQ[pc] = _makePhrase(ph, drops[pc]);
    }
    ctx.fillStyle = 'rgba(10,18,12,0.07)';
    ctx.fillRect(0,0,canvas.width,canvas.height);
    // Random drops — full speed
    ctx.font = '13px monospace';
    for(var i=0;i<drops.length;i++){
      ctx.fillStyle = (Math.random() > 0.93) ? '#2ea043' : '#071a0e';
      ctx.fillText(chars[Math.floor(Math.random()*chars.length)], i*16, drops[i]*16);
      if(drops[i]*16 > canvas.height && Math.random() > 0.97) drops[i] = 0;
      drops[i]++;
    }
    // Phrase slow-reveal overlay
    ctx.font = 'bold 13px monospace';
    for(var ci in eSpecialQ){
      var q = eSpecialQ[ci];
      if(q.pos < q.phrase.length){
        q.timer++;
        if(q.timer >= PHRASE_SPEED){ q.timer = 0; q.pos++; }
      } else {
        q.hold++;
        if(q.hold > 110){ delete eSpecialQ[ci]; continue; }
      }
      for(var j=0;j<q.pos;j++){
        ctx.fillStyle = '#e8e6d0';
        ctx.fillText(q.phrase[j], ci*16, (q.startY + j + 1)*16);
      }
    }
    earnMxRAF = requestAnimationFrame(draw);
  }
  draw();
}
function stopEarnMatrix(){
  earnMxRunning = false;
  if(earnMxRAF) cancelAnimationFrame(earnMxRAF);
}

// ── Refresh control — only on stats tabs ─────────────────────────────────────
var refreshTimer = null;
function startRefresh(){
  if(refreshTimer) clearTimeout(refreshTimer);
  refreshTimer = setTimeout(function(){
    window.location.href = window.location.pathname + window.location.search + window.location.hash;
  }, 30000);
}
function stopRefresh(){
  if(refreshTimer){ clearTimeout(refreshTimer); refreshTimer = null; }
}

// ── Tab switching ─────────────────────────────────────────────────────────────
function show(id, el){
  if(id === 'nov'){ window.location.href = window.location.pathname + '?_=' + Date.now() + '#nov'; return; }
  document.querySelectorAll('.tc').forEach(function(t){t.classList.remove('on')});
  document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('on')});
  document.getElementById('t-'+id).classList.add('on');
  el.classList.add('on');
  window.location.hash = id;
  if(id === 'claude'){ startMatrix(); } else { stopMatrix(); }
  if(id === 'earn'){ startEarnMatrix(); } else { stopEarnMatrix(); }
  if(id === 'nov'){ setTimeout(drawSparkline, 50); setTimeout(updateHageziStatus,300); }
  // Earn and Claude are reading tabs — no refresh. Overview and Expert have live stats.
  if(id === 'nov' || id === 'exp'){ startRefresh(); } else { stopRefresh(); }
  if(id === 'chat'){ initChatGate(); if(localStorage.getItem('rr_donate')==='1'){ initGov(); initChat(); initRooms(); initPeers(); } } else { stopChat(); }
  if(id === 'exp'){ initLocalMesh(); vnstatLoad(); setTimeout(topoInit,300); setTimeout(loadHoneypot,400); setTimeout(updateExpMeshStatus,200); }
  if(id === 'nov'){ setTimeout(loadBwHogs,300); }
  if(id === 'protect'){ initDnsBlock(); }
  if(id === 'video'){ initVideo(); }
  if(id === 'claude'){ initClaude(); }
  if(id === 'live'){ initLive(); } else { stopLive(); }
  if(id === 'account'){ initAccount(); }
  if(id === 'intel'){ initIntel(); }
  if(id === 'netsetup'){ loadNetSetup(); } else { stopNetSetup(); }
}

// ── My Network — hardware discovery ─────────────────────────────────────────
var _nsTimer=null,_nsData=null,_nsLastPoll={};
function loadNetSetup(){
  clearInterval(_nsTimer);
  var btn=document.querySelector('#t-netsetup button[onclick="loadNetSetup()"]');
  if(btn){btn.textContent='⏳ Scanning…';btn.disabled=true;}
  _fetchNetSetup(function(){
    if(btn){btn.textContent='↻ Refresh';btn.disabled=false;}
  });
  _nsTimer=setInterval(function(){_fetchNetSetup(null);},3000);
}
function stopNetSetup(){ clearInterval(_nsTimer); _nsTimer=null; }
function _nsRefreshNow(){
  document.querySelectorAll('.ns-ref-btn').forEach(function(b){b.innerHTML='&#x23F3;';b.disabled=true;});
  _fetchNetSetup(null);
}

function _renderNsOverview(d){
  var el=document.getElementById('ns-overview'); if(!el) return;
  var ifaces=d.interfaces||[], host=_esc(d.hostname||'Router');
  var modems=ifaces.filter(function(i){return i.role==='modem';});
  var lans=ifaces.filter(function(i){return i.role==='lan';});
  var wifis=ifaces.filter(function(i){return i.role==='wifi';});
  var vpns=ifaces.filter(function(i){return i.role==='vpn';});
  var meshes=ifaces.filter(function(i){return i.role==='mesh';});
  // Pick the UP modem as primary WAN (covers QModem where usb1 has SIM, usb0 doesn't)
  var wan=modems.find(function(i){return i.state==='up';})||modems[0]||null;
  var wan2Modem=(modems.length>1)?modems.find(function(i){return i!==wan;}):null;
  var wanUp=wan&&wan.state==='up';
  var rxRate=wan&&wan.rxRate>=0?wan.rxRate:0;
  var txRate=wan&&wan.txRate>=0?wan.txRate:0;

  // ── CARD 1: Pictogram ───────────────────────────────────────────────────
  var s1='<div style="background:#0d1117;border:1px solid rgba(88,166,255,.3);border-radius:13px;padding:18px 20px;margin-bottom:12px">';
  s1+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">';
  s1+='<div style="font-size:1em;font-weight:800;color:#e6edf3">&#128225; What you have right now</div>';
  s1+='<button class="ns-ref-btn" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:3px 9px;font-size:.8em;cursor:pointer">&#x21BB;</button>';
  s1+='</div>';
  s1+='<div style="font-size:.78em;color:#8b949e;margin-bottom:14px">Your live network &#8212; what\'s plugged in, what\'s working, what role each port plays.</div>';

  // SVG pictogram
  var guests=ifaces.filter(function(i){return i.role==='guest'&&/^lan/.test(i.name);});
  var wan2s=ifaces.filter(function(i){return i.role==='wan'&&/^eth/.test(i.name);});
  var svgH=(guests.length>0)?400:320;
  var tipY=(guests.length>0)?340:268;
  s1+='<svg viewBox="0 0 660 '+svgH+'" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:660px;display:block;margin:0 auto">';
  var cx=330;
  // Internet box
  s1+='<rect x="218" y="4" width="224" height="38" rx="8" fill="#0d1117" stroke="rgba(88,166,255,.35)" stroke-width="1.5"/>';
  s1+='<text x="'+cx+'" y="20" text-anchor="middle" fill="#58a6ff" font-size="11" font-weight="700" font-family="system-ui,sans-serif">&#127760; INTERNET</text>';
  s1+='<text x="'+cx+'" y="35" text-anchor="middle" fill="#484f58" font-size="9" font-family="system-ui,sans-serif">5G cell tower signal</text>';
  // pipe Internet→WAN
  s1+='<line x1="'+cx+'" y1="42" x2="'+cx+'" y2="58" stroke="#58a6ff" stroke-width="2" stroke-dasharray="4 3"/>';
  s1+='<polygon points="'+(cx-5)+',50 '+cx+',42 '+(cx+5)+',50" fill="#58a6ff"/>';
  // WAN box — BLUE
  var wanCol=wanUp?'rgba(88,166,255,.65)':'rgba(88,166,255,.25)';
  var wanBg=wanUp?'rgba(88,166,255,.12)':'rgba(88,166,255,.05)';
  s1+='<rect x="196" y="66" width="268" height="54" rx="9" fill="'+wanBg+'" stroke="'+wanCol+'" stroke-width="2"/>';
  s1+='<text x="'+cx+'" y="85" text-anchor="middle" fill="#58a6ff" font-size="10" font-weight="800" font-family="system-ui,sans-serif">&#128244; '+(wan?_esc(wan.name):'none')+' &#8212; 5G Modem '+(wanUp?'&#9679; Up':'&#9675; Down')+'</text>';
  s1+='<text x="'+cx+'" y="99" text-anchor="middle" fill="#8b949e" font-size="9" font-family="system-ui,sans-serif">Your WAN &#8212; this is how internet arrives</text>';
  var rateStr=rxRate>500?('&#8595; '+_nsFmtRate(rxRate)+'  &#8593; '+_nsFmtRate(txRate)):(wanUp?'measuring&#8230;':'offline');
  s1+='<text x="'+cx+'" y="113" text-anchor="middle" fill="#3fb950" font-size="8.5" font-weight="600" font-family="system-ui,sans-serif">'+rateStr+'</text>';
  // WAN label pill
  s1+='<rect x="476" y="78" width="90" height="18" rx="5" fill="rgba(88,166,255,.18)" stroke="rgba(88,166,255,.4)" stroke-width="1"/>';
  s1+='<text x="521" y="91" text-anchor="middle" fill="#58a6ff" font-size="8.5" font-weight="700" font-family="system-ui,sans-serif">Your WAN box</text>';
  s1+='<line x1="476" y1="87" x2="464" y2="87" stroke="#58a6ff" stroke-width="1" stroke-dasharray="3 2"/>';
  // pipe WAN→Router
  s1+='<line x1="'+cx+'" y1="120" x2="'+cx+'" y2="134" stroke="#58a6ff" stroke-width="2" stroke-dasharray="4 3"/>';
  s1+='<polygon points="'+(cx-5)+',128 '+cx+',120 '+(cx+5)+',128" fill="#58a6ff"/>';
  // Router box
  s1+='<rect x="220" y="142" width="220" height="38" rx="9" fill="#0d1117" stroke="#58a6ff" stroke-width="2"/>';
  s1+='<text x="'+cx+'" y="159" text-anchor="middle" fill="#58a6ff" font-size="11" font-weight="800" font-family="system-ui,sans-serif">&#128640; '+host+'</text>';
  s1+='<text x="'+cx+'" y="173" text-anchor="middle" fill="#8b949e" font-size="9" font-family="system-ui,sans-serif">192.168.1.1</text>';
  // LAN branch left
  var lanNames=lans.slice(0,5).map(function(i){return i.name;}).join(' &#183; ');
  s1+='<line x1="264" y1="180" x2="106" y2="214" stroke="#3fb950" stroke-width="1.8"/>';
  s1+='<rect x="20" y="204" width="172" height="46" rx="8" fill="rgba(63,185,80,.08)" stroke="rgba(63,185,80,.4)" stroke-width="1.5"/>';
  s1+='<text x="106" y="222" text-anchor="middle" fill="#3fb950" font-size="10" font-weight="700" font-family="system-ui,sans-serif">&#128268; LAN Ports</text>';
  s1+='<text x="106" y="236" text-anchor="middle" fill="#8b949e" font-size="8" font-family="system-ui,sans-serif">'+lanNames+'</text>';
  s1+='<text x="106" y="247" text-anchor="middle" fill="#484f58" font-size="8" font-family="system-ui,sans-serif">'+lans.length+' wired socket'+(lans.length!==1?'s':'')+'</text>';
  // WiFi branch right
  var wifiNames=wifis.slice(0,3).map(function(i){return i.name.replace(/phy\d+\./,'');}).join(' &#183; ');
  s1+='<line x1="396" y1="180" x2="546" y2="214" stroke="#bc8cff" stroke-width="1.8"/>';
  s1+='<rect x="464" y="204" width="172" height="46" rx="8" fill="rgba(188,140,255,.08)" stroke="rgba(188,140,255,.4)" stroke-width="1.5"/>';
  s1+='<text x="550" y="222" text-anchor="middle" fill="#bc8cff" font-size="10" font-weight="700" font-family="system-ui,sans-serif">&#128246; WiFi</text>';
  s1+='<text x="550" y="236" text-anchor="middle" fill="#8b949e" font-size="8" font-family="system-ui,sans-serif">'+wifiNames+'</text>';
  s1+='<text x="550" y="247" text-anchor="middle" fill="#484f58" font-size="8" font-family="system-ui,sans-serif">'+wifis.length+' wireless band'+(wifis.length!==1?'s':'')+'</text>';
  // VPN/Mesh centre
  if(vpns.length||meshes.length){
    var vmNames=vpns.concat(meshes).map(function(i){return i.name;}).join(' &#183; ');
    s1+='<line x1="'+cx+'" y1="180" x2="'+cx+'" y2="212" stroke="#484f58" stroke-width="1.5"/>';
    s1+='<rect x="270" y="212" width="120" height="34" rx="7" fill="rgba(72,79,88,.1)" stroke="rgba(72,79,88,.35)" stroke-width="1.2"/>';
    s1+='<text x="'+cx+'" y="228" text-anchor="middle" fill="#8b949e" font-size="9" font-weight="700" font-family="system-ui,sans-serif">'+vmNames+'</text>';
    s1+='<text x="'+cx+'" y="240" text-anchor="middle" fill="#484f58" font-size="8" font-family="system-ui,sans-serif">VPN + Mesh</text>';
  }
  // WAN2 sidebar box (fits in base height — right of router)
  if(wan2s.length){
    var w2n=wan2s.map(function(i){return _esc(i.name);}).join('&#183;');
    var _pmw3=d&&d.mwan3;
    var _pmw3On=!!(_pmw3&&_pmw3.enabled);
    var _pmw3H=_pmw3On?54:36;
    var _pmw3ModeStr=_pmw3On?(_pmw3.mode==='failover'?'&#9889; Failover':'&#9878; Balanced'):'';
    var _pmw3Dot=(_pmw3&&_pmw3.wanb==='online')?'&#9679;':'&#9675;';
    var _pmw3DotCol=(_pmw3&&_pmw3.wanb==='online')?'#3fb950':'#484f58';
    s1+='<line x1="440" y1="161" x2="484" y2="148" stroke="rgba(88,166,255,.5)" stroke-width="1.5" stroke-dasharray="4 3"/>';
    s1+='<rect x="484" y="128" width="164" height="'+_pmw3H+'" rx="7" fill="rgba(88,166,255,.1)" stroke="rgba(88,166,255,.4)" stroke-width="1.2"/>';
    s1+='<text x="566" y="143" text-anchor="middle" fill="#58a6ff" font-size="10" font-weight="700" font-family="system-ui,sans-serif">&#8644; WAN2 &#8212; '+w2n+'</text>';
    if(_pmw3On){
      s1+='<text x="566" y="156" text-anchor="middle" fill="#58a6ff" font-size="8.5" font-weight="600" font-family="system-ui,sans-serif">'+_pmw3ModeStr+'</text>';
      s1+='<text x="566" y="169" text-anchor="middle" fill="'+_pmw3DotCol+'" font-size="8.5" font-family="system-ui,sans-serif">'+_pmw3Dot+' '+(_pmw3.wanb==='online'?'online':'offline')+'</text>';
    } else {
      s1+='<text x="566" y="155" text-anchor="middle" fill="#8b949e" font-size="8.5" font-family="system-ui,sans-serif">DHCP uplink &#8212; mwan3 not set up</text>';
    }
  }
  // Second modem box (shown when 2 modems — e.g. RocketPlus E with 2 SIM slots)
  if(wan2Modem&&!wan2s.length){
    var _wm2Up=wan2Modem.state==='up';
    var _wm2Col=_wm2Up?'rgba(88,166,255,.65)':'rgba(88,166,255,.2)';
    var _wm2Bg=_wm2Up?'rgba(88,166,255,.1)':'rgba(88,166,255,.04)';
    var _mw3Lb=!!(d&&d.mwan3&&d.mwan3.enabled&&d.mwan3.mode==='balanced');
    var _mw3Fo=!!(d&&d.mwan3&&d.mwan3.enabled&&d.mwan3.mode==='failover');
    // Load balance + modem2 up: draw line from INTERNET to second modem
    if((_mw3Lb||_mw3Fo)&&_wm2Up){
      s1+='<line x1="272" y1="42" x2="172" y2="128" stroke="#58a6ff" stroke-width="2" stroke-dasharray="4 3"/>';
      s1+='<polygon points="168,119 172,128 179,121" fill="#58a6ff"/>';
    } else {
      s1+='<line x1="220" y1="161" x2="174" y2="148" stroke="rgba(88,166,255,.4)" stroke-width="1.5" stroke-dasharray="4 3"/>';
    }
    s1+='<rect x="10" y="128" width="162" height="34" rx="7" fill="'+_wm2Bg+'" stroke="'+_wm2Col+'" stroke-width="1.2"/>';
    s1+='<text x="91" y="143" text-anchor="middle" fill="#58a6ff" font-size="9" font-weight="700" font-family="system-ui,sans-serif">&#128244; '+_esc(wan2Modem.name)+' &#8212; '+(_wm2Up?'&#9679; Up':'&#9675; No SIM')+'</text>';
    s1+='<text x="91" y="155" text-anchor="middle" fill="#8b949e" font-size="8" font-family="system-ui,sans-serif">'+(_wm2Up?(_mw3Lb?'&#9878; Load balance':_mw3Fo?'&#9889; Failover backup':'Active modem'):'Modem slot empty')+'</text>';
  }
  // Guest zone box (below LAN — extends SVG height)
  if(guests.length){
    var gn=guests.map(function(i){return _esc(i.name);}).join('&#183;');
    s1+='<line x1="106" y1="250" x2="106" y2="278" stroke="rgba(240,165,0,.5)" stroke-width="1.5" stroke-dasharray="4 3"/>';
    s1+='<rect x="20" y="278" width="172" height="46" rx="8" fill="rgba(240,165,0,.06)" stroke="rgba(240,165,0,.4)" stroke-width="1.5"/>';
    s1+='<text x="106" y="297" text-anchor="middle" fill="#f0a500" font-size="10" font-weight="700" font-family="system-ui,sans-serif">&#128100; Guest Zone</text>';
    s1+='<text x="106" y="309" text-anchor="middle" fill="#8b949e" font-size="8" font-family="system-ui,sans-serif">'+gn+' &#8212; 192.168.2.1/24</text>';
    s1+='<text x="106" y="320" text-anchor="middle" fill="#484f58" font-size="7.5" font-family="system-ui,sans-serif">isolated from LAN</text>';
  }
  // tip strip
  s1+='<rect x="10" y="'+tipY+'" width="640" height="44" rx="8" fill="rgba(88,166,255,.05)" stroke="rgba(88,166,255,.12)" stroke-width="1"/>';
  s1+='<text x="'+cx+'" y="'+(tipY+17)+'" text-anchor="middle" fill="#8b949e" font-size="9" font-family="system-ui,sans-serif">&#128071; The cards below show each role in detail &#8212; and you can drag any port to a different zone to reassign it.</text>';
  s1+='<text x="'+cx+'" y="'+(tipY+32)+'" text-anchor="middle" fill="#484f58" font-size="8.5" font-family="system-ui,sans-serif">A 60-second safety countdown protects you &#8212; changes auto-revert if you don\'t confirm. You cannot lock yourself out.</text>';
  s1+='</svg></div>';

  // ── CARD 2: Port Roles at a glance (read-only, matches zone colours) ──────
  var rc=_nsRoleConfig;
  var byRole={};
  Object.keys(rc).forEach(function(r){byRole[r]=[];});
  ifaces.filter(function(i){return i.role!=='ifb';}).forEach(function(i){
    // Modems ARE the WAN — show them there in the at-a-glance view
    var r=(i.role==='modem')?'wan':i.role||'lan';
    if(!byRole[r]) byRole[r]=[];
    byRole[r].push(i);
  });

  var roleDesc={
    wan:   'Your internet uplink &#8212; this is how the outside world reaches you. Your 5G modem lives here.',
    modem: 'The 5G modem device &#8212; bridges the air to your router',
    lan:   'Wired local devices &#8212; plug in a PC, TV, PS5, switch',
    wifi:  'Wireless radios &#8212; phones, laptops, tablets connect here',
    guest: 'Isolated zone &#8212; visitors get internet but can\'t see your LAN',
    vpn:   'Encrypted tunnel &#8212; routes traffic through a remote server',
    mesh:  'Mycelium peer network &#8212; your node in the global mesh'
  };

  var s2='<div style="background:#0d1117;border:1px solid #21262d;border-radius:13px;padding:18px 20px;margin-bottom:12px">';
  s2+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">';
  s2+='<div style="font-size:1em;font-weight:800;color:#e6edf3">&#128269; Port Roles at a glance</div>';
  s2+='<button class="ns-ref-btn" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:3px 9px;font-size:.8em;cursor:pointer">&#x21BB;</button>';
  s2+='</div>';
  s2+='<div style="font-size:.78em;color:#8b949e;margin-bottom:14px">What\'s currently in each role &#8212; colours match the drag zones below. Read-only view.</div>';
  s2+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px">';

  var roleOrder=['wan','lan','wifi','guest','vpn','mesh'];
  roleOrder.forEach(function(role){
    var cfg=rc[role]; if(!cfg) return;
    var ports=byRole[role]||[];
    s2+='<div style="background:'+cfg.bg+';border:1px solid '+cfg.border+';border-radius:9px;padding:11px 13px">';
    s2+='<div style="font-size:.75em;font-weight:800;color:'+cfg.col+';margin-bottom:4px;letter-spacing:.04em">'+cfg.icon+' '+cfg.label.toUpperCase()+'</div>';
    s2+='<div style="font-size:.73em;color:#8b949e;margin-bottom:8px;line-height:1.4">'+(roleDesc[role]||'')+'</div>';
    if(ports.length){
      s2+='<div style="display:flex;flex-wrap:wrap;gap:5px">';
      ports.forEach(function(p){
        var st=p.state==='up'?'&#9679; ':'&#9675; ';
        var stCol=p.state==='up'?'#3fb950':'#484f58';
        s2+='<span style="background:'+cfg.bg+';border:1px solid '+cfg.border+';color:'+cfg.col+';border-radius:6px;padding:4px 9px;font-size:.78em;font-weight:600;white-space:nowrap">';
        s2+=_esc(p.name)+'<span style="color:'+stCol+';margin-left:4px;font-size:.85em">'+st+'</span></span>';
      });
      s2+='</div>';
    } else {
      s2+='<span style="color:'+cfg.col+';opacity:.3;font-size:.76em">empty</span>';
    }
    s2+='</div>';
  });
  s2+='</div>';
  s2+='<div style="margin-top:10px;font-size:.76em;color:#484f58;text-align:center">&#8595; drag and drop to reassign any port in the zone below &#8595;</div>';
  s2+='</div>';

  el.innerHTML=s1+s2;
}

// ── Phase 2 — Port Role Assignment ──────────────────────────────────────────
var _nsPendingRoles={};   // {ifname: newRole}
var _nsRollbackTimer=null, _nsRollbackSecs=0;

var _nsRoleConfig={
  modem: {label:'5G Modem',  icon:'📴', col:'#f0a500', bg:'rgba(240,165,0,.1)',   border:'rgba(240,165,0,.3)'},
  wan:   {label:'WAN',       icon:'🌐', col:'#58a6ff', bg:'rgba(88,166,255,.1)',  border:'rgba(88,166,255,.3)'},
  lan:   {label:'LAN',       icon:'🔌', col:'#3fb950', bg:'rgba(63,185,80,.1)',   border:'rgba(63,185,80,.3)'},
  wifi:  {label:'WiFi',      icon:'📶', col:'#bc8cff', bg:'rgba(188,140,255,.1)', border:'rgba(188,140,255,.3)'},
  guest: {label:'Guest',     icon:'👤', col:'#ffa657', bg:'rgba(255,166,87,.1)',  border:'rgba(255,166,87,.3)'},
  vpn:   {label:'VPN',       icon:'🔒', col:'#f85149', bg:'rgba(248,81,73,.1)',   border:'rgba(248,81,73,.3)'},
  mesh:  {label:'Mesh',      icon:'🕸️', col:'#3fb950', bg:'rgba(63,185,80,.1)',   border:'rgba(63,185,80,.3)'}
};

function _nsAssignDragStart(e){
  e.dataTransfer.setData('text/plain', e.target.dataset.iface);
  e.target.style.opacity='0.45';
}
function _nsAssignDragEnd(e){ e.target.style.opacity='1'; }
function _nsAssignDragOver(e){ e.preventDefault(); e.currentTarget.style.outline='2px solid #58a6ff'; }
function _nsAssignDragLeave(e){ e.currentTarget.style.outline='none'; }
function _nsAssignDrop(e){
  e.preventDefault();
  e.currentTarget.style.outline='none';
  var iface=e.dataTransfer.getData('text/plain');
  var newRole=e.currentTarget.dataset.role;
  if(!iface||!newRole) return;
  _nsPendingRoles[iface]=newRole;
  _nsRefreshAssign();
}

function _nsRefreshAssign(){
  if(!_nsData) return;
  _renderNsAssign(_nsData);
}

function _nsRoleChip(iface, role, isPending){
  var rc=_nsRoleConfig[role]||_nsRoleConfig.lan;
  var pending=isPending?'outline:2px solid #f0a500;':'';
  return '<span draggable="true" data-iface="'+iface+'"'
    +' ondragstart="_nsAssignDragStart(event)" ondragend="_nsAssignDragEnd(event)"'
    +' style="display:inline-flex;align-items:center;gap:5px;background:'+rc.bg+';border:1px solid '+rc.border+';'
    +'color:'+rc.col+';border-radius:7px;padding:5px 10px;font-size:.8em;font-weight:600;cursor:grab;'+pending+'white-space:nowrap;user-select:none">'
    +iface+'</span>';
}

var _nsWizardState={guestSkipped:false,wan2Skipped:false,guestDone:false,guestPortSel:null,wan2PortSel:null,pendingType:null,pendingPort:null,pendingRollbackAt:0,pendingTimer:null,confirming:false,mwan3Done:false,mwan3Skipped:false,wifiExpanded:false};

function _nsWizardFetch(action,body,cb){
  fetch('/cgi-bin/rocket?'+action,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-RR-Admin':'1'},body:body||''})
  .then(function(r){return r.json();}).then(function(j){if(cb)cb(j);}).catch(function(){if(cb)cb({ok:false});});
}

function _nsWizardStartTimer(rollbackAt){
  if(_nsWizardState.pendingTimer) clearInterval(_nsWizardState.pendingTimer);
  _nsWizardState.pendingTimer=setInterval(function(){
    var secs=Math.max(0,Math.round((rollbackAt-Date.now())/1000));
    var el=document.getElementById('ns-wiz-countdown');
    if(el) el.textContent=secs+'s';
    if(secs<=0){
      clearInterval(_nsWizardState.pendingTimer);
      _nsWizardState.pendingType=null;
      _nsWizardState.pendingPort=null;
      _nsWizardState.pendingTimer=null;
      if(_nsData) _renderNsWizard(_nsData);
    }
  },500);
}

function _renderNsWizard(d){
  var el=document.getElementById('ns-wizard'); if(!el) return;
  if(_nsWizardState.confirming) return;
  var ifaces=(d&&d.interfaces)||[];
  var guestPorts=ifaces.filter(function(i){
    return i.role==='lan'&&/^lan[1-9]/.test(i.name)&&i.state!=='up';
  });
  var wan2Ports=ifaces.filter(function(i){
    return i.role==='lan'&&i.max>=2500&&/^eth/.test(i.name);
  });
  // Ports already configured — show remove card
  var configuredGuestPorts=ifaces.filter(function(i){
    return i.role==='guest'&&/^lan/.test(i.name);
  });
  var configuredWan2Ports=ifaces.filter(function(i){
    return i.role==='wan'&&/^eth/.test(i.name)&&i.max>=2500;
  });
  var showGuest=!!(guestPorts.length&&!_nsWizardState.guestSkipped&&!_nsWizardState.guestDone);
  var showWan2=!!(wan2Ports.length&&!_nsWizardState.wan2Skipped);
  var showGuestRemove=!!(configuredGuestPorts.length&&_nsWizardState.pendingType!=='guest_remove'&&_nsWizardState.pendingType!=='guest');
  var showWan2Remove=!!(configuredWan2Ports.length>0&&_nsWizardState.pendingType!=='wan2_remove'&&_nsWizardState.pendingType!=='wan2');
  var _mw3d=d&&d.mwan3;
  var _mw3Active=!!(_mw3d&&_mw3d.enabled);
  var _hasQModem2=!!(d.qmodem&&d.qmodem.length>=2);
  var showMwan3=!!((configuredWan2Ports.length>0||_hasQModem2)&&!_mw3Active&&!_nsWizardState.mwan3Skipped&&!_nsWizardState.pendingType);
  var showMwan3Active=!!(_mw3Active&&!_nsWizardState.pendingType);
  var showWifi=!!(d.wifi&&d.wifi.bands>0);
  if(!showGuest&&!showWan2&&!showGuestRemove&&!showWan2Remove&&!showMwan3&&!showMwan3Active&&!showWifi&&!_nsWizardState.pendingType){el.innerHTML='';return;}
  var h='<div style="background:#0d1117;border:1px solid #21262d;border-radius:12px;padding:18px 20px">';
  h+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:14px">';
  h+='<span style="font-size:1.05em">&#x1F9D9;</span>';
  h+='<span style="font-weight:700;color:#e6edf3;font-size:.95em">Setup Wizard</span>';
  h+='<span style="color:#484f58;font-size:.75em;margin-left:4px">&#8212; opportunities detected on your hardware</span>';
  h+='<button class="ns-ref-btn" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:3px 9px;font-size:.8em;cursor:pointer;margin-left:auto">&#x21BB;</button>';
  h+='</div>';
  if(_nsWizardState.pendingType){
    var lbl;
    if(_nsWizardState.pendingType==='guest_remove') lbl='Guest network being removed';
    else if(_nsWizardState.pendingType==='wan2_remove') lbl='WAN2 ('+(_nsWizardState.pendingPort||'?')+') being removed';
    else lbl=(_nsWizardState.pendingType==='guest'?'Guest network':'Second WAN (wan2)');
    var secs=Math.max(0,Math.round((_nsWizardState.pendingRollbackAt-Date.now())/1000));
    h+='<div style="background:rgba(240,165,0,.12);border:1px solid rgba(240,165,0,.3);border-radius:8px;padding:12px 14px;margin-bottom:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">';
    h+='<span style="font-size:1.1em">&#9201;</span>';
    h+='<span style="color:#f0a500;font-size:.85em;font-weight:600;flex:1">'+lbl+' applied &#8212; auto-reverts in <span id="ns-wiz-countdown">'+secs+'s</span></span>';
    h+='<button onclick="_nsWizardConfirm()" style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:5px 14px;font-size:.8em;font-weight:600;cursor:pointer">&#10003; Keep it</button>';
    h+='<button onclick="_nsWizardRevert()" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:6px;padding:5px 14px;font-size:.8em;font-weight:600;cursor:pointer">&#8617; Undo</button>';
    h+='</div>';
  }
  if(showGuest&&_nsWizardState.pendingType!=='guest'){
    var gNames=guestPorts.map(function(i){return i.name;});
    var gSel='<select id="ns-wiz-guest-port" onchange="_nsWizardState.guestPortSel=this.value" style="background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:5px;padding:3px 8px;font-size:.8em">';
    gNames.forEach(function(n){
      var sel=(n===_nsWizardState.guestPortSel)?'selected':'';
      gSel+='<option value="'+n+'" '+sel+'>'+n+'</option>';
    });
    gSel+='</select>';
    h+='<div style="border:1px solid rgba(63,185,80,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(63,185,80,.04)">';
    h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#128100; Guest Network</div>';
    h+='<div style="color:#8b949e;font-size:.8em;line-height:1.5;margin-bottom:10px">You have '+gNames.length+' empty LAN port(s): <strong style="color:#e6edf3">'+gNames.join(', ')+'</strong>. Turn one into an isolated guest network &#8212; visitors get internet, cannot reach your LAN devices.</div>';
    h+='<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">';
    h+='<span style="color:#8b949e;font-size:.78em">Port:</span>'+gSel;
    h+='<button onclick="_nsWizardGuest()" style="background:rgba(63,185,80,.12);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#10003; Set up guest network</button>';
    h+='<button onclick="_nsWizardSkipGuest()" style="background:transparent;border:1px solid #30363d;color:#484f58;border-radius:6px;padding:5px 10px;font-size:.78em;cursor:pointer">&#10006; Skip</button>';
    h+='</div></div>';
  }
  if(showWan2&&_nsWizardState.pendingType!=='wan2'){
    var wSel='<select id="ns-wiz-wan2-port" onchange="_nsWizardState.wan2PortSel=this.value" style="background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:5px;padding:3px 8px;font-size:.8em">';
    wan2Ports.forEach(function(i){
      var spd=i.max>0?' ('+_nsFmtSpeed(i.max)+')':'';
      var sel=(i.name===_nsWizardState.wan2PortSel)?'selected':'';
      wSel+='<option value="'+i.name+'" '+sel+'>'+i.name+spd+'</option>';
    });
    wSel+='</select>';
    h+='<div style="border:1px solid rgba(88,166,255,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(88,166,255,.04)">';
    h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#127760; Second WAN &#8212; Failover / Combined Bandwidth</div>';
    h+='<div style="color:#8b949e;font-size:.8em;line-height:1.5;margin-bottom:10px">High-speed port(s) currently sitting in your LAN bridge. Pull one out and plug in a backup broadband router for wired failover, or combine with your 5G modem for load-balanced bandwidth. <span style="color:#58a6ff">mwan3 load-balance config comes in Phase 5.</span></div>';
    h+='<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">';
    h+='<span style="color:#8b949e;font-size:.78em">Port:</span>'+wSel;
    h+='<button onclick="_nsWizardWan2()" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#10003; Set up WAN2</button>';
    h+='<button onclick="_nsWizardSkipWan2()" style="background:transparent;border:1px solid #30363d;color:#484f58;border-radius:6px;padding:5px 10px;font-size:.78em;cursor:pointer">&#10006; Skip</button>';
    h+='</div></div>';
  }
  // Remove cards
  if(showGuestRemove){
    var gRPort=configuredGuestPorts[0].name;
    h+='<div style="border:1px solid rgba(248,81,73,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(248,81,73,.04)">';
    h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#128100; Guest Network <span style="color:#3fb950;font-size:.8em;font-weight:400">&#10003; active on '+gRPort+'</span></div>';
    h+='<div style="color:#8b949e;font-size:.8em;line-height:1.5;margin-bottom:10px">Guest network is running on <strong style="color:#e6edf3">'+gRPort+'</strong> (192.168.2.1/24). Visitors can reach the internet but not your LAN.</div>';
    h+='<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">';
    h+='<button onclick="_nsWizardGuestRemove()" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#8617; Take it back out</button>';
    h+='</div></div>';
  }
  if(showWan2Remove){
    configuredWan2Ports.forEach(function(wp){
      if(_nsWizardState.pendingType==='wan2_remove'&&_nsWizardState.pendingPort===wp.name) return;
      var wRPort=wp.name;
      h+='<div style="border:1px solid rgba(248,81,73,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(248,81,73,.04)">';
      h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#127760; WAN Port <span style="color:#3fb950;font-size:.8em;font-weight:400">&#10003; active on '+wRPort+'</span></div>';
      h+='<div style="color:#8b949e;font-size:.8em;line-height:1.5;margin-bottom:10px">WAN interface configured on <strong style="color:#e6edf3">'+wRPort+'</strong>. Port is pulled from br-lan and set as a DHCP uplink.</div>';
      h+='<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">';
      h+='<button onclick="_nsWizardWan2Remove(\''+wRPort+'\')" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#8617; Take it back out</button>';
      h+='</div></div>';
    });
  }
  // mwan3 setup card — shows when WAN2 is active but mwan3 not yet configured
  if(showMwan3){
    h+='<div style="border:1px solid rgba(88,166,255,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(88,166,255,.04)">';
    h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#x1F500; Multi-WAN &#8212; Failover &amp; Load Balance</div>';
    h+='<div style="color:#8b949e;font-size:.8em;line-height:1.5;margin-bottom:12px">WAN2 is active. Configure how both WANs work together &#8212; either automatic failover, or shared load balancing across both uplinks.</div>';
    h+='<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px">';
    h+='<div style="flex:1;min-width:200px;border:1px solid rgba(88,166,255,.25);border-radius:7px;padding:10px 12px;background:rgba(88,166,255,.06);cursor:pointer" onclick="_nsWizardMwan3(\'failover\')">';
    h+='<div style="color:#58a6ff;font-size:.85em;font-weight:700;margin-bottom:4px">&#9889; Failover</div>';
    h+='<div style="color:#8b949e;font-size:.78em;line-height:1.4">WAN stays primary. WAN2 kicks in automatically if WAN drops. Best for reliability.</div>';
    h+='</div>';
    h+='<div style="flex:1;min-width:200px;border:1px solid rgba(63,185,80,.25);border-radius:7px;padding:10px 12px;background:rgba(63,185,80,.06);cursor:pointer" onclick="_nsWizardMwan3(\'balanced\')">';
    h+='<div style="color:#3fb950;font-size:.85em;font-weight:700;margin-bottom:4px">&#9878; Load Balance</div>';
    h+='<div style="color:#8b949e;font-size:.78em;line-height:1.4">Traffic split equally across both WANs. Best for combined bandwidth on two ISPs.</div>';
    h+='</div>';
    h+='</div>';
    h+='<div style="display:flex;gap:8px">';
    h+='<button onclick="_nsWizardMwan3(\'failover\'" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#9889; Apply Failover</button>';
    h+='<button onclick="_nsWizardMwan3(\'balanced\')" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#9878; Apply Balanced</button>';
    h+='<button onclick="_nsWizardSkipMwan3()" style="background:transparent;border:1px solid #30363d;color:#484f58;border-radius:6px;padding:5px 10px;font-size:.78em;cursor:pointer">&#10006; Skip</button>';
    h+='</div></div>';
  }
  // mwan3 active card — shows current mode with option to switch
  if(showMwan3Active){
    var _mw3ModeLabel=_mw3d.mode==='failover'?'&#9889; Failover':'&#9878; Load Balance';
    var _mw3WanOk=_mw3d.wan==='online';
    var _mw3WanbOk=_mw3d.wanb==='online';
    var _dot=function(ok){return ok?'<span style="color:#3fb950">&#9679;</span>':'<span style="color:#484f58">&#9675;</span>';};
    h+='<div style="border:1px solid rgba(88,166,255,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(88,166,255,.04)">';
    h+='<div style="font-weight:600;color:#e6edf3;font-size:.88em;margin-bottom:5px">&#x1F500; Multi-WAN active &#8212; '+_mw3ModeLabel+'</div>';
    var _ifc1Lbl=(d.qmodem&&d.qmodem.length>=1)?d.qmodem[0].iface:'WAN';
    var _ifc2Lbl=(d.qmodem&&d.qmodem.length>=2)?d.qmodem[1].iface:'WAN2';
    h+='<div style="color:#8b949e;font-size:.8em;margin-bottom:10px">'+_ifc1Lbl+' '+_dot(_mw3WanOk)+' '+((_mw3d.wan)||'?')+'&nbsp;&nbsp;'+_ifc2Lbl+' '+_dot(_mw3WanbOk)+' '+((_mw3d.wanb)||'?')+'</div>';
    h+='<div style="display:flex;gap:8px;flex-wrap:wrap">';
    if(_mw3d.mode!=='failover') h+='<button onclick="_nsWizardMwan3(\'failover\')" style="background:rgba(88,166,255,.1);border:1px solid rgba(88,166,255,.3);color:#58a6ff;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">Switch to &#9889; Failover</button>';
    if(_mw3d.mode!=='balanced') h+='<button onclick="_nsWizardMwan3(\'balanced\')" style="background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);color:#3fb950;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">Switch to &#9878; Balanced</button>';
    h+='<button onclick="_nsWizardMwan3Remove()" style="background:rgba(248,81,73,.1);border:1px solid rgba(248,81,73,.3);color:#f85149;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#10006; Remove</button>';
    h+='</div></div>';
  }
  h+='</div>';
  // WiFi config card — always show when WiFi bands present
  if(showWifi){
    var _wSSID=d.wifi&&d.wifi.ssid?d.wifi.ssid:'';
    var _wBands=d.wifi&&d.wifi.bands?d.wifi.bands:0;
    h+='<div style="border:1px solid rgba(188,140,255,.2);border-radius:8px;padding:14px 16px;margin-bottom:10px;background:rgba(188,140,255,.04)">';
    h+='<div style="display:flex;justify-content:space-between;align-items:center">';
    h+='<div><span style="font-weight:600;color:#e6edf3;font-size:.88em">&#128246; WiFi</span>';
    h+=' <span style="color:#8b949e;font-size:.8em">'+_wBands+' band'+(parseInt(_wBands)!==1?'s':'')+(_wSSID?' &#183; SSID: <b style="color:#bc8cff">'+_esc(_wSSID)+'</b>':'')+'</span></div>';
    h+='<button onclick="_nsWizardState.wifiExpanded=!_nsWizardState.wifiExpanded;if(_nsData)_renderNsWizard(_nsData);" style="background:rgba(188,140,255,.1);border:1px solid rgba(188,140,255,.3);color:#bc8cff;border-radius:6px;padding:4px 11px;font-size:.78em;font-weight:600;cursor:pointer">'+(_nsWizardState.wifiExpanded?'&#8963; Close':'&#9998; Change')+'</button>';
    h+='</div>';
    if(_nsWizardState.wifiExpanded){
      h+='<div style="margin-top:12px">';
      h+='<div style="color:#8b949e;font-size:.8em;margin-bottom:10px">Set a new WiFi name and password. All bands (2.4GHz, 5GHz, 6GHz) will be updated together.</div>';
      h+='<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px">';
      h+='<div style="flex:1;min-width:140px"><label style="color:#8b949e;font-size:.75em;display:block;margin-bottom:3px">WiFi Name (SSID)</label>';
      h+='<input id="ns-wifi-ssid" type="text" maxlength="32" value="'+_esc(_wSSID)+'" placeholder="MyNetwork" style="width:100%;box-sizing:border-box;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:5px;padding:5px 8px;font-size:.85em"></div>';
      h+='<div style="flex:1;min-width:140px"><label style="color:#8b949e;font-size:.75em;display:block;margin-bottom:3px">Password (min 8 chars)</label>';
      h+='<input id="ns-wifi-key" type="password" maxlength="63" placeholder="New password" style="width:100%;box-sizing:border-box;background:#161b22;border:1px solid #30363d;color:#e6edf3;border-radius:5px;padding:5px 8px;font-size:.85em"></div>';
      h+='</div>';
      h+='<div style="display:flex;gap:8px">';
      h+='<button onclick="_nsWizardWifi()" style="background:rgba(188,140,255,.15);border:1px solid rgba(188,140,255,.4);color:#bc8cff;border-radius:6px;padding:5px 13px;font-size:.8em;font-weight:600;cursor:pointer">&#10003; Apply WiFi</button>';
      h+='<button onclick="_nsWizardState.wifiExpanded=false;if(_nsData)_renderNsWizard(_nsData);" style="background:transparent;border:1px solid #30363d;color:#484f58;border-radius:6px;padding:5px 10px;font-size:.78em;cursor:pointer">Cancel</button>';
      h+='</div></div>';
    }
    h+='</div>';
  }
  el.innerHTML=h;
  if(_nsWizardState.pendingType) _nsWizardStartTimer(_nsWizardState.pendingRollbackAt);
}

function _nsWizardGuest(){
  var sel=document.getElementById('ns-wiz-guest-port');
  var port=sel?sel.value:'lan1';
  _nsWizardFetch('net_wizard_guest','port='+port,function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    var at=Date.now()+(j.rollback_in||60)*1000;
    _nsWizardState.pendingType='guest';
    _nsWizardState.pendingRollbackAt=at;
    if(_nsData) _renderNsWizard(_nsData);
    _nsWizardStartTimer(at);
  });
}

function _nsWizardWan2(){
  var sel=document.getElementById('ns-wiz-wan2-port');
  var port=sel?sel.value:'eth1';
  _nsWizardFetch('net_wizard_wan2','port='+port,function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    var at=Date.now()+(j.rollback_in||60)*1000;
    _nsWizardState.pendingType='wan2';
    _nsWizardState.pendingPort=port;
    _nsWizardState.pendingRollbackAt=at;
    if(_nsData) _renderNsWizard(_nsData);
    _nsWizardStartTimer(at);
  });
}

function _nsWizardConfirm(){
  _nsWizardState.confirming=true;
  var _wizEl=document.getElementById('ns-wizard');
  function _setConfirmMsg(msg,col){
    if(!_wizEl) return;
    var _wi=_wizEl.querySelector('div');
    if(!_wi) return;
    var _fb=document.createElement('div');
    _fb.id='ns-wiz-confirm-fb';
    _fb.style.cssText='background:rgba(63,185,80,.1);border:1px solid rgba(63,185,80,.3);border-radius:8px;padding:12px 14px;display:flex;align-items:center;gap:8px;color:'+(col||'#3fb950')+';font-size:.85em;font-weight:600';
    _fb.innerHTML=msg;
    _wi.innerHTML='';
    _wi.appendChild(_fb);
  }
  function _doneConfirm(){ _nsWizardState.confirming=false; }
  _setConfirmMsg('<span>&#10003;</span><span>Confirmed &#8212; saving&hellip;</span>');
  if(_nsWizardState.pendingTimer) clearInterval(_nsWizardState.pendingTimer);
  var t=_nsWizardState.pendingType;
  _nsWizardState.pendingType=null;
  _nsWizardState.pendingPort=null;
  _nsWizardState.pendingTimer=null;
  if(t==='guest') _nsWizardState.guestDone=true;
  if(t==='guest_remove'){ _nsWizardState.guestDone=false; _nsWizardState.guestSkipped=false; }
  if(t==='wan2_remove')  _nsWizardState.wan2Skipped=false;
  var _confirmRetries=6;
  function _doConfirm(){
    fetch('/cgi-bin/rocket?net_wizard_confirm',{method:'POST',headers:{'X-RR-Admin':'1'},body:''})
    .then(function(r){return r.json();})
    .then(function(j){
      if(j&&j.error==='already_rolled_back'){
        _setConfirmMsg('<span>&#9888;</span><span>Timed out &#8212; router rolled back the change. Please try again.</span>','#f85149');
        _doneConfirm();
        setTimeout(function(){loadNetSetup();},3000);
        return;
      }
      _setConfirmMsg('<span>&#10003;</span><span>Confirmed &#8212; reloading&#8230;</span>');
      _doneConfirm();
      setTimeout(function(){loadNetSetup();},3000);
    })
    .catch(function(){
      _confirmRetries--;
      if(_confirmRetries>0){
        var _att=7-_confirmRetries;
        _setConfirmMsg('<span>&#8987;</span><span>Waiting for router reload&hellip; (attempt '+_att+'/6)</span>','#f0a500');
        setTimeout(_doConfirm,1000);
      } else {
        _setConfirmMsg('<span>&#9888;</span><span>Could not reach router after reload &#8212; changes may not have saved</span>','#f85149');
        _doneConfirm();
        setTimeout(function(){loadNetSetup();},3000);
      }
    });
  }
  _doConfirm();
}

function _nsWizardRevert(){
  _nsWizardFetch('net_wizard_revert','',function(){
    if(_nsWizardState.pendingTimer) clearInterval(_nsWizardState.pendingTimer);
    _nsWizardState.pendingType=null;
    _nsWizardState.pendingPort=null;
    _nsWizardState.pendingTimer=null;
    if(_nsData) _renderNsWizard(_nsData);
  });
}

function _nsWizardSkipGuest(){
  _nsWizardState.guestSkipped=true;
  if(_nsData) _renderNsWizard(_nsData);
}

function _nsWizardSkipWan2(){
  _nsWizardState.wan2Skipped=true;
  if(_nsData) _renderNsWizard(_nsData);
}

function _nsWizardMwan3(mode){
  _nsWizardFetch('net_wizard_mwan3','mode='+mode,function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    _nsWizardState.mwan3Done=true;
    _nsWizardState.mwan3Skipped=false;
    if(_nsData) _renderNsWizard(_nsData);
    setTimeout(function(){_fetchNetSetup(null);},3000);
  });
}

function _nsWizardSkipMwan3(){
  _nsWizardState.mwan3Skipped=true;
  if(_nsData) _renderNsWizard(_nsData);
}

function _nsWizardMwan3Remove(){
  if(!confirm('Remove Multi-WAN setup and return to single WAN?')) return;
  _nsWizardFetch('net_wizard_mwan3_remove','',function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    _nsWizardState.mwan3Done=false;
    _nsWizardState.mwan3Skipped=false;
    if(_nsData) _renderNsWizard(_nsData);
    setTimeout(function(){_fetchNetSetup(null);},3000);
  });
}

function _nsWizardWifi(){
  var ssid=(document.getElementById('ns-wifi-ssid')||{}).value||'';
  var key=(document.getElementById('ns-wifi-key')||{}).value||'';
  if(!ssid){alert('Please enter a WiFi name.');return;}
  if(key.length>0&&key.length<8){alert('Password must be at least 8 characters.');return;}
  var body='ssid='+encodeURIComponent(ssid)+(key?'&key='+encodeURIComponent(key):'');
  _nsWizardFetch('net_wizard_wifi',body,function(j){
    if(!j.ok){alert('WiFi error: '+(j.error||'failed'));return;}
    _nsWizardState.wifiExpanded=false;
    if(_nsData&&_nsData.wifi) _nsData.wifi.ssid=j.ssid||ssid;
    if(_nsData) _renderNsWizard(_nsData);
    setTimeout(function(){_fetchNetSetup(null);},3000);
  });
}

function _nsWizardGuestRemove(){
  _nsWizardFetch('net_wizard_guest_remove','',function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    var at=Date.now()+(j.rollback_in||60)*1000;
    _nsWizardState.pendingType='guest_remove';
    _nsWizardState.pendingRollbackAt=at;
    if(_nsData) _renderNsWizard(_nsData);
    _nsWizardStartTimer(at);
  });
}

function _nsWizardWan2Remove(port){
  _nsWizardFetch('net_wizard_wan2_remove','port='+port,function(j){
    if(!j.ok){alert('Error: '+(j.error||'failed'));return;}
    var at=Date.now()+(j.rollback_in||60)*1000;
    _nsWizardState.pendingType='wan2_remove';
    _nsWizardState.pendingPort=port;
    _nsWizardState.pendingRollbackAt=at;
    if(_nsData) _renderNsWizard(_nsData);
    _nsWizardStartTimer(at);
  });
}

function _renderNsAssign(d){
  var el=document.getElementById('ns-assign'); if(!el) return;
  var ifaces=(d.interfaces||[]).filter(function(i){
    return i.role!=='ifb';
  });
  if(!ifaces.length){ el.innerHTML=''; return; }

  // Merge pending overrides into current state for display
  var current={};
  ifaces.forEach(function(i){ current[i.name]=_nsPendingRoles[i.name]||i.role; });

  var hasPending=Object.keys(_nsPendingRoles).length>0;

  // Group by current (possibly pending) role
  var byRole={};
  Object.keys(_nsRoleConfig).forEach(function(r){ byRole[r]=[]; });
  ifaces.forEach(function(i){
    var r=current[i.name]||'lan';
    if(!byRole[r]) byRole[r]=[];
    byRole[r].push(i.name);
  });

  // Build copy text
  var _copyLines=['Port Role Assignments — '+(_nsData&&_nsData.hostname||'Router'),''];
  Object.keys(_nsRoleConfig).forEach(function(role){
    var ports=byRole[role]||[];
    if(ports.length) ports.forEach(function(n){ _copyLines.push(n+': '+_nsRoleConfig[role].label); });
  });
  var _copyText=_copyLines.join('\n');

  var _btnS='background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer;margin-left:6px';
  var s='<div style="margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">'
    +'<div><div style="font-size:1em;font-weight:800;color:#e6edf3">🔧 Port Roles</div>'
    +'<div style="font-size:.78em;color:#8b949e;margin-top:2px">Drag a port into a different role zone to reassign it</div></div>'
    +'<div style="display:flex;align-items:center;flex-wrap:wrap;gap:4px">'
    +'<button class="ns-ref-btn" type="button" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 9px;font-size:.8em;cursor:pointer">&#x21BB;</button>'
    +'<button type="button" onclick="_nsCopy(\'ns-roles-txt\',this)" style="'+_btnS+'">📋 Copy</button>'
    +'<button type="button" onclick="_nsDownloadTxt(\'ns-roles-txt\',\'rocket-port-roles.txt\',this)" style="'+_btnS+'">💾 Save .txt</button>'
    +'</div>'
    +'</div>'
    +'<div id="ns-roles-txt" style="display:none">'+_copyText+'</div>';

  if(hasPending){
    s+='<div style="display:flex;gap:8px">'
      +'<button type="button" onclick="_nsApplyRoles()" style="background:rgba(240,165,0,.15);border:1px solid rgba(240,165,0,.4);color:#f0a500;border-radius:7px;padding:6px 16px;font-size:.8em;font-weight:700;cursor:pointer">✓ Apply Changes</button>'
      +'<button type="button" onclick="_nsClearPending()" style="background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.25);color:#f85149;border-radius:7px;padding:6px 14px;font-size:.8em;font-weight:600;cursor:pointer">✕ Cancel</button>'
      +'</div>';
  }
  s+='</div>';

  // Rollback bar (shown after apply)
  s+='<div id="ns-rollback-bar" style="display:none;background:rgba(240,165,0,.1);border:1px solid rgba(240,165,0,.35);border-radius:9px;padding:12px 16px;margin-bottom:14px">'
    +'<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">'
    +'<div>'
    +'<div style="font-size:.85em;font-weight:700;color:#f0a500">⏱ Auto-reverting in <span id="ns-rollback-count">60</span>s</div>'
    +'<div style="font-size:.76em;color:#8b949e;margin-top:2px">Changes will revert unless you confirm — safety net so you can\'t lock yourself out</div>'
    +'</div>'
    +'<div style="display:flex;gap:8px">'
    +'<button type="button" onclick="_nsConfirmRoles()" style="background:rgba(63,185,80,.15);border:1px solid rgba(63,185,80,.4);color:#3fb950;border-radius:7px;padding:6px 16px;font-size:.8em;font-weight:700;cursor:pointer">✓ Confirm — Keep Changes</button>'
    +'<button type="button" onclick="_nsRevertRoles()" style="background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.25);color:#f85149;border-radius:7px;padding:6px 14px;font-size:.8em;font-weight:600;cursor:pointer">↩ Revert Now</button>'
    +'</div></div>'
    +'<div style="margin-top:10px;height:4px;background:#21262d;border-radius:2px;overflow:hidden">'
    +'<div id="ns-rollback-progress" style="height:100%;background:#f0a500;border-radius:2px;width:100%;transition:width 1s linear"></div>'
    +'</div></div>';

  // Role zones grid
  s+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px">';
  Object.keys(_nsRoleConfig).forEach(function(role){
    var rc=_nsRoleConfig[role];
    var chips=byRole[role]||[];
    var dropActive=chips.length===0?'min-height:54px;':'';
    s+='<div data-role="'+role+'"'
      +' ondragover="_nsAssignDragOver(event)" ondragleave="_nsAssignDragLeave(event)" ondrop="_nsAssignDrop(event)"'
      +' style="background:'+rc.bg+';border:1px solid '+rc.border+';border-radius:9px;padding:10px 12px;'+dropActive+'transition:outline .1s">'
      +'<div style="font-size:.75em;font-weight:700;color:'+rc.col+';margin-bottom:7px;letter-spacing:.04em">'+rc.icon+' '+rc.label.toUpperCase()+'</div>'
      +'<div style="display:flex;flex-wrap:wrap;gap:5px;min-height:26px">';
    chips.forEach(function(ifname){
      var isPending=!!_nsPendingRoles[ifname];
      s+=_nsRoleChip(ifname, role, isPending);
    });
    if(!chips.length) s+='<span style="color:'+rc.col+';opacity:.3;font-size:.75em;align-self:center">drop here</span>';
    s+='</div></div>';
  });
  s+='</div>';

  el.innerHTML=s;
}

function _nsClearPending(){
  _nsPendingRoles={};
  _nsRefreshAssign();
}

function _nsApplyRoles(){
  if(!Object.keys(_nsPendingRoles).length) return;
  // Build roles string: iface:role,iface:role,...
  var parts=[];
  if(_nsData){
    (_nsData.interfaces||[]).forEach(function(i){
      var r=_nsPendingRoles[i.name]||i.role;
      parts.push(i.name+':'+r);
    });
  }
  var body='roles='+encodeURIComponent(parts.join(','));
  fetch('/cgi-bin/rocket?net_roles_save',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','Content-Length':body.length},body:body})
  .then(function(r){return r.json();})
  .then(function(d){
    if(!d.ok){ alert('Save failed'); return; }
    _nsPendingRoles={};
    _nsStartRollback(60);
  })
  .catch(function(){ alert('Could not reach router'); });
}

function _nsStartRollback(secs){
  _nsRollbackSecs=secs;
  var bar=document.getElementById('ns-rollback-bar');
  if(bar) bar.style.display='block';
  _nsUpdateRollbackUI();
  if(_nsRollbackTimer) clearInterval(_nsRollbackTimer);
  _nsRollbackTimer=setInterval(function(){
    _nsRollbackSecs--;
    _nsUpdateRollbackUI();
    if(_nsRollbackSecs<=0){
      clearInterval(_nsRollbackTimer); _nsRollbackTimer=null;
      // Auto-reverted on server — refresh discovery
      _fetchNetSetup(null);
      var bar=document.getElementById('ns-rollback-bar');
      if(bar) bar.style.display='none';
    }
  },1000);
}

function _nsUpdateRollbackUI(){
  var cnt=document.getElementById('ns-rollback-count');
  var prog=document.getElementById('ns-rollback-progress');
  if(cnt) cnt.textContent=_nsRollbackSecs;
  if(prog) prog.style.width=((_nsRollbackSecs/60)*100)+'%';
}

function _nsConfirmRoles(){
  if(_nsRollbackTimer){ clearInterval(_nsRollbackTimer); _nsRollbackTimer=null; }
  fetch('/cgi-bin/rocket?net_roles_confirm',{method:'POST',body:''})
  .then(function(){
    var bar=document.getElementById('ns-rollback-bar');
    if(bar) bar.style.display='none';
    _fetchNetSetup(null);
  });
}

function _nsRevertRoles(){
  if(_nsRollbackTimer){ clearInterval(_nsRollbackTimer); _nsRollbackTimer=null; }
  fetch('/cgi-bin/rocket?net_roles_revert',{method:'POST',body:''})
  .then(function(){
    var bar=document.getElementById('ns-rollback-bar');
    if(bar) bar.style.display='none';
    _fetchNetSetup(null);
  });
}
function _nsAnimDur(bps){
  if(!bps||bps<=0) return '8s';
  if(bps<2000)    return '5s';
  if(bps<20000)   return '2.5s';
  if(bps<200000)  return '1.2s';
  if(bps<2000000) return '0.6s';
  return '0.25s';
}
function _nsFmtRate(bps){
  if(bps<0) return '&#8230;';
  if(bps<1024)       return Math.round(bps)+' B/s';
  if(bps<1048576)    return (bps/1024).toFixed(1)+' KB/s';
  if(bps<1073741824) return (bps/1048576).toFixed(1)+' Mbps';
  return (bps/1073741824).toFixed(2)+' Gbps';
}
function _nsDownloadTxt(contentId,filename,btn){
  var el=document.getElementById(contentId); if(!el) return;
  var text=el.innerText||el.textContent||'';
  var blob=new Blob([text],{type:'text/plain'});
  var url=URL.createObjectURL(blob);
  var a=document.createElement('a');
  a.href=url; a.download=filename||'network-info.txt'; a.click();
  URL.revokeObjectURL(url);
  if(btn){var o=btn.textContent;btn.textContent='\u2713 Saved!';setTimeout(function(){btn.textContent=o;},1500);}
}
function _fetchNetSetup(cb){
  fetch('/cgi-bin/rocket?hw_discover')
  .then(function(r){return r.json();})
  .then(function(d){
    var now=Date.now();
    (d.interfaces||[]).forEach(function(i){
      var prev=_nsLastPoll[i.name];
      if(prev&&now>prev.ts&&i.rx>=prev.rx&&i.tx>=prev.tx){
        var dt=(now-prev.ts)/1000;
        i.rxRate=(i.rx-prev.rx)/dt;
        i.txRate=(i.tx-prev.tx)/dt;
      } else { i.rxRate=-1; i.txRate=-1; }
      _nsLastPoll[i.name]={rx:i.rx,tx:i.tx,ts:now};
    });
    _nsData=d;
    _renderNsDiagram(d);
    _renderNsSummary(d);
    _renderNsDetails(d);
    _renderNsOverview(d);
    _renderNsWizard(d);
    _renderNsAssign(d);
    if(cb) cb();
  })
  .catch(function(){
    var el=document.getElementById('ns-diagram');
    if(el&&!_nsData) el.innerHTML='<div style="color:#f85149;font-size:.85em;text-align:center;padding:30px">Could not reach router — check connection</div>';
    if(cb) cb();
  });
}
function _nsFmtBytes(b){
  b=parseInt(b)||0;
  if(b>1073741824) return (b/1073741824).toFixed(1)+' GB';
  if(b>1048576)    return (b/1048576).toFixed(1)+' MB';
  if(b>1024)       return (b/1024).toFixed(0)+' KB';
  return b+' B';
}
function _nsFmtSpeed(s){
  s=parseInt(s);
  if(s<=0||isNaN(s)) return '&#8212;';
  if(s>=10000) return '10G'; if(s>=2500) return '2.5G';
  if(s>=1000)  return '1G';  if(s>=100)  return '100M';
  return s+'M';
}
function _nsRoleLabel(r){
  var map={
    wan:   '<span style="background:rgba(88,166,255,.15);color:#58a6ff;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">WAN</span>',
    modem: '<span style="background:rgba(240,165,0,.15);color:#f0a500;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">5G Modem</span>',
    wifi:  '<span style="background:rgba(188,140,255,.15);color:#bc8cff;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">WiFi</span>',
    lan:   '<span style="background:rgba(63,185,80,.15);color:#3fb950;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">LAN</span>',
    vpn:   '<span style="background:rgba(248,81,73,.15);color:#f85149;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">VPN</span>',
    mesh:  '<span style="background:rgba(63,185,80,.15);color:#3fb950;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">Mesh</span>',
    ifb:   '<span style="background:rgba(72,79,88,.15);color:#484f58;border-radius:4px;padding:1px 7px;font-size:.75em;font-weight:700">Internal</span>'
  };
  return map[r]||map.lan;
}
function _nsIfaceDesc(name){
  if(name==='ifb4usb0'||name.match(/^ifb/)) return {
    s:'Internal traffic shaper — kernel-only, not a real port',
    c:'IFB (Intermediate Functional Block): a virtual interface Linux creates automatically to mirror modem traffic for QoS/bandwidth shaping. It clones packets so the kernel can apply upload speed limits. You never plug anything into this — it needs no configuration and is managed entirely by the OS.'
  };
  if(name==='wg0'||name.match(/^wg\d/)) return {
    s:'WireGuard VPN tunnel — currently inactive',
    c:'WireGuard is a modern, fast VPN protocol built into the Linux kernel. When active, this encrypts all your traffic and routes it through a remote server — your ISP and anyone snooping sees nothing. Down = tunnel not connected right now.'
  };
  if(name==='ygg0'||name.match(/^ygg/)) return {
    s:'Yggdrasil mesh — your Mycelium node',
    c:'Yggdrasil is an end-to-end encrypted overlay network. Your router uses it to connect to other Rocket Router nodes worldwide without a central server. Even with "Down" status, the 456 bytes sent means it has handshaked or sent keepalives. This is how the Mycelium finds its peers.'
  };
  if(name==='eth0') return {
    s:'Internal CPU-to-switch link — not a physical socket',
    c:'On the MT7988A chipset, the CPU connects to the built-in switch chip over an internal 10G fabric link (10000baseCR = direct copper trace on PCB). Everything flowing through LAN ports lan0/1/2 passes through here internally. No socket exists — hidden from the main table.'
  };
  if(name==='eth1') return {
    s:'2.5G LAN port — nothing plugged in',
    c:'A dedicated 2.5GbE RJ45 socket on the router chassis. Plug in any device or switch that supports 2.5G for a faster wired connection than the standard 1G ports. Auto-negotiates between 100M / 1G / 2.5G. Currently empty — when plugged in, speed will show here.'
  };
  if(name==='eth2') return {
    s:'SFP+ 10G port — connected at 10Gbps',
    c:'The 10G SFP+ cage on the router. Currently running 10GBASE-R (serial optical or DAC copper). Accepts SFP+ modules: single-mode fibre, multi-mode fibre, DAC copper cable, or a 10G RJ45 adapter. High traffic on this port is your 10G uplink in use.'
  };
  if(name.match(/^eth\d+$/)) return {
    s:'Physical ethernet port on the router board',
    c:'One of the router\'s built-in Ethernet ports. Plug in a cable to connect a device or switch.'
  };
  if(name.match(/^lan\d+$/)) return {
    s:'Numbered LAN socket on the router',
    c:'DSA (Distributed Switch Architecture) port — your router has a built-in network switch chip, and these are the individual physical sockets on it, presented to Linux as separate interfaces. lan0/1/2 are the numbered ports on the back/side of the router.'
  };
  if(name.match(/mesh0$/)) return {
    s:'Local neighbourhood mesh (802.11s) — not the global Yggdrasil mesh',
    c:'This is the wireless backhaul your router uses to talk directly to other nearby Rocket Routers over the 5GHz band, forming a local mesh "neighbourhood". It is separate from Yggdrasil (Mycelium) — Yggdrasil works over the internet worldwide, this only works between routers within radio range of each other. Use the local mesh button (Expert tab) to join or release it; the status shown here updates once the router applies the change.'
  };
  if(name.match(/^phy\d+\.0-ap/)) return {
    s:'2.4 GHz WiFi radio — longest range, most compatible',
    c:'The 2.4GHz band. Slower than 5/6GHz but travels further and penetrates walls better. Older devices (smart home kit, IoT sensors) usually connect here. "phy0.0" = physical radio 0, band index 0.'
  };
  if(name.match(/^phy\d+\.1-ap/)) return {
    s:'5 GHz WiFi radio — fast, medium range',
    c:'The 5GHz band. Faster than 2.4GHz, shorter range. Most modern phones, laptops, and tablets prefer this band automatically. "phy0.1" = physical radio 0, band index 1.'
  };
  if(name.match(/^phy\d+\.2-ap/)) return {
    s:'6 GHz WiFi radio — WiFi 7 only, fastest, shortest range',
    c:'The 6GHz band — only available on WiFi 7 (802.11be) hardware. Fastest speeds, lowest interference (fewer devices use it), but shortest range. Only the newest phones and laptops can connect here. This is your premium lane.'
  };
  if(name.match(/^usb\d+$/)) return {
    s:'5G modem — your internet connection',
    c:'An M.2 5G modem module seated inside the router. It talks to the router CPU via USB NCM/MBIM protocol internally — that is why Linux names it usb0, even though there is no USB cable. The IP 192.168.42.x is the modem\'s internal NCM subnet. All internet traffic flows through here. Speed shown (~3.75G) is the USB 3.0 bus speed, not your 5G air speed — actual download/upload depends on signal and network conditions.'
  };
  if(name.match(/^wlan\d+$/)) return {
    s:'WiFi radio interface',
    c:'Standard Linux wireless LAN interface.'
  };
  return {s:'Network interface',c:'Linux kernel network interface.'};
}
function _nsSpeedCell(i){
  if(i.role==='vpn'||i.role==='mesh') return '<span style="color:#484f58;font-size:.85em">Virtual</span>';
  if(i.role==='wifi') return '<span style="color:#484f58;font-size:.85em">Wireless</span>';
  if(i.role==='modem'){
    return i.speed>0?'<span title="USB 3.0 bus speed">'+_nsFmtSpeed(i.speed)+'<span style="color:#484f58;font-size:.75em;margin-left:3px">USB</span></span>':'&#8212;';
  }
  if(i.state==='up'&&i.speed>0) return _nsFmtSpeed(i.speed);
  if(i.max>0) return '<span style="color:#484f58;font-size:.9em">max '+_nsFmtSpeed(i.max)+'</span>';
  return '&#8212;';
}
function _renderNsDiagram(d){
  var el=document.getElementById('ns-diagram'); if(!el) return;
  var ifaces=d.interfaces||[], host=_esc(d.hostname||'Router');
  // Filter internals, classify properly
  var modems=ifaces.filter(function(i){return i.role==='modem';});
  var lans=ifaces.filter(function(i){return i.role==='lan'&&i.state==='up';});
  var wifis=ifaces.filter(function(i){return i.role==='wifi'&&i.state==='up';});
  var vpns=ifaces.filter(function(i){return i.role==='vpn'||i.role==='mesh';});
  // SVG: vertical chain Internet → Modem → Router, branches left/right
  var W=700, H=460;
  var rCX=350;
  // Positions (vertical chain)
  var inet_y=44, modem_y=130, router_y=220;
  var rX=250, rW=200, rH=72;
  var rCY=router_y+rH/2;
  var wanIf=modems[0]||null, wanUp=wanIf&&wanIf.state==='up';
  var wC=wanUp?'#58a6ff':'#21262d';
  var s='<svg viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block">';
  // Internet box
  s+='<rect x="'+(rCX-88)+'" y="6" width="176" height="46" rx="8" fill="#0d1117" stroke="'+wC+'" stroke-width="1.5"/>';
  s+='<text x="'+rCX+'" y="23" text-anchor="middle" fill="'+wC+'" font-size="11" font-weight="700">&#127760; INTERNET</text>';
  s+='<text x="'+rCX+'" y="38" text-anchor="middle" fill="#484f58" font-size="9">Cell tower &#8594; 5G &#8594; your modem</text>';
  // Internet → Modem line — speed based on modem download rate
  var _wanM=modems[0]||null;
  var _rxBps=(_wanM&&_wanM.rxRate>=0)?_wanM.rxRate:0;
  var _txBps=(_wanM&&_wanM.txRate>=0)?_wanM.txRate:0;
  var _totBps=_rxBps+_txBps;
  var _i2mDur=_nsAnimDur(_rxBps);
  // Modem positions first -- so Internet->modem0 line lands on usb0 box centre, not the gap
  var mc=modems.length, msp=Math.min(160,(W-80)/Math.max(mc,1));
  var msx=rCX-(msp*(mc-1)/2);
  var _wm0Col=wanUp?'#f0a500':'#21262d';
  s+='<line x1="'+rCX+'" y1="52" x2="'+msx+'" y2="'+(modem_y)+'" '
    +(_rxBps>0?'class="ns-flow-dyn" style="stroke:'+_wm0Col+';stroke-width:2.5;stroke-linecap:round;animation-duration:'+_i2mDur+'"'
              :'style="stroke:'+_wm0Col+';stroke-width:2.5;stroke-linecap:round;opacity:.35"')
    +'/>';
  // Download rate label (right of pipe, Internet->Modem segment)
  if(_rxBps>500) s+='<text x="'+(msx+8)+'" y="'+(52+Math.round((modem_y-52)/2))+'" fill="#f0a500" font-size="8" font-weight="600">&#8595; '+_nsFmtRate(_rxBps)+'</text>';
  modems.forEach(function(m,i){
    var mx=msx+(i*msp), up=m.state==='up', col=up?'#f0a500':'#21262d';
    var mbox_y=modem_y, mbox_h=68;
    var _mBps=(m.rxRate>=0)?(m.rxRate+m.txRate):0;
    if(i>0){
      var _md=_nsAnimDur(_mBps);
      s+='<line x1="'+rCX+'" y1="52" x2="'+mx+'" y2="'+mbox_y+'" '
        +(_mBps>0?'class="ns-flow-dyn" style="stroke:'+col+';stroke-width:2;stroke-linecap:round;animation-duration:'+_md+'"'
                 :'style="stroke:'+col+';stroke-width:2;stroke-linecap:round;opacity:.35"')
        +'/>';
    }
    s+='<rect x="'+(mx-70)+'" y="'+mbox_y+'" width="140" height="'+mbox_h+'" rx="8" fill="#0d1117" stroke="'+col+'" stroke-width="1.8"/>';
    s+='<text x="'+mx+'" y="'+(mbox_y+17)+'" text-anchor="middle" fill="'+col+'" font-size="11" font-weight="700">&#128244; '+_esc(m.name)+'</text>';
    s+='<text x="'+mx+'" y="'+(mbox_y+31)+'" text-anchor="middle" fill="#8b949e" font-size="9">5G Modem'+(up?' &#9679; Up':' &#9675; Down')+'</text>';
    s+='<text x="'+mx+'" y="'+(mbox_y+45)+'" text-anchor="middle" fill="'+col+'" font-size="9" font-weight="600">&#8595; '+_nsFmtBytes(m.rx)+'  &#8593; '+_nsFmtBytes(m.tx)+'</text>';
    var _mRate=(m.rxRate>=0)?('&#8595; '+_nsFmtRate(m.rxRate)+'  &#8593; '+_nsFmtRate(m.txRate)):'measuring&#8230;';
    s+='<text x="'+mx+'" y="'+(mbox_y+59)+'" text-anchor="middle" fill="#3fb950" font-size="8.5" font-weight="600">'+_mRate+'</text>';
  });
  // Modem → Router line — speed based on combined rate
  var modem_bottom=modem_y+68;
  var _m2rDur=_nsAnimDur(_totBps);
  s+='<line x1="'+rCX+'" y1="'+modem_bottom+'" x2="'+rCX+'" y2="'+router_y+'" '
    +(_totBps>0?'class="ns-flow-dyn" style="stroke:#58a6ff;stroke-width:2.5;stroke-linecap:round;animation-duration:'+_m2rDur+'"'
              :'style="stroke:#21262d;stroke-width:2.5;stroke-linecap:round;opacity:.35"')
    +'/>';
  // Upload rate label (right of pipe, Modem→Router segment)
  if(_txBps>500) s+='<text x="'+(rCX+8)+'" y="'+(modem_bottom+Math.round((router_y-modem_bottom)/2))+'" fill="#58a6ff" font-size="8" font-weight="600">&#8593; '+_nsFmtRate(_txBps)+'</text>';
  // Router box
  s+='<rect x="'+rX+'" y="'+router_y+'" width="'+rW+'" height="'+rH+'" rx="10" fill="#0d1117" stroke="#58a6ff" stroke-width="2"/>';
  s+='<text x="'+rCX+'" y="'+(router_y+22)+'" text-anchor="middle" fill="#58a6ff" font-size="13" font-weight="800">&#128640; '+host+'</text>';
  s+='<text x="'+rCX+'" y="'+(router_y+38)+'" text-anchor="middle" fill="#8b949e" font-size="10">192.168.1.1 — Your Router</text>';
  s+='<circle cx="'+(rCX-18)+'" cy="'+(router_y+56)+'" r="3" fill="#3fb950" class="ns-dot"/>';
  s+='<text x="'+(rCX-12)+'" y="'+(router_y+60)+'" fill="#3fb950" font-size="9">Online</text>';
  var router_bottom=router_y+rH;
  // LAN — right side (dynamic animation per port traffic)
  var visLans=lans.slice(0,6);
  var lsp=visLans.length>0?Math.min(42,(H-router_bottom-20)/Math.max(visLans.length,1)):42;
  var lsy=router_bottom+34;
  visLans.forEach(function(l,i){
    var lx=W-68, ly=lsy+(i*lsp), col='#3fb950';
    var _lBps=(l.rxRate>=0)?(l.rxRate+l.txRate):0;
    var _ld=_nsAnimDur(_lBps);
    s+='<line x1="'+(rX+rW)+'" y1="'+rCY+'" x2="'+(lx-30)+'" y2="'+ly+'" '
      +(_lBps>0?'class="ns-flow-dyn" style="stroke:'+col+';stroke-width:1.8;stroke-linecap:round;animation-duration:'+_ld+'"'
               :'style="stroke:'+col+';stroke-width:1.8;stroke-linecap:round;opacity:.3"')
      +'/>';
    s+='<rect x="'+(lx-38)+'" y="'+(ly-15)+'" width="98" height="32" rx="5" fill="#0d1117" stroke="'+col+'" stroke-width="1.5"/>';
    s+='<text x="'+(lx+11)+'" y="'+(ly+2)+'" text-anchor="middle" fill="'+col+'" font-size="9.5" font-weight="600">'+_esc(l.name)+'</text>';
    var _ldisp=(_lBps>500)?_nsFmtRate(_lBps):_nsFmtSpeed(l.speed);
    if(_ldisp&&_ldisp!='&#8212;') s+='<text x="'+(lx+11)+'" y="'+(ly+14)+'" text-anchor="middle" fill="#f0a500" font-size="7.5">'+_ldisp+'</text>';
  });
  if(lans.length) s+='<text x="'+(W-50)+'" y="'+(router_bottom+8)+'" text-anchor="middle" fill="#3fb950" font-size="9" font-weight="700">LAN</text>';
  // WiFi — left side (dynamic animation per radio traffic)
  var visWifi=wifis.slice(0,4);
  var wsp=visWifi.length>0?Math.min(44,(H-router_bottom-20)/Math.max(visWifi.length,1)):44;
  var wsy=router_bottom+34;
  // Local 802.11s neighbourhood mesh (phy*-mesh0) joined/released state — same
  // toggle as the Expert tab's local-mesh button, surfaced here so the status
  // is visible right on the box without switching tabs.
  var meshJoined = !(d.local_mesh && (d.local_mesh.disabled==='1'||d.local_mesh.disabled===1));
  visWifi.forEach(function(w,i){
    var isMesh=/mesh0$/.test(w.name);
    var wx=58, wy=wsy+(i*wsp), col=isMesh?(meshJoined?'#3fb950':'#484f58'):'#bc8cff';
    var _wBps=(w.rxRate>=0)?(w.rxRate+w.txRate):0;
    var _wd=_nsAnimDur(_wBps);
    s+='<line x1="'+rX+'" y1="'+rCY+'" x2="'+(wx+30)+'" y2="'+wy+'" '
      +(_wBps>0?'class="ns-flow-dyn" style="stroke:'+col+';stroke-width:1.8;stroke-linecap:round;animation-duration:'+_wd+'"'
               :'style="stroke:'+col+';stroke-width:1.8;stroke-linecap:round;opacity:.3"')
      +'/>';
    s+='<rect x="8" y="'+(wy-15)+'" width="96" height="32" rx="5" fill="#0d1117" stroke="'+col+'" stroke-width="1.5"/>';
    s+='<text x="56" y="'+(wy+2)+'" text-anchor="middle" fill="'+col+'" font-size="9.5" font-weight="600">'+(isMesh?'Local Mesh':_esc(w.name))+'</text>';
    var band=w.name.match(/\.2-/)?' 6GHz':w.name.match(/\.1-/)?' 5GHz':' 2.4GHz';
    var _wdisp;
    if(isMesh){
      _wdisp=meshJoined?'&#9679; Joined':'&#9675; Released';
    }else{
      _wdisp=(_wBps>500)?_nsFmtRate(_wBps):band;
    }
    s+='<text x="56" y="'+(wy+14)+'" text-anchor="middle" fill="'+(isMesh?col:'#f0a500')+'" font-size="7.5" font-weight="'+(isMesh?'700':'400')+'">'+_wdisp+'</text>';
  });
  if(wifis.length) s+='<text x="56" y="'+(router_bottom+8)+'" text-anchor="middle" fill="#bc8cff" font-size="9" font-weight="700">WiFi</text>';
  s+='</svg>';
  // Copy button + SVG
  var copyTxt=host+' | WAN: '+(wanIf?wanIf.name:'none')+' | LAN: '+lans.map(function(i){return i.name;}).join(',')+' | WiFi: '+wifis.map(function(i){return i.name;}).join(',');
  var _btnS='background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer';
  el.innerHTML='<div style="display:flex;justify-content:flex-end;margin-bottom:6px">'+' <button onclick="_nsCopy(\'ns-diag-txt\',this)" style="'+_btnS+'">&#128203; Copy</button>'+' <button onclick="_nsDownloadTxt(\'ns-diag-txt\',\'rocket-diagram.txt\',this)" style="'+_btnS+';margin-left:6px">&#128229; Save .txt</button>'+'</div>'
    +'<div id="ns-diag-txt" style="display:none">'+copyTxt+'</div>'+s;
}
function _renderNsSummary(d){
  var el=document.getElementById('ns-summary'); if(!el) return;
  var ifaces=d.interfaces||[];
  var modems=ifaces.filter(function(i){return i.role==='modem';});
  var lans=ifaces.filter(function(i){return i.role==='lan';});
  var wifis=ifaces.filter(function(i){return i.role==='wifi';});
  var vpns=ifaces.filter(function(i){return i.role==='vpn';});
  var mesh=ifaces.filter(function(i){return i.role==='mesh';});
  var upM=modems.filter(function(i){return i.state==='up';});
  var upL=lans.filter(function(i){return i.state==='up';});
  var upW=wifis.filter(function(i){return i.state==='up';});
  var items=[];
  // Internet
  if(upM.length===1){
    items.push({icon:'&#128244;',label:'Internet',col:'#f0a500',
      simple:'Your internet comes through the <strong style="color:#f0a500">5G modem ('+_esc(upM[0].name)+')</strong> — pulling signal from a cell tower.',
      tech:'WAN interface: '+_esc(upM[0].name)+' (USB CDC-NCM/MBIM). &#8595;'+_nsFmtBytes(upM[0].rx)+' received, &#8593;'+_nsFmtBytes(upM[0].tx)+' sent.'});
  } else if(upM.length>1){
    var _mw3Cfgd=!!(d.mwan3&&d.mwan3.enabled);
    items.push({icon:'&#128244;',label:'Internet',col:'#f0a500',
      simple:'<strong style="color:#f0a500">'+upM.length+' active 5G modems</strong> — '+(_mw3Cfgd?'load balancing between them for faster, more resilient internet.':'both modems ready — apply Failover or Load Balance in the Setup Wizard below.'),
      tech:'Multi-WAN: '+upM.map(function(i){return i.name;}).join(', ')+(_mw3Cfgd?'. mwan3 routing active.':'. mwan3 not yet configured.')+'  &#9888; Removing a SIM requires a router reboot to re-detect interfaces.'});
    } else {
    items.push({icon:'&#9888;',label:'Internet',col:'#f85149',simple:'No active internet connection detected.',tech:'No WAN interface is up.'});
  }
  // LAN
  if(upL.length){
    var ethUp=upL.filter(function(i){return i.name.match(/^eth/);});
    var lanUp=upL.filter(function(i){return i.name.match(/^lan/);});
    items.push({icon:'&#128279;',label:'Wired devices',col:'#3fb950',
      simple:upL.length+' wired connection'+(upL.length>1?'s are':' is')+' active. These are physical ethernet cables plugged into your router\'s LAN ports.',
      tech:'Active LAN interfaces: '+upL.map(function(i){return i.name+' ('+_nsFmtSpeed(i.speed)+')';}).join(', ')+'.'});
  }
  // WiFi
  if(upW.length){
    var bands=upW.map(function(w){return w.name.match(/\.2-/)?' 6 GHz':w.name.match(/\.1-/)?' 5 GHz':' 2.4 GHz';});
    items.push({icon:'&#128225;',label:'WiFi',col:'#bc8cff',
      simple:upW.length+' WiFi radio'+(upW.length>1?'s are':' is')+' broadcasting ('+bands.join(', ')+' bands). Any wireless device nearby can connect.',
      tech:'Active AP interfaces: '+upW.map(function(i){return i.name;}).join(', ')+'. Tri-band WiFi 7 (802.11be).'});
  }
  // VPN
  var vpnUp=vpns.filter(function(i){return i.state==='up';});
  if(vpns.length){
    items.push({icon:'&#128274;',label:'WireGuard VPN',col:vpnUp.length?'#f85149':'#484f58',
      simple: vpnUp.length?'VPN tunnel is <strong style="color:#f85149">active</strong> — your traffic is encrypted.':'VPN tunnel is <strong style="color:#484f58">inactive</strong> — not connected. Enable it to encrypt your traffic through a remote server.',
      tech:'wg0 interface state: '+(vpnUp.length?'up':'down')+'.'});
  }
  // Mesh
  var meshIf=mesh[0]||null;
  if(meshIf){
    var meshUp=meshIf.state==='up';
    items.push({icon:'&#127812;',label:'Yggdrasil Mesh',col:meshUp?'#3fb950':'#484f58',
      simple: meshUp?'Your Mycelium mesh node is <strong style="color:#3fb950">connected</strong> to the global peer network.':'Yggdrasil mesh is <strong style="color:#8b949e">standing by</strong>'+(parseInt(meshIf.tx)>0?' — has sent '+_nsFmtBytes(meshIf.tx)+' (handshaked with peers).':'.'),
      tech:'ygg0 state: '+meshIf.state+'. TX: '+_nsFmtBytes(meshIf.tx)+' RX: '+_nsFmtBytes(meshIf.rx)+'.'});
  }
  var h='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">';
  h+='<div style="font-size:.82em;font-weight:700;color:#8b949e;text-transform:uppercase;letter-spacing:.08em">Current Setup</div>';
  h+='<div style="display:flex;gap:6px;align-items:center">';
  h+='<button class="ns-ref-btn" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 9px;font-size:.8em;cursor:pointer">&#x21BB;</button>';
  h+='<button onclick="_nsCopyCard(\'ns-summary-body\',this)" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer">&#128203; Copy</button>';
  h+='<button onclick="_nsDownloadTxt(\'ns-summary-body\',\'rocket-setup.txt\',this)" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer">&#128229; Save .txt</button>';
  h+='</div>';
  h+='</div><div id="ns-summary-body">';
  items.forEach(function(item){
    h+='<div style="border:1px solid #21262d;border-radius:8px;padding:12px 14px;margin-bottom:8px">';
    h+='<div style="font-size:.82em;font-weight:700;color:'+item.col+';margin-bottom:4px">'+item.icon+' '+item.label+'</div>';
    h+='<div style="font-size:.85em;color:#c9d1d9;line-height:1.7;margin-bottom:4px">'+item.simple+'</div>';
    h+='<div style="font-size:.75em;color:#484f58;font-family:monospace;line-height:1.6">'+item.tech+'</div>';
    h+='</div>';
  });
  h+='</div>';
  el.innerHTML=h;
}
function _nsCopyCard(id,btn){
  var el=document.getElementById(id); if(!el) return;
  var text=el.innerText||el.textContent;
  if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(function(){
      if(btn){var o=btn.textContent;btn.textContent='✓ Copied!';setTimeout(function(){btn.textContent=o;},1500);}
    });
  }
}
function _nsCopy(id,btn){
  var el=document.getElementById(id); if(!el) return;
  var text=el.innerText||el.textContent||el.getAttribute('data-txt')||'';
  if(!text&&el.dataset) text=el.dataset.txt||'';
  if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(function(){
      if(btn){var o=btn.textContent;btn.textContent='✓ Copied!';setTimeout(function(){btn.textContent=o;},1500);}
    });
  }
}
function _renderNsDetails(d){
  var el=document.getElementById('ns-details'); if(!el) return;
  var ifaces=d.interfaces||[]; if(!ifaces.length){el.innerHTML='';return;}
  var h='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">';
  h+='<div style="font-size:.82em;font-weight:700;color:#8b949e;text-transform:uppercase;letter-spacing:.08em">All Interfaces</div>';
  h+='<div style="display:flex;gap:6px;align-items:center">';
  h+='<button class="ns-ref-btn" onclick="_nsRefreshNow()" title="Refresh" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 9px;font-size:.8em;cursor:pointer">&#x21BB;</button>';
  h+='<button onclick="_nsCopyCard(\'ns-details-body\',this)" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer">&#128203; Copy</button>';
  h+='<button onclick="_nsDownloadTxt(\'ns-details-body\',\'rocket-interfaces.txt\',this)" style="background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);color:#58a6ff;border-radius:6px;padding:4px 12px;font-size:.75em;cursor:pointer">&#128229; Save .txt</button>';
  h+='</div>';
  h+='</div><div id="ns-details-body">';
  h+='<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:.8em">';
  h+='<tr style="border-bottom:1px solid #21262d">';
  h+='<th style="text-align:left;padding:6px 10px;color:#484f58;font-weight:600">Interface</th>';
  h+='<th style="text-align:left;padding:6px 10px;color:#484f58;font-weight:600">What it is</th>';
  h+='<th style="text-align:left;padding:6px 10px;color:#484f58;font-weight:600">Role</th>';
  h+='<th style="text-align:left;padding:6px 10px;color:#484f58;font-weight:600">Speed</th>';
  h+='<th style="text-align:left;padding:6px 10px;color:#484f58;font-weight:600">Status</th>';
  h+='<th style="text-align:right;padding:6px 10px;color:#484f58;font-weight:600">&#8595; In</th>';
  h+='<th style="text-align:right;padding:6px 10px;color:#484f58;font-weight:600">&#8593; Out</th>';
  h+='</tr>';
  // Physical interfaces first, then software tunnels
  var physical=ifaces.filter(function(i){return i.role!=='vpn'&&i.role!=='mesh';});
  var tunnels=ifaces.filter(function(i){return i.role==='vpn'||i.role==='mesh';});
  var renderRow=function(i){
    var up=i.state==='up', sc=up?'#3fb950':'#484f58';
    var desc=_nsIfaceDesc(i.name);
    // Virtual/software interfaces have no meaningful physical speed
    var spd=_nsSpeedCell(i);
    h+='<tr style="border-bottom:1px solid #161b22">';
    h+='<td style="padding:7px 10px;color:#e6edf3;font-weight:600;font-family:monospace;white-space:nowrap">'+_esc(i.name)+'</td>';
    h+='<td style="padding:7px 10px;min-width:180px"><div style="color:#c9d1d9;font-size:.85em;line-height:1.5">'+desc.s+'</div><div style="color:#484f58;font-size:.73em;line-height:1.5;margin-top:2px">'+desc.c+'</div></td>';
    h+='<td style="padding:7px 10px;white-space:nowrap">'+_nsRoleLabel(i.role)+'</td>';
    h+='<td style="padding:7px 10px;color:#8b949e;white-space:nowrap">'+spd+'</td>';
    h+='<td style="padding:7px 10px;white-space:nowrap"><span style="color:'+sc+'">&#9679; '+(up?'Up':'Down')+'</span></td>';
    h+='<td style="padding:7px 10px;text-align:right;color:#8b949e;white-space:nowrap">'+_nsFmtBytes(i.rx)+'</td>';
    h+='<td style="padding:7px 10px;text-align:right;color:#8b949e;white-space:nowrap">'+_nsFmtBytes(i.tx)+'</td>';
    h+='</tr>';
  };
  physical.forEach(renderRow);
  if(tunnels.length){
    h+='<tr><td colspan="7" style="padding:10px 10px 4px;font-size:.73em;font-weight:700;color:#484f58;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid #21262d;border-top:1px solid #30363d">&#128275; Software Tunnels &amp; Mesh</td></tr>';
    tunnels.forEach(renderRow);
  }
  h+='</table></div>';
  // Footnote about hidden internal interfaces
  h+='<div style="margin-top:10px;padding:8px 12px;background:rgba(33,38,45,.5);border-radius:6px;font-size:.73em;color:#484f58;border:1px solid #21262d">';
  h+='<strong style="color:#8b949e">Hidden:</strong> <code style="color:#8b949e">ifb4usb0</code> — internal kernel traffic-shaper mirror (IFB). ';
  h+='It exists so the OS can apply QoS/bandwidth limits to the modem. Not a real port, never needs configuration. Shown here for transparency only.';
  h+='</div></div>';
  el.innerHTML=h;
}


// ── Celebration canvas ────────────────────────────────────────────────────────
function celebrate(){
  var canvas = document.getElementById('ccanvas');
  if(!canvas) return;
  canvas.style.display = 'block';
  var ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  var colors = ['#ff6b35','#3fb950','#f0a500','#58a6ff','#ff7ee1','#ffd60a','#ff453a'];
  var particles = [];
  for(var i = 0; i < 140; i++){
    var r = Math.random();
    var type = r < 0.25 ? 'heart' : (r < 0.6 ? 'rect' : 'circle');
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      size: Math.random() * 14 + 6,
      color: colors[Math.floor(Math.random() * colors.length)],
      type: type,
      rot: Math.random() * Math.PI * 2,
      rotV: (Math.random() - 0.5) * 0.18,
      alpha: 1
    });
  }
  var startTime = Date.now();
  var duration = 3800;
  function drawHeart(c, sz){
    c.beginPath();
    c.moveTo(0, -sz * 0.3);
    c.bezierCurveTo(sz * 0.5, -sz * 0.9, sz * 1.1, -sz * 0.2, sz * 0.5, sz * 0.3);
    c.bezierCurveTo(sz * 0.25, sz * 0.6, 0, sz * 0.75, 0, sz * 0.75);
    c.bezierCurveTo(0, sz * 0.75, -sz * 0.25, sz * 0.6, -sz * 0.5, sz * 0.3);
    c.bezierCurveTo(-sz * 1.1, -sz * 0.2, -sz * 0.5, -sz * 0.9, 0, -sz * 0.3);
    c.fill();
  }
  function frame(){
    var elapsed = Date.now() - startTime;
    if(elapsed > duration){
      canvas.style.display = 'none';
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      return;
    }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    var progress = elapsed / duration;
    particles.forEach(function(p){
      p.x += p.vx; p.y += p.vy; p.rot += p.rotV; p.vy += 0.08;
      if(p.y > canvas.height){ p.y = -20; p.x = Math.random() * canvas.width; p.vy = Math.random() * 4 + 2; }
      p.alpha = progress < 0.65 ? 1 : (1 - (progress - 0.65) / 0.35);
      ctx.globalAlpha = Math.max(0, p.alpha);
      ctx.fillStyle = p.color;
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
      if(p.type === 'rect'){ ctx.fillRect(-p.size/2, -p.size/4, p.size, p.size/2); }
      else if(p.type === 'circle'){ ctx.beginPath(); ctx.arc(0, 0, p.size/2, 0, Math.PI*2); ctx.fill(); }
      else { drawHeart(ctx, p.size/2); }
      ctx.restore(); ctx.globalAlpha = 1;
    });
    requestAnimationFrame(frame);
  }
  frame();
}

// ── Apply donation/gate state ────────────────────────────────────────────────
function applyDonationState(){
  var donated = false;
  try{ donated = localStorage.getItem('rr_donate') === '1'; }catch(e){}
  document.querySelectorAll('.rr-gated').forEach(function(el){
    if(donated){ el.classList.add('rr-donated'); }
    else{ el.classList.remove('rr-donated'); }
  });
  // Update donate buttons across all instances
  document.querySelectorAll('.rr-donate-all').forEach(function(b){
    if(donated){
      b.textContent = '\u2713 Donating My 75% \u2014 Thank You';
      b.classList.add('donated');
      b.onclick = null;
    } else {
      b.textContent = 'Donate My 75% \u2014 Into the Mycelium';
      b.classList.remove('donated');
      b.onclick = function(){ donateMesh(); };
    }
  });
  document.querySelectorAll('.rr-donate-leave-all').forEach(function(l){
    l.style.display = donated ? 'block' : 'none';
  });
  // Mesh status text in gate pitches
  var meshJoined = false;
  try{ meshJoined = localStorage.getItem('rr_mesh') === '1'; }catch(e){}
  document.querySelectorAll('.gp-ygg-status').forEach(function(el){
    el.textContent = meshJoined ? '\u2713 Connected to the Mycelium mesh' : 'Not currently in the mesh';
  });
}

// ── Donate ────────────────────────────────────────────────────────────────────
function donateMesh(silent){
  var btn = document.getElementById('donate-btn');
  var leave = document.getElementById('donate-leave');
  if(btn){
    btn.textContent = '✓ Donating My 75% — Thank You';
    btn.classList.add('donated');
    btn.onclick = null;
  }
  if(leave) leave.style.display = 'block';
  // sync all tab instances
  document.querySelectorAll('.rr-donate-all').forEach(function(b){
    b.textContent = '✓ Donating My 75% — Thank You';
    b.classList.add('donated');
    b.onclick = null;
  });
  document.querySelectorAll('.rr-donate-leave-all').forEach(function(l){ l.style.display = 'block'; });
  try{ localStorage.setItem('rr_donate','1'); }catch(e){}
  applyDonationState();
  if(!silent){
    celebrate();
    setTimeout(function(){ var o=document.getElementById('ty-donate'); if(o) o.style.display='block'; }, 1600);
  }
}
function undonate(){
  var btn = document.getElementById('donate-btn');
  var leave = document.getElementById('donate-leave');
  if(btn){
    btn.textContent = 'Donate My 75% — Into the Mycelium';
    btn.classList.remove('donated');
    btn.onclick = function(){ donateMesh(); };
  }
  if(leave) leave.style.display = 'none';
  // sync all tab instances
  document.querySelectorAll('.rr-donate-all').forEach(function(b){
    b.textContent = 'Donate My 75% — Into the Mycelium';
    b.classList.remove('donated');
    b.onclick = function(){ donateMesh(); };
  });
  document.querySelectorAll('.rr-donate-leave-all').forEach(function(l){ l.style.display = 'none'; });
  try{ localStorage.setItem('rr_donate','0'); }catch(e){}
  applyDonationState();
}

// ── Join / Leave mesh ─────────────────────────────────────────────────────────
function _syncMeshUI(joined){
  // Sync earn tab (ID-based)
  var btn  = document.getElementById('join-btn');
  var note = document.getElementById('mj-note');
  var lv   = document.getElementById('mj-leave');
  if(btn){  btn.textContent = joined ? '✓ IN THE MESH — SHARING THE FREEDOM' : 'JOIN THE MESH — SHARE THE FREEDOM'; btn.classList.toggle('joined', joined); }
  if(note)  note.style.display  = joined ? 'none'  : 'block';
  if(lv)    lv.style.display    = joined ? 'block' : 'none';
  // Sync all other tab instances (class-based)
  document.querySelectorAll('.rr-join-all').forEach(function(b){ b.textContent = joined ? '✓ IN THE MESH — SHARING THE FREEDOM' : 'JOIN THE MESH — SHARE THE FREEDOM'; b.classList.toggle('joined', joined); });
  document.querySelectorAll('.rr-note-all').forEach(function(n){ n.style.display = joined ? 'none'  : 'block'; });
  document.querySelectorAll('.rr-leave-all').forEach(function(l){ l.style.display = joined ? 'block' : 'none'; });
  // Sync the real per-tab gate-pitch buttons (gp-* class, present in every gated tab)
  document.querySelectorAll('.gp-join-btn').forEach(function(b){ b.textContent = joined ? '✓ IN THE MESH — SHARING THE FREEDOM' : 'JOIN THE MESH — SHARE THE FREEDOM'; b.classList.toggle('joined', joined); });
  document.querySelectorAll('.gp-leave-wrap').forEach(function(l){ l.style.display = joined ? 'block' : 'none'; });
}
function joinMesh(silent){
  fetch('/cgi-bin/rocket?mesh_join').then(function(){
    _syncMeshUI(true);
    try{ localStorage.setItem('rr_mesh','1'); }catch(e){}
    // Joining the mesh is the only step now — it unlocks everything that used
    // to require a separate "donate" action. No standalone donate gate.
    donateMesh(true);
    if(!silent){
      celebrate();
      setTimeout(function(){ var o=document.getElementById('ty-mesh'); if(o) o.style.display='block'; }, 1600);
    }
  });
}
function leaveMesh(){
  fetch('/cgi-bin/rocket?mesh_leave').then(function(){
    _syncMeshUI(false);
    try{ localStorage.setItem('rr_mesh','0'); }catch(e){}
    // Leaving the mesh re-locks everything joining unlocked.
    undonate();
  });
}

// ── Local mesh (802.11s neighbourhood) ───────────────────────────────────────
function initLocalMesh(){
  fetch('/cgi-bin/rocket?local_mesh_status').then(function(r){ return r.json(); }).then(function(d){
    renderLocalMesh(d.disabled === '1' || d.disabled === 1);
  }).catch(function(){
    var s = document.getElementById('local-mesh-status');
    if(s) s.innerHTML = '<span style="color:#f85149">⚠ Could not read status</span>';
  });
}
function renderLocalMesh(released){
  var btn    = document.getElementById('local-mesh-btn');
  var status = document.getElementById('local-mesh-status');
  if(!btn) return;
  if(released){
    status.innerHTML = '<span style="color:#484f58">○ Released — not in local mesh</span>';
    btn.textContent  = 'MESH JOIN LOCAL';
    btn.style.background = 'linear-gradient(135deg,#196127,#238636,#2ea043)';
    btn.dataset.state = 'released';
  } else {
    status.innerHTML = '<span style="color:#3fb950">● Joined — scanning for neighbours</span>';
    btn.textContent  = 'MESH RELEASE LOCAL';
    btn.style.background = 'linear-gradient(135deg,#6e3a1e,#9e4424,#b84d2a)';
    btn.dataset.state = 'joined';
  }
}
function toggleLocalMesh(){
  var btn = document.getElementById('local-mesh-btn');
  if(!btn) return;
  btn.disabled = true;
  btn.textContent = 'Please wait…';
  var action = btn.dataset.state === 'joined' ? 'local_mesh_release' : 'local_mesh_join';
  fetch('/cgi-bin/rocket?' + action).then(function(){
    btn.disabled = false;
    renderLocalMesh(action === 'local_mesh_release');
  }).catch(function(){
    btn.disabled = false;
    btn.textContent = '⚠ Error — try again';
  });
}

// ── HaGeZi DNS Blocklist ──────────────────────────────────────────────────────
var _hgzSelected = null;
var _hgzCurrent  = 'off';

var _hgzDesc = {
  'off':     'No DNS-level ad or threat blocking from this feature. The Cloudflare Family Shield above still runs independently.',
  'light':   '📗 Light — 131,000 domains. Blocks the most obvious ads and trackers. Relaxed filtering — unlikely to break anything. Good starting point if you\'re not sure.',
  'normal':  '📘 Normal — 184,000 domains. Blocks ads, trackers, and common malware domains. The sweet spot for most households. Balanced — everyday sites work fine.',
  'pro':     '📒 Pro — 250,000 domains. Adds native platform tracking (apps phoning home) and popup ads on top of Normal. Balanced/thorough — occasional false positives possible on obscure sites.',
  'proplus': '📙 Pro++ — 322,000 domains. Adds bug trackers and aggressive ad networks. Most of the internet\'s surveillance infrastructure, blocked at the DNS level. Suits privacy-conscious households.',
  'ultimate':'📕 Ultimate — 414,000 domains. Maximum coverage. Blocks known bad actors, data brokers, telemetry, and threat infrastructure. Some legitimate services may be caught — check this level if anything stops working.'
};

function updateHageziStatus(){ try{ initDnsBlock(); }catch(e){} }
function initDnsBlock(){
  fetch('/cgi-bin/rocket?dns_block_status').then(function(r){ return r.json(); }).then(function(d){
    _hgzCurrent  = d.level || 'off';
    _hgzSelected = _hgzCurrent;
    _renderDnsBlock(d);
  }).catch(function(){
    var s = document.getElementById('hagezi-status');
    if(s) s.textContent = '⚠ unavailable';
  });
}

function _renderDnsBlock(d){
  var s = document.getElementById('hagezi-status');
  if(s){
    if(d.level === 'off') s.innerHTML = '<span style="color:#484f58">● OFF</span>';
    else s.innerHTML = '<span style="color:#3fb950">● Active — ' + d.level + '</span>' + (d.updated !== 'never' ? ' <span style="color:#484f58;font-size:.9em">· ' + d.updated + '</span>' : '');
  }
  _highlightDnsLevel(_hgzCurrent);
  _showDnsDesc(_hgzCurrent);
  var upd = document.getElementById('hagezi-update');
  if(upd) upd.style.display = (d.level !== 'off') ? 'inline-block' : 'none';
}

function selectDnsLevel(level){
  _hgzSelected = level;
  _highlightDnsLevel(level);
  _showDnsDesc(level);
  var apply = document.getElementById('hagezi-apply');
  if(apply) apply.style.display = (level !== _hgzCurrent) ? 'inline-block' : 'none';
  var warn = document.getElementById('hagezi-memwarn');
  if(warn) warn.style.display = (level === 'proplus' || level === 'ultimate') ? 'block' : 'none';
}

function _highlightDnsLevel(level){
  document.querySelectorAll('.hgz-lvl').forEach(function(b){
    var active = b.dataset.level === level;
    b.style.border    = active ? '2px solid #58a6ff' : '1px solid rgba(88,166,255,.3)';
    b.style.color     = active ? '#e6edf3' : '#8b949e';
    b.style.background= active ? 'rgba(88,166,255,.15)' : 'rgba(48,54,61,.5)';
  });
}

function _showDnsDesc(level){
  var desc = document.getElementById('hagezi-desc');
  if(!desc) return;
  desc.textContent = _hgzDesc[level] || '';
  desc.style.display = 'block';
}

function applyDnsLevel(){
  if(!_hgzSelected) return;
  var apply = document.getElementById('hagezi-apply');
  var msg   = document.getElementById('hagezi-msg');
  if(apply){ apply.disabled = true; apply.textContent = 'Applying…'; }
  if(msg){ msg.style.display = 'none'; }
  var url = _hgzSelected === 'off' ? '/cgi-bin/rocket?dns_block_off' : '/cgi-bin/rocket?dns_block_set=' + _hgzSelected;
  fetch(url).then(function(r){ return r.json(); }).then(function(d){
    if(apply){ apply.disabled = false; apply.textContent = 'Apply'; }
    if(d.ok){
      _hgzCurrent = _hgzSelected;
      apply.style.display = 'none';
      if(msg){ msg.textContent = '✓ Applied'; msg.style.display = 'inline'; setTimeout(function(){ msg.style.display = 'none'; }, 3000); }
      var upd = document.getElementById('hagezi-update');
      if(upd) upd.style.display = (_hgzCurrent !== 'off') ? 'inline-block' : 'none';
      var s = document.getElementById('hagezi-status');
      if(s && _hgzCurrent === 'off') s.innerHTML = '<span style="color:#484f58">● OFF</span>';
      else if(s) s.innerHTML = '<span style="color:#3fb950">● Active — ' + _hgzCurrent + '</span>';
    } else {
      if(msg){ msg.style.color = '#f85149'; msg.textContent = '⚠ ' + (d.error || 'failed'); msg.style.display = 'inline'; }
    }
  }).catch(function(){
    if(apply){ apply.disabled = false; apply.textContent = 'Apply'; }
    if(msg){ msg.style.color = '#f85149'; msg.textContent = '⚠ network error'; msg.style.display = 'inline'; }
  });
}

function updateDnsLevel(){
  if(_hgzCurrent === 'off') return;
  var upd = document.getElementById('hagezi-update');
  var msg = document.getElementById('hagezi-msg');
  if(upd){ upd.disabled = true; upd.textContent = '↻ Updating…'; }
  fetch('/cgi-bin/rocket?dns_block_set=' + _hgzCurrent).then(function(r){ return r.json(); }).then(function(d){
    if(upd){ upd.disabled = false; upd.textContent = '↻ Update list now'; }
    if(d.ok && msg){ msg.style.color = '#3fb950'; msg.textContent = '✓ List updated'; msg.style.display = 'inline'; setTimeout(function(){ msg.style.display = 'none'; }, 3000); }
    else if(msg){ msg.style.color = '#f85149'; msg.textContent = '⚠ update failed'; msg.style.display = 'inline'; }
  }).catch(function(){
    if(upd){ upd.disabled = false; upd.textContent = '↻ Update list now'; }
  });
}

// ── Memory options ────────────────────────────────────────────────────────────
function selectMem(v, el){
  document.querySelectorAll('.mem-opt').forEach(function(o){o.classList.remove('active')});
  el.classList.add('active');
  var note = document.getElementById('mem-note');
  var notes = {
    'none':    'Not contributing. No memory allocated to the mesh AI. Change any time.',
    '128':     'Light contribution — caching responses and relaying inference requests. Every bit helps. Your router will not feel this at all.',
    '256':     'Solid contribution — enough for local inference on small tasks across your LAN. Still nothing your router will notice.',
    'dynamic': 'Maximum contribution. We take what\'s free, give it back the instant the router needs it. On this router that\'s typically 400–600 MB of real, useful memory going into the mesh. This is the good stuff.'
  };
  if(note) note.textContent = notes[v] || '';
  try{ localStorage.setItem('rr_mem', v); }catch(e){}
}
function saveMem(){
  document.getElementById('mem-saved').style.display = 'block';
}

// ── Wallet ────────────────────────────────────────────────────────────────────
function saveWallet(){
  try{
    localStorage.setItem('rr_paypal', document.getElementById('w-paypal').value);
    localStorage.setItem('rr_crypto', document.getElementById('w-crypto').value);
  }catch(e){}
  document.getElementById('wallet-saved').style.display = 'block';
}

// ── Community governance ──────────────────────────────────────────────────────
// ── Governance v3.7 ──────────────────────────────────────────────────────────
var _govLoaded = false;
function initGov(){
  if(_govLoaded) return;
  _govLoaded = true;
  fetch('/cgi-bin/rocket?gov_status')
    .then(function(r){ return r.json(); })
    .then(function(d){ _renderGov(d); })
    .catch(function(){ var i=document.getElementById('gov-inner'); if(i) i.innerHTML='<span style="color:#f0a500;font-size:.82em">&#x26A0;&#xFE0F; Could not reach governance API</span>'; });
}
function _renderGov(d){
  var i=document.getElementById('gov-inner'); if(!i) return;
  var h='';
  if(!d.ready){
    h+='<div style="background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.25);border-radius:10px;padding:16px;margin-bottom:14px">';
    h+='<div style="font-size:.85em;font-weight:600;color:#f0a500;margin-bottom:8px">&#x26A0;&#xFE0F; Govbot Not Configured</div>';
    h+='<div style="font-size:.78em;color:#8b949e;line-height:1.8">SSH to the router, then run:<pre style="background:#0d1117;border:1px solid #21262d;border-radius:6px;padding:10px;margin:8px 0;color:#3fb950;font-size:.88em;overflow-x:auto;white-space:pre">mkdir -p /etc/rocket\n# Register govbot (once only):\ncurl -s -X POST http://localhost:6167/_matrix/client/v3/register \\\n  -H &quot;Content-Type: application/json&quot; \\\n  -d &apos;{&quot;username&quot;:&quot;rocket-gov&quot;,&quot;password&quot;:&quot;CHANGE_ME&quot;,&quot;kind&quot;:&quot;user&quot;}&apos;\n\n# Store token + room ID:\necho &quot;TOKEN_HERE&quot; &gt; /etc/rocket/gov-token\necho &quot;!roomid:matrix.rocketrouters.co.uk&quot; &gt; /etc/rocket/gov-room</pre>';
    h+='Room ID: Element &#x2192; Room Settings &#x2192; Advanced</div></div>';
  }
  h+='<div style="background:rgba(240,165,0,.06);border:1px solid rgba(240,165,0,.2);border-radius:10px;padding:16px;margin-bottom:10px">';
  h+='<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">';
  h+='<div><div style="font-size:.86em;font-weight:600;color:#f0a500;margin-bottom:3px">&#x26A0;&#xFE0F; Warn</div>';
  h+='<div style="font-size:.77em;color:#6e7681;line-height:1.55">Flag a member. Posted to community room. Reversible.</div></div>';
  h+='<button onclick="govShowForm(\'warn\')" style="background:rgba(240,165,0,.14);border:1px solid rgba(240,165,0,.38);color:#f0a500;border-radius:7px;padding:8px 16px;font-size:.81em;font-weight:600;cursor:pointer;flex-shrink:0"'+(d.ready?'':' disabled title="Configure govbot first"')+'>Issue Warning</button>';
  h+='</div><div id="gov-warn-form" style="display:none;margin-top:12px;border-top:1px solid rgba(240,165,0,.12);padding-top:12px">'+_govForm('warn','f0a500','Post Warning &#x2192;')+'</div></div>';
  h+='<div style="background:rgba(226,75,74,.06);border:1px solid rgba(226,75,74,.2);border-radius:10px;padding:16px;margin-bottom:10px">';
  h+='<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">';
  h+='<div><div style="font-size:.86em;font-weight:600;color:#e24b4a;margin-bottom:3px">&#x1F534; Chat Ban</div>';
  h+='<div style="font-size:.77em;color:#6e7681;line-height:1.55">Community vote. Posts proposal to Matrix room. 24h deliberation.</div></div>';
  h+='<button onclick="govShowForm(\'ban\')" style="background:rgba(226,75,74,.11);border:1px solid rgba(226,75,74,.32);color:#e24b4a;border-radius:7px;padding:8px 16px;font-size:.81em;font-weight:600;cursor:pointer;flex-shrink:0"'+(d.ready?'':' disabled title="Configure govbot first"')+'>Propose Ban</button>';
  h+='</div><div id="gov-ban-form" style="display:none;margin-top:12px;border-top:1px solid rgba(226,75,74,.12);padding-top:12px">'+_govForm('ban','e24b4a','Open Vote &#x2192;')+'</div></div>';
  h+='<div style="background:rgba(48,54,61,.4);border:1px solid rgba(48,54,61,.8);border-radius:10px;padding:16px" id="gov-bomb-card">';
  h+='<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">';
  h+='<div><div style="font-size:.86em;font-weight:600;color:#484f58;margin-bottom:3px">&#x1F4A3; Mesh Bomb <span style="font-size:.75em;font-weight:400;color:#3a3f44">(locked until Chat Ban passes)</span></div>';
  h+='<div style="font-size:.77em;color:#484f58;line-height:1.55">Ed25519-signed. Propagates to every mesh node. Permanent. Cannot be undone.</div></div>';
  h+='<button disabled style="background:rgba(48,54,61,.25);border:1px solid rgba(48,54,61,.5);color:#3a3f44;border-radius:7px;padding:8px 16px;font-size:.81em;font-weight:600;cursor:not-allowed;flex-shrink:0">&#x1F512; Locked</button>';
  h+='</div></div>';
  if(d.proposals && d.proposals.length){
    h+='<div style="margin-top:14px;padding-top:14px;border-top:1px solid #21262d">';
    h+='<div style="font-size:.7em;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#3fb950;margin-bottom:8px">Active Proposals</div>';
    d.proposals.forEach(function(p){
      h+='<div style="background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px;margin-bottom:8px;font-size:.81em">';
      h+='<span style="color:#e24b4a;font-weight:600">&#x1F534; BAN</span> <code style="color:#8b949e;font-size:.9em">'+_esc(p.target)+'</code>';
      h+='<br><span style="color:#6e7681;font-size:.92em">'+_esc(p.reason)+'</span>';
      h+='<br><span style="color:#3fb950">&#x1F44D; '+(p.votes_for||0)+'</span> <span style="color:#484f58;margin:0 6px">&#xB7;</span> <span style="color:#e24b4a">&#x1F44E; '+(p.votes_against||0)+'</span>';
      h+=' <span style="color:#3a3f44;font-size:.88em;margin-left:6px">'+_esc(p.created)+'</span></div>';
    });
    h+='</div>';
  }
  i.innerHTML=h;
}
function _esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function _govForm(type,col,btnLabel){
  var c=type==='warn'?'240,165,0':'226,75,74';
  return '<div style="display:grid;gap:9px">'+
    '<div><label style="font-size:.77em;color:#6e7681;display:block;margin-bottom:3px">Matrix ID of member</label>'+
    '<input id="gov-'+type+'-target" type="text" placeholder="@username:matrix.rocketrouters.co.uk" style="width:100%;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:7px 11px;color:#e6edf3;font-size:.84em;font-family:monospace"></div>'+
    '<div><label style="font-size:.77em;color:#6e7681;display:block;margin-bottom:3px">Reason <span style="color:#3a3f44">(visible to whole community)</span></label>'+
    '<textarea id="gov-'+type+'-reason" rows="2" placeholder="Clear, factual reason&#x2026;" style="width:100%;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:7px 11px;color:#e6edf3;font-size:.84em;resize:vertical"></textarea></div>'+
    '<div style="display:flex;gap:7px;justify-content:flex-end">'+
    '<button onclick="govShowForm(\''+type+'\',1)" style="background:none;border:1px solid #30363d;color:#484f58;border-radius:6px;padding:6px 13px;font-size:.79em;cursor:pointer">Cancel</button>'+
    '<button onclick="govSubmit(\''+type+'\')" id="gov-'+type+'-btn" style="background:rgba('+c+',.13);border:1px solid rgba('+c+',.36);color:#'+col+';border-radius:6px;padding:6px 15px;font-size:.79em;font-weight:600;cursor:pointer">'+btnLabel+'</button></div>'+
    '<div id="gov-'+type+'-msg" style="font-size:.78em;min-height:16px"></div></div>';
}
function govShowForm(type,hide){
  var f=document.getElementById('gov-'+type+'-form'); if(!f) return;
  f.style.display=(hide||f.style.display==='block')?'none':'block';
  if(f.style.display==='block'){ var inp=document.getElementById('gov-'+type+'-target'); if(inp) setTimeout(function(){inp.focus();},40); }
}
function govSubmit(type){
  var tEl=document.getElementById('gov-'+type+'-target');
  var rEl=document.getElementById('gov-'+type+'-reason');
  var btn=document.getElementById('gov-'+type+'-btn');
  var msg=document.getElementById('gov-'+type+'-msg');
  var t=(tEl&&tEl.value||'').trim(), r=(rEl&&rEl.value||'').trim();
  if(!t){ if(msg){msg.style.color='#f0a500';msg.textContent='&#x26A0;&#xFE0F; Matrix ID required';} return; }
  if(!r){ if(msg){msg.style.color='#f0a500';msg.textContent='&#x26A0;&#xFE0F; Reason required';} return; }
  if(btn){btn.disabled=true;btn.textContent='Sending…';}
  if(msg){msg.textContent='';}
  fetch('/cgi-bin/rocket?gov_'+type+'&target='+encodeURIComponent(t)+'&reason='+encodeURIComponent(r))
    .then(function(res){return res.json();})
    .then(function(d){
      if(btn){btn.disabled=false;btn.innerHTML=type==='warn'?'Post Warning &#x2192;':'Open Vote &#x2192;';}
      if(d.ok){
        if(msg){msg.style.color='#3fb950';msg.textContent='✓ '+d.msg;}
        if(tEl)tEl.value=''; if(rEl)rEl.value='';
        _govLoaded=false;
        setTimeout(function(){initGov();},1400);
      } else {
        if(msg){msg.style.color='#e24b4a';msg.textContent='✗ '+(d.error||'Failed');}
      }
    })
    .catch(function(){
      if(btn){btn.disabled=false;btn.innerHTML=type==='warn'?'Post Warning &#x2192;':'Open Vote &#x2192;';}
      if(msg){msg.style.color='#e24b4a';msg.textContent='✗ Network error';}
    });
}

// ── Embedded live chat ────────────────────────────────────────────────────────
var _chatPoll = null;
var _chatReady = false;
var _chatSeq = 0;   // increments on room switch — stale in-flight fetches bail on mismatch
var _chatErrs = 0;  // consecutive error counter — only show offline after 2+ in a row


function initChat(){
  if(_chatReady) return;
  _chatReady = true;
  loadMessages(true);
  _chatPoll = setInterval(function(){ loadMessages(false); }, 5000);
}

function stopChat(){
  _chatReady = false;
  _chatSeq++;
  _chatErrs = 0;
  if(_chatPoll){ clearInterval(_chatPoll); _chatPoll = null; }
}

function loadMessages(scroll){
  if(_chatTab === 'global') return; // don't clobber global view
  var seq = _chatSeq; // capture now — if it changes before fetch resolves, we're stale
  var _cmUrl = '/cgi-bin/rocket?chat_messages&_t='+Date.now();
  if(currentRoom && currentRoom.id) _cmUrl += '&room=' + encodeURIComponent(currentRoom.id);
  fetch(_cmUrl)  // govbot always reads — user token only needed for sending
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(_chatSeq !== seq) return; // room switched while in-flight — discard
      _chatErrs = 0;
      renderMessages(d, scroll);
    })
    .catch(function(err){
      if(_chatSeq !== seq) return;
      _chatErrs++;
      console.error('[chat] fetch failed (err '+_chatErrs+'):', err && err.name, err && err.message);
      if(_chatErrs >= 2){
        var s = document.getElementById('chat-status');
        if(s){ s.textContent = '⚠ ' + (err && err.name ? err.name : 'offline'); s.style.color = '#f0a500'; }
      }
    });
}

function renderMessages(d, scroll){
  if(_chatTab !== 'local') return; // discard if user switched tab while fetch was in-flight
  var box  = document.getElementById('chat-msgs');
  var stat = document.getElementById('chat-status');
  if(!box) return;

  if(d.ok === false){
    if(d.error === 'not_configured' || d.error === 'token_expired'){
      var isExpired = d.error === 'token_expired';
      var head = isExpired ? '&#x26A0;&#xFE0F; Session expired' : '&#x1F344; No mesh identity yet';
      var sub  = isExpired
        ? 'The govbot token expired. One click refreshes it automatically.'
        : 'Setting up your mesh identity lets you chat with other Rocket Router owners — locally on your network and globally across the mesh. It also powers the community voting system. You only need to do this once.';
      var btnTxt = isExpired ? 'Refresh token &#x1F344;' : 'Set up mesh identity &#x1F344;';
      if(stat){ stat.innerHTML = isExpired ? '&#x26A0;&#xFE0F; expired' : '&#x26A0;&#xFE0F; not set up'; stat.style.color='#f0a500'; }
      box.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:10px;padding:20px;text-align:center">'
        +'<div style="font-size:.9em;font-weight:600;color:#e6edf3">'+head+'</div>'
        +'<div style="font-size:.79em;color:#484f58;line-height:1.75;max-width:300px">'+sub+'</div>'
        +'<button onclick="chatAutoSetup()" id="chat-setup-btn" style="background:rgba(63,185,80,.13);border:1px solid rgba(63,185,80,.38);color:#3fb950;border-radius:8px;padding:10px 22px;font-size:.86em;font-weight:600;cursor:pointer;margin-top:2px">'+btnTxt+'</button>'
        +'<div id="chat-setup-msg" style="font-size:.78em;min-height:18px;color:#484f58"></div>'
        +'</div>';
      return;
    }
    if(stat){ stat.textContent = '⚠ error'; stat.style.color='#f0a500'; }
    box.innerHTML = '<span style="color:#484f58;font-size:.81em;align-self:center;text-align:center;padding:10px">Matrix error: '+_esc(d.error||'unknown')+'</span>';
    return;
  }

  var chunk = (d.chunk || []).slice().reverse();
  chunk = chunk.filter(function(ev){ return ev.type === 'm.room.message' && ev.content && ev.content.body && !/^#(global|mesh|world)\b/i.test(ev.content.body); }); // hide gossip-carrier messages from local view

  if(stat){ stat.textContent = chunk.length ? '● live' : '○ empty'; stat.style.color = chunk.length ? '#3fb950' : '#484f58'; }

  if(!chunk.length){
    box.innerHTML = '<span style="color:#3a3f44;font-size:.82em;align-self:center;margin:auto">No messages yet — say hello 👋</span>';
    return;
  }

  var atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;

  // Rewrite old CGI file URLs to new static path
  function _fixFileUrl(u){
    if(!u) return u;
    var m = u.match(/chat_file[^&]*&id=([a-zA-Z0-9._-]+)/);
    if(m) return '/chat-files/' + m[1];
    return u;
  }

  function _buildMsgEl(ev){
    var sender  = ev.sender || '';
    var local   = sender.replace(/^@([^:]+):.*$/, '$1') || sender.replace(/^@/,'') || 'anon';
    var _rawBody = ev.content.body || '';
    if(/^#(global|mesh|world)\b/i.test(_rawBody)) return null; // hard block gossip messages
    var body    = _esc(_rawBody);
    var msgtype = ev.content.msgtype || 'm.text';
    var ts      = ev.origin_server_ts ? new Date(ev.origin_server_ts) : null;
    var timeStr = ts ? ts.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '';
    var isGov   = /^(WARNING:|BAN PROPOSAL)/.test(ev.content.body || '');
    var bg      = isGov ? 'rgba(226,75,74,.07)' : 'rgba(22,27,34,.6)';
    var border  = isGov ? 'rgba(226,75,74,.18)' : 'rgba(48,54,61,.38)';
    var evId    = _esc(ev.event_id || '');
    var contentHtml = '';
    if(msgtype === 'm.image' && ev.content.url){
      var imgUrl = _esc(_fixFileUrl(ev.content.url));
      contentHtml = '<div style="margin-top:5px"><img src="'+imgUrl+'" alt="'+body+'" style="max-width:100%;max-height:220px;border-radius:8px;cursor:pointer;display:block" onclick="window.open(\''+imgUrl+'\',\'_blank\')" onerror="this.style.display=\'none\'"></div>';
    } else if(msgtype==='m.video' && ev.content.url){
      var fUrl  = _esc(_fixFileUrl(ev.content.url));
      var fMime = (ev.content.info && ev.content.info.mimetype) ? _esc(ev.content.info.mimetype) : 'video/mp4';
      var fSize = ev.content.info && ev.content.info.size ? ' · '+Math.round(ev.content.info.size/1024)+'KB' : '';
      contentHtml = '<div style="margin-top:6px">'
        + '<video controls preload="auto" src="'+fUrl+'" type="'+fMime+'" style="max-width:100%;max-height:280px;border-radius:8px;background:#000;display:block"></video>'
        + '<div style="font-size:.75em;color:#484f58;margin-top:3px">🎥 '+body+fSize+'</div>'
        + '</div>';
    } else if(msgtype==='m.audio' && ev.content.url){
      var fUrl  = _esc(_fixFileUrl(ev.content.url));
      var fMime = (ev.content.info && ev.content.info.mimetype) ? _esc(ev.content.info.mimetype) : 'audio/mpeg';
      var fSize = ev.content.info && ev.content.info.size ? ' · '+Math.round(ev.content.info.size/1024)+'KB' : '';
      contentHtml = '<div style="margin-top:6px">'
        + '<audio controls preload="metadata" style="width:100%;max-width:360px;display:block">'
        + '<source src="'+fUrl+'" type="'+fMime+'">'
        + '</audio>'
        + '<div style="font-size:.75em;color:#484f58;margin-top:3px">🎵 '+body+fSize+'</div>'
        + '</div>';
    } else if(msgtype==='m.file' && ev.content.url){
      var fUrl  = _esc(_fixFileUrl(ev.content.url));
      var fSize = ev.content.info && ev.content.info.size ? ' · '+Math.round(ev.content.info.size/1024)+'KB' : '';
      contentHtml = '<div style="margin-top:5px"><a href="'+fUrl+'" target="_blank" style="display:inline-flex;align-items:center;gap:6px;background:rgba(88,166,255,.08);border:1px solid rgba(88,166,255,.2);border-radius:7px;padding:6px 12px;color:#58a6ff;font-size:.83em;text-decoration:none">📎 '+body+fSize+'</a></div>';
    } else {
      contentHtml = '<div style="color:#c9d1d9;font-size:.85em;line-height:1.55;word-break:break-word">'+body+'</div>';
    }
    var h = '<div data-ev="'+evId+'" style="background:'+bg+';border:1px solid '+border+';border-radius:9px;padding:8px 12px">';
    h += '<div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px">';
    h += '<div style="display:flex;align-items:center;gap:6px">'+_avatarWrap(sender,24)+'<span style="color:#58a6ff;font-weight:600;font-size:.84em">@'+_esc(local)+'</span></div>';
    h += '<div style="display:flex;align-items:center;gap:8px">';
    h += '<span style="color:#3a3f44;font-size:.8em">'+timeStr+'</span>';
    if(evId) h += '<button onclick="chatRedact(\''+evId+'\',this)" title="Delete message" style="background:none;border:none;color:#3a3f44;cursor:pointer;font-size:.8em;padding:0 2px;line-height:1;transition:.15s" onmouseover="this.style.color=\'#f85149\'" onmouseout="this.style.color=\'#3a3f44\'">&#x2715;</button>';
    h += '</div></div>';
    h += contentHtml;
    h += '</div>';
    return h;
  }

  // DOM diff — only add genuinely new messages, never replace existing ones
  // This preserves video/audio elements so they don't get reset mid-playback
  var existingIds = {};
  Array.prototype.forEach.call(box.querySelectorAll('[data-ev]'), function(el){
    existingIds[el.getAttribute('data-ev')] = true;
  });

  var added = 0;
  chunk.forEach(function(ev){
    var evId = ev.event_id || '';
    if(evId && existingIds[_esc(evId)]) return; // already in DOM — leave it alone
    var tmp = document.createElement('div');
    var _msgHtml = _buildMsgEl(ev);
    if(!_msgHtml) return;
    tmp.innerHTML = _msgHtml;
    var newEl = tmp.firstChild;
    if(newEl) { box.appendChild(newEl); added++; }
  });

  // If this is a forced reload (scroll=true) and nothing was added, box was already up to date
  if(scroll && added === 0 && !box.querySelector('[data-ev]')){
    // Empty room — already handled above
  }
  if(scroll || atBottom) box.scrollTop = box.scrollHeight;
}

var _chatPendingFiles = [];

function chatSend(){
  var inp = document.getElementById('chat-input');
  var btn = document.getElementById('chat-send-btn');
  if(!inp) return;
  var msg = inp.value.trim();
  var hasPending = _chatPendingFiles.length > 0;
  if(!msg && !hasPending) return;
  if(btn){ btn.disabled = true; btn.textContent = '…'; }
  inp.value = '';
  inp.style.height = '38px';
  var room = (_chatTab === 'local' && currentRoom && currentRoom.id) ? currentRoom.id : '';
  var pendingCopy = _chatPendingFiles.slice();
  _chatPendingFiles = [];
  _renderChatPendingStrip();
  function afterText(){
    if(pendingCopy.length > 0){
      _uploadChatFilesSeq(pendingCopy, room, 0, function(){
        if(btn){ btn.disabled=false; btn.textContent='Send 🍄'; }
        document.getElementById('chat-file-input').value='';
        if(_chatTab === 'global') loadGlobal();
        else setTimeout(function(){ loadMessages(true); }, 700);
      });
    } else {
      if(btn){ btn.disabled=false; btn.textContent='Send 🍄'; }
    }
  }
  if(msg){
    var sendMsg = (_chatTab === 'global' && !/^#(global|mesh|world)/i.test(msg)) ? '#global ' + msg : msg;
    var _userTok = _getUserToken();
    var _csUrl = '/cgi-bin/rocket?chat_send&msg=' + encodeURIComponent(sendMsg) + (_userTok ? '&tok='+encodeURIComponent(_userTok) : '');
    if(room) _csUrl += '&room=' + encodeURIComponent(room);
    fetch(_csUrl)
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d.ok){
          if(_chatTab === 'global') loadGlobal();
          else setTimeout(function(){ loadMessages(true); }, 400);
        } else if(d.error === 'token_expired'){
          // Token stale (server restarted) — clear it so user sees login prompt
          try{ localStorage.removeItem('rr_user_token'); }catch(e){}
          if(typeof userInit === 'function') userInit();
          inp.value = msg; // restore message so user can resend after re-login
          var s = document.getElementById('chat-status');
          if(s){ s.textContent = '⚠ Session expired — please sign in again'; s.style.color = '#f0a500'; }
        } else {
          inp.value = msg;
          var s = document.getElementById('chat-status');
          if(s){ s.textContent = '⚠ ' + (d.error || 'send failed'); s.style.color = '#f0a500'; }
        }
        afterText();
      })
      .catch(function(){ inp.value = msg; afterText(); });
  } else {
    afterText();
  }
}

function chatKeydown(e){
  if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); chatSend(); }
}

function chatAttach(){
  document.getElementById('chat-file-input').click();
}

function handleChatFile(input){
  var ALLOWED_EXT = /\.(jpe?g|jfif|png|gif|webp|avif|heic|heif|bmp|mp4|mov|avi|mkv|webm|mp3|ogg|wav|flac|aac|pdf|txt|zip|tar|gz|doc|docx|xls|xlsx|ppt|pptx)$/i;
  var files = Array.prototype.slice.call(input.files);
  if(!files.length) return;
  var blocked = [];
  for(var i=0;i<files.length;i++){
    var f = files[i];
    if(f.size > 52428800){ alert('File too large — max 50MB: ' + f.name); continue; }
    if(!ALLOWED_EXT.test(f.name)){
      blocked.push(f.name);
      continue;
    }
    _chatPendingFiles.push(f);
  }
  if(blocked.length){
    alert('File type not supported:\n' + blocked.join('\n') + '\n\nAllowed: images, video, audio, PDF, Office docs, zip, txt');
  }
  _renderChatPendingStrip();
  input.value = '';
}

function _renderChatPendingStrip(){
  var strip = document.getElementById('chat-pending-strip');
  if(!strip) return;
  if(_chatPendingFiles.length === 0){ strip.style.display='none'; strip.innerHTML=''; return; }
  strip.style.display = 'flex';
  strip.innerHTML = '';
  for(var i=0;i<_chatPendingFiles.length;i++){
    (function(idx, file){
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative;display:inline-flex;align-items:center;gap:4px;background:rgba(48,54,61,.7);border-radius:8px;padding:4px 8px;font-size:12px;color:#c9d1d9;max-width:140px';
      var isImg = file.type.startsWith('image/');
      if(isImg){
        var thumb = document.createElement('img');
        thumb.style.cssText = 'width:36px;height:36px;object-fit:cover;border-radius:4px;flex-shrink:0';
        var url = URL.createObjectURL(file);
        thumb.src = url;
        thumb.onload = function(){ URL.revokeObjectURL(url); };
        wrap.appendChild(thumb);
      } else {
        var icon = document.createElement('span');
        icon.style.cssText = 'font-size:22px;flex-shrink:0';
        icon.textContent = file.type.startsWith('video/') ? '🎬' : file.type.startsWith('audio/') ? '🎵' : '📄';
        wrap.appendChild(icon);
      }
      var name = document.createElement('span');
      name.style.cssText = 'overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:80px';
      name.textContent = file.name;
      wrap.appendChild(name);
      var x = document.createElement('button');
      x.textContent = '×';
      x.style.cssText = 'background:none;border:none;color:#8b949e;cursor:pointer;font-size:14px;padding:0 2px;flex-shrink:0;line-height:1';
      x.onclick = function(){ _removeChatPending(idx); };
      wrap.appendChild(x);
      strip.appendChild(wrap);
    })(i, _chatPendingFiles[i]);
  }
}

function _removeChatPending(idx){
  _chatPendingFiles.splice(idx, 1);
  _renderChatPendingStrip();
}

function _uploadChatFilesSeq(files, room, idx, done){
  if(idx >= files.length){ if(done) done(); return; }
  var file = files[idx];
  var btn = document.getElementById('chat-send-btn');
  if(btn) btn.textContent = '⬆ '+(idx+1)+'/'+files.length;
  var url = '/cgi-bin/rocket?chat_upload&name='+encodeURIComponent(file.name)+'&mime='+encodeURIComponent(file.type||'application/octet-stream');
  if(room) url += '&room='+encodeURIComponent(room);
  var xhr = new XMLHttpRequest();
  xhr.upload.onprogress = function(e){
    if(!e.lengthComputable||!btn) return;
    btn.textContent = '⬆ '+(idx+1)+'/'+files.length+' '+Math.round(e.loaded/e.total*100)+'%';
  };
  xhr.onload = function(){
    try{
      var d=JSON.parse(xhr.responseText);
      if(!d.ok) alert('Upload failed: '+(d.error||'unknown')+' ('+file.name+')');
    }catch(e){}
    _uploadChatFilesSeq(files, room, idx+1, done);
  };
  xhr.onerror = function(){
    alert('Upload failed — network error ('+file.name+')');
    _uploadChatFilesSeq(files, room, idx+1, done);
  };
  xhr.open('POST', url);
  xhr.setRequestHeader('Content-Type', file.type||'application/octet-stream');
  xhr.send(file);
}

function chatRedact(evId, btn){
  if(!evId) return;
  if(!confirm('Delete this message?')) return;
  var msgDiv = btn.closest ? btn.closest('[data-ev]') : (function(el){ while(el && !el.dataset.ev) el=el.parentElement; return el; })(btn);
  if(btn){ btn.disabled = true; btn.textContent = '…'; }
  var url = '/cgi-bin/rocket?msg_redact&event=' + encodeURIComponent(evId);
  if(currentRoom && currentRoom.id) url += '&room=' + encodeURIComponent(currentRoom.id);
  fetch(url)
    .then(function(r){ return r.json(); })
    .then(function(d){
      if(d.ok){
        if(msgDiv){ msgDiv.style.opacity = '0'; msgDiv.style.transition = 'opacity .3s'; setTimeout(function(){ if(msgDiv.parentNode) msgDiv.parentNode.removeChild(msgDiv); }, 300); }
      } else {
        if(btn){ btn.disabled = false; btn.textContent = '✕'; }
        var s = document.getElementById('chat-status');
        if(s){ s.textContent = '⚠ ' + (d.error || 'delete failed'); s.style.color = '#f0a500'; }
      }
    })
    .catch(function(){
      if(btn){ btn.disabled = false; btn.textContent = '✕'; }
    });
}

function chatAutoSetup(){
  var btn = document.getElementById('chat-setup-btn');
  var msg = document.getElementById('chat-setup-msg');
  if(btn){ btn.disabled=true; btn.innerHTML='Setting up&#x2026;'; }
  var steps = ['Checking conduwuit config&#x2026;','Registering govbot&#x2026;','Creating community room&#x2026;','Storing credentials&#x2026;'];
  var si = 0;
  var ticker = setInterval(function(){
    si = (si+1) % steps.length;
    if(msg && btn && btn.disabled) msg.innerHTML = steps[si];
  }, 1200);
  if(msg) msg.innerHTML = steps[0];
  fetch('/cgi-bin/rocket?chat_setup')
    .then(function(r){ return r.json(); })
    .then(function(d){
      clearInterval(ticker);
      if(d.ok){
        if(msg){ msg.style.color='#3fb950'; msg.innerHTML='&#x2713; Ready — '+_esc(d.room); }
        if(btn){ btn.disabled=false; btn.style.display='none'; }
        _govLoaded = false;
        setTimeout(function(){ loadMessages(true); initGov(); }, 900);
      } else {
        if(btn){ btn.disabled=false; btn.innerHTML='Retry &#x1F344;'; }
        if(msg){ msg.style.color='#e24b4a'; msg.innerHTML='&#x2717; Step: '+_esc(d.step||'?')+' &mdash; '+_esc(d.error||'failed'); }
      }
    })
    .catch(function(){
      clearInterval(ticker);
      if(btn){ btn.disabled=false; btn.innerHTML='Retry &#x1F344;'; }
      if(msg){ msg.style.color='#e24b4a'; msg.textContent='Network error'; }
    });
}

// ── Rooms — static server-side rendered, no init needed ──────────────────────
function initRooms(){}

// ── Room switching ────────────────────────────────────────────────────────────
var currentRoom = null; // null = default community room (from /etc/rocket/gov-room)

function joinRoom(alias, name, emoji){
  var status = document.getElementById('chat-status');
  if(status){ status.textContent = '⟳ joining…'; status.style.color='#484f58'; }
  fetch('/cgi-bin/rocket?room_resolve&alias=' + encodeURIComponent(alias))
    .then(function(r){ return r.json(); })
    .then(function(d){
      currentRoom = d.ok
        ? {id: d.room_id, alias: alias, name: name, emoji: emoji||'💬'}
        : {id: null, alias: alias, name: name, emoji: emoji||'💬', comingSoon: true};
      _updateRoomBreadcrumb();
      // Scroll chat box into view
      var box = document.getElementById('chat-box');
      if(box) setTimeout(function(){ box.scrollIntoView({behavior:'smooth', block:'nearest'}); }, 80);
      // Restart chat poll for new room
      stopChat();
      if(currentRoom.comingSoon){
        var msgs = document.getElementById('chat-msgs');
        if(msgs) msgs.innerHTML = '<span style="color:#484f58;font-size:.82em;align-self:center;text-align:center;padding:20px">🌱 This room is coming soon<br><span style="color:#3a3f44;font-size:.9em;display:block;margin-top:6px">Opens when the first member joins.</span></span>';
        var s = document.getElementById('chat-status');
        if(s){ s.textContent = '○ empty'; s.style.color='#484f58'; }
      } else {
        initChat();
      }
    })
    .catch(function(){
      if(status){ status.textContent = '⚠ error'; status.style.color='#f0a500'; }
    });
}

function leaveRoom(){
  currentRoom = null;
  _updateRoomBreadcrumb();
  stopChat();
  initChat();
  var grid = document.getElementById('rooms-grid');
  if(grid) setTimeout(function(){ grid.scrollIntoView({behavior:'smooth', block:'start'}); }, 80);
}

function _updateRoomBreadcrumb(){
  var crumb = document.getElementById('chat-room-crumb');
  var nameEl = document.getElementById('chat-room-name');
  if(!crumb) return;
  if(currentRoom){
    crumb.style.display = 'block';
    if(nameEl) nameEl.textContent = (currentRoom.emoji||'') + ' ' + (currentRoom.name||'');
  } else {
    crumb.style.display = 'none';
    if(nameEl) nameEl.textContent = '';
  }
}

// ── filterRooms — search over server-side rendered cards ─────────────────────
function filterRooms(val){
  var q = (val||'').toLowerCase().trim();
  var cards = document.querySelectorAll('.rr-rc');
  var shown = 0;
  cards.forEach(function(c){
    var match = !q || (c.dataset.n||'').indexOf(q) > -1 || (c.dataset.d||'').indexOf(q) > -1;
    c.style.display = match ? '' : 'none';
    if(match) shown++;
  });
  var cnt = document.getElementById('rooms-count');
  if(cnt) cnt.textContent = shown + ' room' + (shown !== 1 ? 's' : '');
}
function cpA(addr,btn){
  try{ navigator.clipboard.writeText(addr); }catch(e){
    var t=document.createElement('textarea');t.value=addr;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);
  }
  var o=btn.textContent; btn.textContent='✓ copied'; btn.style.color='#3fb950';
  setTimeout(function(){ btn.textContent=o; btn.style.color='#484f58'; },2000);
}

