# Rocket Routers Firmware A v2.5 - package name fixes
# (current OpenWrt SNAPSHOT renamed/reorganised some packages since v2.4)
#
# Append to .config in ~/src/openwrt then run: make defconfig

# WireGuard - the standalone luci-app was deprecated. WireGuard is now
# configured as a network protocol via Network -> Interfaces -> Add -> WireGuard.
# This package adds the protocol handler to LuCI. The CLI tool (wireguard-tools)
# is already in the main config.
CONFIG_PACKAGE_luci-proto-wireguard=y
# CONFIG_PACKAGE_luci-app-wireguard is not set

# mtr - now split into json/nojson variants. We pick the JSON-capable one
# for future scripting (mtr -j gives JSON output for automation/dashboards).
CONFIG_PACKAGE_mtr-json=y

# speedtest-netperf - the underlying script (no LuCI wrapper exists in current
# feeds). Customers SSH in and run "speedtest-netperf" for a quick bandwidth
# check against public netperf servers. iperf3 is also baked in for full
# bidirectional testing.
CONFIG_PACKAGE_speedtest-netperf=y
