# Rocket Routers Firmware A v2.5.4 - package additions
# Append to .config in ~/src/openwrt then run: make defconfig
#
# Build delta v2.5.3 -> v2.5.4:
#   - REMOVED luci-proto-modemmanager (it owns the "Cellular Network"
#     menu entry that we don't want; we don't use ModemManager protocol
#     for dialing anyway - Q-modem owns the modem)
#   - ADDED   uci-defaults 92-rocket-pin-modem (handled at file-tree level,
#     not via .config - drops /etc/rocket-pin-modem.sh + init.d service)
#   - KEPT    everything else from v2.5.3

# ============================================================================
# v2.4 baseline (unchanged)
# ============================================================================

# Multi-WAN failover/load-balance
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# SQM / cake bufferbloat control
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y

# Statistics + graphs
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-ping=y

# Bandwidth monitor
CONFIG_PACKAGE_luci-app-nlbwmon=y

# vnstat2 — per-interface traffic stats for Expert tab dashboard
CONFIG_PACKAGE_vnstat2=y

# ModemManager core - kept (some kmods depend on it indirectly).
# Disabled at runtime in 97-rocket-modem so it doesn't fight Q-modem.
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y

# v2.5.4 NEW REMOVAL: luci-proto-modemmanager - owns the Cellular Network
# menu entry that confuses customers. We don't use this proto.
# CONFIG_PACKAGE_luci-proto-modemmanager is not set

# Software flow offloading kernel side (nftables)
CONFIG_PACKAGE_kmod-nft-offload=y

# ============================================================================
# v2.5 baseline (unchanged)
# ============================================================================

# WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y

# banIP - threat-feed firewall (default disabled, switchable in LuCI)
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_luci-app-banip=y

# Diagnostics
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-speedtest-netperf=y

# ============================================================================
# v2.5.4: Q-Modem GUI suite (TRIMMED, unchanged from v2.5.3)
# ============================================================================
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y

# ============================================================================
# v3.4.0: sms-tool — REQUIRED for AT command execution
# ============================================================================
# 97-rocket-modem uses sms_tool -d /dev/ttyUSBx at '...' for ALL AT commands
# (NCM mode, autoapn, APN fallback, etc). Without this package every AT command
# returns error 127 (command not found) and the modem is never configured.
CONFIG_PACKAGE_sms-tool=y
# CONFIG_PACKAGE_luci-app-qmodem-monitor is not set
# CONFIG_PACKAGE_luci-app-qmodem-mwan is not set

# ============================================================================
# 802.11s mesh + wpad-mesh-mbedtls (unchanged from v2.5.3)
# ============================================================================
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic is not set
CONFIG_PACKAGE_wpad-mesh-mbedtls=y

# ============================================================================
# Attended Sysupgrade (unchanged - still removed)
# ============================================================================
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_attendedsysupgrade-common is not set
# ============================================================================
# LuCI — REQUIRED, full stack explicitly listed (no missing deps)
# ============================================================================
# luci              = meta-package, pulls in theme + core modules
# luci-base         = dispatcher, runtime, core JS/CSS
# luci-theme-bootstrap = default theme (templates in /www/luci-static)
# uhttpd            = web server (REQUIRED — without it nothing serves port 80)
# uhttpd-mod-ubus   = ubus bridge for real-time LuCI data
# rpcd              = RPC daemon (session auth, module APIs)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
# v3.4.2: modemdata status tab (was missing — only qmodem-next was present)
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
# v3.4.2: WireGuard LuCI protocol (fixes "unsupported protocol" in LuCI)
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y

CONFIG_PACKAGE_miniupnpc=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_yggdrasil=y
CONFIG_PACKAGE_yggdrasil-jumper=y
CONFIG_PACKAGE_luci-proto-yggdrasil=y
CONFIG_PACKAGE_openssl-util=y

# ============================================================================
# v3.4.1: MT7996 WiFi driver + firmware — REQUIRED for Z8803BE WiFi
# ============================================================================
# These were missing from all previous builds. Without them /lib/firmware/mediatek/
# is empty, lsmod shows no mt7996, and iwinfo returns nothing.
# kmod-mt7996e       = kernel driver (the .ko)
# kmod-mt7996-firmware-common = shared firmware blobs
# kmod-mt7996-firmware        = standard firmware set
# kmod-mt7996-233-firmware    = newer chip revision firmware (also needed)
# ============================================================================
# v3.4.2: Network tools
# ============================================================================
# nmap: network scanner — see all devices, open ports, identify unknowns
# Not just for hackers — essential for any network admin or curious customer
CONFIG_PACKAGE_nmap=y

# tcpdump + libpcap — packet capture for Expert tab dashboard
# Must be baked in — apk install produces pcap symbol errors (ABI mismatch)
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_libpcap=y

CONFIG_PACKAGE_kmod-mt7996e=y
CONFIG_PACKAGE_kmod-mt7996-firmware-common=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996-233-firmware=y

# ============================================================================
# v3.5.1: USB storage — Samsung SSD + future Conduit Matrix homeserver
# ============================================================================
# kmod-usb-storage     = USB mass storage driver (shows drive as /dev/sda)
# kmod-usb-storage-uas = UAS protocol — faster for SSDs over USB 3.x
# kmod-fs-ext4         = ext4 read/write support (Linux native filesystem)
# e2fsprogs            = mkfs.ext4 + fsck.ext4 (format and check the drive)
# block-mount          = automount support (mount on boot, fstab integration)
# fdisk                = partition the drive from the router CLI
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
