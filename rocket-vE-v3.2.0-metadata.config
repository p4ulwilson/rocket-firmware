# Rocket Routers Firmware E — Mycelium v3.2.0 — VERSION METADATA
# Append to .config in ~/src/openwrt then run: make defconfig
#
# Changes from v3.1.0:
#   - 97-rocket-modem: PERMANENT APN FIX
#       autoapn=0 (was =1 — fails on Smarty/Three UK MVNO)
#       AT+CGDCONT=1,"IPV4V6","three.co.uk" set explicitly at first boot
#       /etc/hotplug.d/usb/20-quectel-smarty-apn deployed — re-applies APN
#       on every USB connect event (modem power cycle, cfun reset, USB glitch)
#       Firewall WAN zone lookup by name (was @zone[1] index — fragile)
#   - 96-rocket-yggdrasil: KEYPAIR PERSISTENCE FIX
#       Private key extracted from yggdrasil.conf and saved to UCI immediately
#       after keygen — proto script always finds same key, address never changes
#       /etc/init.d/rocket-ygg-persist deployed — syncs UCI key from conf on
#       every boot (START=19, before netifd=20)
#   - Package manager: APK (not opkg — pttuan custom branch)

CONFIG_VERSION_DIST="Rocket Routers"
CONFIG_VERSION_NUMBER="3.2.0"
CONFIG_VERSION_CODE="rocket-E-mycelium"
CONFIG_VERSION_REPO="https://rocketrouters.co.uk"
CONFIG_VERSION_MANUFACTURER="Rocket Routers"
CONFIG_VERSION_MANUFACTURER_URL="https://rocketrouters.co.uk"
CONFIG_VERSION_BUG_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_SUPPORT_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_PRODUCT="Rocket Plus E"
CONFIG_VERSION_HWREV="E"
CONFIG_VERSION_FILENAMES=y
