# Rocket Routers Firmware A v2.5.1 - VERSION METADATA
# Append to .config in ~/src/openwrt then run: make defconfig
#
# WHY THIS EXISTS:
# Builds without these fields produce sysupgrade tarballs whose CONTROL file
# only contains BOARD=zbtlink_zbt-z8803be. LuCI's "Flash image" page rejects
# such images as "invalid" because metadata (VERSION/REVISION) is missing.
# sysupgrade on CLI requires -F to override.
#
# With these fields set, the build embeds full metadata into the sysupgrade
# image and /etc/openwrt_release on the running router. LuCI accepts the
# upload without Force, and `cat /etc/openwrt_release` shows Rocket branding.

CONFIG_VERSION_DIST="Rocket Routers"
CONFIG_VERSION_NUMBER="2.5.1"
CONFIG_VERSION_CODE="rocket-A-fibre-cell"
CONFIG_VERSION_REPO="https://rocketrouters.co.uk"
CONFIG_VERSION_MANUFACTURER="Rocket Routers"
CONFIG_VERSION_MANUFACTURER_URL="https://rocketrouters.co.uk"
CONFIG_VERSION_BUG_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_SUPPORT_URL="https://rocketrouters.co.uk/support"
CONFIG_VERSION_PRODUCT="Rocket Plus"
CONFIG_VERSION_HWREV="A"
CONFIG_VERSION_FILENAMES=y
