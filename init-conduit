#!/bin/sh /etc/rc.common
# /etc/init.d/conduit
# procd service for conduwuit Matrix homeserver
# Binary lives on SSD at /mnt/ssd/conduit — graceful no-op if not present
# Rocket Routers v3.6.0+

START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -x /mnt/ssd/conduit ] || return 0
    [ -f /mnt/ssd/conduit-data/conduit.toml ] || return 0

    # ── Unique invite code per device ────────────────────────────────────────
    # If still set to the factory default, replace with a random per-device code.
    # This runs once at first boot after setup. Existing accounts are NEVER affected —
    # the token only gates new registrations.
    CURRENT_TOKEN=$(grep 'registration_token' /mnt/ssd/conduit-data/conduit.toml | cut -d'"' -f2)
    if [ "$CURRENT_TOKEN" = "mycelium2026" ]; then
        # Generate a friendly random code: mycelium- + 8 random hex chars
        NEW_TOKEN="mycelium-$(cat /dev/urandom | tr -dc 'a-z0-9' | head -c 8)"
        sed -i "s/registration_token = \"mycelium2026\"/registration_token = \"${NEW_TOKEN}\"/" \
            /mnt/ssd/conduit-data/conduit.toml
        logger -t rocket "Generated unique mesh invite code: ${NEW_TOKEN}"
    fi
    # ─────────────────────────────────────────────────────────────────────────

    # Remove stale RocksDB lock if present
    rm -f /mnt/ssd/conduit-data/db/LOCK 2>/dev/null

    procd_open_instance
    procd_set_param command /mnt/ssd/conduit --config /mnt/ssd/conduit-data/conduit.toml
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}
